{
    "label": "Counsel",
    "description": "Classic, trustworthy design for law firms, attorneys and notaries with navy, ivory and brass colors, serif headings, sharp corners and fine gold rules",
    "maintainer": "Aimeos",
    "email": "info@aimeos.org",
    "website": "https://pagible.com",
    "types": {
        "page": {
            "sections": [
                "main",
                "footer"
            ]
        },
        "docs": {
            "sections": [
                "main",
                "footer"
            ]
        },
        "blog": {
            "sections": [
                "main",
                "footer"
            ]
        }
    },
    "config": {
        "firm": {
            "group": "basic",
            "icon": "<svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 24 24\" fill=\"currentColor\"><path d=\"M11 3.5V5H6.6L4 11.2c-.1.2-.1.5 0 .7C4.4 13.7 5.6 15 7.5 15s3.1-1.3 3.5-3.1c.1-.2 0-.5 0-.7L8.7 7H11v12H7v2h10v-2h-4V7h2.3L13 11.2c-.1.2-.1.5 0 .7.4 1.8 1.6 3.1 3.5 3.1s3.1-1.3 3.5-3.1c.1-.2 0-.5 0-.7L17.4 5H13V3.5a1 1 0 0 0-2 0zM7.5 8.3 9 11.5H6zm9 0 1.5 3.2h-3z\"/></svg>",
            "fields": {
                "name": {
                    "type": "string",
                    "hint": "Name of the law firm",
                    "required": true
                },
                "business-type": {
                    "type": "select",
                    "label": "Firm type",
                    "hint": "Kind of legal practice shown to search engines",
                    "default": "LegalService",
                    "options": [
                        {
                            "value": "LegalService",
                            "label": "Law firm"
                        },
                        {
                            "value": "Attorney",
                            "label": "Attorney"
                        },
                        {
                            "value": "Notary",
                            "label": "Notary"
                        },
                        {
                            "value": "LocalBusiness",
                            "label": "Other legal service"
                        }
                    ],
                    "required": true
                },
                "street-address": {
                    "type": "string",
                    "label": "Street address",
                    "hint": "Street and house number",
                    "required": true
                },
                "postal-code": {
                    "type": "string",
                    "label": "Postal code",
                    "hint": "Postal code of the office",
                    "required": true
                },
                "locality": {
                    "type": "string",
                    "label": "City",
                    "hint": "City the office is located in",
                    "required": true
                },
                "country": {
                    "type": "string",
                    "label": "Country code",
                    "hint": "Two letter ISO country code, e.g. DE or US",
                    "default": "DE",
                    "min": 2,
                    "max": 2,
                    "uppercase": true,
                    "required": true
                },
                "telephone": {
                    "type": "string",
                    "hint": "Phone number in international format, also used by the call button",
                    "required": true
                },
                "email": {
                    "type": "string",
                    "hint": "Email address for consultation requests"
                },
                "hotline": {
                    "type": "string",
                    "label": "Hotline",
                    "hint": "Phone number for urgent legal matters, e.g. arrests or searches, shown at the top of every page"
                },
                "consultation": {
                    "type": "string",
                    "label": "Consultation link",
                    "hint": "Link to the contact page or online scheduling, shown as a button in the header"
                },
                "languages": {
                    "type": "string",
                    "label": "Languages",
                    "hint": "Comma separated list of the languages spoken by the attorneys, e.g. English, German, French"
                },
                "practice-areas": {
                    "type": "string",
                    "label": "Practice areas",
                    "hint": "Comma separated list of the practice areas, e.g. Employment law, Family law, Real estate law"
                },
                "price-range": {
                    "type": "string",
                    "label": "Price range",
                    "hint": "Fee level of the firm, e.g. $$ or €€"
                },
                "call-button": {
                    "type": "switch",
                    "label": "Action bar",
                    "hint": "Show call and consultation buttons at the bottom of the screen on phones",
                    "default": true
                },
                "disclaimer": {
                    "type": "plaintext",
                    "label": "Disclaimer",
                    "hint": "Legal notice shown at the bottom of every page, e.g. that the website is no legal advice"
                },
                "hours": {
                    "type": "items",
                    "label": "Office hours",
                    "hint": "Office hours for each day of the week",
                    "identity": "id",
                    "item": {
                        "day": {
                            "type": "select",
                            "hint": "Day of the week",
                            "options": [
                                {
                                    "value": "Monday",
                                    "label": "Monday"
                                },
                                {
                                    "value": "Tuesday",
                                    "label": "Tuesday"
                                },
                                {
                                    "value": "Wednesday",
                                    "label": "Wednesday"
                                },
                                {
                                    "value": "Thursday",
                                    "label": "Thursday"
                                },
                                {
                                    "value": "Friday",
                                    "label": "Friday"
                                },
                                {
                                    "value": "Saturday",
                                    "label": "Saturday"
                                },
                                {
                                    "value": "Sunday",
                                    "label": "Sunday"
                                }
                            ]
                        },
                        "opens": {
                            "type": "string",
                            "hint": "Opening time in 24 hour format, e.g. 07:30",
                            "pattern": "^(?:[01][0-9]|2[0-3]):[0-5][0-9]$"
                        },
                        "closes": {
                            "type": "string",
                            "hint": "Closing time in 24 hour format, e.g. 17:00",
                            "pattern": "^(?:[01][0-9]|2[0-3]):[0-5][0-9]$"
                        }
                    }
                }
            }
        },
        "theme": {
            "group": "theme",
            "icon": "<svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 24 24\" fill=\"currentColor\"><path d=\"M11 3.5V5H6.6L4 11.2c-.1.2-.1.5 0 .7C4.4 13.7 5.6 15 7.5 15s3.1-1.3 3.5-3.1c.1-.2 0-.5 0-.7L8.7 7H11v12H7v2h10v-2h-4V7h2.3L13 11.2c-.1.2-.1.5 0 .7.4 1.8 1.6 3.1 3.5 3.1s3.1-1.3 3.5-3.1c.1-.2 0-.5 0-.7L17.4 5H13V3.5a1 1 0 0 0-2 0zM7.5 8.3 9 11.5H6zm9 0 1.5 3.2h-3z\"/></svg>",
            "fields": {
                "--pico-font-family-sans-serif": {
                    "type": "string",
                    "hint": "Comma separated list of fonts used for the text",
                    "default": "system-ui, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif"
                },
                "--pico-color": {
                    "type": "color",
                    "hint": "Default text color",
                    "default": "#1F2733"
                },
                "--pico-background-color": {
                    "type": "color",
                    "hint": "Background color of the pages",
                    "default": "#F8F6F1"
                },
                "--pico-text-selection-color": {
                    "type": "color",
                    "hint": "Background color of selected text",
                    "default": "#C6A15B4D"
                },
                "--pico-contrast": {
                    "type": "color",
                    "hint": "Color of elements with strong contrast to the background",
                    "default": "#0E2A47"
                },
                "--pico-contrast-hover": {
                    "type": "color",
                    "hint": "Contrast color when hovering or focusing an element",
                    "default": "#081C31"
                },
                "--pico-contrast-inverse": {
                    "type": "color",
                    "hint": "Text color on elements using the contrast color",
                    "default": "#FFFFFF"
                },
                "--pico-primary": {
                    "type": "color",
                    "hint": "Main brand color used for links and buttons",
                    "default": "#7D5F2A"
                },
                "--pico-primary-background": {
                    "type": "color",
                    "hint": "Background color of primary buttons and highlights",
                    "default": "#7D5F2A"
                },
                "--pico-primary-hover": {
                    "type": "color",
                    "hint": "Primary color when hovering or focusing an element",
                    "default": "#654C21"
                },
                "--pico-primary-hover-background": {
                    "type": "color",
                    "hint": "Primary background color when hovering or focusing an element",
                    "default": "#654C21"
                },
                "--pico-secondary": {
                    "type": "color",
                    "hint": "Additional color used for less important links and buttons",
                    "default": "#C6A15B"
                },
                "--pico-secondary-background": {
                    "type": "color",
                    "hint": "Background color of secondary buttons",
                    "default": "#C6A15B"
                },
                "--pico-secondary-hover": {
                    "type": "color",
                    "hint": "Secondary color when hovering or focusing an element",
                    "default": "#B38D48"
                },
                "--pico-secondary-hover-background": {
                    "type": "color",
                    "hint": "Secondary background color when hovering or focusing an element",
                    "default": "#B38D48"
                },
                "--pico-border-radius": {
                    "type": "string",
                    "hint": "Rounding of corners as CSS length, e.g. 0.25rem or 0 for sharp corners",
                    "default": "0.125rem"
                },
                "--pico-nav-breadcrumb-divider": {
                    "type": "string",
                    "hint": "Character shown between the breadcrumb links",
                    "default": "/"
                }
            }
        }
    }
}
