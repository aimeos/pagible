{
    "name": "aimeos/pagible-themes-counsel",
    "description": "Pagible CMS - Counsel theme for law firms, attorneys and notaries",
    "keywords": ["laravel", "cms", "theme", "law firm", "lawyer", "attorney", "legal", "notary"],
    "homepage": "https://pagible.com",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": "^8.2",
        "aimeos/pagible-theme": "*@dev"
    },
    "autoload": {
        "psr-4": {
            "Aimeos\\Cms\\": "src/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Aimeos\\Cms\\CounselServiceProvider"
            ]
        }
    }
}
