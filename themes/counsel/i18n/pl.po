msgid "counsel::firm"
msgstr "kancelaria"

#. config.firm.name
#: schema.json
msgctxt "fh"
msgid "Name of the law firm"
msgstr "Nazwa kancelarii prawnej"

#. config.firm.business-type
#: schema.json
msgctxt "fn"
msgid "Firm type"
msgstr "Rodzaj kancelarii"

#. config.firm.business-type
#: schema.json
msgctxt "op"
msgid "Law firm"
msgstr "Kancelaria prawna"

#. config.firm.business-type
#: schema.json
msgctxt "op"
msgid "Attorney"
msgstr "Adwokat"

#. config.firm.business-type
#: schema.json
msgctxt "op"
msgid "Notary"
msgstr "Notariusz"

#. config.firm.business-type
#: schema.json
msgctxt "op"
msgid "Other legal service"
msgstr "Inna usługa prawna"

#. config.firm.email
#: schema.json
msgctxt "fh"
msgid "Email address for consultation requests"
msgstr "Adres e-mail do zapytań o konsultacje"

#. config.firm.hotline
#: schema.json
msgctxt "fn"
msgid "Hotline"
msgstr "Telefon w pilnych sprawach"

#. config.firm.hotline
#: schema.json
msgctxt "fh"
msgid "Phone number for urgent legal matters, e.g. arrests or searches, shown at the top of every page"
msgstr "Numer telefonu w pilnych sprawach prawnych, np. zatrzymania lub przeszukania, wyświetlany u góry każdej strony"

#. config.firm.consultation
#: schema.json
msgctxt "fn"
msgid "Consultation link"
msgstr "Link do konsultacji"

#. config.firm.consultation
#: schema.json
msgctxt "fh"
msgid "Link to the contact page or online scheduling, shown as a button in the header"
msgstr "Link do strony kontaktowej lub rezerwacji online, wyświetlany jako przycisk w nagłówku"

#. config.firm.languages
#: schema.json
msgctxt "fh"
msgid "Comma separated list of the languages spoken by the attorneys, e.g. English, German, French"
msgstr "Lista języków, którymi posługują się prawnicy, oddzielonych przecinkami, np. angielski, niemiecki, francuski"

#. config.firm.practice-areas
#: schema.json
msgctxt "fn"
msgid "Practice areas"
msgstr "Specjalizacje"

#. config.firm.practice-areas
#: schema.json
msgctxt "fh"
msgid "Comma separated list of the practice areas, e.g. Employment law, Family law, Real estate law"
msgstr "Lista specjalizacji oddzielonych przecinkami, np. Prawo pracy, Prawo rodzinne, Prawo nieruchomości"

#. config.firm.call-button
#: schema.json
msgctxt "fh"
msgid "Show call and consultation buttons at the bottom of the screen on phones"
msgstr "Pokaż przyciski połączenia i konsultacji na dole ekranu na telefonach"

#. config.firm.disclaimer
#: schema.json
msgctxt "fn"
msgid "Disclaimer"
msgstr "Zastrzeżenie prawne"

#. config.firm.disclaimer
#: schema.json
msgctxt "fh"
msgid "Legal notice shown at the bottom of every page, e.g. that the website is no legal advice"
msgstr "Nota prawna wyświetlana na dole każdej strony, np. że strona nie stanowi porady prawnej"

#. config.firm.hours
#: schema.json
msgctxt "fn"
msgid "Office hours"
msgstr "Godziny pracy"

#. config.firm.hours
#: schema.json
msgctxt "fh"
msgid "Office hours for each day of the week"
msgstr "Godziny pracy kancelarii dla każdego dnia tygodnia"

