msgid "counsel::firm"
msgstr "фірма"

#. config.firm.name
#: schema.json
msgctxt "fh"
msgid "Name of the law firm"
msgstr "Назва юридичної фірми"

#. config.firm.business-type
#: schema.json
msgctxt "fn"
msgid "Firm type"
