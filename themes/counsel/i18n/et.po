#. config.firm.email
#: schema.json
msgctxt "fh"
msgid "Email address for consultation requests"
msgstr "E-posti aadress konsultatsioonipäringute jaoks"

#. config.firm.hotline
#: schema.json
msgctxt "fn"
msgid "Hotline"
msgstr "Valveliin"

#. config.firm.hotline
#: schema.json
msgctxt "fh"
msgid "Phone number for urgent legal matters, e.g. arrests or searches, shown at the top of every page"
msgstr "Telefoninumber kiireloomuliste õigusküsimuste jaoks, nt vahistamised või läbiotsimised, kuvatakse iga lehe ülaosas"

#. config.firm.consultation
#: schema.json
msgctxt "fn"
msgid "Consultation link"
msgstr "Konsultatsiooni link"

#. config.firm.consultation
#: schema.json
msgctxt "fh"
msgid "Link to the contact page or online scheduling, shown as a button in the header"
msgstr "Link kontaktilehele või veebipõhisele aja broneerimisele, kuvatakse päises nupuna"

#. config.firm.languages
#: schema.json
msgctxt "fh"
msgid "Comma separated list of the languages spoken by the attorneys, e.g. English, German, French"
msgstr "Komadega eraldatud loend advokaatide räägitavatest keeltest, nt inglise, saksa, prantsuse"

#. config.firm.practice-areas
#: schema.json
msgctxt "fn"
msgid "Practice areas"
msgstr "Õigusvaldkonnad"

#. config.firm.practice-areas
#: schema.json
msgctxt "fh"
msgid "Comma separated list of the practice areas, e.g. Employment law, Family law, Real estate law"
msgstr "Komadega eraldatud õigusvaldkondade loend, nt Tööõigus, Perekonnaõigus, Kinnisvaraõigus"

#. config.firm.call-button
#: schema.json
msgctxt "fh"
msgid "Show call and consultation buttons at the bottom of the screen on phones"
msgstr "Kuva telefonides ekraani allosas helistamise ja konsultatsiooni nupud"

#. config.firm.disclaimer
#: schema.json
msgctxt "fn"
msgid "Disclaimer"
msgstr "Vastutusest loobumine"

#. config.firm.disclaimer
#: schema.json
msgctxt "fh"
msgid "Legal notice shown at the bottom of every page, e.g. that the website is no legal advice"
msgstr "Õiguslik märkus iga lehe allosas, nt et veebileht ei ole õigusabi"

#. config.firm.hours
#: schema.json
msgctxt "fn"
msgid "Office hours"
msgstr "Lahtiolekuajad"

#. config.firm.hours
#: schema.json
msgctxt "fh"
msgid "Office hours for each day of the week"
msgstr "Büroo lahtiolekuajad iga nädalapäeva kohta"

