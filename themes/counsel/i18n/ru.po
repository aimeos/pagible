#. config.firm.hotline
#: schema.json
msgctxt "fh"
msgid "Phone number for urgent legal matters, e.g. arrests or searches, shown at the top of every page"
msgstr "Номер телефона для срочных юридических вопросов, например при задержании или обыске, отображается вверху каждой страницы"

#. config.firm.consultation
#: schema.json
msgctxt "fn"
msgid "Consultation link"
msgstr "Ссылка на консультацию"

#. config.firm.consultation
#: schema.json
msgctxt "fh"
msgid "Link to the contact page or online scheduling, shown as a button in the header"
msgstr "Ссылка на страницу контактов или онлайн-запись, отображается как кнопка в шапке"

#. config.firm.languages
#: schema.json
msgctxt "fh"
msgid "Comma separated list of the languages spoken by the attorneys, e.g. English, German, French"
msgstr "Список языков, на которых говорят адвокаты, через запятую, например английский, немецкий, французский"

#. config.firm.practice-areas
#: schema.json
msgctxt "fn"
msgid "Practice areas"
msgstr "Направления практики"

#. config.firm.practice-areas
#: schema.json
msgctxt "fh"
msgid "Comma separated list of the practice areas, e.g. Employment law, Family law, Real estate law"
msgstr "Список направлений практики через запятую, например Трудовое право, Семейное право, Право недвижимости"

#. config.firm.call-button
#: schema.json
msgctxt "fh"
msgid "Show call and consultation buttons at the bottom of the screen on phones"
msgstr "Показывать кнопки звонка и консультации внизу экрана на телефонах"

#. config.firm.disclaimer
#: schema.json
msgctxt "fn"
msgid "Disclaimer"
msgstr "Отказ от ответственности"

#. config.firm.disclaimer
#: schema.json
msgctxt "fh"
msgid "Legal notice shown at the bottom of every page, e.g. that the website is no legal advice"
msgstr "Юридическое уведомление внизу каждой страницы, например о том, что сайт не является юридической консультацией"

#. config.firm.hours
