msgstr "Link către pagina de contact sau programarea online, afișat ca buton în antet"

#. config.firm.languages
#: schema.json
msgctxt "fh"
msgid "Comma separated list of the languages spoken by the attorneys, e.g. English, German, French"
msgstr "Listă separată prin virgule a limbilor vorbite de avocați, de ex. engleză, germană, franceză"

#. config.firm.practice-areas
#: schema.json
msgctxt "fn"
msgid "Practice areas"
msgstr "Domenii de practică"

