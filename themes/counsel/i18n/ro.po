#. config.firm.call-button
#: schema.json
msgctxt "fh"
msgid "Show call and consultation buttons at the bottom of the screen on phones"
msgstr "Afișează butoanele de apel și consultanță în partea de jos a ecranului pe telefoane"

#. config.firm.disclaimer
#: schema.json
msgctxt "fn"
