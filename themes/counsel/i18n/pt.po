msgid "Link to the contact page or online scheduling, shown as a button in the header"
msgstr "Link para a página de contacto ou agendamento online, mostrado como botão no cabeçalho"

#. config.firm.languages
#: schema.json
msgctxt "fh"
msgid "Comma separated list of the languages spoken by the attorneys, e.g. English, German, French"
msgstr "Lista de idiomas falados pelos advogados separados por vírgulas, p. ex. inglês, alemão, francês"

#. config.firm.practice-areas
#: schema.json
msgctxt "fn"
msgid "Practice areas"
msgstr "Áreas de atuação"

