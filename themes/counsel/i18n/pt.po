#. config.firm.hotline
#: schema.json
msgctxt "fh"
msgid "Phone number for urgent legal matters, e.g. arrests or searches, shown at the top of every page"
msgstr "Número de telefone para assuntos jurídicos urgentes, p. ex. detenções ou buscas, mostrado no topo de cada página"

