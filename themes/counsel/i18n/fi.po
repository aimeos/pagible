#. config.firm.business-type
#: schema.json
msgctxt "op"
msgid "Law firm"
msgstr "Asianajotoimisto"

#. config.firm.business-type
#: schema.json
msgctxt "op"
msgid "Attorney"
msgstr "Asianajaja"

#. config.firm.business-type
#: schema.json
msgctxt "op"
msgid "Notary"
msgstr "Notaari"

#. config.firm.business-type
#: schema.json
msgctxt "op"
msgid "Other legal service"
msgstr "Muu oikeudellinen palvelu"

#. config.firm.email
#: schema.json
msgctxt "fh"
msgid "Email address for consultation requests"
msgstr "Sähköpostiosoite neuvontapyynnöille"

#. config.firm.hotline
#: schema.json
msgctxt "fn"
msgid "Hotline"
msgstr "Päivystysnumero"

#. config.firm.hotline
#: schema.json
msgctxt "fh"
msgid "Phone number for urgent legal matters, e.g. arrests or searches, shown at the top of every page"
msgstr "Puhelinnumero kiireellisiin oikeudellisiin asioihin, esim. pidätykset tai kotietsinnät, näytetään jokaisen sivun yläosassa"

#. config.firm.consultation
#: schema.json
msgctxt "fn"
msgid "Consultation link"
msgstr "Neuvontalinkki"

#. config.firm.consultation
#: schema.json
msgctxt "fh"
msgid "Link to the contact page or online scheduling, shown as a button in the header"
msgstr "Linkki yhteystietosivulle tai ajanvaraukseen verkossa, näytetään painikkeena ylätunnisteessa"

#. config.firm.languages
#: schema.json
msgctxt "fh"
msgid "Comma separated list of the languages spoken by the attorneys, e.g. English, German, French"
msgstr "Pilkuilla eroteltu luettelo asianajajien puhumista kielistä, esim. englanti, saksa, ranska"

#. config.firm.practice-areas
#: schema.json
msgctxt "fn"
msgid "Practice areas"
msgstr "Oikeudenalat"

#. config.firm.practice-areas
#: schema.json
msgctxt "fh"
msgid "Comma separated list of the practice areas, e.g. Employment law, Family law, Real estate law"
msgstr "Pilkuilla eroteltu luettelo oikeudenaloista, esim. Työoikeus, Perheoikeus, Kiinteistöoikeus"

#. config.firm.call-button
#: schema.json
msgctxt "fh"
msgid "Show call and consultation buttons at the bottom of the screen on phones"
msgstr "Näytä soitto- ja neuvontapainikkeet näytön alareunassa puhelimissa"

#. config.firm.disclaimer
#: schema.json
msgctxt "fn"
msgid "Disclaimer"
msgstr "Vastuuvapauslauseke"

#. config.firm.disclaimer
#: schema.json
msgctxt "fh"
msgid "Legal notice shown at the bottom of every page, e.g. that the website is no legal advice"
msgstr "Oikeudellinen huomautus jokaisen sivun alaosassa, esim. ettei verkkosivusto ole oikeudellista neuvontaa"

#. config.firm.hours
#: schema.json
msgctxt "fn"
msgid "Office hours"
msgstr "Aukioloajat"

#. config.firm.hours
#: schema.json
msgctxt "fh"
msgid "Office hours for each day of the week"
msgstr "Toimiston aukioloajat jokaiselle viikonpäivälle"

