#. config.firm.email
#: schema.json
msgctxt "fh"
msgid "Email address for consultation requests"
msgstr "Məsləhət sorğuları üçün e-poçt ünvanı"

#. config.firm.hotline
#: schema.json
msgctxt "fn"
msgid "Hotline"
msgstr "Qaynar xətt"

#. config.firm.hotline
#: schema.json
msgctxt "fh"
msgid "Phone number for urgent legal matters, e.g. arrests or searches, shown at the top of every page"
msgstr "Təcili hüquqi məsələlər üçün, məsələn, həbs və ya axtarış hallarında istifadə olunan telefon nömrəsi hər səhifənin yuxarısında göstərilir."

#. config.firm.consultation
#: schema.json
msgctxt "fn"
msgid "Consultation link"
msgstr "Məsləhətləşmə linki"

#. config.firm.consultation
#: schema.json
msgctxt "fh"
msgid "Link to the contact page or online scheduling, shown as a button in the header"
msgstr "Başlıqda düymə şəklində göstərilən əlaqə səhifəsinə və ya onlayn cədvəlləşdirməyə keçid"

#. config.firm.languages
#: schema.json
msgctxt "fh"
msgid "Comma separated list of the languages spoken by the attorneys, e.g. English, German, French"
msgstr "Vəkillərin danışdığı dillərin virgulla ayrılmış siyahısı, məsələn: İngilis, Alman, Fransız"

#. config.firm.practice-areas
#: schema.json
msgctxt "fn"
msgid "Practice areas"
msgstr "Fəaliyyət sahələri"

#. config.firm.practice-areas
#: schema.json
msgctxt "fh"
msgid "Comma separated list of the practice areas, e.g. Employment law, Family law, Real estate law"
msgstr "Praktika sahələrinin vergüllə ayrılmış siyahısı, məsələn: əmək hüququ, ailə hüququ, daşınmaz əmlak hüququ"

#. config.firm.call-button
#: schema.json
msgctxt "fh"
msgid "Show call and consultation buttons at the bottom of the screen on phones"
msgstr "Telefonlarda ekranın aşağı hissəsində zəng və məsləhətləşmə düymələrini göstərin"

#. config.firm.disclaimer
#: schema.json
msgctxt "fn"
msgid "Disclaimer"
msgstr "Məsuliyyətdən imtina"

#. config.firm.disclaimer
#: schema.json
msgctxt "fh"
msgid "Legal notice shown at the bottom of every page, e.g. that the website is no legal advice"
msgstr "Hər səhifənin sonunda göstərilən hüquqi bildiriş, məsələn, vebsaytın hüquqi məsləhət olmadığını bildirir."

#. config.firm.hours
#: schema.json
msgctxt "fn"
msgid "Office hours"
msgstr "Ofis saatları"

#. config.firm.hours
#: schema.json
msgctxt "fh"
msgid "Office hours for each day of the week"
msgstr "Həftənin hər günü üçün iş saatları"

