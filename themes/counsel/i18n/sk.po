#. config.firm.hotline
#: schema.json
msgctxt "fn"
msgid "Hotline"
msgstr "Pohotovostná linka"

#. config.firm.hotline
#: schema.json
msgctxt "fh"
msgid "Phone number for urgent legal matters, e.g. arrests or searches, shown at the top of every page"
msgstr "Telefónne číslo pre naliehavé právne záležitosti, napr. zatknutia alebo domové prehliadky, zobrazené v hornej časti každej stránky"

#. config.firm.consultation
#: schema.json
msgctxt "fn"
msgid "Consultation link"
msgstr "Odkaz na konzultáciu"

#. config.firm.consultation
#: schema.json
msgctxt "fh"
msgid "Link to the contact page or online scheduling, shown as a button in the header"
msgstr "Odkaz na kontaktnú stránku alebo online objednanie, zobrazený ako tlačidlo v hlavičke"

#. config.firm.languages
#: schema.json
msgctxt "fh"
msgid "Comma separated list of the languages spoken by the attorneys, e.g. English, German, French"
msgstr "Čiarkami oddelený zoznam jazykov, ktorými hovoria advokáti, napr. angličtina, nemčina, francúzština"

#. config.firm.practice-areas
#: schema.json
msgctxt "fn"
msgid "Practice areas"
msgstr "Právne oblasti"

#. config.firm.practice-areas
#: schema.json
msgctxt "fh"
msgid "Comma separated list of the practice areas, e.g. Employment law, Family law, Real estate law"
msgstr "Čiarkami oddelený zoznam právnych oblastí, napr. Pracovné právo, Rodinné právo, Právo nehnuteľností"

#. config.firm.call-button
#: schema.json
msgctxt "fh"
msgid "Show call and consultation buttons at the bottom of the screen on phones"
msgstr "Zobraziť tlačidlá na volanie a konzultáciu v dolnej časti obrazovky na telefónoch"

#. config.firm.disclaimer
#: schema.json
msgctxt "fn"
msgid "Disclaimer"
msgstr "Vyhlásenie o vylúčení zodpovednosti"

#. config.firm.disclaimer
#: schema.json
msgctxt "fh"
msgid "Legal notice shown at the bottom of every page, e.g. that the website is no legal advice"
msgstr "Právne upozornenie zobrazené v dolnej časti každej stránky, napr. že web nepredstavuje právne poradenstvo"

#. config.firm.hours
