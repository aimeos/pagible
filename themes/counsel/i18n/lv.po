msgid "Link to the contact page or online scheduling, shown as a button in the header"
msgstr "Saite uz kontaktu lapu vai tiešsaistes pierakstu, tiek rādīta kā poga galvenē"

#. config.firm.languages
#: schema.json
msgctxt "fh"
msgid "Comma separated list of the languages spoken by the attorneys, e.g. English, German, French"
msgstr "Ar komatiem atdalīts advokātu runāto valodu saraksts, piem., angļu, vācu, franču"

#. config.firm.practice-areas
#: schema.json
msgctxt "fn"
msgid "Practice areas"
msgstr "Tiesību jomas"

#. config.firm.practice-areas
#: schema.json
msgctxt "fh"
msgid "Comma separated list of the practice areas, e.g. Employment law, Family law, Real estate law"
msgstr "Ar komatiem atdalīts tiesību jomu saraksts, piem., Darba tiesības, Ģimenes tiesības, Nekustamā īpašuma tiesības"

#. config.firm.call-button
#: schema.json
msgctxt "fh"
msgid "Show call and consultation buttons at the bottom of the screen on phones"
msgstr "Rādīt zvana un konsultācijas pogas ekrāna apakšā tālruņos"

#. config.firm.disclaimer
#: schema.json
msgctxt "fn"
msgid "Disclaimer"
msgstr "Atruna"

