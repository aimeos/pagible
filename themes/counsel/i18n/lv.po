#. config.firm.hotline
#: schema.json
msgctxt "fh"
msgid "Phone number for urgent legal matters, e.g. arrests or searches, shown at the top of every page"
msgstr "Tālruņa numurs steidzamiem juridiskiem jautājumiem, piem., aizturēšanām vai kratīšanām, tiek rādīts katras lapas augšdaļā"

