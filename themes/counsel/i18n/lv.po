#: schema.json
msgctxt "fh"
msgid "Legal notice shown at the bottom of every page, e.g. that the website is no legal advice"
msgstr "Juridisks paziņojums katras lapas apakšā, piem., ka vietne nav juridiska konsultācija"

#. config.firm.hours
