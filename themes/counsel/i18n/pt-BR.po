#. config.firm
#: schema.json
msgctxt "st"
msgid "counsel::firm"
msgstr "Escritório"

#. config.firm.name
#: schema.json
msgctxt "fh"
msgid "Name of the law firm"
msgstr "Nome do escritório de advocacia"

#. config.firm.business-type
#: schema.json
msgctxt "fn"
msgid "Firm type"
msgstr "Tipo de escritório"

#. config.firm.business-type
#: schema.json
msgctxt "op"
msgid "Law firm"
msgstr "Escritório de advocacia"

#. config.firm.business-type
#: schema.json
msgctxt "op"
msgid "Attorney"
msgstr "Advogado"

#. config.firm.business-type
#: schema.json
msgctxt "op"
msgid "Notary"
msgstr "Notário"

#. config.firm.business-type
#: schema.json
msgctxt "op"
msgid "Other legal service"
msgstr "Outros serviços jurídicos"

#. config.firm.email
#: schema.json
msgctxt "fh"
msgid "Email address for consultation requests"
msgstr "Endereço de e-mail para solicitações de consulta"

#. config.firm.hotline
#: schema.json
msgctxt "fn"
msgid "Hotline"
msgstr "Linha direta"

#. config.firm.hotline
#: schema.json
msgctxt "fh"
msgid "Phone number for urgent legal matters, e.g. arrests or searches, shown at the top of every page"
msgstr "Número de telefone para questões jurídicas urgentes, como, por exemplo, prisões ou buscas, exibido na parte superior de cada página"

#. config.firm.consultation
#: schema.json
msgctxt "fn"
msgid "Consultation link"
msgstr "Link para a consulta"

#. config.firm.consultation
#: schema.json
msgctxt "fh"
msgid "Link to the contact page or online scheduling, shown as a button in the header"
msgstr "Link para a página de contato ou agendamento on-line, exibido como um botão no cabeçalho"

#. config.firm.languages
#: schema.json
msgctxt "fh"
msgid "Comma separated list of the languages spoken by the attorneys, e.g. English, German, French"
msgstr "Lista separada por vírgulas dos idiomas falados pelos advogados, por exemplo: inglês, alemão, francês"

#. config.firm.practice-areas
#: schema.json
msgctxt "fn"
msgid "Practice areas"
msgstr "Áreas de atuação"

#. config.firm.practice-areas
#: schema.json
msgctxt "fh"
msgid "Comma separated list of the practice areas, e.g. Employment law, Family law, Real estate law"
msgstr "Lista separada por vírgulas das áreas de atuação, por exemplo: Direito do Trabalho, Direito da Família, Direito Imobiliário"

#. config.firm.call-button
#: schema.json
msgctxt "fh"
msgid "Show call and consultation buttons at the bottom of the screen on phones"
msgstr "Exibir os botões “Ligar” e “Consultar” na parte inferior da tela em celulares"

#. config.firm.disclaimer
#: schema.json
msgctxt "fn"
msgid "Disclaimer"
msgstr "Isenção de responsabilidade"

#. config.firm.disclaimer
#: schema.json
msgctxt "fh"
msgid "Legal notice shown at the bottom of every page, e.g. that the website is no legal advice"
msgstr "Aviso legal exibido na parte inferior de cada página, por exemplo, informando que o site não constitui aconselhamento jurídico"

#. config.firm.hours
#: schema.json
msgctxt "fn"
msgid "Office hours"
msgstr "Horário de atendimento"

#. config.firm.hours
#: schema.json
msgctxt "fh"
msgid "Office hours for each day of the week"
msgstr "Horário de atendimento para cada dia da semana"

#. config.theme
#: schema.json
msgctxt "st"
msgid "counsel::theme"
msgstr "Tema"
