msgid "Email address for consultation requests"
msgstr "E-mailová adresa pro žádosti o konzultaci"

#. config.firm.hotline
#: schema.json
msgctxt "fn"
msgid "Hotline"
msgstr "Pohotovostní linka"

#. config.firm.hotline
#: schema.json
msgctxt "fh"
msgid "Phone number for urgent legal matters, e.g. arrests or searches, shown at the top of every page"
msgstr "Telefonní číslo pro naléhavé právní záležitosti, např. zatčení nebo domovní prohlídky, zobrazené v horní části každé stránky"

#. config.firm.consultation
#: schema.json
msgctxt "fn"
msgid "Consultation link"
msgstr "Odkaz na konzultaci"

#. config.firm.consultation
#: schema.json
msgctxt "fh"
msgid "Link to the contact page or online scheduling, shown as a button in the header"
msgstr "Odkaz na kontaktní stránku nebo online objednání, zobrazený jako tlačítko v záhlaví"

#. config.firm.languages
#: schema.json
msgctxt "fh"
msgid "Comma separated list of the languages spoken by the attorneys, e.g. English, German, French"
msgstr "Čárkami oddělený seznam jazyků, kterými hovoří advokáti, např. angličtina, němčina, francouzština"

#. config.firm.practice-areas
#: schema.json
msgctxt "fn"
msgid "Practice areas"
msgstr "Právní oblasti"

#. config.firm.practice-areas
#: schema.json
msgctxt "fh"
msgid "Comma separated list of the practice areas, e.g. Employment law, Family law, Real estate law"
msgstr "Čárkami oddělený seznam právních oblastí, např. Pracovní právo, Rodinné právo, Právo nemovitostí"

#. config.firm.call-button
#: schema.json
msgctxt "fh"
msgid "Show call and consultation buttons at the bottom of the screen on phones"
msgstr "Zobrazit tlačítka pro volání a konzultaci v dolní části obrazovky na telefonech"

#. config.firm.disclaimer
#: schema.json
msgctxt "fn"
msgid "Disclaimer"
msgstr "Prohlášení o vyloučení odpovědnosti"

#. config.firm.disclaimer
#: schema.json
msgctxt "fh"
msgid "Legal notice shown at the bottom of every page, e.g. that the website is no legal advice"
msgstr "Právní upozornění zobrazené v dolní části každé stránky, např. že web nepředstavuje právní poradenství"

#. config.firm.hours
