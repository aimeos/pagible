msgid "counsel::firm"
msgstr "iroda"

#. config.firm.name
#: schema.json
msgctxt "fh"
msgid "Name of the law firm"
msgstr "Az ügyvédi iroda neve"

#. config.firm.business-type
#: schema.json
msgctxt "fn"
msgid "Firm type"
msgstr "Iroda típusa"

#. config.firm.business-type
#: schema.json
msgctxt "op"
msgid "Law firm"
msgstr "Ügyvédi iroda"

#. config.firm.business-type
#: schema.json
msgctxt "op"
msgid "Attorney"
msgstr "Ügyvéd"

#. config.firm.business-type
#: schema.json
msgctxt "op"
msgid "Notary"
msgstr "Közjegyző"

#. config.firm.business-type
#: schema.json
msgctxt "op"
msgid "Other legal service"
msgstr "Egyéb jogi szolgáltatás"

#. config.firm.email
#: schema.json
msgctxt "fh"
msgid "Email address for consultation requests"
msgstr "E-mail-cím konzultációs kérésekhez"

#. config.firm.hotline
#: schema.json
msgctxt "fn"
msgid "Hotline"
msgstr "Ügyeleti szám"

#. config.firm.hotline
#: schema.json
msgctxt "fh"
msgid "Phone number for urgent legal matters, e.g. arrests or searches, shown at the top of every page"
msgstr "Telefonszám sürgős jogi ügyekhez, pl. őrizetbe vétel vagy házkutatás, minden oldal tetején megjelenik"

#. config.firm.consultation
#: schema.json
msgctxt "fn"
msgid "Consultation link"
msgstr "Konzultációs hivatkozás"

#. config.firm.consultation
#: schema.json
msgctxt "fh"
msgid "Link to the contact page or online scheduling, shown as a button in the header"
msgstr "Hivatkozás a kapcsolati oldalra vagy az online időpontfoglalásra, gombként jelenik meg a fejlécben"

#. config.firm.languages
#: schema.json
msgctxt "fh"
msgid "Comma separated list of the languages spoken by the attorneys, e.g. English, German, French"
msgstr "Az ügyvédek által beszélt nyelvek vesszővel elválasztott listája, pl. angol, német, francia"

#. config.firm.practice-areas
#: schema.json
msgctxt "fn"
msgid "Practice areas"
msgstr "Jogterületek"

#. config.firm.practice-areas
#: schema.json
msgctxt "fh"
msgid "Comma separated list of the practice areas, e.g. Employment law, Family law, Real estate law"
msgstr "Vesszővel elválasztott jogterületek listája, pl. Munkajog, Családjog, Ingatlanjog"

#. config.firm.call-button
#: schema.json
msgctxt "fh"
msgid "Show call and consultation buttons at the bottom of the screen on phones"
msgstr "Hívás és konzultáció gombok megjelenítése a képernyő alján telefonokon"

#. config.firm.disclaimer
#: schema.json
msgctxt "fn"
msgid "Disclaimer"
msgstr "Jogi nyilatkozat"

#. config.firm.disclaimer
#: schema.json
msgctxt "fh"
msgid "Legal notice shown at the bottom of every page, e.g. that the website is no legal advice"
msgstr "Jogi nyilatkozat minden oldal alján, pl. hogy a weboldal nem minősül jogi tanácsadásnak"

#. config.firm.hours
#: schema.json
msgctxt "fn"
msgid "Office hours"
msgstr "Ügyfélfogadási idő"

#. config.firm.hours
#: schema.json
msgctxt "fh"
msgid "Office hours for each day of the week"
msgstr "Ügyfélfogadási idő a hét minden napjára"

