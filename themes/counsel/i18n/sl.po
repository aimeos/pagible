#. config.firm.hotline
#: schema.json
msgctxt "fn"
msgid "Hotline"
msgstr "Dežurna linija"

#. config.firm.hotline
#: schema.json
msgctxt "fh"
msgid "Phone number for urgent legal matters, e.g. arrests or searches, shown at the top of every page"
msgstr "Telefonska številka za nujne pravne zadeve, npr. aretacije ali hišne preiskave, prikazana na vrhu vsake strani"

#. config.firm.consultation
#: schema.json
msgctxt "fn"
msgid "Consultation link"
msgstr "Povezava za svetovanje"

#. config.firm.consultation
#: schema.json
msgctxt "fh"
msgid "Link to the contact page or online scheduling, shown as a button in the header"
msgstr "Povezava do strani za stik ali spletnega naročanja, prikazana kot gumb v glavi"

#. config.firm.languages
#: schema.json
msgctxt "fh"
msgid "Comma separated list of the languages spoken by the attorneys, e.g. English, German, French"
msgstr "Z vejicami ločen seznam jezikov, ki jih govorijo odvetniki, npr. angleščina, nemščina, francoščina"

#. config.firm.practice-areas
#: schema.json
msgctxt "fn"
msgid "Practice areas"
msgstr "Pravna področja"

#. config.firm.practice-areas
#: schema.json
msgctxt "fh"
msgid "Comma separated list of the practice areas, e.g. Employment law, Family law, Real estate law"
msgstr "Z vejicami ločen seznam pravnih področij, npr. Delovno pravo, Družinsko pravo, Nepremičninsko pravo"

#. config.firm.call-button
#: schema.json
msgctxt "fh"
msgid "Show call and consultation buttons at the bottom of the screen on phones"
msgstr "Prikaži gumba za klic in svetovanje na dnu zaslona na telefonih"

#. config.firm.disclaimer
#: schema.json
msgctxt "fn"
msgid "Disclaimer"
msgstr "Izjava o omejitvi odgovornosti"

#. config.firm.disclaimer
#: schema.json
msgctxt "fh"
msgid "Legal notice shown at the bottom of every page, e.g. that the website is no legal advice"
msgstr "Pravno obvestilo na dnu vsake strani, npr. da spletna stran ni pravni nasvet"

#. config.firm.hours
#: schema.json
msgctxt "fn"
msgid "Office hours"
msgstr "Uradne ure"

