#. config.firm.hotline
#: schema.json
msgctxt "fn"
msgid "Hotline"
msgstr "Skubi linija"

#. config.firm.hotline
#: schema.json
msgctxt "fh"
msgid "Phone number for urgent legal matters, e.g. arrests or searches, shown at the top of every page"
msgstr "Telefono numeris skubiems teisiniams klausimams, pvz., sulaikymams ar kratoms, rodomas kiekvieno puslapio viršuje"

#. config.firm.consultation
#: schema.json
msgctxt "fn"
msgid "Consultation link"
msgstr "Konsultacijos nuoroda"

#. config.firm.consultation
#: schema.json
msgctxt "fh"
msgid "Link to the contact page or online scheduling, shown as a button in the header"
msgstr "Nuoroda į kontaktų puslapį arba internetinę registraciją, rodoma kaip mygtukas antraštėje"

#. config.firm.languages
#: schema.json
msgctxt "fh"
msgid "Comma separated list of the languages spoken by the attorneys, e.g. English, German, French"
msgstr "Kableliais atskirtas advokatų kalbamų kalbų sąrašas, pvz., anglų, vokiečių, prancūzų"

#. config.firm.practice-areas
#: schema.json
msgctxt "fn"
msgid "Practice areas"
msgstr "Teisės sritys"

#. config.firm.practice-areas
#: schema.json
msgctxt "fh"
msgid "Comma separated list of the practice areas, e.g. Employment law, Family law, Real estate law"
msgstr "Kableliais atskirtas teisės sričių sąrašas, pvz., Darbo teisė, Šeimos teisė, Nekilnojamojo turto teisė"

#. config.firm.call-button
#: schema.json
msgctxt "fh"
msgid "Show call and consultation buttons at the bottom of the screen on phones"
msgstr "Rodyti skambinimo ir konsultacijos mygtukus ekrano apačioje telefonuose"

#. config.firm.disclaimer
#: schema.json
msgctxt "fn"
msgid "Disclaimer"
msgstr "Atsakomybės apribojimas"

#. config.firm.disclaimer
#: schema.json
msgctxt "fh"
msgid "Legal notice shown at the bottom of every page, e.g. that the website is no legal advice"
msgstr "Teisinė pastaba kiekvieno puslapio apačioje, pvz., kad svetainė nėra teisinė konsultacija"

#. config.firm.hours
