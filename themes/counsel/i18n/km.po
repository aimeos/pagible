#. config.firm
#: schema.json
msgctxt "st"
msgid "counsel::firm"
msgstr "ការិយាល័យច្បាប់"

#. config.firm.name
#: schema.json
msgctxt "fh"
msgid "Name of the law firm"
msgstr "ឈ្មោះការិយាល័យច្បាប់"

#. config.firm.business-type
#: schema.json
msgctxt "fn"
msgid "Firm type"
msgstr "ប្រភេទការិយាល័យ"

#. config.firm.business-type
#: schema.json
msgctxt "op"
msgid "Law firm"
msgstr "ការិយាល័យច្បាប់"

#. config.firm.business-type
#: schema.json
msgctxt "op"
msgid "Attorney"
msgstr "មេធាវី"

#. config.firm.business-type
#: schema.json
msgctxt "op"
msgid "Notary"
msgstr "សារការី"

#. config.firm.business-type
#: schema.json
msgctxt "op"
msgid "Other legal service"
msgstr "សេវាច្បាប់ផ្សេងទៀត"

#. config.firm.email
#: schema.json
msgctxt "fh"
msgid "Email address for consultation requests"
msgstr "អាសយដ្ឋានអ៊ីមែលសម្រាប់សំណើពិគ្រោះយោបល់"

#. config.firm.hotline
#: schema.json
msgctxt "fn"
msgid "Hotline"
msgstr "ខ្សែទូរស័ព្ទបន្ទាន់"

#. config.firm.hotline
#: schema.json
msgctxt "fh"
msgid "Phone number for urgent legal matters, e.g. arrests or searches, shown at the top of every page"
msgstr "លេខទូរស័ព្ទសម្រាប់បញ្ហាច្បាប់បន្ទាន់ ឧ. ការចាប់ខ្លួន ឬការឆែកឆេរ ដែលបង្ហាញនៅផ្នែកខាងលើនៃទំព័រនីមួយៗ"

#. config.firm.consultation
#: schema.json
msgctxt "fn"
msgid "Consultation link"
msgstr "តំណពិគ្រោះយោបល់"

#. config.firm.consultation
#: schema.json
msgctxt "fh"
msgid "Link to the contact page or online scheduling, shown as a button in the header"
msgstr "តំណទៅទំព័រទំនាក់ទំនង ឬការណាត់ជួបអនឡាញ ដែលបង្ហាញជាប៊ូតុងនៅក្បាលទំព័រ"

#. config.firm.languages
#: schema.json
msgctxt "fh"
msgid "Comma separated list of the languages spoken by the attorneys, e.g. English, German, French"
msgstr "បញ្ជីភាសាដែលមេធាវីនិយាយ ដោយបំបែកដោយសញ្ញាក្បៀស ឧ. English, German, French"

#. config.firm.practice-areas
#: schema.json
msgctxt "fn"
msgid "Practice areas"
msgstr "វិស័យច្បាប់"

#. config.firm.practice-areas
#: schema.json
msgctxt "fh"
msgid "Comma separated list of the practice areas, e.g. Employment law, Family law, Real estate law"
msgstr "បញ្ជីវិស័យច្បាប់ ដោយបំបែកដោយសញ្ញាក្បៀស ឧ. ច្បាប់ការងារ ច្បាប់គ្រួសារ ច្បាប់អចលនទ្រព្យ"

#. config.firm.call-button
#: schema.json
msgctxt "fh"
msgid "Show call and consultation buttons at the bottom of the screen on phones"
msgstr "បង្ហាញប៊ូតុងហៅទូរស័ព្ទ និងពិគ្រោះយោបល់នៅផ្នែកខាងក្រោមនៃអេក្រង់លើទូរស័ព្ទ"

#. config.firm.disclaimer
#: schema.json
msgctxt "fn"
msgid "Disclaimer"
msgstr "សេចក្តីបដិសេធ"

#. config.firm.disclaimer
#: schema.json
msgctxt "fh"
msgid "Legal notice shown at the bottom of every page, e.g. that the website is no legal advice"
msgstr "សេចក្តីជូនដំណឹងផ្លូវច្បាប់ដែលបង្ហាញនៅផ្នែកខាងក្រោមនៃទំព័រនីមួយៗ ឧ. ថាគេហទំព័រនេះមិនមែនជាដំបូន្មានផ្លូវច្បាប់"

#. config.firm.hours
#: schema.json
msgctxt "fn"
msgid "Office hours"
msgstr "ម៉ោងធ្វើការ"

#. config.firm.hours
#: schema.json
msgctxt "fh"
msgid "Office hours for each day of the week"
msgstr "ម៉ោងធ្វើការសម្រាប់ថ្ងៃនីមួយៗក្នុងសប្តាហ៍"

#. config.theme
#: schema.json
msgctxt "st"
msgid "counsel::theme"
msgstr "រចនាប័ទ្ម"
