#. config.firm.hotline
#: schema.json
msgctxt "fh"
msgid "Phone number for urgent legal matters, e.g. arrests or searches, shown at the top of every page"
msgstr "Nomor telepon untuk masalah hukum mendesak, mis. penangkapan atau penggeledahan, ditampilkan di bagian atas setiap halaman"

