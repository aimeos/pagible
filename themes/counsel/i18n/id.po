#: schema.json
msgctxt "fh"
msgid "Legal notice shown at the bottom of every page, e.g. that the website is no legal advice"
msgstr "Pemberitahuan hukum yang ditampilkan di bagian bawah setiap halaman, mis. bahwa situs web ini bukan nasihat hukum"

#. config.firm.hours
