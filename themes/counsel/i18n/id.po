msgid "Link to the contact page or online scheduling, shown as a button in the header"
msgstr "Tautan ke halaman kontak atau penjadwalan online, ditampilkan sebagai tombol di header"

#. config.firm.languages
#: schema.json
msgctxt "fh"
msgid "Comma separated list of the languages spoken by the attorneys, e.g. English, German, French"
msgstr "Daftar bahasa yang digunakan para advokat, dipisahkan koma, mis. Inggris, Jerman, Prancis"

#. config.firm.practice-areas
#: schema.json
msgctxt "fn"
msgid "Practice areas"
msgstr "Bidang praktik"

#. config.firm.practice-areas
#: schema.json
msgctxt "fh"
