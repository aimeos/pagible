msgstr "Daftar bidang praktik yang dipisahkan koma, mis. Hukum ketenagakerjaan, Hukum keluarga, Hukum properti"

#. config.firm.call-button
#: schema.json
msgctxt "fh"
msgid "Show call and consultation buttons at the bottom of the screen on phones"
msgstr "Tampilkan tombol telepon dan konsultasi di bagian bawah layar pada ponsel"

#. config.firm.disclaimer
#: schema.json
msgctxt "fn"
msgid "Disclaimer"
msgstr "Penafian"

