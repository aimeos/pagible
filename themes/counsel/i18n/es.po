msgid "counsel::firm"
msgstr "despacho"

#. config.firm.name
#: schema.json
msgctxt "fh"
msgid "Name of the law firm"
msgstr "Nombre del despacho de abogados"

#. config.firm.business-type
#: schema.json
msgctxt "fn"
msgid "Firm type"
msgstr "Tipo de despacho"

#. config.firm.business-type
#: schema.json
msgctxt "op"
msgid "Law firm"
msgstr "Despacho de abogados"

#. config.firm.business-type
#: schema.json
msgctxt "op"
msgid "Attorney"
msgstr "Abogado"

#. config.firm.business-type
#: schema.json
msgctxt "op"
msgid "Notary"
msgstr "Notario"

#. config.firm.business-type
#: schema.json
msgctxt "op"
msgid "Other legal service"
msgstr "Otro servicio jurídico"

#. config.firm.email
#: schema.json
msgctxt "fh"
msgid "Email address for consultation requests"
msgstr "Dirección de correo electrónico para solicitudes de consulta"

#. config.firm.hotline
#: schema.json
msgctxt "fn"
msgid "Hotline"
msgstr "Línea de urgencias"

#. config.firm.hotline
#: schema.json
msgctxt "fh"
msgid "Phone number for urgent legal matters, e.g. arrests or searches, shown at the top of every page"
msgstr "Número de teléfono para asuntos legales urgentes, p. ej. detenciones o registros, mostrado en la parte superior de cada página"

#. config.firm.consultation
#: schema.json
msgctxt "fn"
msgid "Consultation link"
msgstr "Enlace de consulta"

#. config.firm.consultation
#: schema.json
msgctxt "fh"
msgid "Link to the contact page or online scheduling, shown as a button in the header"
msgstr "Enlace a la página de contacto o a la reserva de citas en línea, mostrado como botón en la cabecera"

#. config.firm.languages
#: schema.json
msgctxt "fh"
msgid "Comma separated list of the languages spoken by the attorneys, e.g. English, German, French"
msgstr "Lista de idiomas hablados por los abogados separados por comas, p. ej. inglés, alemán, francés"

#. config.firm.practice-areas
#: schema.json
msgctxt "fn"
msgid "Practice areas"
msgstr "Áreas de especialidad"

#. config.firm.practice-areas
#: schema.json
msgctxt "fh"
msgid "Comma separated list of the practice areas, e.g. Employment law, Family law, Real estate law"
msgstr "Lista de áreas de práctica separadas por comas, p. ej. Derecho laboral, Derecho de familia, Derecho inmobiliario"

#. config.firm.call-button
#: schema.json
msgctxt "fh"
msgid "Show call and consultation buttons at the bottom of the screen on phones"
msgstr "Mostrar botones de llamada y consulta en la parte inferior de la pantalla en teléfonos"

#. config.firm.disclaimer
#: schema.json
msgctxt "fn"
msgid "Disclaimer"
msgstr "Aviso legal"

#. config.firm.disclaimer
#: schema.json
msgctxt "fh"
msgid "Legal notice shown at the bottom of every page, e.g. that the website is no legal advice"
msgstr "Aviso legal mostrado al pie de cada página, p. ej. que el sitio web no constituye asesoramiento jurídico"

#. config.firm.hours
#: schema.json
msgctxt "fn"
msgid "Office hours"
msgstr "Horario de atención"

#. config.firm.hours
#: schema.json
msgctxt "fh"
msgid "Office hours for each day of the week"
msgstr "Horario de atención para cada día de la semana"

