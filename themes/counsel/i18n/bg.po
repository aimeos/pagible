msgid "Link to the contact page or online scheduling, shown as a button in the header"
msgstr "Връзка към страницата за контакт или онлайн записване, показвана като бутон в заглавната част"

#. config.firm.languages
#: schema.json
msgctxt "fh"
msgid "Comma separated list of the languages spoken by the attorneys, e.g. English, German, French"
msgstr "Списък на езиците, които адвокатите говорят, разделени със запетаи, напр. английски, немски, френски"

#. config.firm.practice-areas
#: schema.json
msgctxt "fn"
msgid "Practice areas"
msgstr "Правни области"

#. config.firm.practice-areas
#: schema.json
msgctxt "fh"
msgid "Comma separated list of the practice areas, e.g. Employment law, Family law, Real estate law"
msgstr "Списък на правните области, разделени със запетаи, напр. Трудово право, Семейно право, Право на недвижимите имоти"

#. config.firm.call-button
#: schema.json
msgctxt "fh"
msgid "Show call and consultation buttons at the bottom of the screen on phones"
msgstr "Показване на бутони за обаждане и консултация в долната част на екрана на телефони"

#. config.firm.disclaimer
#: schema.json
msgctxt "fn"
