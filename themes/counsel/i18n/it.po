msgid "Name of the law firm"
msgstr "Nome dello studio legale"

#. config.firm.business-type
#: schema.json
msgctxt "fn"
msgid "Firm type"
msgstr "Tipo di studio"

#. config.firm.business-type
#: schema.json
msgctxt "op"
msgid "Law firm"
msgstr "Studio legale"

#. config.firm.business-type
#: schema.json
msgctxt "op"
msgid "Attorney"
msgstr "Avvocato"

#. config.firm.business-type
#: schema.json
msgctxt "op"
msgid "Notary"
msgstr "Notaio"

#. config.firm.business-type
#: schema.json
msgctxt "op"
msgid "Other legal service"
msgstr "Altro servizio legale"

#. config.firm.email
#: schema.json
msgctxt "fh"
msgid "Email address for consultation requests"
msgstr "Indirizzo e-mail per le richieste di consulenza"

#. config.firm.hotline
#: schema.json
msgctxt "fn"
msgid "Hotline"
msgstr "Numero di emergenza"

#. config.firm.hotline
#: schema.json
msgctxt "fh"
msgid "Phone number for urgent legal matters, e.g. arrests or searches, shown at the top of every page"
msgstr "Numero di telefono per questioni legali urgenti, ad es. arresti o perquisizioni, mostrato in alto su ogni pagina"

#. config.firm.consultation
#: schema.json
msgctxt "fn"
msgid "Consultation link"
msgstr "Link per la consulenza"

#. config.firm.consultation
#: schema.json
msgctxt "fh"
msgid "Link to the contact page or online scheduling, shown as a button in the header"
msgstr "Link alla pagina dei contatti o alla prenotazione online, mostrato come pulsante nell'intestazione"

#. config.firm.languages
#: schema.json
msgctxt "fh"
msgid "Comma separated list of the languages spoken by the attorneys, e.g. English, German, French"
msgstr "Elenco delle lingue parlate dagli avvocati separate da virgole, ad es. inglese, tedesco, francese"

#. config.firm.practice-areas
#: schema.json
msgctxt "fn"
msgid "Practice areas"
msgstr "Aree di competenza"

#. config.firm.practice-areas
#: schema.json
msgctxt "fh"
msgid "Comma separated list of the practice areas, e.g. Employment law, Family law, Real estate law"
msgstr "Elenco delle aree di competenza separate da virgole, ad es. Diritto del lavoro, Diritto di famiglia, Diritto immobiliare"

#. config.firm.call-button
#: schema.json
msgctxt "fh"
msgid "Show call and consultation buttons at the bottom of the screen on phones"
msgstr "Mostra i pulsanti di chiamata e consulenza in fondo allo schermo sugli smartphone"

#. config.firm.disclaimer
#: schema.json
msgctxt "fn"
msgid "Disclaimer"
msgstr "Note legali"

#. config.firm.disclaimer
#: schema.json
msgctxt "fh"
msgid "Legal notice shown at the bottom of every page, e.g. that the website is no legal advice"
msgstr "Avviso legale mostrato in fondo a ogni pagina, ad es. che il sito web non costituisce consulenza legale"

#. config.firm.hours
#: schema.json
msgctxt "fn"
msgid "Office hours"
msgstr "Orari d'ufficio"

#. config.firm.hours
#: schema.json
msgctxt "fh"
msgid "Office hours for each day of the week"
msgstr "Orari dello studio per ogni giorno della settimana"

