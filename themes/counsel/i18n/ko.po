#: schema.json
msgctxt "fh"
msgid "Legal notice shown at the bottom of every page, e.g. that the website is no legal advice"
msgstr "모든 페이지 하단에 표시되는 법적 고지, 예: 웹사이트가 법률 자문이 아니라는 내용"

#. config.firm.hours
#: schema.json
msgctxt "fn"
msgid "Office hours"
msgstr "운영 시간"

#. config.firm.hours
#: schema.json
msgctxt "fh"
msgid "Office hours for each day of the week"
msgstr "요일별 사무소 운영 시간"

