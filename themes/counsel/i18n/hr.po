#. config.firm.email
#: schema.json
msgctxt "fh"
msgid "Email address for consultation requests"
msgstr "Adresa e-pošte za zahtjeve za konzultacije"

#. config.firm.hotline
#: schema.json
msgctxt "fn"
msgid "Hotline"
msgstr "Linija za hitne slučajeve"

#. config.firm.hotline
#: schema.json
msgctxt "fh"
msgid "Phone number for urgent legal matters, e.g. arrests or searches, shown at the top of every page"
msgstr "Broj telefona za hitna pravna pitanja, npr. uhićenja ili pretrese, prikazan je na vrhu svake stranice."

#. config.firm.consultation
#: schema.json
msgctxt "fn"
msgid "Consultation link"
msgstr "Poveznica za konzultacije"

#. config.firm.consultation
#: schema.json
msgctxt "fh"
msgid "Link to the contact page or online scheduling, shown as a button in the header"
msgstr "Poveznica na stranicu za kontakt ili na online zakazivanje, prikazana kao gumb u zaglavlju"

#. config.firm.languages
#: schema.json
msgctxt "fh"
msgid "Comma separated list of the languages spoken by the attorneys, e.g. English, German, French"
msgstr "Popis jezika koje odvjetnici govore, odvojenih zarezom, npr. engleski, njemački, francuski"

#. config.firm.practice-areas
#: schema.json
msgctxt "fn"
msgid "Practice areas"
msgstr "Pravna područja"

#. config.firm.practice-areas
#: schema.json
msgctxt "fh"
msgid "Comma separated list of the practice areas, e.g. Employment law, Family law, Real estate law"
msgstr "Popis područja prakse odvojenih zarezom, npr. radno pravo, obiteljsko pravo, pravo nekretnina"

#. config.firm.call-button
#: schema.json
msgctxt "fh"
msgid "Show call and consultation buttons at the bottom of the screen on phones"
msgstr "Prikaži gumbe za poziv i konzultacije na dnu zaslona na telefonima"

#. config.firm.disclaimer
#: schema.json
msgctxt "fn"
msgid "Disclaimer"
msgstr "Odricanje od odgovornosti"

#. config.firm.disclaimer
#: schema.json
msgctxt "fh"
msgid "Legal notice shown at the bottom of every page, e.g. that the website is no legal advice"
msgstr "Pravna napomena prikazana na dnu svake stranice, npr. da web-stranica ne predstavlja pravni savjet"

#. config.firm.hours
#: schema.json
msgctxt "fn"
msgid "Office hours"
msgstr "Radno vrijeme"

#. config.firm.hours
#: schema.json
msgctxt "fh"
msgid "Office hours for each day of the week"
msgstr "Radno vrijeme svakog dana u tjednu"

