msgid "Consultation link"
msgstr "Beratungslink"

#. config.firm.consultation
#: schema.json
msgctxt "fh"
msgid "Link to the contact page or online scheduling, shown as a button in the header"
msgstr "Link zur Kontaktseite oder Online-Terminvereinbarung, wird als Button in der Kopfzeile angezeigt"

#. config.firm.languages
#: schema.json
msgctxt "fh"
msgid "Comma separated list of the languages spoken by the attorneys, e.g. English, German, French"
msgstr "Kommagetrennte Liste der von den Anwälten gesprochenen Sprachen, z. B. Englisch, Deutsch, Französisch"

#. config.firm.practice-areas
#: schema.json
msgctxt "fn"
msgid "Practice areas"
msgstr "Rechtsgebiete"

