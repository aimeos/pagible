msgstr "Kommagetrennte Liste der Rechtsgebiete, z. B. Arbeitsrecht, Familienrecht, Immobilienrecht"

#. config.firm.call-button
#: schema.json
msgctxt "fh"
msgid "Show call and consultation buttons at the bottom of the screen on phones"
msgstr "Anruf- und Beratungs-Buttons am unteren Bildschirmrand auf Smartphones anzeigen"

#. config.firm.disclaimer
#: schema.json
msgctxt "fn"
msgid "Disclaimer"
msgstr "Haftungsausschluss"

