msgctxt "st"
msgid "counsel::firm"
msgstr "γραφείο"

#. config.firm.name
#: schema.json
msgctxt "fh"
msgid "Name of the law firm"
msgstr "Όνομα του δικηγορικού γραφείου"

#. config.firm.business-type
#: schema.json
msgctxt "fn"
msgid "Firm type"
msgstr "Τύπος γραφείου"

#. config.firm.business-type
#: schema.json
msgctxt "op"
msgid "Law firm"
msgstr "Δικηγορικό γραφείο"

#. config.firm.business-type
#: schema.json
msgctxt "op"
msgid "Attorney"
msgstr "Δικηγόρος"

#. config.firm.business-type
#: schema.json
msgctxt "op"
msgid "Notary"
msgstr "Συμβολαιογράφος"

#. config.firm.business-type
#: schema.json
msgctxt "op"
msgid "Other legal service"
msgstr "Άλλη νομική υπηρεσία"

#. config.firm.email
#: schema.json
msgctxt "fh"
msgid "Email address for consultation requests"
msgstr "Διεύθυνση email για αιτήματα συμβουλευτικής"

#. config.firm.hotline
#: schema.json
msgctxt "fn"
msgid "Hotline"
msgstr "Γραμμή επειγόντων"

#. config.firm.hotline
#: schema.json
msgctxt "fh"
msgid "Phone number for urgent legal matters, e.g. arrests or searches, shown at the top of every page"
msgstr "Αριθμός τηλεφώνου για επείγουσες νομικές υποθέσεις, π.χ. συλλήψεις ή έρευνες, εμφανίζεται στο πάνω μέρος κάθε σελίδας"

#. config.firm.consultation
#: schema.json
msgctxt "fn"
msgid "Consultation link"
msgstr "Σύνδεσμος συμβουλευτικής"

#. config.firm.consultation
#: schema.json
msgctxt "fh"
msgid "Link to the contact page or online scheduling, shown as a button in the header"
msgstr "Σύνδεσμος προς τη σελίδα επικοινωνίας ή την ηλεκτρονική κράτηση ραντεβού, εμφανίζεται ως κουμπί στην κεφαλίδα"

#. config.firm.languages
#: schema.json
msgctxt "fh"
msgid "Comma separated list of the languages spoken by the attorneys, e.g. English, German, French"
msgstr "Λίστα γλωσσών που μιλούν οι δικηγόροι διαχωρισμένων με κόμμα, π.χ. Αγγλικά, Γερμανικά, Γαλλικά"

#. config.firm.practice-areas
#: schema.json
msgctxt "fn"
msgid "Practice areas"
msgstr "Τομείς δικαίου"

#. config.firm.practice-areas
#: schema.json
msgctxt "fh"
msgid "Comma separated list of the practice areas, e.g. Employment law, Family law, Real estate law"
msgstr "Λίστα τομέων δικαίου διαχωρισμένων με κόμμα, π.χ. Εργατικό δίκαιο, Οικογενειακό δίκαιο, Δίκαιο ακινήτων"

#. config.firm.call-button
#: schema.json
msgctxt "fh"
msgid "Show call and consultation buttons at the bottom of the screen on phones"
msgstr "Εμφάνιση κουμπιών κλήσης και συμβουλευτικής στο κάτω μέρος της οθόνης στα κινητά"

#. config.firm.disclaimer
#: schema.json
msgctxt "fn"
msgid "Disclaimer"
msgstr "Αποποίηση ευθύνης"

#. config.firm.disclaimer
#: schema.json
msgctxt "fh"
msgid "Legal notice shown at the bottom of every page, e.g. that the website is no legal advice"
msgstr "Νομική σημείωση στο κάτω μέρος κάθε σελίδας, π.χ. ότι ο ιστότοπος δεν αποτελεί νομική συμβουλή"

#. config.firm.hours
#: schema.json
msgctxt "fn"
msgid "Office hours"
msgstr "Ώρες γραφείου"

#. config.firm.hours
#: schema.json
msgctxt "fh"
msgid "Office hours for each day of the week"
msgstr "Ώρες λειτουργίας του γραφείου για κάθε ημέρα της εβδομάδας"

#. config.theme
#: schema.json
msgctxt "st"
msgid "counsel::theme"
msgstr "Θέμα"
