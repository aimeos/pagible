msgid "Phone number for urgent legal matters, e.g. arrests or searches, shown at the top of every page"
msgstr "شماره تلفن برای امور حقوقی فوری، مانند بازداشت یا تفتیش، در بالای هر صفحه نمایش داده می‌شود."

#. config.firm.consultation
#: schema.json
msgctxt "fn"
msgid "Consultation link"
msgstr "لینک مشاوره"

#. config.firm.consultation
#: schema.json
msgctxt "fh"
msgid "Link to the contact page or online scheduling, shown as a button in the header"
msgstr "لینک به صفحه تماس یا برنامه‌ریزی آنلاین، که به صورت یک دکمه در هدر نمایش داده می‌شود."

#. config.firm.languages
#: schema.json
msgctxt "fh"
msgid "Comma separated list of the languages spoken by the attorneys, e.g. English, German, French"
msgstr "فهرست کاما‌جدای‌شده زبان‌های مورد استفاده وکلای دادگستری، مانند انگلیسی، آلمانی، فرانسوی"

#. config.firm.practice-areas
#: schema.json
msgctxt "fn"
msgid "Practice areas"
msgstr "حوزه‌های فعالیت"

#. config.firm.practice-areas
#: schema.json
msgctxt "fh"
msgid "Comma separated list of the practice areas, e.g. Employment law, Family law, Real estate law"
msgstr "فهرست حوزه‌های تخصصی جداشده با ویرگول، مانند: حقوق کار، حقوق خانواده، حقوق املاک و مستغلات"

#. config.firm.call-button
#: schema.json
msgctxt "fh"
msgid "Show call and consultation buttons at the bottom of the screen on phones"
msgstr "در گوشی‌ها، دکمه‌های تماس و مشاوره را در پایین صفحه نمایش دهید."

#. config.firm.disclaimer
#: schema.json
msgctxt "fn"
msgid "Disclaimer"
msgstr "سلب مسئولیت"

#. config.firm.disclaimer
#: schema.json
