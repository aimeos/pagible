#. config.firm
#: schema.json
msgctxt "st"
msgid "counsel::firm"
msgstr "công ty"

#. config.firm.name
#: schema.json
msgctxt "fh"
msgid "Name of the law firm"
msgstr "Tên công ty luật"

#. config.firm.business-type
#: schema.json
msgctxt "fn"
msgid "Firm type"
msgstr "Loại hình công ty"

#. config.firm.business-type
#: schema.json
msgctxt "op"
msgid "Law firm"
msgstr "Công ty luật"

#. config.firm.business-type
#: schema.json
msgctxt "op"
msgid "Attorney"
msgstr "Luật sư"

#. config.firm.business-type
#: schema.json
msgctxt "op"
msgid "Notary"
msgstr "Công chứng viên"

#. config.firm.business-type
#: schema.json
msgctxt "op"
msgid "Other legal service"
msgstr "Dịch vụ pháp lý khác"

#. config.firm.email
#: schema.json
msgctxt "fh"
msgid "Email address for consultation requests"
msgstr "Địa chỉ email cho yêu cầu tư vấn"

#. config.firm.hotline
#: schema.json
msgctxt "fn"
msgid "Hotline"
msgstr "Đường dây nóng"

#. config.firm.hotline
#: schema.json
msgctxt "fh"
msgid "Phone number for urgent legal matters, e.g. arrests or searches, shown at the top of every page"
msgstr "Số điện thoại cho các vấn đề pháp lý khẩn cấp, ví dụ bắt giữ hoặc khám xét, hiển thị ở đầu mỗi trang"

#. config.firm.consultation
#: schema.json
msgctxt "fn"
msgid "Consultation link"
msgstr "Liên kết tư vấn"

#. config.firm.consultation
#: schema.json
msgctxt "fh"
msgid "Link to the contact page or online scheduling, shown as a button in the header"
msgstr "Liên kết đến trang liên hệ hoặc đặt lịch trực tuyến, hiển thị dưới dạng nút ở đầu trang"

#. config.firm.languages
#: schema.json
msgctxt "fh"
msgid "Comma separated list of the languages spoken by the attorneys, e.g. English, German, French"
msgstr "Danh sách ngôn ngữ mà các luật sư sử dụng, phân tách bằng dấu phẩy, ví dụ tiếng Anh, tiếng Đức, tiếng Pháp"

#. config.firm.practice-areas
#: schema.json
msgctxt "fn"
msgid "Practice areas"
msgstr "Lĩnh vực hành nghề"

#. config.firm.practice-areas
#: schema.json
msgctxt "fh"
msgid "Comma separated list of the practice areas, e.g. Employment law, Family law, Real estate law"
msgstr "Danh sách lĩnh vực hành nghề phân tách bằng dấu phẩy, ví dụ Luật lao động, Luật gia đình, Luật bất động sản"

#. config.firm.call-button
#: schema.json
msgctxt "fh"
msgid "Show call and consultation buttons at the bottom of the screen on phones"
msgstr "Hiển thị nút gọi và tư vấn ở cuối màn hình trên điện thoại"

#. config.firm.disclaimer
#: schema.json
msgctxt "fn"
msgid "Disclaimer"
msgstr "Tuyên bố miễn trừ trách nhiệm"

#. config.firm.disclaimer
#: schema.json
msgctxt "fh"
msgid "Legal notice shown at the bottom of every page, e.g. that the website is no legal advice"
msgstr "Thông báo pháp lý hiển thị ở cuối mỗi trang, ví dụ rằng trang web không phải là tư vấn pháp lý"

#. config.firm.hours
#: schema.json
msgctxt "fn"
msgid "Office hours"
msgstr "Giờ làm việc"

#. config.firm.hours
#: schema.json
msgctxt "fh"
msgid "Office hours for each day of the week"
msgstr "Giờ làm việc của văn phòng cho mỗi ngày trong tuần"

#. config.theme
#: schema.json
msgctxt "st"
msgid "counsel::theme"
msgstr "Giao diện"
