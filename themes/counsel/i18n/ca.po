#. config.firm
#: schema.json
msgctxt "st"
msgid "counsel::firm"
msgstr "Despatx"

#. config.firm.name
#: schema.json
msgctxt "fh"
msgid "Name of the law firm"
msgstr "Nom del despatx d'advocats"

#. config.firm.business-type
#: schema.json
msgctxt "fn"
msgid "Firm type"
msgstr "Tipus de despatx"

#. config.firm.business-type
#: schema.json
msgctxt "op"
msgid "Law firm"
msgstr "Despatx d'advocats"

#. config.firm.business-type
#: schema.json
msgctxt "op"
msgid "Attorney"
msgstr "Advocat"

#. config.firm.business-type
#: schema.json
msgctxt "op"
msgid "Notary"
msgstr "Notari"

#. config.firm.business-type
#: schema.json
msgctxt "op"
msgid "Other legal service"
msgstr "Altres serveis jurídics"

#. config.firm.email
#: schema.json
msgctxt "fh"
msgid "Email address for consultation requests"
msgstr "Adreça de correu electrònic per a sol·licituds de consulta"

#. config.firm.hotline
#: schema.json
msgctxt "fn"
msgid "Hotline"
msgstr "Línia directa"

#. config.firm.hotline
#: schema.json
msgctxt "fh"
msgid "Phone number for urgent legal matters, e.g. arrests or searches, shown at the top of every page"
msgstr "El número de telèfon per a assumptes legals urgents, com ara detencions o escorcolls, es mostra a la part superior de cada pàgina."

#. config.firm.consultation
#: schema.json
msgctxt "fn"
msgid "Consultation link"
msgstr "Enllaç de consulta"

#. config.firm.consultation
#: schema.json
msgctxt "fh"
msgid "Link to the contact page or online scheduling, shown as a button in the header"
msgstr "Enllaç a la pàgina de contacte o a la programació en línia, mostrat com un botó a la capçalera"

#. config.firm.languages
#: schema.json
msgctxt "fh"
msgid "Comma separated list of the languages spoken by the attorneys, e.g. English, German, French"
msgstr "Llista separada per comes de les llengües parlades pels advocats, p. ex. anglès, alemany, francès"

#. config.firm.practice-areas
#: schema.json
msgctxt "fn"
msgid "Practice areas"
msgstr "Àrees de pràctica"

#. config.firm.practice-areas
#: schema.json
msgctxt "fh"
msgid "Comma separated list of the practice areas, e.g. Employment law, Family law, Real estate law"
msgstr "Llista separada per comes de les àrees de pràctica, p. ex. Dret laboral, Dret de família, Dret immobiliari"

#. config.firm.call-button
#: schema.json
msgctxt "fh"
msgid "Show call and consultation buttons at the bottom of the screen on phones"
msgstr "Mostra els botons de trucada i de consulta a la part inferior de la pantalla dels telèfons"

#. config.firm.disclaimer
#: schema.json
msgctxt "fn"
msgid "Disclaimer"
msgstr "Avís legal"

#. config.firm.disclaimer
#: schema.json
msgctxt "fh"
msgid "Legal notice shown at the bottom of every page, e.g. that the website is no legal advice"
msgstr "Avís legal que es mostra a la part inferior de cada pàgina, per exemple, que el lloc web no constitueix assessorament jurídic."

#. config.firm.hours
#: schema.json
msgctxt "fn"
msgid "Office hours"
msgstr "Horari d'atenció"

#. config.firm.hours
#: schema.json
msgctxt "fh"
msgid "Office hours for each day of the week"
msgstr "Horari d'atenció de dilluns a divendres"

#. config.theme
#: schema.json
msgctxt "st"
msgid "counsel::theme"
msgstr "Tema"
