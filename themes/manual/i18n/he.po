#: schema.json
msgctxt "fh"
msgid "Rounding of corners as CSS length, e.g. 0.5rem or 0 for sharp corners"
msgstr "עיגול פינות כערך אורך ב-CSS, למשל 0.5rem או 0 לפינות חדות"
