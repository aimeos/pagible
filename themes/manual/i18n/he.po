#: schema.json
msgctxt "fh"
msgid "License of the software shown in the footer, e.g. MIT"
msgstr "רישיון התוכנה המוצג בכותרת התחתונה, למשל MIT"

#. config.theme
#: schema.json
msgctxt "st"
msgid "manual::theme"
msgstr "ערכת נושא"

