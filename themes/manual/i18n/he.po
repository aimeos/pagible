#. config.project.repository
#: schema.json
msgctxt "fn"
msgid "Repository"
msgstr "מאגר"

#. config.project.repository
#: schema.json
msgctxt "fh"
msgid "Link to the source code repository, e.g. https://github.com/acme/project, shown as icon in the header"
msgstr "קישור למאגר קוד המקור, למשל https://github.com/acme/project, מוצג כסמל בכותרת"

#. config.project.language
#: schema.json
msgctxt "fn"
msgid "Programming language"
msgstr "שפת תכנות"

#. config.project.language
#: schema.json
msgctxt "fh"
msgid "Main programming language of the project for search engines, e.g. PHP or TypeScript"
msgstr "שפת התכנות העיקרית של הפרויקט עבור מנועי חיפוש, למשל PHP או TypeScript"

#. config.project.license
#: schema.json
