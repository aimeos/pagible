msgid "manual::project"
msgstr "פרויקט"

#. config.project.name
#: schema.json
msgctxt "fh"
msgid "Name of the software project"
msgstr "שם פרויקט התוכנה"

#. config.project.version
#: schema.json
msgctxt "fn"
msgid "Version"
msgstr "גרסה"

#. config.project.version
#: schema.json
msgctxt "fh"
msgid "Current version shown next to the logo, e.g. v3.2"
msgstr "הגרסה הנוכחית המוצגת ליד הלוגו, למשל v3.2"

#. config.project.description
#: schema.json
msgctxt "fh"
msgid "One sentence describing what the software does, used for search engines"
