{
    "name": "aimeos/pagible-themes-manual",
    "description": "Pagible CMS - Manual theme for software documentation, developer guides, API references and changelogs",
    "keywords": [
        "laravel",
        "cms",
        "theme",
        "documentation",
        "docs",
        "developer",
        "api reference",
        "changelog",
        "software"
    ],
    "homepage": "https://pagible.com",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": "^8.2",
        "aimeos/pagible-theme": "*@dev"
    },
    "autoload": {
        "psr-4": {
            "Aimeos\\Cms\\": "src/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Aimeos\\Cms\\ManualServiceProvider"
            ]
        }
    }
}
