{
    "name": "aimeos/pagible-themes-glow",
    "description": "Pagible CMS - Glow theme for beauty salons, skin studios, nail and lash bars",
    "keywords": ["laravel", "cms", "theme", "beauty salon", "cosmetics", "nail salon", "lash studio", "day spa"],
    "homepage": "https://pagible.com",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": "^8.2",
        "aimeos/pagible-theme": "*@dev"
    },
    "autoload": {
        "psr-4": {
            "Aimeos\\Cms\\": "src/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Aimeos\\Cms\\GlowServiceProvider"
            ]
        }
    }
}
