{
    "label": "Paws",
    "description": "Warm, friendly design for veterinary clinics and animal hospitals with navy, coral and cream colors, serif headings, rounded cards and soft wave edges",
    "maintainer": "Aimeos",
    "email": "info@aimeos.org",
    "website": "https://pagible.com",
    "types": {
        "page": {
            "sections": [
                "main",
                "footer"
            ]
        },
        "docs": {
            "sections": [
                "main",
                "footer"
            ]
        },
        "blog": {
            "sections": [
                "main",
                "footer"
            ]
        }
    },
    "config": {
        "clinic": {
            "group": "basic",
            "icon": "<svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 24 24\" fill=\"currentColor\"><path d=\"M12 11c-3 0-6.5 3.6-6.5 6.6 0 1.9 1.4 3 3.1 3 1.4 0 2.2-.8 3.4-.8s2 .8 3.4.8c1.7 0 3.1-1.1 3.1-3 0-3-3.5-6.6-6.5-6.6zM6.2 10.7c1.2-.5 1.6-2.1 1-3.6S5.2 4.8 4 5.3s-1.6 2.1-1 3.6 2 2.3 3.2 1.8zm3.6-2.4c1.4 0 2.4-1.5 2.4-3.4S11.2 1.6 9.8 1.6 7.4 3 7.4 4.9s1 3.4 2.4 3.4zm4.4 0c1.4 0 2.4-1.5 2.4-3.4s-1-3.3-2.4-3.3-2.4 1.4-2.4 3.3 1 3.4 2.4 3.4zm5.8-3c-1.2-.5-2.6.3-3.2 1.8s-.2 3.1 1 3.6 2.6-.3 3.2-1.8.2-3.1-1-3.6z\"/></svg>",
            "fields": {
                "name": {
                    "type": "string",
                    "hint": "Name of the veterinary clinic",
                    "required": true
                },
                "business-type": {
                    "type": "select",
                    "label": "Clinic type",
                    "hint": "Kind of clinic shown to search engines",
                    "default": "VeterinaryCare",
                    "options": [
                        {
                            "value": "VeterinaryCare",
                            "label": "Veterinary clinic"
                        },
                        {
                            "value": "EmergencyService",
                            "label": "Animal emergency hospital"
                        },
                        {
                            "value": "AnimalShelter",
                            "label": "Animal shelter"
                        },
                        {
                            "value": "LocalBusiness",
                            "label": "Other pet service"
                        }
                    ],
                    "required": true
                },
                "street-address": {
                    "type": "string",
                    "label": "Street address",
                    "hint": "Street and house number",
                    "required": true
                },
                "postal-code": {
                    "type": "string",
                    "label": "Postal code",
                    "hint": "Postal code of the clinic",
                    "required": true
                },
                "locality": {
                    "type": "string",
                    "label": "City",
                    "hint": "City the clinic is located in",
                    "required": true
                },
                "country": {
                    "type": "string",
                    "label": "Country code",
                    "hint": "Two letter ISO country code, e.g. DE or US",
                    "default": "DE",
                    "min": 2,
                    "max": 2,
                    "uppercase": true,
                    "required": true
                },
                "telephone": {
                    "type": "string",
                    "hint": "Phone number in international format, also used by the call button",
                    "required": true
                },
                "email": {
                    "type": "string",
                    "hint": "Email address for appointment requests"
                },
                "emergency-phone": {
                    "type": "string",
                    "label": "Emergency number",
                    "hint": "Phone number for pet emergencies, shown at the top of every page"
                },
                "booking": {
                    "type": "string",
                    "label": "Booking link",
                    "hint": "Link to the appointment page or online booking, shown as a button in the header"
                },
                "languages": {
                    "type": "string",
                    "label": "Languages",
                    "hint": "Comma separated list of the languages spoken in the clinic, e.g. English, German, French"
                },
                "species": {
                    "type": "string",
                    "label": "Animals treated",
                    "hint": "Comma separated list of the animals treated, e.g. Dogs, Cats, Rabbits"
                },
                "new-clients": {
                    "type": "switch",
                    "label": "New clients",
                    "hint": "Tell search engines that the clinic welcomes new clients",
                    "default": true
                },
                "price-range": {
                    "type": "string",
                    "label": "Price range",
                    "hint": "Price level of the clinic, e.g. $$ or €€"
                },
                "call-button": {
                    "type": "switch",
                    "label": "Action bar",
                    "hint": "Show call and booking buttons at the bottom of the screen on phones",
                    "default": true
                },
                "hours": {
                    "type": "items",
                    "label": "Opening hours",
                    "hint": "Opening hours for each day of the week",
                    "identity": "id",
                    "item": {
                        "day": {
                            "type": "select",
                            "hint": "Day of the week",
                            "options": [
                                {
                                    "value": "Monday",
                                    "label": "Monday"
                                },
                                {
                                    "value": "Tuesday",
                                    "label": "Tuesday"
                                },
                                {
                                    "value": "Wednesday",
                                    "label": "Wednesday"
                                },
                                {
                                    "value": "Thursday",
                                    "label": "Thursday"
                                },
                                {
                                    "value": "Friday",
                                    "label": "Friday"
                                },
                                {
                                    "value": "Saturday",
                                    "label": "Saturday"
                                },
                                {
                                    "value": "Sunday",
                                    "label": "Sunday"
                                }
                            ]
                        },
                        "opens": {
                            "type": "string",
                            "hint": "Opening time in 24 hour format, e.g. 07:30",
                            "pattern": "^(?:[01][0-9]|2[0-3]):[0-5][0-9]$"
                        },
                        "closes": {
                            "type": "string",
                            "hint": "Closing time in 24 hour format, e.g. 17:00",
                            "pattern": "^(?:[01][0-9]|2[0-3]):[0-5][0-9]$"
                        }
                    }
                }
            }
        },
        "theme": {
            "group": "theme",
            "icon": "<svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 24 24\" fill=\"currentColor\"><path d=\"M12 11c-3 0-6.5 3.6-6.5 6.6 0 1.9 1.4 3 3.1 3 1.4 0 2.2-.8 3.4-.8s2 .8 3.4.8c1.7 0 3.1-1.1 3.1-3 0-3-3.5-6.6-6.5-6.6zM6.2 10.7c1.2-.5 1.6-2.1 1-3.6S5.2 4.8 4 5.3s-1.6 2.1-1 3.6 2 2.3 3.2 1.8zm3.6-2.4c1.4 0 2.4-1.5 2.4-3.4S11.2 1.6 9.8 1.6 7.4 3 7.4 4.9s1 3.4 2.4 3.4zm4.4 0c1.4 0 2.4-1.5 2.4-3.4s-1-3.3-2.4-3.3-2.4 1.4-2.4 3.3 1 3.4 2.4 3.4zm5.8-3c-1.2-.5-2.6.3-3.2 1.8s-.2 3.1 1 3.6 2.6-.3 3.2-1.8.2-3.1-1-3.6z\"/></svg>",
            "fields": {
                "--pico-font-family-sans-serif": {
                    "type": "string",
                    "hint": "Comma separated list of fonts used for the text",
                    "default": "system-ui, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif"
                },
                "--pico-color": {
                    "type": "color",
                    "hint": "Default text color",
                    "default": "#2B3A4A"
                },
                "--pico-background-color": {
                    "type": "color",
                    "hint": "Background color of the pages",
                    "default": "#FBF6F0"
                },
                "--pico-text-selection-color": {
                    "type": "color",
                    "hint": "Background color of selected text",
                    "default": "#E0573F40"
                },
                "--pico-contrast": {
                    "type": "color",
                    "hint": "Color of elements with strong contrast to the background",
                    "default": "#16324F"
                },
                "--pico-contrast-hover": {
                    "type": "color",
                    "hint": "Contrast color when hovering or focusing an element",
                    "default": "#0E2238"
                },
                "--pico-contrast-inverse": {
                    "type": "color",
                    "hint": "Text color on elements using the contrast color",
                    "default": "#FFFFFF"
                },
                "--pico-primary": {
                    "type": "color",
                    "hint": "Main brand color used for links and buttons",
                    "default": "#C2412B"
                },
                "--pico-primary-background": {
                    "type": "color",
                    "hint": "Background color of primary buttons and highlights",
                    "default": "#C2412B"
                },
                "--pico-primary-hover": {
                    "type": "color",
                    "hint": "Primary color when hovering or focusing an element",
                    "default": "#A33421"
                },
                "--pico-primary-hover-background": {
                    "type": "color",
                    "hint": "Primary background color when hovering or focusing an element",
                    "default": "#A33421"
                },
                "--pico-secondary": {
                    "type": "color",
                    "hint": "Additional color used for less important links and buttons",
                    "default": "#F4C6A8"
                },
                "--pico-secondary-background": {
                    "type": "color",
                    "hint": "Background color of secondary buttons",
                    "default": "#F4C6A8"
                },
                "--pico-secondary-hover": {
                    "type": "color",
                    "hint": "Secondary color when hovering or focusing an element",
                    "default": "#EEB089"
                },
                "--pico-secondary-hover-background": {
                    "type": "color",
                    "hint": "Secondary background color when hovering or focusing an element",
                    "default": "#EEB089"
                },
                "--pico-border-radius": {
                    "type": "string",
                    "hint": "Rounding of corners as CSS length, e.g. 0.25rem or 0 for sharp corners",
                    "default": "1rem"
                },
                "--pico-nav-breadcrumb-divider": {
                    "type": "string",
                    "hint": "Character shown between the breadcrumb links",
                    "default": "›"
                }
            }
        }
    }
}
