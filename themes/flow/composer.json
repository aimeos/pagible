{
    "name": "aimeos/pagible-themes-flow",
    "description": "Pagible CMS - Flow theme for plumbers and heating engineers",
    "keywords": ["laravel", "cms", "theme", "plumber", "heating", "heat-pump", "sanitary", "gas", "trades"],
    "homepage": "https://pagible.com",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": "^8.2",
        "aimeos/pagible-theme": "*@dev"
    },
    "autoload": {
        "psr-4": {
            "Aimeos\\Cms\\": "src/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Aimeos\\Cms\\FlowServiceProvider"
            ]
        }
    }
}
