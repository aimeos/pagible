{
    "label": "Flow",
    "description": "Clean, trustworthy design for plumbers, heating engineers and gas fitters with deep petrol, water blue and copper accents, rounded headings, water drop markers and wave backgrounds",
    "maintainer": "Aimeos",
    "email": "info@aimeos.org",
    "website": "https://pagible.com",
    "types": {
        "page": {
            "sections": [
                "main",
                "footer"
            ]
        },
        "docs": {
            "sections": [
                "main",
                "footer"
            ]
        },
        "blog": {
            "sections": [
                "main",
                "footer"
            ]
        }
    },
    "config": {
        "business": {
            "group": "basic",
            "icon": "<svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 24 24\" fill=\"currentColor\"><path d=\"M12 2C12 2 5 10 5 14.5A7 7 0 0 0 19 14.5C19 10 12 2 12 2Z\"/></svg>",
            "fields": {
                "name": {
                    "type": "string",
                    "hint": "Name of the company",
                    "required": true
                },
                "business-type": {
                    "type": "select",
                    "label": "Business type",
                    "hint": "Kind of business shown to search engines",
                    "default": "Plumber",
                    "options": [
                        {
                            "value": "Plumber",
                            "label": "Plumber"
                        },
                        {
                            "value": "HVACBusiness",
                            "label": "Heating and air conditioning"
                        },
                        {
                            "value": "HomeAndConstructionBusiness",
                            "label": "Home and construction business"
                        }
                    ],
                    "required": true
                },
                "street-address": {
                    "type": "string",
                    "label": "Street address",
                    "hint": "Street and house number",
                    "required": true
                },
                "postal-code": {
                    "type": "string",
                    "label": "Postal code",
                    "hint": "Postal code of the company",
                    "required": true
                },
                "locality": {
                    "type": "string",
                    "label": "City",
                    "hint": "City the company is located in",
                    "required": true
                },
                "country": {
                    "type": "string",
                    "label": "Country code",
                    "hint": "Two letter ISO country code, e.g. DE or US",
                    "default": "DE",
                    "min": 2,
                    "max": 2,
                    "uppercase": true,
                    "required": true
                },
                "telephone": {
                    "type": "string",
                    "hint": "Phone number in international format, also used by the call button",
                    "required": true
                },
                "emergency-phone": {
                    "type": "string",
                    "label": "Emergency number",
                    "hint": "Phone number for emergencies, shown at the top of every page"
                },
                "emergency": {
                    "type": "switch",
                    "label": "24/7 service",
                    "hint": "Emergency service is available around the clock"
                },
                "email": {
                    "type": "string",
                    "hint": "Email address for enquiries"
                },
                "area": {
                    "type": "string",
                    "label": "Places served",
                    "hint": "Comma separated list of the towns and regions you work in, e.g. Leeds, Bradford, York"
                },
                "price-range": {
                    "type": "string",
                    "label": "Price range",
                    "hint": "Price level of the company, e.g. $$ or €€"
                },
                "call-button": {
                    "type": "switch",
                    "label": "Call button",
                    "hint": "Show a call button at the bottom of the screen on phones",
                    "default": true
                },
                "hours": {
                    "type": "items",
                    "label": "Opening hours",
                    "hint": "Opening hours for each day of the week",
                    "identity": "id",
                    "item": {
                        "day": {
                            "type": "select",
                            "hint": "Day of the week",
                            "options": [
                                {
                                    "value": "Monday",
                                    "label": "Monday"
                                },
                                {
                                    "value": "Tuesday",
                                    "label": "Tuesday"
                                },
                                {
                                    "value": "Wednesday",
                                    "label": "Wednesday"
                                },
                                {
                                    "value": "Thursday",
                                    "label": "Thursday"
                                },
                                {
                                    "value": "Friday",
                                    "label": "Friday"
                                },
                                {
                                    "value": "Saturday",
                                    "label": "Saturday"
                                },
                                {
                                    "value": "Sunday",
                                    "label": "Sunday"
                                }
                            ]
                        },
                        "opens": {
                            "type": "string",
                            "hint": "Opening time in 24 hour format, e.g. 07:30",
                            "pattern": "^(?:[01][0-9]|2[0-3]):[0-5][0-9]$"
                        },
                        "closes": {
                            "type": "string",
                            "hint": "Closing time in 24 hour format, e.g. 17:00",
                            "pattern": "^(?:[01][0-9]|2[0-3]):[0-5][0-9]$"
                        }
                    }
                }
            }
        },
        "theme": {
            "group": "theme",
            "icon": "<svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 24 24\" fill=\"currentColor\"><path d=\"M12 2C12 2 5 10 5 14.5A7 7 0 0 0 19 14.5C19 10 12 2 12 2Z\"/></svg>",
            "fields": {
                "--pico-font-family-sans-serif": {
                    "type": "string",
                    "hint": "Comma separated list of fonts used for the text",
                    "default": "system-ui, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif"
                },
                "--pico-color": {
                    "type": "color",
                    "hint": "Default text color",
                    "default": "#15303B"
                },
                "--pico-background-color": {
                    "type": "color",
                    "hint": "Background color of the pages",
                    "default": "#F2F7F7"
                },
                "--pico-text-selection-color": {
                    "type": "color",
                    "hint": "Background color of selected text",
                    "default": "#0B7A9E40"
                },
                "--pico-contrast": {
                    "type": "color",
                    "hint": "Color of elements with strong contrast to the background",
                    "default": "#0A2B3B"
                },
                "--pico-contrast-hover": {
                    "type": "color",
                    "hint": "Contrast color when hovering or focusing an element",
                    "default": "#051A24"
                },
                "--pico-contrast-inverse": {
                    "type": "color",
                    "hint": "Text color on elements using the contrast color",
                    "default": "#FFFFFF"
                },
                "--pico-primary": {
                    "type": "color",
                    "hint": "Main brand color used for links and buttons",
                    "default": "#0B7A9E"
                },
                "--pico-primary-background": {
                    "type": "color",
                    "hint": "Background color of primary buttons and highlights",
                    "default": "#0B7A9E"
                },
                "--pico-primary-hover": {
                    "type": "color",
                    "hint": "Primary color when hovering or focusing an element",
                    "default": "#08627F"
                },
                "--pico-primary-hover-background": {
                    "type": "color",
                    "hint": "Primary background color when hovering or focusing an element",
                    "default": "#08627F"
                },
                "--pico-secondary": {
                    "type": "color",
                    "hint": "Additional color used for less important links and buttons",
                    "default": "#E07B39"
                },
                "--pico-secondary-background": {
                    "type": "color",
                    "hint": "Background color of secondary buttons",
                    "default": "#E07B39"
                },
                "--pico-secondary-hover": {
                    "type": "color",
                    "hint": "Secondary color when hovering or focusing an element",
                    "default": "#C4652A"
                },
                "--pico-secondary-hover-background": {
                    "type": "color",
                    "hint": "Secondary background color when hovering or focusing an element",
                    "default": "#C4652A"
                },
                "--pico-border-radius": {
                    "type": "string",
                    "hint": "Rounding of corners as CSS length, e.g. 0.25rem or 0 for sharp corners",
                    "default": "0.75rem"
                },
                "--pico-nav-breadcrumb-divider": {
                    "type": "string",
                    "hint": "Character shown between the breadcrumb links",
                    "default": "›"
                }
            }
        }
    }
}
