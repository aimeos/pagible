#. config.cafe
#: schema.json
msgctxt "st"
msgid "brew::cafe"
msgstr "Quán cà phê"

#. config.cafe.name
#: schema.json
msgctxt "fh"
msgid "Name of the café, roastery or bakery"
msgstr "Tên quán cà phê, xưởng rang hoặc tiệm bánh"

#. config.cafe.business-type
#: schema.json
msgctxt "op"
msgid "Café or coffee shop"
msgstr "Quán cà phê"

#. config.cafe.business-type
#: schema.json
msgctxt "op"
msgid "Bakery"
msgstr "Tiệm bánh"

#. config.cafe.business-type
#: schema.json
msgctxt "op"
msgid "Restaurant"
msgstr "Nhà hàng"

#. config.cafe.business-type
#: schema.json
msgctxt "op"
msgid "Other business, e.g. roastery"
msgstr "Loại hình khác, ví dụ: xưởng rang"

#. config.cafe.email
#: schema.json
msgctxt "fh"
msgid "Email address for questions, catering and wholesale requests"
msgstr "Địa chỉ email cho câu hỏi, dịch vụ tiệc và yêu cầu bán sỉ"

#. config.cafe.announcement
#: schema.json
msgctxt "fh"
msgid "Short note shown at the top of every page, e.g. Freshly roasted every Tuesday"
msgstr "Thông báo ngắn hiển thị ở đầu mỗi trang, ví dụ: Rang mới mỗi thứ Ba"

#. config.cafe.order
#: schema.json
msgctxt "fn"
msgid "Order link"
msgstr "Liên kết đặt hàng"

#. config.cafe.order
#: schema.json
msgctxt "fh"
msgid "Link to the online shop or order ahead page, shown as a button in the header"
msgstr "Liên kết đến cửa hàng trực tuyến hoặc trang đặt trước, hiển thị dưới dạng nút ở phần đầu trang"

#. config.cafe.menu
#: schema.json
msgctxt "fn"
msgid "Menu link"
msgstr "Liên kết thực đơn"

#. config.cafe.menu
#: schema.json
msgctxt "fh"
msgid "Link to the page with the food and drinks menu"
msgstr "Liên kết đến trang thực đơn đồ ăn và thức uống"

#. config.cafe.cuisine
#: schema.json
msgctxt "fn"
msgid "Cuisine"
msgstr "Ẩm thực"

#. config.cafe.cuisine
#: schema.json
msgctxt "fh"
msgid "Comma separated list of what you serve, e.g. Specialty coffee, Bakery, Breakfast"
msgstr "Danh sách những gì bạn phục vụ, phân cách bằng dấu phẩy, ví dụ: Cà phê đặc sản, Bánh nướng, Bữa sáng"

#. config.cafe.action-bar
#: schema.json
msgctxt "fh"
msgid "Show call and order buttons at the bottom of the screen on phones"
msgstr "Hiển thị nút gọi và đặt hàng ở cuối màn hình trên điện thoại"

#. config.theme
#: schema.json
msgctxt "st"
msgid "brew::theme"
msgstr "Giao diện"
