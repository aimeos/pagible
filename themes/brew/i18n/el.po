msgid "Link to the page with the food and drinks menu"
msgstr "Σύνδεσμος προς τη σελίδα με τον κατάλογο φαγητών και ποτών"

#. config.cafe.cuisine
#: schema.json
msgctxt "fn"
msgid "Cuisine"
msgstr "Προσφερόμενα είδη"

#. config.cafe.cuisine
#: schema.json
msgctxt "fh"
msgid "Comma separated list of what you serve, e.g. Specialty coffee, Bakery, Breakfast"
msgstr "Λίστα διαχωρισμένη με κόμματα με όσα σερβίρετε, π.χ. Specialty καφές, Αρτοσκευάσματα, Πρωινό"

#. config.cafe.action-bar
#: schema.json
msgctxt "fh"
msgid "Show call and order buttons at the bottom of the screen on phones"
msgstr "Εμφάνιση κουμπιών κλήσης και παραγγελίας στο κάτω μέρος της οθόνης στα κινητά"

