#. config.cafe.order
#: schema.json
msgctxt "fn"
msgid "Order link"
msgstr "Σύνδεσμος παραγγελίας"

#. config.cafe.order
#: schema.json
msgctxt "fh"
msgid "Link to the online shop or order ahead page, shown as a button in the header"
msgstr "Σύνδεσμος προς το ηλεκτρονικό κατάστημα ή τη σελίδα προπαραγγελίας, εμφανίζεται ως κουμπί στην κεφαλίδα"

#. config.cafe.menu
#: schema.json
msgctxt "fn"
msgid "Menu link"
msgstr "Σύνδεσμος καταλόγου"

