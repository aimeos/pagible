#: schema.json
msgctxt "fh"
msgid "Opening time in 24 hour format, e.g. 07:30"
msgstr "ម៉ោងបើកជាទម្រង់ 24 ម៉ោង ឧ. 07:30"

#. config.cafe.hours.closes
#: schema.json
msgctxt "fn"
msgid "closes"
msgstr "ដល់ម៉ោង"

#. config.cafe.hours.closes
#: schema.json
msgctxt "fh"
msgid "Closing time in 24 hour format, e.g. 17:00"
msgstr "ម៉ោងបិទជាទម្រង់ 24 ម៉ោង ឧ. 17:00"

#. config.theme
