#: schema.json
msgctxt "op"
msgid "Monday"
msgstr "ថ្ងៃច័ន្ទ"

#. config.cafe.hours.day
#: schema.json
msgctxt "op"
msgid "Tuesday"
msgstr "ថ្ងៃអង្គារ"

#. config.cafe.hours.day
#: schema.json
msgctxt "op"
msgid "Wednesday"
msgstr "ថ្ងៃពុធ"

#. config.cafe.hours.day
#: schema.json
msgctxt "op"
msgid "Thursday"
msgstr "ថ្ងៃព្រហស្បតិ៍"

#. config.cafe.hours.day
#: schema.json
msgctxt "op"
msgid "Friday"
