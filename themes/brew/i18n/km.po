#. config.cafe.hours.day
#: schema.json
msgctxt "op"
msgid "Saturday"
msgstr "ថ្ងៃសៅរ៍"

#. config.cafe.hours.day
#: schema.json
msgctxt "op"
msgid "Sunday"
msgstr "ថ្ងៃអាទិត្យ"

#. config.cafe.hours.opens
#: schema.json
msgctxt "fn"
msgid "opens"
msgstr "ចាប់ពីម៉ោង"

