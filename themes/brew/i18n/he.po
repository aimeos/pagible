#. config.cafe.business-type
#: schema.json
msgctxt "op"
msgid "Café or coffee shop"
msgstr "בית קפה"

#. config.cafe.business-type
#: schema.json
msgctxt "op"
msgid "Bakery"
msgstr "מאפייה"

#. config.cafe.business-type
#: schema.json
msgctxt "op"
msgid "Restaurant"
msgstr "מסעדה"

#. config.cafe.business-type
#: schema.json
msgctxt "op"
