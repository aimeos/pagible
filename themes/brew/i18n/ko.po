#. config.cafe
#: schema.json
msgctxt "st"
msgid "brew::cafe"
msgstr "카페"

#. config.cafe.name
#: schema.json
msgctxt "fh"
msgid "Name of the café, roastery or bakery"
msgstr "카페, 로스터리 또는 베이커리 이름"

#. config.cafe.business-type
#: schema.json
msgctxt "op"
msgid "Café or coffee shop"
msgstr "카페 또는 커피숍"

#. config.cafe.business-type
#: schema.json
msgctxt "op"
msgid "Bakery"
msgstr "베이커리"

#. config.cafe.business-type
#: schema.json
msgctxt "op"
msgid "Restaurant"
msgstr "레스토랑"

#. config.cafe.business-type
#: schema.json
msgctxt "op"
msgid "Other business, e.g. roastery"
msgstr "기타 업종(예: 로스터리)"

#. config.cafe.email
#: schema.json
msgctxt "fh"
msgid "Email address for questions, catering and wholesale requests"
msgstr "문의, 케이터링 및 도매 요청용 이메일 주소"

#. config.cafe.announcement
#: schema.json
msgctxt "fh"
msgid "Short note shown at the top of every page, e.g. Freshly roasted every Tuesday"
msgstr "모든 페이지 상단에 표시되는 짧은 공지(예: 매주 화요일 갓 로스팅)"

#. config.cafe.order
#: schema.json
msgctxt "fn"
msgid "Order link"
msgstr "주문 링크"

#. config.cafe.order
#: schema.json
msgctxt "fh"
msgid "Link to the online shop or order ahead page, shown as a button in the header"
msgstr "온라인 상점 또는 사전 주문 페이지 링크, 헤더에 버튼으로 표시됨"

#. config.cafe.menu
#: schema.json
msgctxt "fn"
msgid "Menu link"
msgstr "메뉴 링크"

#. config.cafe.menu
#: schema.json
msgctxt "fh"
msgid "Link to the page with the food and drinks menu"
msgstr "음식 및 음료 메뉴 페이지 링크"

#. config.cafe.cuisine
#: schema.json
msgctxt "fn"
msgid "Cuisine"
msgstr "메뉴 종류"

#. config.cafe.cuisine
#: schema.json
msgctxt "fh"
msgid "Comma separated list of what you serve, e.g. Specialty coffee, Bakery, Breakfast"
msgstr "제공하는 메뉴의 쉼표로 구분된 목록(예: 스페셜티 커피, 베이커리, 아침 식사)"

#. config.cafe.action-bar
#: schema.json
msgctxt "fh"
msgid "Show call and order buttons at the bottom of the screen on phones"
msgstr "휴대폰에서 화면 하단에 전화 및 주문 버튼 표시"

#. config.theme
#: schema.json
msgctxt "st"
