#. config.cafe
#: schema.json
msgctxt "st"
msgid "brew::cafe"
msgstr "คาเฟ่"

#. config.cafe.name
#: schema.json
msgctxt "fh"
msgid "Name of the café, roastery or bakery"
msgstr "ชื่อคาเฟ่ โรงคั่วกาแฟ หรือร้านเบเกอรี่"

#. config.cafe.business-type
#: schema.json
msgctxt "op"
msgid "Café or coffee shop"
msgstr "คาเฟ่หรือร้านกาแฟ"

#. config.cafe.business-type
#: schema.json
msgctxt "op"
msgid "Bakery"
msgstr "ร้านเบเกอรี่"

#. config.cafe.business-type
#: schema.json
msgctxt "op"
msgid "Restaurant"
msgstr "ร้านอาหาร"

#. config.cafe.business-type
#: schema.json
msgctxt "op"
msgid "Other business, e.g. roastery"
msgstr "ธุรกิจอื่น เช่น โรงคั่วกาแฟ"

#. config.cafe.email
#: schema.json
msgctxt "fh"
msgid "Email address for questions, catering and wholesale requests"
msgstr "อีเมลสำหรับคำถาม การจัดเลี้ยง และคำขอสั่งซื้อแบบขายส่ง"

#. config.cafe.announcement
#: schema.json
msgctxt "fh"
msgid "Short note shown at the top of every page, e.g. Freshly roasted every Tuesday"
msgstr "ข้อความสั้นที่แสดงด้านบนของทุกหน้า เช่น คั่วสดทุกวันอังคาร"

#. config.cafe.order
#: schema.json
msgctxt "fn"
msgid "Order link"
msgstr "ลิงก์สั่งซื้อ"

#. config.cafe.order
#: schema.json
msgctxt "fh"
msgid "Link to the online shop or order ahead page, shown as a button in the header"
msgstr "ลิงก์ไปยังร้านค้าออนไลน์หรือหน้าสั่งล่วงหน้า แสดงเป็นปุ่มในส่วนหัว"

#. config.cafe.menu
#: schema.json
msgctxt "fn"
msgid "Menu link"
msgstr "ลิงก์เมนู"

#. config.cafe.menu
#: schema.json
msgctxt "fh"
msgid "Link to the page with the food and drinks menu"
msgstr "ลิงก์ไปยังหน้าเมนูอาหารและเครื่องดื่ม"

#. config.cafe.cuisine
#: schema.json
msgctxt "fn"
msgid "Cuisine"
msgstr "ประเภทอาหาร"

#. config.cafe.cuisine
#: schema.json
msgctxt "fh"
msgid "Comma separated list of what you serve, e.g. Specialty coffee, Bakery, Breakfast"
msgstr "รายการสิ่งที่คุณเสิร์ฟคั่นด้วยจุลภาค เช่น กาแฟพิเศษ, เบเกอรี่, อาหารเช้า"

#. config.cafe.action-bar
#: schema.json
msgctxt "fh"
msgid "Show call and order buttons at the bottom of the screen on phones"
msgstr "แสดงปุ่มโทรและปุ่มสั่งซื้อที่ด้านล่างของหน้าจอบนโทรศัพท์"

#. config.theme
