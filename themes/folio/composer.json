{
    "name": "aimeos/pagible-themes-folio",
    "description": "Pagible CMS - Folio theme for developer blogs, personal websites and portfolios",
    "keywords": [
        "laravel",
        "cms",
        "theme",
        "blog",
        "portfolio",
        "developer",
        "personal website",
        "resume",
        "writing"
    ],
    "homepage": "https://pagible.com",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": "^8.2",
        "aimeos/pagible-theme": "*@dev"
    },
    "autoload": {
        "psr-4": {
            "Aimeos\\Cms\\": "src/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Aimeos\\Cms\\FolioServiceProvider"
            ]
        }
    }
}
