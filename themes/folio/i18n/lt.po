#. config.profile
#: schema.json
msgctxt "st"
msgid "folio::profile"
msgstr "Profilis"

#. config.profile.name
#: schema.json
msgctxt "fh"
msgid "Your full name, shown as logo and author of the posts"
msgstr "Jūsų vardas ir pavardė, rodomi kaip logotipas ir įrašų autorius"

#. config.profile.job
#: schema.json
msgctxt "fn"
msgid "Job title"
msgstr "Pareigos"

#. config.profile.job
#: schema.json
msgctxt "fh"
msgid "Your role used for search engines, e.g. Staff Engineer"
msgstr "Jūsų vaidmuo paieškos sistemoms, pvz. Staff Engineer"

#. config.profile.company
#: schema.json
msgctxt "fn"
msgid "Company"
msgstr "Įmonė"

#. config.profile.company
#: schema.json
msgctxt "fh"
msgid "Company or organization you work for, e.g. Northwind Labs"
msgstr "Įmonė ar organizacija, kurioje dirbate, pvz. Northwind Labs"

#. config.profile.location
#: schema.json
msgctxt "fh"
msgid "City or region you live in, e.g. Berlin, Germany"
msgstr "Miestas ar regionas, kuriame gyvenate, pvz. Berlynas, Vokietija"

#. config.profile.avatar
#: schema.json
msgctxt "fn"
msgid "Photo"
msgstr "Nuotrauka"

#. config.profile.avatar
#: schema.json
msgctxt "fh"
msgid "Square photo or avatar of you shown below the posts"
msgstr "Kvadratinė jūsų nuotrauka ar avataras po įrašais"

#. config.profile.bio
#: schema.json
msgctxt "fn"
msgid "Short bio"
msgstr "Trumpas aprašymas"

#. config.profile.bio
#: schema.json
msgctxt "fh"
msgid "One sentence about you shown below every post, e.g. I build Laravel apps and write about databases"
msgstr "Vienas sakinys apie jus po kiekvienu įrašu, pvz. Kuriu Laravel programas ir rašau apie duomenų bazes"

#. config.profile.email
#: schema.json
msgctxt "fh"
msgid "E-mail address shown in the footer with a copy button"
msgstr "El. pašto adresas poraštėje su kopijavimo mygtuku"

#. config.profile.links
#: schema.json
msgctxt "fn"
msgid "Profiles"
msgstr "Profiliai"

#. config.profile.links
#: schema.json
msgctxt "fh"
msgid "Links to your profiles shown in the footer, e.g. GitHub, Mastodon or LinkedIn"
msgstr "Nuorodos į jūsų profilius poraštėje, pvz. GitHub, Mastodon ar LinkedIn"

#. config.profile.links.label
#: schema.json
msgctxt "fh"
msgid "Name of the website, e.g. GitHub"
msgstr "Svetainės pavadinimas, pvz. GitHub"

#. config.profile.links.url
#: schema.json
msgctxt "fh"
msgid "Link to your profile, e.g. https://github.com/lena"
msgstr "Nuoroda į jūsų profilį, pvz. https://github.com/lena"

#. config.theme
#: schema.json
msgctxt "st"
msgid "folio::theme"
msgstr "Tema"

#. config.theme-dark
#: schema.json
msgctxt "st"
msgid "folio::theme-dark"
msgstr "Tamsi tema"
