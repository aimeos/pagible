#. config.profile
#: schema.json
msgctxt "st"
msgid "folio::profile"
msgstr "Profil"

#. config.profile.name
#: schema.json
msgctxt "fh"
msgid "Your full name, shown as logo and author of the posts"
msgstr "Ditt fullständiga namn, visas som logotyp och författare till inläggen"

#. config.profile.job
#: schema.json
msgctxt "fn"
msgid "Job title"
msgstr "Titel"

#. config.profile.job
#: schema.json
msgctxt "fh"
msgid "Your role used for search engines, e.g. Staff Engineer"
msgstr "Din roll för sökmotorer, t.ex. Staff Engineer"

#. config.profile.company
#: schema.json
msgctxt "fn"
msgid "Company"
msgstr "Företag"

#. config.profile.company
#: schema.json
msgctxt "fh"
msgid "Company or organization you work for, e.g. Northwind Labs"
msgstr "Företag eller organisation du arbetar för, t.ex. Northwind Labs"

#. config.profile.location
#: schema.json
msgctxt "fn"
msgid "Location"
msgstr "Plats"

#. config.profile.location
#: schema.json
msgctxt "fh"
msgid "City or region you live in, e.g. Berlin, Germany"
msgstr "Stad eller region där du bor, t.ex. Berlin, Tyskland"

#. config.profile.avatar
#: schema.json
msgctxt "fn"
msgid "Photo"
msgstr "Foto"

#. config.profile.avatar
#: schema.json
msgctxt "fh"
msgid "Square photo or avatar of you shown below the posts"
msgstr "Kvadratiskt foto eller avatar som visas under inläggen"

#. config.profile.bio
#: schema.json
msgctxt "fn"
msgid "Short bio"
msgstr "Kort presentation"

#. config.profile.bio
#: schema.json
msgctxt "fh"
msgid "One sentence about you shown below every post, e.g. I build Laravel apps and write about databases"
msgstr "En mening om dig under varje inlägg, t.ex. Jag bygger Laravel-appar och skriver om databaser"

#. config.profile.email
#: schema.json
msgctxt "fn"
msgid "E-mail"
msgstr "E-post"

#. config.profile.email
#: schema.json
msgctxt "fh"
msgid "E-mail address shown in the footer with a copy button"
msgstr "E-postadress i sidfoten med en kopieringsknapp"

#. config.profile.links
#: schema.json
msgctxt "fn"
msgid "Profiles"
msgstr "Profiler"

#. config.profile.links
#: schema.json
msgctxt "fh"
msgid "Links to your profiles shown in the footer, e.g. GitHub, Mastodon or LinkedIn"
msgstr "Länkar till dina profiler i sidfoten, t.ex. GitHub, Mastodon eller LinkedIn"

#. config.profile.links.label
#: schema.json
msgctxt "fh"
msgid "Name of the website, e.g. GitHub"
msgstr "Webbplatsens namn, t.ex. GitHub"

#. config.profile.links.url
#: schema.json
msgctxt "fh"
msgid "Link to your profile, e.g. https://github.com/lena"
msgstr "Länk till din profil, t.ex. https://github.com/lena"

#. config.theme
#: schema.json
msgctxt "st"
msgid "folio::theme"
msgstr "Tema"

#. config.theme.--pico-border-radius
#: schema.json
msgctxt "fh"
msgid "Rounding of corners as CSS length, e.g. 0.5rem or 0 for sharp corners"
msgstr "Avrundning av hörn som CSS-längd, t.ex. 0.5rem eller 0 för skarpa hörn"
