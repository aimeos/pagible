#. config.profile
#: schema.json
msgctxt "st"
msgid "folio::profile"
msgstr "Perfil"

#. config.profile.name
#: schema.json
msgctxt "fh"
msgid "Your full name, shown as logo and author of the posts"
msgstr "O seu nome completo, mostrado como logótipo e autor dos artigos"

#. config.profile.job
#: schema.json
msgctxt "fn"
msgid "Job title"
msgstr "Cargo"

#. config.profile.job
#: schema.json
msgctxt "fh"
msgid "Your role used for search engines, e.g. Staff Engineer"
msgstr "A sua função para motores de busca, p. ex. Staff Engineer"

#. config.profile.company
#: schema.json
msgctxt "fn"
msgid "Company"
msgstr "Empresa"

#. config.profile.company
#: schema.json
msgctxt "fh"
msgid "Company or organization you work for, e.g. Northwind Labs"
msgstr "Empresa ou organização onde trabalha, p. ex. Northwind Labs"

#. config.profile.location
#: schema.json
msgctxt "fh"
msgid "City or region you live in, e.g. Berlin, Germany"
msgstr "Cidade ou região onde vive, p. ex. Berlim, Alemanha"

#. config.profile.avatar
#: schema.json
msgctxt "fn"
msgid "Photo"
msgstr "Foto"

#. config.profile.avatar
#: schema.json
msgctxt "fh"
msgid "Square photo or avatar of you shown below the posts"
msgstr "Foto quadrada ou avatar mostrado por baixo dos artigos"

#. config.profile.bio
#: schema.json
msgctxt "fn"
msgid "Short bio"
msgstr "Biografia curta"

#. config.profile.bio
#: schema.json
msgctxt "fh"
msgid "One sentence about you shown below every post, e.g. I build Laravel apps and write about databases"
msgstr "Uma frase sobre si por baixo de cada artigo, p. ex. Crio apps Laravel e escrevo sobre bases de dados"

#. config.profile.email
#: schema.json
msgctxt "fh"
msgid "E-mail address shown in the footer with a copy button"
msgstr "Endereço de e-mail no rodapé com botão de copiar"

#. config.profile.links
#: schema.json
msgctxt "fn"
msgid "Profiles"
msgstr "Perfis"

#. config.profile.links
#: schema.json
msgctxt "fh"
msgid "Links to your profiles shown in the footer, e.g. GitHub, Mastodon or LinkedIn"
msgstr "Links para os seus perfis no rodapé, p. ex. GitHub, Mastodon ou LinkedIn"

#. config.profile.links.label
#: schema.json
msgctxt "fh"
msgid "Name of the website, e.g. GitHub"
msgstr "Nome do site, p. ex. GitHub"

#. config.profile.links.url
#: schema.json
msgctxt "fh"
msgid "Link to your profile, e.g. https://github.com/lena"
msgstr "Link para o seu perfil, p. ex. https://github.com/lena"

#. config.theme
#: schema.json
msgctxt "st"
msgid "folio::theme"
msgstr "Tema"

#. config.theme-dark
