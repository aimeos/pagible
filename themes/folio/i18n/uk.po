#. config.profile
#: schema.json
msgctxt "st"
msgid "folio::profile"
msgstr "Профіль"

#. config.profile.name
#: schema.json
msgctxt "fh"
msgid "Your full name, shown as logo and author of the posts"
msgstr "Ваше повне ім'я, показується як логотип і автор статей"

#. config.profile.job
#: schema.json
msgctxt "fn"
msgid "Job title"
msgstr "Посада"

#. config.profile.job
#: schema.json
msgctxt "fh"
msgid "Your role used for search engines, e.g. Staff Engineer"
msgstr "Ваша роль для пошукових систем, наприклад Staff Engineer"

#. config.profile.company
#: schema.json
msgctxt "fn"
msgid "Company"
msgstr "Компанія"

#. config.profile.company
#: schema.json
msgctxt "fh"
msgid "Company or organization you work for, e.g. Northwind Labs"
msgstr "Компанія чи організація, де ви працюєте, наприклад Northwind Labs"

#. config.profile.location
#: schema.json
msgctxt "fn"
msgid "Location"
msgstr "Розташування"

#. config.profile.location
#: schema.json
msgctxt "fh"
msgid "City or region you live in, e.g. Berlin, Germany"
msgstr "Місто чи регіон, де ви живете, наприклад Берлін, Німеччина"

#. config.profile.avatar
#: schema.json
msgctxt "fn"
msgid "Photo"
msgstr "Фото"

#. config.profile.avatar
#: schema.json
msgctxt "fh"
msgid "Square photo or avatar of you shown below the posts"
msgstr "Квадратне фото чи аватар під статтями"

#. config.profile.bio
#: schema.json
msgctxt "fn"
msgid "Short bio"
msgstr "Коротка біографія"

#. config.profile.bio
#: schema.json
msgctxt "fh"
msgid "One sentence about you shown below every post, e.g. I build Laravel apps and write about databases"
msgstr "Одне речення про вас під кожною статтею, наприклад Я створюю застосунки на Laravel і пишу про бази даних"

#. config.profile.email
#: schema.json
msgctxt "fn"
msgid "E-mail"
msgstr "E-mail"

#. config.profile.email
#: schema.json
msgctxt "fh"
msgid "E-mail address shown in the footer with a copy button"
msgstr "Адреса e-mail у футері з кнопкою копіювання"

#. config.profile.links
#: schema.json
msgctxt "fn"
msgid "Profiles"
msgstr "Профілі"

#. config.profile.links
#: schema.json
msgctxt "fh"
msgid "Links to your profiles shown in the footer, e.g. GitHub, Mastodon or LinkedIn"
msgstr "Посилання на ваші профілі у футері, наприклад GitHub, Mastodon або LinkedIn"

#. config.profile.links.label
#: schema.json
msgctxt "fh"
msgid "Name of the website, e.g. GitHub"
msgstr "Назва сайту, наприклад GitHub"

#. config.profile.links.url
#: schema.json
msgctxt "fh"
msgid "Link to your profile, e.g. https://github.com/lena"
msgstr "Посилання на ваш профіль, наприклад https://github.com/lena"

#. config.theme
#: schema.json
msgctxt "st"
msgid "folio::theme"
msgstr "Тема оформлення"

#. config.theme.--pico-border-radius
#: schema.json
msgctxt "fh"
msgid "Rounding of corners as CSS length, e.g. 0.5rem or 0 for sharp corners"
msgstr "Згладжування кутів як значення довжини в CSS, наприклад 0.5rem або 0 для гострих кутів"
