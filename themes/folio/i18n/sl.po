#. config.profile
#: schema.json
msgctxt "st"
msgid "folio::profile"
msgstr "Profil"

#. config.profile.name
#: schema.json
msgctxt "fh"
msgid "Your full name, shown as logo and author of the posts"
msgstr "Vaše polno ime, prikazano kot logotip in avtor objav"

#. config.profile.job
#: schema.json
msgctxt "fn"
msgid "Job title"
msgstr "Delovno mesto"

#. config.profile.job
#: schema.json
msgctxt "fh"
msgid "Your role used for search engines, e.g. Staff Engineer"
msgstr "Vaša vloga za iskalnike, npr. Staff Engineer"

#. config.profile.company
#: schema.json
msgctxt "fn"
msgid "Company"
msgstr "Podjetje"

#. config.profile.company
#: schema.json
msgctxt "fh"
msgid "Company or organization you work for, e.g. Northwind Labs"
msgstr "Podjetje ali organizacija, kjer delate, npr. Northwind Labs"

#. config.profile.location
#: schema.json
msgctxt "fh"
msgid "City or region you live in, e.g. Berlin, Germany"
msgstr "Mesto ali regija, kjer živite, npr. Berlin, Nemčija"

#. config.profile.avatar
#: schema.json
msgctxt "fn"
msgid "Photo"
msgstr "Fotografija"

#. config.profile.avatar
#: schema.json
msgctxt "fh"
msgid "Square photo or avatar of you shown below the posts"
msgstr "Kvadratna fotografija ali avatar pod objavami"

#. config.profile.bio
#: schema.json
msgctxt "fn"
msgid "Short bio"
msgstr "Kratek opis"

#. config.profile.bio
#: schema.json
msgctxt "fh"
msgid "One sentence about you shown below every post, e.g. I build Laravel apps and write about databases"
msgstr "En stavek o vas pod vsako objavo, npr. Razvijam aplikacije Laravel in pišem o podatkovnih bazah"

#. config.profile.email
#: schema.json
msgctxt "fh"
msgid "E-mail address shown in the footer with a copy button"
msgstr "E-poštni naslov v nogi z gumbom za kopiranje"

#. config.profile.links
#: schema.json
msgctxt "fn"
msgid "Profiles"
msgstr "Profili"

#. config.profile.links
#: schema.json
msgctxt "fh"
msgid "Links to your profiles shown in the footer, e.g. GitHub, Mastodon or LinkedIn"
msgstr "Povezave do vaših profilov v nogi, npr. GitHub, Mastodon ali LinkedIn"

#. config.profile.links.label
#: schema.json
msgctxt "fh"
msgid "Name of the website, e.g. GitHub"
msgstr "Ime spletnega mesta, npr. GitHub"

#. config.profile.links.url
#: schema.json
msgctxt "fh"
msgid "Link to your profile, e.g. https://github.com/lena"
msgstr "Povezava do vašega profila, npr. https://github.com/lena"

#. config.theme
#: schema.json
msgctxt "st"
msgid "folio::theme"
msgstr "Tema"

#. config.theme-dark
#: schema.json
msgctxt "st"
msgid "folio::theme-dark"
msgstr "Temna tema"
