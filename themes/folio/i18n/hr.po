"Content-Type: text/plain; charset=UTF-8\n"
"Language: hr\n"

#. config.profile
#: schema.json
msgctxt "st"
msgid "folio::profile"
msgstr "Profil"

#. config.profile.name
#: schema.json
msgctxt "fh"
msgid "Your full name, shown as logo and author of the posts"
msgstr "Vaše puno ime i prezime, prikazano kao logo i autor objava"

#. config.profile.job
#: schema.json
msgctxt "fn"
msgid "Job title"
msgstr "Naziv radnog mjesta"

#. config.profile.job
#: schema.json
msgctxt "fh"
msgid "Your role used for search engines, e.g. Staff Engineer"
msgstr "Vaša uloga koja se koristi za tražilice, npr. inženjer osoblja"

#. config.profile.company
#: schema.json
msgctxt "fn"
msgid "Company"
msgstr "Tvrtka"

#. config.profile.company
#: schema.json
msgctxt "fh"
msgid "Company or organization you work for, e.g. Northwind Labs"
msgstr "Tvrtka ili organizacija za koju radite, npr. Northwind Labs"

#. config.profile.location
#: schema.json
msgctxt "fn"
msgid "Location"
msgstr "Lokacija"

#. config.profile.location
#: schema.json
msgctxt "fh"
msgid "City or region you live in, e.g. Berlin, Germany"
msgstr "Grad ili regija u kojoj živite, npr. Berlin, Njemačka"

#. config.profile.avatar
#: schema.json
msgctxt "fn"
msgid "Photo"
msgstr "Fotografija"

#. config.profile.avatar
#: schema.json
msgctxt "fh"
msgid "Square photo or avatar of you shown below the posts"
msgstr "Kvadratna fotografija ili avatar od tebe prikazan ispod objava"

#. config.profile.bio
#: schema.json
msgctxt "fn"
msgid "Short bio"
msgstr "Kratka biografija"

#. config.profile.bio
#: schema.json
msgctxt "fh"
msgid "One sentence about you shown below every post, e.g. I build Laravel apps and write about databases"
msgstr "Jedna rečenica o vama prikazuje se ispod svake objave, npr. Izrađujem Laravel aplikacije i pišem o bazama podataka."

#. config.profile.email
#: schema.json
msgctxt "fn"
msgid "E-mail"
msgstr "E-pošta"

#. config.profile.email
#: schema.json
msgctxt "fh"
msgid "E-mail address shown in the footer with a copy button"
msgstr "Adresa e-pošte prikazana u podnožju s gumbom za kopiranje"

#. config.profile.links
#: schema.json
msgctxt "fn"
msgid "Profiles"
msgstr "Profili"

#. config.profile.links
#: schema.json
msgctxt "fh"
msgid "Links to your profiles shown in the footer, e.g. GitHub, Mastodon or LinkedIn"
msgstr "Poveznice na vaše profile prikazane u podnožju, npr. GitHub, Mastodon ili LinkedIn"

#. config.profile.links.label
#: schema.json
msgctxt "fh"
msgid "Name of the website, e.g. GitHub"
msgstr "Naziv web stranice, npr. GitHub"

#. config.profile.links.url
#: schema.json
msgctxt "fh"
msgid "Link to your profile, e.g. https://github.com/lena"
msgstr "Poveznica na vaš profil, npr. https://github.com/lena"

#. config.theme
#: schema.json
msgctxt "st"
msgid "folio::theme"
msgstr "Tema"

#. config.theme.--pico-border-radius
#: schema.json
msgctxt "fh"
msgid "Rounding of corners as CSS length, e.g. 0.5rem or 0 for sharp corners"
msgstr "Zaobljavanje kutova kao CSS duljina, npr. 0.5rem ili 0 za oštre kutove"
