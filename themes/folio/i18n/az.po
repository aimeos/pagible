#. config.profile
#: schema.json
msgctxt "st"
msgid "folio::profile"
msgstr "Profil"

#. config.profile.name
#: schema.json
msgctxt "fh"
msgid "Your full name, shown as logo and author of the posts"
msgstr "Paylaşımlarda loqo və müəllif kimi göstərilən tam adınız"

#. config.profile.job
#: schema.json
msgctxt "fn"
msgid "Job title"
msgstr "Vəzifə adı"

#. config.profile.job
#: schema.json
msgctxt "fh"
msgid "Your role used for search engines, e.g. Staff Engineer"
msgstr "Axtarış sistemlərində istifadə olunan rolunuz, məsələn: Mühəndis işçi"

#. config.profile.company
#: schema.json
msgctxt "fn"
msgid "Company"
msgstr "Şirkət"

#. config.profile.company
#: schema.json
msgctxt "fh"
msgid "Company or organization you work for, e.g. Northwind Labs"
msgstr "İşlədiyiniz şirkət və ya təşkilat, məsələn, Northwind Labs"

#. config.profile.location
#: schema.json
msgctxt "fh"
msgid "City or region you live in, e.g. Berlin, Germany"
msgstr "Yaşadığınız şəhər və ya region, məsələn, Berlin, Almaniya"

#. config.profile.avatar
#: schema.json
msgctxt "fn"
msgid "Photo"
msgstr "Foto"

#. config.profile.avatar
#: schema.json
msgctxt "fh"
msgid "Square photo or avatar of you shown below the posts"
msgstr "Paylaşımların altında sizin kvadrat fotoşəkili və ya avatarınız göstərilir."

#. config.profile.bio
#: schema.json
msgctxt "fn"
msgid "Short bio"
msgstr "Qısa bio"

#. config.profile.bio
#: schema.json
msgctxt "fh"
msgid "One sentence about you shown below every post, e.g. I build Laravel apps and write about databases"
msgstr "Hər paylaşımın altında göstərilən sizin haqqınızda bir cümlə, məsələn: Mən Laravel tətbiqləri qururam və verilənlər bazaları haqqında yazıram."

#. config.profile.email
#: schema.json
msgctxt "fh"
msgid "E-mail address shown in the footer with a copy button"
msgstr "Ayaqlıqda kopyalama düyməsi ilə e-poçt ünvanı göstərilir"

#. config.profile.links
#: schema.json
msgctxt "fn"
msgid "Profiles"
msgstr "Profilər"

#. config.profile.links
#: schema.json
msgctxt "fh"
msgid "Links to your profiles shown in the footer, e.g. GitHub, Mastodon or LinkedIn"
msgstr "Ayaqlıqda göstərilən profillərinizə keçidlər, məsələn GitHub, Mastodon və ya LinkedIn"

#. config.profile.links.label
#: schema.json
msgctxt "fh"
msgid "Name of the website, e.g. GitHub"
msgstr "Vebsaytın adı, məsələn GitHub"

#. config.profile.links.url
#: schema.json
msgctxt "fh"
msgid "Link to your profile, e.g. https://github.com/lena"
msgstr "Profilinizə keçid, məsələn: https://github.com/lena"

#. config.theme
#: schema.json
msgctxt "st"
msgid "folio::theme"
msgstr "Mövzu"
