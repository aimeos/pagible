#. config.profile
#: schema.json
msgctxt "st"
msgid "folio::profile"
msgstr "Profiel"

#. config.profile.name
#: schema.json
msgctxt "fh"
msgid "Your full name, shown as logo and author of the posts"
msgstr "Jou volle naam, vertoon as logo en skrywer van die plasings"

#. config.profile.job
#: schema.json
msgctxt "fn"
msgid "Job title"
msgstr "Postitel"

#. config.profile.job
#: schema.json
msgctxt "fh"
msgid "Your role used for search engines, e.g. Staff Engineer"
msgstr "Jou rol wat vir soekenjins gebruik word, bv. Personeelingenieur"

#. config.profile.company
#: schema.json
msgctxt "fn"
msgid "Company"
msgstr "Maatskappy"

#. config.profile.company
#: schema.json
msgctxt "fh"
msgid "Company or organization you work for, e.g. Northwind Labs"
msgstr "Maatskappy of organisasie waarvoor jy werk, bv. Northwind Labs"

#. config.profile.location
#: schema.json
msgctxt "fh"
msgid "City or region you live in, e.g. Berlin, Germany"
msgstr "Stad of streek waarin jy woon, bv. Berlyn, Duitsland"

#. config.profile.avatar
#: schema.json
msgctxt "fn"
msgid "Photo"
msgstr "Foto"

#. config.profile.avatar
#: schema.json
msgctxt "fh"
msgid "Square photo or avatar of you shown below the posts"
msgstr "Kwadratefoto of avatar van jou wat onder die plasings gewys word"

#. config.profile.bio
#: schema.json
msgctxt "fn"
msgid "Short bio"
msgstr "Kort lewensbeskrywing"

#. config.profile.bio
#: schema.json
msgctxt "fh"
msgid "One sentence about you shown below every post, e.g. I build Laravel apps and write about databases"
msgstr "Een sin oor jou wat onder elke pos gewys word, bv. Ek bou Laravel-apps en skryf oor databasisse"

#. config.profile.email
#: schema.json
msgctxt "fh"
msgid "E-mail address shown in the footer with a copy button"
msgstr "E-posadres wat in die voetskrif vertoon word met 'n kopieer-knoppie"

#. config.profile.links
#: schema.json
msgctxt "fn"
msgid "Profiles"
msgstr "Profiele"

#. config.profile.links
#: schema.json
msgctxt "fh"
msgid "Links to your profiles shown in the footer, e.g. GitHub, Mastodon or LinkedIn"
msgstr "Skakels na jou profiele wat in die voetskrif vertoon word, bv. GitHub, Mastodon of LinkedIn"

#. config.profile.links.label
#: schema.json
msgctxt "fh"
msgid "Name of the website, e.g. GitHub"
msgstr "Naam van die webwerf, bv. GitHub"

#. config.profile.links.url
#: schema.json
msgctxt "fh"
msgid "Link to your profile, e.g. https://github.com/lena"
msgstr "Skakel na jou profiel, bv. https://github.com/lena"

#. config.theme
#: schema.json
msgctxt "st"
msgid "folio::theme"
msgstr "Tema"

#. config.theme-dark
#: schema.json
msgctxt "st"
msgid "folio::theme-dark"
msgstr "Donker tema"
