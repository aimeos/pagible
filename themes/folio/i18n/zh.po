#. config.profile
#: schema.json
msgctxt "st"
msgid "folio::profile"
msgstr "个人资料"

#. config.profile.name
#: schema.json
msgctxt "fh"
msgid "Your full name, shown as logo and author of the posts"
msgstr "您的全名，显示为徽标和文章作者"

#. config.profile.job
#: schema.json
msgctxt "fn"
msgid "Job title"
msgstr "职位"

#. config.profile.job
#: schema.json
msgctxt "fh"
msgid "Your role used for search engines, e.g. Staff Engineer"
msgstr "用于搜索引擎的职位，例如 Staff Engineer"

#. config.profile.company
#: schema.json
msgctxt "fn"
msgid "Company"
msgstr "公司"

#. config.profile.company
#: schema.json
msgctxt "fh"
msgid "Company or organization you work for, e.g. Northwind Labs"
msgstr "您所在的公司或组织，例如 Northwind Labs"

#. config.profile.location
#: schema.json
msgctxt "fh"
msgid "City or region you live in, e.g. Berlin, Germany"
msgstr "您居住的城市或地区，例如 德国柏林"

#. config.profile.avatar
#: schema.json
msgctxt "fn"
msgid "Photo"
msgstr "照片"

#. config.profile.avatar
#: schema.json
msgctxt "fh"
msgid "Square photo or avatar of you shown below the posts"
msgstr "显示在文章下方的方形照片或头像"

#. config.profile.bio
#: schema.json
msgctxt "fn"
msgid "Short bio"
msgstr "简短介绍"

#. config.profile.bio
#: schema.json
msgctxt "fh"
msgid "One sentence about you shown below every post, e.g. I build Laravel apps and write about databases"
msgstr "显示在每篇文章下方的一句话简介，例如 我开发 Laravel 应用并撰写数据库相关文章"

#. config.profile.email
#: schema.json
msgctxt "fh"
msgid "E-mail address shown in the footer with a copy button"
msgstr "显示在页脚并带有复制按钮的电子邮件地址"

#. config.profile.links
#: schema.json
msgctxt "fn"
msgid "Profiles"
msgstr "个人主页"

#. config.profile.links
#: schema.json
msgctxt "fh"
msgid "Links to your profiles shown in the footer, e.g. GitHub, Mastodon or LinkedIn"
msgstr "显示在页脚的个人主页链接，例如 GitHub、Mastodon 或 LinkedIn"

#. config.profile.links.label
#: schema.json
msgctxt "fh"
msgid "Name of the website, e.g. GitHub"
msgstr "网站名称，例如 GitHub"

#. config.profile.links.url
#: schema.json
msgctxt "fh"
msgid "Link to your profile, e.g. https://github.com/lena"
msgstr "您的个人主页链接，例如 https://github.com/lena"

#. config.theme
#: schema.json
msgctxt "st"
msgid "folio::theme"
msgstr "主题"
