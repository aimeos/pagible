#. config.profile
#: schema.json
msgctxt "st"
msgid "folio::profile"
msgstr "Профил"

#. config.profile.name
#: schema.json
msgctxt "fh"
msgid "Your full name, shown as logo and author of the posts"
msgstr "Ваше пуно име, приказано као лого и аутор објава"

#. config.profile.job
#: schema.json
msgctxt "fn"
msgid "Job title"
msgstr "Радно место"

#. config.profile.job
#: schema.json
msgctxt "fh"
msgid "Your role used for search engines, e.g. Staff Engineer"
msgstr "Ваша улога за претраживаче, нпр. инжењер особља"

#. config.profile.company
#: schema.json
msgctxt "fn"
msgid "Company"
msgstr "Компанија"

#. config.profile.company
#: schema.json
msgctxt "fh"
msgid "Company or organization you work for, e.g. Northwind Labs"
msgstr "Компанија или организација за коју радите, нпр. Northwind Labs"

#. config.profile.location
#: schema.json
msgctxt "fh"
msgid "City or region you live in, e.g. Berlin, Germany"
msgstr "Град или регион у којем живите, нпр. Берлин, Немачка"

#. config.profile.avatar
#: schema.json
msgctxt "fn"
msgid "Photo"
msgstr "Фото"

#. config.profile.avatar
#: schema.json
msgctxt "fh"
msgid "Square photo or avatar of you shown below the posts"
msgstr "Квадратна фотографија или аватар од вас приказан испод објава"

#. config.profile.bio
#: schema.json
msgctxt "fn"
msgid "Short bio"
msgstr "Кратка биографија"

#. config.profile.bio
#: schema.json
msgctxt "fh"
msgid "One sentence about you shown below every post, e.g. I build Laravel apps and write about databases"
msgstr "Једна реченица о вама се приказује испод сваког поста, нпр. \"Израђујем Laravel апликације и пишем о базама података\""

#. config.profile.email
#: schema.json
msgctxt "fh"
msgid "E-mail address shown in the footer with a copy button"
msgstr "Е-маил адреса приказана у подножју са дугметом за копирање"

#. config.profile.links
#: schema.json
msgctxt "fn"
msgid "Profiles"
msgstr "Профили"

#. config.profile.links
#: schema.json
msgctxt "fh"
msgid "Links to your profiles shown in the footer, e.g. GitHub, Mastodon or LinkedIn"
msgstr "Линк despite вашим профилима приказаним у подножју, нпр. GitHub, Mastodon или LinkedIn"

#. config.profile.links.label
#: schema.json
msgctxt "fh"
msgid "Name of the website, e.g. GitHub"
msgstr "Име веб-сајта, нпр. GitHub"

#. config.profile.links.url
#: schema.json
msgctxt "fh"
msgid "Link to your profile, e.g. https://github.com/lena"
msgstr "Линк до вашег профила, нпр. https://github.com/lena"

#. config.theme
#: schema.json
msgctxt "st"
msgid "folio::theme"
msgstr "Тема"

#. config.theme-dark
#: schema.json
msgctxt "st"
msgid "folio::theme-dark"
msgstr "Тамна тема"
