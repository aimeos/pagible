#. config.profile
#: schema.json
msgctxt "st"
msgid "folio::profile"
msgstr "โปรไฟล์"

#. config.profile.name
#: schema.json
msgctxt "fh"
msgid "Your full name, shown as logo and author of the posts"
msgstr "ชื่อเต็มของคุณ แสดงเป็นโลโก้และผู้เขียนบทความ"

#. config.profile.job
#: schema.json
msgctxt "fn"
msgid "Job title"
msgstr "ตำแหน่งงาน"

#. config.profile.job
#: schema.json
msgctxt "fh"
msgid "Your role used for search engines, e.g. Staff Engineer"
msgstr "บทบาทของคุณสำหรับเครื่องมือค้นหา เช่น Staff Engineer"

#. config.profile.company
#: schema.json
msgctxt "fn"
msgid "Company"
msgstr "บริษัท"

#. config.profile.company
#: schema.json
msgctxt "fh"
msgid "Company or organization you work for, e.g. Northwind Labs"
msgstr "บริษัทหรือองค์กรที่คุณทำงาน เช่น Northwind Labs"

#. config.profile.location
#: schema.json
msgctxt "fh"
msgid "City or region you live in, e.g. Berlin, Germany"
msgstr "เมืองหรือภูมิภาคที่คุณอาศัย เช่น เบอร์ลิน เยอรมนี"

#. config.profile.avatar
#: schema.json
msgctxt "fn"
msgid "Photo"
msgstr "รูปภาพ"

#. config.profile.avatar
#: schema.json
msgctxt "fh"
msgid "Square photo or avatar of you shown below the posts"
msgstr "รูปภาพสี่เหลี่ยมจัตุรัสหรืออวาตาร์ที่แสดงใต้บทความ"

#. config.profile.bio
#: schema.json
msgctxt "fn"
msgid "Short bio"
msgstr "ประวัติย่อ"

#. config.profile.bio
#: schema.json
msgctxt "fh"
msgid "One sentence about you shown below every post, e.g. I build Laravel apps and write about databases"
msgstr "ประโยคสั้นๆ เกี่ยวกับคุณใต้ทุกบทความ เช่น ฉันสร้างแอป Laravel และเขียนเรื่องฐานข้อมูล"

#. config.profile.email
#: schema.json
msgctxt "fh"
msgid "E-mail address shown in the footer with a copy button"
msgstr "ที่อยู่อีเมลในส่วนท้ายพร้อมปุ่มคัดลอก"

#. config.profile.links
#: schema.json
msgctxt "fn"
msgid "Profiles"
msgstr "โปรไฟล์ออนไลน์"

#. config.profile.links
#: schema.json
msgctxt "fh"
msgid "Links to your profiles shown in the footer, e.g. GitHub, Mastodon or LinkedIn"
msgstr "ลิงก์ไปยังโปรไฟล์ของคุณในส่วนท้าย เช่น GitHub, Mastodon หรือ LinkedIn"

#. config.profile.links.label
#: schema.json
msgctxt "fh"
msgid "Name of the website, e.g. GitHub"
msgstr "ชื่อเว็บไซต์ เช่น GitHub"

#. config.profile.links.url
#: schema.json
msgctxt "fh"
msgid "Link to your profile, e.g. https://github.com/lena"
msgstr "ลิงก์ไปยังโปรไฟล์ของคุณ เช่น https://github.com/lena"

#. config.theme
#: schema.json
msgctxt "st"
msgid "folio::theme"
msgstr "ธีม"

#. config.theme-dark
#: schema.json
msgctxt "st"
msgid "folio::theme-dark"
msgstr "ธีมสีเข้ม"
