#. config.profile
#: schema.json
msgctxt "st"
msgid "folio::profile"
msgstr "Hồ sơ"

#. config.profile.name
#: schema.json
msgctxt "fh"
msgid "Your full name, shown as logo and author of the posts"
msgstr "Họ tên đầy đủ của bạn, hiển thị làm logo và tác giả bài viết"

#. config.profile.job
#: schema.json
msgctxt "fn"
msgid "Job title"
msgstr "Chức danh"

#. config.profile.job
#: schema.json
msgctxt "fh"
msgid "Your role used for search engines, e.g. Staff Engineer"
msgstr "Vai trò của bạn cho công cụ tìm kiếm, ví dụ Staff Engineer"

#. config.profile.company
#: schema.json
msgctxt "fn"
msgid "Company"
msgstr "Công ty"

#. config.profile.company
#: schema.json
msgctxt "fh"
msgid "Company or organization you work for, e.g. Northwind Labs"
msgstr "Công ty hoặc tổ chức bạn làm việc, ví dụ Northwind Labs"

#. config.profile.location
#: schema.json
msgctxt "fh"
msgid "City or region you live in, e.g. Berlin, Germany"
msgstr "Thành phố hoặc khu vực bạn sống, ví dụ Berlin, Đức"

#. config.profile.avatar
#: schema.json
msgctxt "fn"
msgid "Photo"
msgstr "Ảnh"

#. config.profile.avatar
#: schema.json
msgctxt "fh"
msgid "Square photo or avatar of you shown below the posts"
msgstr "Ảnh vuông hoặc avatar của bạn hiển thị dưới bài viết"

#. config.profile.bio
#: schema.json
msgctxt "fn"
msgid "Short bio"
msgstr "Tiểu sử ngắn"

#. config.profile.bio
#: schema.json
msgctxt "fh"
msgid "One sentence about you shown below every post, e.g. I build Laravel apps and write about databases"
msgstr "Một câu về bạn dưới mỗi bài viết, ví dụ Tôi xây dựng ứng dụng Laravel và viết về cơ sở dữ liệu"

#. config.profile.email
#: schema.json
msgctxt "fh"
msgid "E-mail address shown in the footer with a copy button"
msgstr "Địa chỉ e-mail ở chân trang kèm nút sao chép"

#. config.profile.links
#: schema.json
msgctxt "fn"
msgid "Profiles"
msgstr "Hồ sơ trực tuyến"

#. config.profile.links
#: schema.json
msgctxt "fh"
msgid "Links to your profiles shown in the footer, e.g. GitHub, Mastodon or LinkedIn"
msgstr "Liên kết đến hồ sơ của bạn ở chân trang, ví dụ GitHub, Mastodon hoặc LinkedIn"

#. config.profile.links.label
#: schema.json
msgctxt "fh"
msgid "Name of the website, e.g. GitHub"
msgstr "Tên trang web, ví dụ GitHub"

#. config.profile.links.url
#: schema.json
msgctxt "fh"
msgid "Link to your profile, e.g. https://github.com/lena"
msgstr "Liên kết đến hồ sơ của bạn, ví dụ https://github.com/lena"

#. config.theme
#: schema.json
msgctxt "st"
msgid "folio::theme"
msgstr "Giao diện"

#. config.theme-dark
#: schema.json
msgctxt "st"
msgid "folio::theme-dark"
msgstr "Giao diện tối"
