#. config.profile
#: schema.json
msgctxt "st"
msgid "folio::profile"
msgstr "Perfil"

#. config.profile.name
#: schema.json
msgctxt "fh"
msgid "Your full name, shown as logo and author of the posts"
msgstr "Seu nome completo, exibido como logotipo e autor das postagens"

#. config.profile.job
#: schema.json
msgctxt "fn"
msgid "Job title"
msgstr "Cargo"

#. config.profile.job
#: schema.json
msgctxt "fh"
msgid "Your role used for search engines, e.g. Staff Engineer"
msgstr "Sua função, conforme utilizada nos mecanismos de busca, por exemplo, Engenheiro Sênior"

#. config.profile.company
#: schema.json
msgctxt "fn"
msgid "Company"
msgstr "Empresa"

#. config.profile.company
#: schema.json
msgctxt "fh"
msgid "Company or organization you work for, e.g. Northwind Labs"
msgstr "Empresa ou organização para a qual você trabalha, por exemplo, Northwind Labs"

#. config.profile.location
#: schema.json
msgctxt "fn"
msgid "Location"
msgstr "Localização"

#. config.profile.location
#: schema.json
msgctxt "fh"
msgid "City or region you live in, e.g. Berlin, Germany"
msgstr "Cidade ou região onde você mora, por exemplo, Berlim, Alemanha"

#. config.profile.avatar
#: schema.json
msgctxt "fn"
msgid "Photo"
msgstr "Foto"

#. config.profile.avatar
#: schema.json
msgctxt "fh"
msgid "Square photo or avatar of you shown below the posts"
msgstr "Foto quadrada ou avatar seu exibido abaixo das postagens"

#. config.profile.bio
#: schema.json
msgctxt "fn"
msgid "Short bio"
msgstr "Breve biografia"

#. config.profile.bio
#: schema.json
msgctxt "fh"
msgid "One sentence about you shown below every post, e.g. I build Laravel apps and write about databases"
msgstr "Uma frase sobre você exibida abaixo de cada postagem, por exemplo: “Eu desenvolvo aplicativos em Laravel e escrevo sobre bancos de dados”"

#. config.profile.email
#: schema.json
msgctxt "fn"
msgid "E-mail"
msgstr "E-mail"

#. config.profile.email
#: schema.json
msgctxt "fh"
msgid "E-mail address shown in the footer with a copy button"
msgstr "Endereço de e-mail exibido no rodapé com um botão para copiar"

#. config.profile.links
#: schema.json
msgctxt "fn"
msgid "Profiles"
msgstr "Perfis"

#. config.profile.links
#: schema.json
msgctxt "fh"
msgid "Links to your profiles shown in the footer, e.g. GitHub, Mastodon or LinkedIn"
msgstr "Links para seus perfis exibidos no rodapé, por exemplo, GitHub, Mastodon ou LinkedIn"

#. config.profile.links.label
#: schema.json
msgctxt "fh"
msgid "Name of the website, e.g. GitHub"
msgstr "Nome do site, por exemplo, GitHub"

#. config.profile.links.url
#: schema.json
msgctxt "fh"
msgid "Link to your profile, e.g. https://github.com/lena"
msgstr "Link para o seu perfil, por exemplo, https://github.com/lena"

#. config.theme
#: schema.json
msgctxt "st"
msgid "folio::theme"
msgstr "Tema"

#. config.theme.--pico-border-radius
#: schema.json
msgctxt "fh"
msgid "Rounding of corners as CSS length, e.g. 0.5rem or 0 for sharp corners"
msgstr "Arredondamento de cantos como valor de comprimento em CSS, por exemplo, 0.5rem ou 0 para cantos bem definidos"
