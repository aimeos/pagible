#. config.profile
#: schema.json
msgctxt "st"
msgid "folio::profile"
msgstr "פרופיל"

#. config.profile.name
#: schema.json
msgctxt "fh"
msgid "Your full name, shown as logo and author of the posts"
msgstr "השם המלא שלך, מוצג כלוגו וככותב הפוסטים"

#. config.profile.job
#: schema.json
msgctxt "fn"
msgid "Job title"
msgstr "תפקיד"

#. config.profile.job
#: schema.json
msgctxt "fh"
msgid "Your role used for search engines, e.g. Staff Engineer"
msgstr "התפקיד שלך עבור מנועי חיפוש, למשל Staff Engineer"

#. config.profile.company
#: schema.json
msgctxt "fn"
msgid "Company"
msgstr "חברה"

#. config.profile.company
#: schema.json
msgctxt "fh"
msgid "Company or organization you work for, e.g. Northwind Labs"
msgstr "החברה או הארגון שבו אתה עובד, למשל Northwind Labs"

#. config.profile.location
#: schema.json
msgctxt "fh"
msgid "City or region you live in, e.g. Berlin, Germany"
msgstr "העיר או האזור שבו אתה גר, למשל ברלין, גרמניה"

#. config.profile.avatar
#: schema.json
msgctxt "fn"
msgid "Photo"
msgstr "תמונה"

#. config.profile.avatar
#: schema.json
msgctxt "fh"
msgid "Square photo or avatar of you shown below the posts"
msgstr "תמונה ריבועית או אווטאר שלך המוצגים מתחת לפוסטים"

#. config.profile.bio
#: schema.json
msgctxt "fn"
msgid "Short bio"
msgstr "ביוגרפיה קצרה"

#. config.profile.bio
#: schema.json
msgctxt "fh"
msgid "One sentence about you shown below every post, e.g. I build Laravel apps and write about databases"
msgstr "משפט אחד עליך מתחת לכל פוסט, למשל אני בונה אפליקציות Laravel וכותב על מסדי נתונים"

#. config.profile.email
#: schema.json
msgctxt "fh"
msgid "E-mail address shown in the footer with a copy button"
msgstr "כתובת דוא״ל בכותרת התחתונה עם כפתור העתקה"

#. config.profile.links
#: schema.json
msgctxt "fn"
msgid "Profiles"
msgstr "פרופילים"

#. config.profile.links
#: schema.json
msgctxt "fh"
msgid "Links to your profiles shown in the footer, e.g. GitHub, Mastodon or LinkedIn"
msgstr "קישורים לפרופילים שלך בכותרת התחתונה, למשל GitHub, Mastodon או LinkedIn"

#. config.profile.links.label
#: schema.json
msgctxt "fh"
msgid "Name of the website, e.g. GitHub"
msgstr "שם האתר, למשל GitHub"

#. config.profile.links.url
#: schema.json
msgctxt "fh"
msgid "Link to your profile, e.g. https://github.com/lena"
msgstr "קישור לפרופיל שלך, למשל https://github.com/lena"

#. config.theme
#: schema.json
msgctxt "st"
msgid "folio::theme"
msgstr "ערכת נושא"
