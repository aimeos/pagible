#. config.profile
#: schema.json
msgctxt "st"
msgid "folio::profile"
msgstr "Προφίλ"

#. config.profile.name
#: schema.json
msgctxt "fh"
msgid "Your full name, shown as logo and author of the posts"
msgstr "Το πλήρες όνομά σας, εμφανίζεται ως λογότυπο και συγγραφέας των άρθρων"

#. config.profile.job
#: schema.json
msgctxt "fn"
msgid "Job title"
msgstr "Τίτλος θέσης"

#. config.profile.job
#: schema.json
msgctxt "fh"
msgid "Your role used for search engines, e.g. Staff Engineer"
msgstr "Ο ρόλος σας για τις μηχανές αναζήτησης, π.χ. Staff Engineer"

#. config.profile.company
#: schema.json
msgctxt "fn"
msgid "Company"
msgstr "Εταιρεία"

#. config.profile.company
#: schema.json
msgctxt "fh"
msgid "Company or organization you work for, e.g. Northwind Labs"
msgstr "Εταιρεία ή οργανισμός όπου εργάζεστε, π.χ. Northwind Labs"

#. config.profile.location
#: schema.json
msgctxt "fh"
msgid "City or region you live in, e.g. Berlin, Germany"
msgstr "Πόλη ή περιοχή όπου ζείτε, π.χ. Βερολίνο, Γερμανία"

#. config.profile.avatar
#: schema.json
msgctxt "fn"
msgid "Photo"
msgstr "Φωτογραφία"

#. config.profile.avatar
#: schema.json
msgctxt "fh"
msgid "Square photo or avatar of you shown below the posts"
msgstr "Τετράγωνη φωτογραφία ή avatar σας κάτω από τα άρθρα"

#. config.profile.bio
#: schema.json
msgctxt "fn"
msgid "Short bio"
msgstr "Σύντομο βιογραφικό"

#. config.profile.bio
#: schema.json
msgctxt "fh"
msgid "One sentence about you shown below every post, e.g. I build Laravel apps and write about databases"
msgstr "Μία πρόταση για εσάς κάτω από κάθε άρθρο, π.χ. Φτιάχνω εφαρμογές Laravel και γράφω για βάσεις δεδομένων"

#. config.profile.email
#: schema.json
msgctxt "fh"
msgid "E-mail address shown in the footer with a copy button"
msgstr "Διεύθυνση e-mail στο υποσέλιδο με κουμπί αντιγραφής"

#. config.profile.links
#: schema.json
msgctxt "fn"
msgid "Profiles"
msgstr "Προφίλ"

#. config.profile.links
#: schema.json
msgctxt "fh"
msgid "Links to your profiles shown in the footer, e.g. GitHub, Mastodon or LinkedIn"
msgstr "Σύνδεσμοι προς τα προφίλ σας στο υποσέλιδο, π.χ. GitHub, Mastodon ή LinkedIn"

#. config.profile.links.label
#: schema.json
msgctxt "fh"
msgid "Name of the website, e.g. GitHub"
msgstr "Όνομα του ιστότοπου, π.χ. GitHub"

#. config.profile.links.url
#: schema.json
msgctxt "fh"
msgid "Link to your profile, e.g. https://github.com/lena"
msgstr "Σύνδεσμος προς το προφίλ σας, π.χ. https://github.com/lena"

#. config.theme
#: schema.json
msgctxt "st"
msgid "folio::theme"
msgstr "Θέμα"

#. config.theme-dark
#: schema.json
msgctxt "st"
msgid "folio::theme-dark"
msgstr "Σκούρο θέμα"
