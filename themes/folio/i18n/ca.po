#. config.profile
#: schema.json
msgctxt "st"
msgid "folio::profile"
msgstr "Perfil"

#. config.profile.name
#: schema.json
msgctxt "fh"
msgid "Your full name, shown as logo and author of the posts"
msgstr "El teu nom complet, mostrat com a logotip i autor de les publicacions"

#. config.profile.job
#: schema.json
msgctxt "fn"
msgid "Job title"
msgstr "Càrrec"

#. config.profile.job
#: schema.json
msgctxt "fh"
msgid "Your role used for search engines, e.g. Staff Engineer"
msgstr "El teu rol utilitzat per als motors de cerca, p. ex. Enginyer de plantilla"

#. config.profile.company
#: schema.json
msgctxt "fn"
msgid "Company"
msgstr "Empresa"

#. config.profile.company
#: schema.json
msgctxt "fh"
msgid "Company or organization you work for, e.g. Northwind Labs"
msgstr "Empresa o organització per a la qual treballa, p. ex. Northwind Labs"

#. config.profile.location
#: schema.json
msgctxt "fn"
msgid "Location"
msgstr "Ubicació"

#. config.profile.location
#: schema.json
msgctxt "fh"
msgid "City or region you live in, e.g. Berlin, Germany"
msgstr "Ciutat o regió on vius, p. ex. Berlín, Alemanya"

#. config.profile.avatar
#: schema.json
msgctxt "fn"
msgid "Photo"
msgstr "Foto"

#. config.profile.avatar
#: schema.json
msgctxt "fh"
msgid "Square photo or avatar of you shown below the posts"
msgstr "Fotografia quadrada o avatar teu que es mostra a sota de les publicacions."

#. config.profile.bio
#: schema.json
msgctxt "fn"
msgid "Short bio"
msgstr "Biografia breu"

#. config.profile.bio
#: schema.json
msgctxt "fh"
msgid "One sentence about you shown below every post, e.g. I build Laravel apps and write about databases"
msgstr "Una frase sobre tu que es mostra a sota de cada publicació, per exemple: construeixo aplicacions Laravel i escric sobre bases de dades."

#. config.profile.email
#: schema.json
msgctxt "fn"
msgid "E-mail"
msgstr "Correu electrònic"

#. config.profile.email
#: schema.json
msgctxt "fh"
msgid "E-mail address shown in the footer with a copy button"
msgstr "Adreça de correu electrònic que es mostra al peu de pàgina amb un botó de còpia"

#. config.profile.links
#: schema.json
msgctxt "fn"
msgid "Profiles"
msgstr "Perfils"

#. config.profile.links
#: schema.json
msgctxt "fh"
msgid "Links to your profiles shown in the footer, e.g. GitHub, Mastodon or LinkedIn"
msgstr "Enllaços als teus perfils que es mostren al peu de pàgina, p. ex. GitHub, Mastodon o LinkedIn"

#. config.profile.links.label
#: schema.json
msgctxt "fh"
msgid "Name of the website, e.g. GitHub"
msgstr "Nom del lloc web, p. ex. GitHub"

#. config.profile.links.url
#: schema.json
msgctxt "fh"
msgid "Link to your profile, e.g. https://github.com/lena"
msgstr "Enllaç al teu perfil, p. ex. https://github.com/lena"

#. config.theme
#: schema.json
msgctxt "st"
msgid "folio::theme"
msgstr "Tema"

#. config.theme.--pico-border-radius
#: schema.json
msgctxt "fh"
msgid "Rounding of corners as CSS length, e.g. 0.5rem or 0 for sharp corners"
msgstr "Redondatge de cantonades com a longitud en CSS, p. ex. 0.5rem o 0 per a cantonades afilades"
