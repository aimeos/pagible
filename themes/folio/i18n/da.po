msgid "Your full name, shown as logo and author of the posts"
msgstr "Dit fulde navn, vist som logo og forfatter af indlæggene"

#. config.profile.job
#: schema.json
msgctxt "fn"
msgid "Job title"
msgstr "Jobtitel"

#. config.profile.job
#: schema.json
