"Language: ro\n"

#. config.profile
#: schema.json
msgctxt "st"
msgid "folio::profile"
msgstr "Profil"

#. config.profile.name
#: schema.json
msgctxt "fh"
msgid "Your full name, shown as logo and author of the posts"
msgstr "Numele tău complet, afișat ca logo și autor al articolelor"

#. config.profile.job
#: schema.json
msgctxt "fn"
msgid "Job title"
msgstr "Funcție"

#. config.profile.job
#: schema.json
msgctxt "fh"
msgid "Your role used for search engines, e.g. Staff Engineer"
msgstr "Rolul tău pentru motoarele de căutare, de ex. Staff Engineer"

#. config.profile.company
#: schema.json
msgctxt "fn"
msgid "Company"
msgstr "Companie"

#. config.profile.company
#: schema.json
msgctxt "fh"
msgid "Company or organization you work for, e.g. Northwind Labs"
msgstr "Compania sau organizația la care lucrezi, de ex. Northwind Labs"

#. config.profile.location
#: schema.json
msgctxt "fn"
msgid "Location"
msgstr "Locație"

#. config.profile.location
#: schema.json
msgctxt "fh"
msgid "City or region you live in, e.g. Berlin, Germany"
msgstr "Orașul sau regiunea în care locuiești, de ex. Berlin, Germania"

#. config.profile.avatar
#: schema.json
msgctxt "fn"
msgid "Photo"
msgstr "Fotografie"

#. config.profile.avatar
#: schema.json
msgctxt "fh"
msgid "Square photo or avatar of you shown below the posts"
msgstr "Fotografie pătrată sau avatar afișat sub articole"

#. config.profile.bio
#: schema.json
msgctxt "fn"
msgid "Short bio"
msgstr "Scurtă biografie"

#. config.profile.bio
#: schema.json
msgctxt "fh"
msgid "One sentence about you shown below every post, e.g. I build Laravel apps and write about databases"
msgstr "O propoziție despre tine sub fiecare articol, de ex. Construiesc aplicații Laravel și scriu despre baze de date"

#. config.profile.email
#: schema.json
msgctxt "fn"
msgid "E-mail"
msgstr "E-mail"

#. config.profile.email
#: schema.json
msgctxt "fh"
msgid "E-mail address shown in the footer with a copy button"
msgstr "Adresa de e-mail în subsol cu buton de copiere"

#. config.profile.links
#: schema.json
msgctxt "fn"
msgid "Profiles"
msgstr "Profiluri"

#. config.profile.links
#: schema.json
msgctxt "fh"
msgid "Links to your profiles shown in the footer, e.g. GitHub, Mastodon or LinkedIn"
msgstr "Linkuri către profilurile tale în subsol, de ex. GitHub, Mastodon sau LinkedIn"

#. config.profile.links.label
#: schema.json
msgctxt "fh"
msgid "Name of the website, e.g. GitHub"
msgstr "Numele site-ului, de ex. GitHub"

#. config.profile.links.url
#: schema.json
msgctxt "fh"
msgid "Link to your profile, e.g. https://github.com/lena"
msgstr "Link către profilul tău, de ex. https://github.com/lena"

#. config.theme
#: schema.json
msgctxt "st"
msgid "folio::theme"
msgstr "Temă"

#. config.theme.--pico-border-radius
#: schema.json
msgctxt "fh"
msgid "Rounding of corners as CSS length, e.g. 0.5rem or 0 for sharp corners"
msgstr "Rotunjirea colțurilor ca valoare de lungime CSS, de exemplu 0.5rem sau 0 pentru colțuri ascuțite"
