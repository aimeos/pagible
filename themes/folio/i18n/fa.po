#. config.profile
#: schema.json
msgctxt "st"
msgid "folio::profile"
msgstr "پروفایل"

#. config.profile.name
#: schema.json
msgctxt "fh"
msgid "Your full name, shown as logo and author of the posts"
msgstr "نام کامل شما، نمایش داده شده به‌عنوان لوگو و نویسندهٔ پست‌ها"

#. config.profile.job
#: schema.json
msgctxt "fn"
msgid "Job title"
msgstr "عنوان شغلی"

#. config.profile.job
#: schema.json
msgctxt "fh"
msgid "Your role used for search engines, e.g. Staff Engineer"
msgstr "نقش شما برای موتورهای جستجو، مثلاً مهندس کارمند"

#. config.profile.company
#: schema.json
msgctxt "fn"
msgid "Company"
msgstr "شرکت"

#. config.profile.company
#: schema.json
msgctxt "fh"
msgid "Company or organization you work for, e.g. Northwind Labs"
msgstr "شرکت یا سازمانی که برای آن کار می‌کنید، مثلاً نورث‌ویند لبز"

#. config.profile.location
#: schema.json
msgctxt "fh"
msgid "City or region you live in, e.g. Berlin, Germany"
msgstr "شهر یا منطقه‌ای که در آن زندگی می‌کنید، مثلاً برلین، آلمان"

#. config.profile.avatar
#: schema.json
msgctxt "fn"
msgid "Photo"
msgstr "عکس"

#. config.profile.avatar
#: schema.json
msgctxt "fh"
msgid "Square photo or avatar of you shown below the posts"
msgstr "عکس مربعی یا آواتار شما زیر پست‌ها نمایش داده می‌شود."

#. config.profile.bio
#: schema.json
msgctxt "fn"
msgid "Short bio"
msgstr "زندگی‌نامهٔ کوتاه"

#. config.profile.bio
#: schema.json
msgctxt "fh"
msgid "One sentence about you shown below every post, e.g. I build Laravel apps and write about databases"
msgstr "یک جمله دربارهٔ شما که در زیر هر پست نمایش داده می‌شود، مثلاً: من اپلیکیشن‌های لاراول می‌سازم و دربارهٔ پایگاه‌های داده می‌نویسم."

#. config.profile.email
#: schema.json
msgctxt "fh"
msgid "E-mail address shown in the footer with a copy button"
msgstr "نشانی ایمیل در فوتر همراه با دکمهٔ ارسال کپی نمایش داده می‌شود."

#. config.profile.links
#: schema.json
msgctxt "fn"
msgid "Profiles"
msgstr "پروفایل‌ها"

#. config.profile.links
#: schema.json
msgctxt "fh"
msgid "Links to your profiles shown in the footer, e.g. GitHub, Mastodon or LinkedIn"
msgstr "لینک‌های پروفایل‌های شما که در فوتر نمایش داده می‌شوند، مانند گیت‌هاب، ماستودون یا لینکدین"

#. config.profile.links.label
#: schema.json
msgctxt "fh"
msgid "Name of the website, e.g. GitHub"
msgstr "نام وب‌سایت، مثلاً گیت‌هاب"

#. config.profile.links.url
#: schema.json
msgctxt "fh"
msgid "Link to your profile, e.g. https://github.com/lena"
msgstr "لینک پروفایل شما، مثلاً https://github.com/lena"

#. config.theme
#: schema.json
msgctxt "st"
msgid "folio::theme"
msgstr "پوسته"

#. config.theme-dark
#: schema.json
msgctxt "st"
msgid "folio::theme-dark"
msgstr "پوسته تیره"
