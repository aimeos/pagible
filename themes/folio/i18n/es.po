#. config.profile
#: schema.json
msgctxt "st"
msgid "folio::profile"
msgstr "Perfil"

#. config.profile.name
#: schema.json
msgctxt "fh"
msgid "Your full name, shown as logo and author of the posts"
msgstr "Tu nombre completo, mostrado como logo y autor de los artículos"

#. config.profile.job
#: schema.json
msgctxt "fn"
msgid "Job title"
msgstr "Cargo"

#. config.profile.job
#: schema.json
msgctxt "fh"
msgid "Your role used for search engines, e.g. Staff Engineer"
msgstr "Tu rol para los buscadores, p. ej. Staff Engineer"

#. config.profile.company
#: schema.json
msgctxt "fn"
msgid "Company"
msgstr "Empresa"

#. config.profile.company
#: schema.json
msgctxt "fh"
msgid "Company or organization you work for, e.g. Northwind Labs"
msgstr "Empresa u organización en la que trabajas, p. ej. Northwind Labs"

#. config.profile.location
#: schema.json
msgctxt "fn"
msgid "Location"
msgstr "Ubicación"

#. config.profile.location
#: schema.json
msgctxt "fh"
msgid "City or region you live in, e.g. Berlin, Germany"
msgstr "Ciudad o región donde vives, p. ej. Berlín, Alemania"

#. config.profile.avatar
#: schema.json
msgctxt "fn"
msgid "Photo"
msgstr "Foto"

#. config.profile.avatar
#: schema.json
msgctxt "fh"
msgid "Square photo or avatar of you shown below the posts"
msgstr "Foto cuadrada o avatar tuyo mostrado bajo los artículos"

#. config.profile.bio
#: schema.json
msgctxt "fn"
msgid "Short bio"
msgstr "Biografía breve"

#. config.profile.bio
#: schema.json
msgctxt "fh"
msgid "One sentence about you shown below every post, e.g. I build Laravel apps and write about databases"
msgstr "Una frase sobre ti bajo cada artículo, p. ej. Creo apps con Laravel y escribo sobre bases de datos"

#. config.profile.email
#: schema.json
msgctxt "fn"
msgid "E-mail"
msgstr "Correo electrónico"

#. config.profile.email
#: schema.json
msgctxt "fh"
msgid "E-mail address shown in the footer with a copy button"
msgstr "Dirección de correo en el pie de página con botón de copiar"

#. config.profile.links
#: schema.json
msgctxt "fn"
msgid "Profiles"
msgstr "Perfiles"

#. config.profile.links
#: schema.json
msgctxt "fh"
msgid "Links to your profiles shown in the footer, e.g. GitHub, Mastodon or LinkedIn"
msgstr "Enlaces a tus perfiles en el pie de página, p. ej. GitHub, Mastodon o LinkedIn"

#. config.profile.links.label
#: schema.json
msgctxt "fh"
msgid "Name of the website, e.g. GitHub"
msgstr "Nombre del sitio web, p. ej. GitHub"

#. config.profile.links.url
#: schema.json
msgctxt "fh"
msgid "Link to your profile, e.g. https://github.com/lena"
msgstr "Enlace a tu perfil, p. ej. https://github.com/lena"

#. config.theme
#: schema.json
msgctxt "st"
msgid "folio::theme"
msgstr "Tema"

#. config.theme.--pico-border-radius
#: schema.json
msgctxt "fh"
msgid "Rounding of corners as CSS length, e.g. 0.5rem or 0 for sharp corners"
msgstr "Redondeo de esquinas como longitud CSS; por ejemplo, 0.5rem o 0 para esquinas afiladas"
