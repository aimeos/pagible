#. config.profile
#: schema.json
msgctxt "st"
msgid "folio::profile"
msgstr "個人資料"

#. config.profile.name
#: schema.json
msgctxt "fh"
msgid "Your full name, shown as logo and author of the posts"
msgstr "您的全名，將作為貼文的標誌及作者顯示"

#. config.profile.job
#: schema.json
msgctxt "fn"
msgid "Job title"
msgstr "職稱"

#. config.profile.job
#: schema.json
msgctxt "fh"
msgid "Your role used for search engines, e.g. Staff Engineer"
msgstr "您在搜尋引擎領域所擔任的職務，例如：資深工程師"

#. config.profile.company
#: schema.json
msgctxt "fn"
msgid "Company"
msgstr "公司"

#. config.profile.company
#: schema.json
msgctxt "fh"
msgid "Company or organization you work for, e.g. Northwind Labs"
msgstr "您任職的公司或組織，例如 Northwind Labs"

#. config.profile.location
#: schema.json
msgctxt "fh"
msgid "City or region you live in, e.g. Berlin, Germany"
msgstr "您居住的城市或地區，例如：德國柏林"

#. config.profile.avatar
#: schema.json
msgctxt "fn"
msgid "Photo"
msgstr "照片"

#. config.profile.avatar
#: schema.json
msgctxt "fh"
msgid "Square photo or avatar of you shown below the posts"
msgstr "貼文下方顯示您的方形照片或大頭貼"

#. config.profile.bio
#: schema.json
msgctxt "fn"
msgid "Short bio"
msgstr "簡介"

#. config.profile.bio
#: schema.json
msgctxt "fh"
msgid "One sentence about you shown below every post, e.g. I build Laravel apps and write about databases"
msgstr "每篇貼文下方會顯示一句關於你的簡介，例如：我開發 Laravel 應用程式，並撰寫關於資料庫的文章"

#. config.profile.email
#: schema.json
msgctxt "fh"
msgid "E-mail address shown in the footer with a copy button"
msgstr "頁尾顯示的電子郵件地址，並附有「複製」按鈕"

#. config.profile.links
#: schema.json
msgctxt "fn"
msgid "Profiles"
msgstr "個人檔案"

#. config.profile.links
#: schema.json
msgctxt "fh"
msgid "Links to your profiles shown in the footer, e.g. GitHub, Mastodon or LinkedIn"
msgstr "頁尾處顯示的個人檔案連結，例如 GitHub、Mastodon 或 LinkedIn"

#. config.profile.links.label
#: schema.json
msgctxt "fh"
msgid "Name of the website, e.g. GitHub"
msgstr "網站名稱，例如 GitHub"

#. config.profile.links.url
#: schema.json
msgctxt "fh"
msgid "Link to your profile, e.g. https://github.com/lena"
msgstr "您的個人檔案連結，例如：https://github.com/lena"

#. config.theme
#: schema.json
msgctxt "st"
msgid "folio::theme"
msgstr "主題"
