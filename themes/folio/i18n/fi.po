#. config.profile
#: schema.json
msgctxt "st"
msgid "folio::profile"
msgstr "Profiili"

#. config.profile.name
#: schema.json
msgctxt "fh"
msgid "Your full name, shown as logo and author of the posts"
msgstr "Koko nimesi, näytetään logona ja kirjoitusten kirjoittajana"

#. config.profile.job
#: schema.json
msgctxt "fn"
msgid "Job title"
msgstr "Työnimike"

#. config.profile.job
#: schema.json
msgctxt "fh"
msgid "Your role used for search engines, e.g. Staff Engineer"
msgstr "Roolisi hakukoneille, esim. Staff Engineer"

#. config.profile.company
#: schema.json
msgctxt "fn"
msgid "Company"
msgstr "Yritys"

#. config.profile.company
#: schema.json
msgctxt "fh"
msgid "Company or organization you work for, e.g. Northwind Labs"
msgstr "Yritys tai organisaatio, jossa työskentelet, esim. Northwind Labs"

#. config.profile.location
#: schema.json
msgctxt "fh"
msgid "City or region you live in, e.g. Berlin, Germany"
msgstr "Kaupunki tai alue, jossa asut, esim. Berliini, Saksa"

#. config.profile.avatar
#: schema.json
msgctxt "fn"
msgid "Photo"
msgstr "Kuva"

#. config.profile.avatar
#: schema.json
msgctxt "fh"
msgid "Square photo or avatar of you shown below the posts"
msgstr "Neliön muotoinen kuva tai avatar kirjoitusten alla"

#. config.profile.bio
#: schema.json
msgctxt "fn"
msgid "Short bio"
msgstr "Lyhyt esittely"

#. config.profile.bio
#: schema.json
msgctxt "fh"
msgid "One sentence about you shown below every post, e.g. I build Laravel apps and write about databases"
msgstr "Yksi lause sinusta jokaisen kirjoituksen alla, esim. Rakennan Laravel-sovelluksia ja kirjoitan tietokannoista"

#. config.profile.email
#: schema.json
msgctxt "fh"
msgid "E-mail address shown in the footer with a copy button"
msgstr "Sähköpostiosoite alatunnisteessa kopiointipainikkeen kanssa"

#. config.profile.links
#: schema.json
msgctxt "fn"
msgid "Profiles"
msgstr "Profiilit"

#. config.profile.links
#: schema.json
msgctxt "fh"
msgid "Links to your profiles shown in the footer, e.g. GitHub, Mastodon or LinkedIn"
msgstr "Linkit profiileihisi alatunnisteessa, esim. GitHub, Mastodon tai LinkedIn"

#. config.profile.links.label
#: schema.json
msgctxt "fh"
msgid "Name of the website, e.g. GitHub"
msgstr "Sivuston nimi, esim. GitHub"

#. config.profile.links.url
#: schema.json
msgctxt "fh"
msgid "Link to your profile, e.g. https://github.com/lena"
msgstr "Linkki profiiliisi, esim. https://github.com/lena"

#. config.theme
#: schema.json
msgctxt "st"
msgid "folio::theme"
msgstr "Teema"
