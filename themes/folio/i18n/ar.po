#. config.profile
#: schema.json
msgctxt "st"
msgid "folio::profile"
msgstr "الملف الشخصي"

#. config.profile.name
#: schema.json
msgctxt "fh"
msgid "Your full name, shown as logo and author of the posts"
msgstr "اسمك الكامل، يظهر كشعار وكاتب للمقالات"

#. config.profile.job
#: schema.json
msgctxt "fn"
msgid "Job title"
msgstr "المسمى الوظيفي"

#. config.profile.job
#: schema.json
msgctxt "fh"
msgid "Your role used for search engines, e.g. Staff Engineer"
msgstr "دورك لمحركات البحث، مثل Staff Engineer"

#. config.profile.company
#: schema.json
msgctxt "fn"
msgid "Company"
msgstr "الشركة"

#. config.profile.company
#: schema.json
msgctxt "fh"
msgid "Company or organization you work for, e.g. Northwind Labs"
msgstr "الشركة أو المؤسسة التي تعمل بها، مثل Northwind Labs"

#. config.profile.location
#: schema.json
msgctxt "fh"
msgid "City or region you live in, e.g. Berlin, Germany"
msgstr "المدينة أو المنطقة التي تعيش فيها، مثل برلين، ألمانيا"

#. config.profile.avatar
#: schema.json
msgctxt "fn"
msgid "Photo"
msgstr "الصورة"

#. config.profile.avatar
#: schema.json
msgctxt "fh"
msgid "Square photo or avatar of you shown below the posts"
msgstr "صورة مربعة أو صورة رمزية لك تظهر أسفل المقالات"

#. config.profile.bio
#: schema.json
msgctxt "fn"
msgid "Short bio"
msgstr "نبذة قصيرة"

#. config.profile.bio
#: schema.json
msgctxt "fh"
msgid "One sentence about you shown below every post, e.g. I build Laravel apps and write about databases"
msgstr "جملة واحدة عنك تظهر أسفل كل مقال، مثل أبني تطبيقات Laravel وأكتب عن قواعد البيانات"

#. config.profile.email
#: schema.json
msgctxt "fh"
msgid "E-mail address shown in the footer with a copy button"
msgstr "عنوان البريد الإلكتروني في التذييل مع زر نسخ"

#. config.profile.links
#: schema.json
msgctxt "fn"
msgid "Profiles"
msgstr "الحسابات"

#. config.profile.links
#: schema.json
msgctxt "fh"
msgid "Links to your profiles shown in the footer, e.g. GitHub, Mastodon or LinkedIn"
msgstr "روابط حساباتك في التذييل، مثل GitHub أو Mastodon أو LinkedIn"

#. config.profile.links.label
#: schema.json
msgctxt "fh"
msgid "Name of the website, e.g. GitHub"
msgstr "اسم الموقع، مثل GitHub"

#. config.profile.links.url
#: schema.json
msgctxt "fh"
msgid "Link to your profile, e.g. https://github.com/lena"
msgstr "رابط حسابك، مثل https://github.com/lena"

#. config.theme
#: schema.json
msgctxt "st"
msgid "folio::theme"
msgstr "المظهر"
