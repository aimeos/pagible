#. config.profile
#: schema.json
msgctxt "st"
msgid "folio::profile"
msgstr "プロフィール"

#. config.profile.name
#: schema.json
msgctxt "fh"
msgid "Your full name, shown as logo and author of the posts"
msgstr "フルネーム。ロゴと記事の著者として表示されます"

#. config.profile.job
#: schema.json
msgctxt "fn"
msgid "Job title"
msgstr "役職"

#. config.profile.job
#: schema.json
msgctxt "fh"
msgid "Your role used for search engines, e.g. Staff Engineer"
msgstr "検索エンジン向けの役職。例: Staff Engineer"

#. config.profile.company
#: schema.json
msgctxt "fn"
msgid "Company"
msgstr "会社"

#. config.profile.company
#: schema.json
msgctxt "fh"
msgid "Company or organization you work for, e.g. Northwind Labs"
msgstr "勤務先の会社または組織。例: Northwind Labs"

#. config.profile.location
#: schema.json
msgctxt "fh"
msgid "City or region you live in, e.g. Berlin, Germany"
msgstr "住んでいる都市または地域。例: ドイツ、ベルリン"

#. config.profile.avatar
#: schema.json
msgctxt "fn"
msgid "Photo"
msgstr "写真"

#. config.profile.avatar
#: schema.json
msgctxt "fh"
msgid "Square photo or avatar of you shown below the posts"
msgstr "記事の下に表示される正方形の写真またはアバター"

#. config.profile.bio
#: schema.json
msgctxt "fn"
msgid "Short bio"
msgstr "短い自己紹介"

#. config.profile.bio
#: schema.json
msgctxt "fh"
msgid "One sentence about you shown below every post, e.g. I build Laravel apps and write about databases"
msgstr "各記事の下に表示される一文の自己紹介。例: Laravelアプリを作り、データベースについて書いています"

#. config.profile.email
#: schema.json
msgctxt "fh"
msgid "E-mail address shown in the footer with a copy button"
msgstr "コピーボタン付きでフッターに表示されるメールアドレス"

#. config.profile.links
#: schema.json
msgctxt "fn"
msgid "Profiles"
msgstr "プロフィールリンク"

#. config.profile.links
#: schema.json
msgctxt "fh"
msgid "Links to your profiles shown in the footer, e.g. GitHub, Mastodon or LinkedIn"
msgstr "フッターに表示されるプロフィールへのリンク。例: GitHub、Mastodon、LinkedIn"

#. config.profile.links.label
#: schema.json
msgctxt "fh"
msgid "Name of the website, e.g. GitHub"
msgstr "ウェブサイト名。例: GitHub"

#. config.profile.links.url
#: schema.json
msgctxt "fh"
msgid "Link to your profile, e.g. https://github.com/lena"
msgstr "プロフィールへのリンク。例: https://github.com/lena"

#. config.theme
#: schema.json
msgctxt "st"
msgid "folio::theme"
msgstr "テーマ"

#. config.theme-dark
#: schema.json
msgctxt "st"
msgid "folio::theme-dark"
msgstr "ダークテーマ"
