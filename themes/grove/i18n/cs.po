#. config.garden
#: schema.json
msgctxt "st"
msgid "grove::garden"
msgstr "Zahrada"

#. config.garden.name
#: schema.json
msgctxt "fh"
msgid "Name of the gardening, landscaping or garden design business"
msgstr "Název zahradnické, krajinářské nebo zahradně-architektonické firmy"

#. config.garden.business-type
#: schema.json
msgctxt "op"
msgid "Gardener and landscaper"
msgstr "Zahradník a krajinář"

#. config.garden.business-type
#: schema.json
msgctxt "op"
msgid "Landscape contractor"
msgstr "Firma pro zakládání zeleně"

#. config.garden.business-type
#: schema.json
msgctxt "op"
msgid "Garden design studio"
msgstr "Studio zahradní architektury"

#. config.garden.business-type
#: schema.json
msgctxt "op"
msgid "Garden centre or nursery"
msgstr "Zahradní centrum nebo školka"

#. config.garden.business-type
#: schema.json
msgctxt "op"
msgid "Other garden business"
msgstr "Jiná zahradnická firma"

#. config.garden.areas
#: schema.json
msgctxt "fn"
msgid "Service area"
msgstr "Oblast působnosti"

#. config.garden.areas
#: schema.json
msgctxt "fh"
msgid "Towns and areas you work in, separated by commas, shown in the top bar and the footer"
msgstr "Obce a oblasti, kde pracujete, oddělené čárkami; zobrazují se v horní liště a v patičce"

#. config.garden.email
#: schema.json
msgctxt "fh"
msgid "Email address for quotes, site visits and garden care enquiries"
msgstr "E-mailová adresa pro poptávky, prohlídky na místě a dotazy k péči o zahradu"

#. config.garden.announcement
#: schema.json
msgctxt "fh"
msgid "Short note shown at the top of every page, e.g. Autumn tidy-ups: book your slot before November"
msgstr "Krátké oznámení v horní části každé stránky, např. Podzimní úklid zahrady: rezervujte si termín do listopadu"

#. config.garden.quote
#: schema.json
msgctxt "fn"
msgid "Quote link"
msgstr "Odkaz na cenovou nabídku"

#. config.garden.quote
#: schema.json
msgctxt "fh"
msgid "Link to the quote or site visit request page, shown as a button in the header"
msgstr "Odkaz na stránku pro poptávku nabídky nebo prohlídky, zobrazený jako tlačítko v záhlaví"

#. config.garden.plans
#: schema.json
msgctxt "fn"
msgid "Care plans link"
msgstr "Odkaz na plány péče"

#. config.garden.plans
#: schema.json
msgctxt "fh"
msgid "Link to the page with garden care plans and prices"
msgstr "Odkaz na stránku s plány péče o zahradu a ceníkem"

#. config.garden.notice
#: schema.json
msgctxt "fh"
msgid "Short note shown in the footer, e.g. Fully insured, all planting comes with a 12 month guarantee."
msgstr "Krátká poznámka v patičce, např. Plně pojištěno, na veškerou výsadbu poskytujeme 12měsíční záruku."

#. config.garden.action-bar
#: schema.json
msgctxt "fh"
msgid "Show call and quote buttons at the bottom of the screen on phones"
msgstr "Zobrazit na telefonech tlačítka pro volání a nabídku ve spodní části obrazovky"

#. config.garden.hours
#: schema.json
msgctxt "fn"
msgid "Office hours"
msgstr "Provozní doba"

#. config.garden.hours
#: schema.json
msgctxt "fh"
msgid "Office hours for each day of the week"
msgstr "Úřední hodiny pro každý den v týdnu"

#. config.theme
#: schema.json
msgctxt "st"
msgid "grove::theme"
msgstr "Vzhled"
