#: schema.json
msgctxt "op"
msgid "Other garden business"
msgstr "その他の園芸関連事業"

#. config.garden.areas
#: schema.json
msgctxt "fn"
msgid "Service area"
msgstr "対応エリア"

#. config.garden.areas
#: schema.json
msgctxt "fh"
msgid "Towns and areas you work in, separated by commas, shown in the top bar and the footer"
msgstr "対応している地域をカンマ区切りで入力。上部バーとフッターに表示されます"

#. config.garden.email
#: schema.json
msgctxt "fh"
msgid "Email address for quotes, site visits and garden care enquiries"
msgstr "見積もり、現地調査、庭のお手入れに関するお問い合わせ用のメールアドレス"

#. config.garden.announcement
#: schema.json
msgctxt "fh"
msgid "Short note shown at the top of every page, e.g. Autumn tidy-ups: book your slot before November"
msgstr "全ページの上部に表示される短いお知らせ（例：秋の庭木手入れ、11月までにご予約ください）"

#. config.garden.quote
#: schema.json
msgctxt "fn"
msgid "Quote link"
msgstr "見積もりリンク"

#. config.garden.quote
#: schema.json
msgctxt "fh"
msgid "Link to the quote or site visit request page, shown as a button in the header"
msgstr "見積もり・現地調査の依頼ページへのリンク。ヘッダーにボタンとして表示されます"

#. config.garden.plans
#: schema.json
msgctxt "fn"
msgid "Care plans link"
msgstr "お手入れプランのリンク"

#. config.garden.plans
#: schema.json
msgctxt "fh"
msgid "Link to the page with garden care plans and prices"
msgstr "庭のお手入れプランと料金を掲載したページへのリンク"

#. config.garden.notice
#: schema.json
msgctxt "fh"
msgid "Short note shown in the footer, e.g. Fully insured, all planting comes with a 12 month guarantee."
msgstr "フッターに表示される短い説明（例：損害保険加入済み。植栽はすべて12か月保証付きです。）"

#. config.garden.action-bar
#: schema.json
msgctxt "fh"
msgid "Show call and quote buttons at the bottom of the screen on phones"
msgstr "スマートフォンで画面下部に電話・見積もりボタンを表示する"

#. config.garden.hours
#: schema.json
msgctxt "fn"
msgid "Office hours"
msgstr "営業時間"

#. config.garden.hours
#: schema.json
msgctxt "fh"
msgid "Office hours for each day of the week"
msgstr "各曜日の事務所の営業時間"

