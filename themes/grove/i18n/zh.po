msgstr "园艺中心或苗圃"

#. config.garden.business-type
#: schema.json
msgctxt "op"
msgid "Other garden business"
msgstr "其他园艺企业"

#. config.garden.areas
#: schema.json
msgctxt "fn"
msgid "Service area"
msgstr "服务区域"

#. config.garden.areas
#: schema.json
msgctxt "fh"
msgid "Towns and areas you work in, separated by commas, shown in the top bar and the footer"
msgstr "您提供服务的城镇和区域，用逗号分隔，显示在顶部栏和页脚中"

#. config.garden.email
#: schema.json
msgctxt "fh"
msgid "Email address for quotes, site visits and garden care enquiries"
msgstr "用于报价、上门勘察和园艺养护咨询的电子邮箱地址"

#. config.garden.announcement
#: schema.json
msgctxt "fh"
msgid "Short note shown at the top of every page, e.g. Autumn tidy-ups: book your slot before November"
msgstr "显示在每个页面顶部的简短通知，例如：秋季花园清理，请在 11 月前预约"

#. config.garden.quote
#: schema.json
msgctxt "fn"
msgid "Quote link"
msgstr "报价链接"

#. config.garden.quote
#: schema.json
msgctxt "fh"
msgid "Link to the quote or site visit request page, shown as a button in the header"
msgstr "报价或上门勘察申请页面的链接，以按钮形式显示在页眉中"

#. config.garden.plans
#: schema.json
msgctxt "fn"
msgid "Care plans link"
msgstr "养护套餐链接"

#. config.garden.plans
#: schema.json
msgctxt "fh"
msgid "Link to the page with garden care plans and prices"
msgstr "介绍园艺养护套餐及价格的页面链接"

#. config.garden.notice
#: schema.json
msgctxt "fh"
msgid "Short note shown in the footer, e.g. Fully insured, all planting comes with a 12 month guarantee."
msgstr "显示在页脚中的简短说明，例如：全面投保，所有种植均提供 12 个月质保。"

#. config.garden.action-bar
#: schema.json
msgctxt "fh"
msgid "Show call and quote buttons at the bottom of the screen on phones"
msgstr "在手机屏幕底部显示致电和报价按钮"

#. config.garden.hours
#: schema.json
msgctxt "fn"
msgid "Office hours"
msgstr "办公时间"

#. config.garden.hours
#: schema.json
msgctxt "fh"
msgid "Office hours for each day of the week"
msgstr "每周各天的办公时间"

