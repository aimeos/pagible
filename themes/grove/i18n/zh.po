msgid "grove::garden"
msgstr "花园"

#. config.garden.name
#: schema.json
msgctxt "fh"
msgid "Name of the gardening, landscaping or garden design business"
msgstr "园艺、景观或花园设计公司的名称"

#. config.garden.business-type
#: schema.json
msgctxt "op"
msgid "Gardener and landscaper"
msgstr "园丁与景观工"

#. config.garden.business-type
#: schema.json
msgctxt "op"
msgid "Landscape contractor"
msgstr "景观工程承包商"

#. config.garden.business-type
#: schema.json
