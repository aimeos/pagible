#. config.garden
#: schema.json
msgctxt "st"
msgid "grove::garden"
msgstr "Jardim"

#. config.garden.name
#: schema.json
msgctxt "fh"
msgid "Name of the gardening, landscaping or garden design business"
msgstr "Nome da empresa de jardinagem, paisagismo ou projeto de jardins"

#. config.garden.business-type
#: schema.json
msgctxt "op"
msgid "Gardener and landscaper"
msgstr "Jardineiro e paisagista"

#. config.garden.business-type
#: schema.json
msgctxt "op"
msgid "Landscape contractor"
msgstr "Empresa de paisagismo"

#. config.garden.business-type
#: schema.json
msgctxt "op"
msgid "Garden design studio"
msgstr "Estúdio de paisagismo"

#. config.garden.business-type
#: schema.json
msgctxt "op"
msgid "Garden centre or nursery"
msgstr "Centro de jardinagem ou viveiro"

#. config.garden.business-type
#: schema.json
msgctxt "op"
msgid "Other garden business"
msgstr "Outros negócios relacionados a jardinagem"

#. config.garden.areas
#: schema.json
msgctxt "fn"
msgid "Service area"
msgstr "Área de atendimento"

#. config.garden.areas
#: schema.json
msgctxt "fh"
msgid "Towns and areas you work in, separated by commas, shown in the top bar and the footer"
msgstr "Cidades e regiões em que você trabalha, separadas por vírgulas, exibidas na barra superior e no rodapé"

#. config.garden.email
#: schema.json
msgctxt "fh"
msgid "Email address for quotes, site visits and garden care enquiries"
msgstr "Endereço de e-mail para orçamentos, visitas ao local e consultas sobre cuidados com o jardim"

#. config.garden.announcement
#: schema.json
msgctxt "fh"
msgid "Short note shown at the top of every page, e.g. Autumn tidy-ups: book your slot before November"
msgstr "Breve nota exibida no topo de cada página, por exemplo: Limpezas de outono: agende seu horário antes de novembro"

#. config.garden.quote
#: schema.json
msgctxt "fn"
msgid "Quote link"
msgstr "Link de orçamento"

#. config.garden.quote
#: schema.json
msgctxt "fh"
msgid "Link to the quote or site visit request page, shown as a button in the header"
msgstr "Link para a página de solicitação de orçamento ou visita ao local, exibido como um botão no cabeçalho"

#. config.garden.plans
#: schema.json
msgctxt "fn"
msgid "Care plans link"
msgstr "Link para planos de manutenção"

#. config.garden.plans
#: schema.json
msgctxt "fh"
msgid "Link to the page with garden care plans and prices"
msgstr "Link para a página com planos de manutenção de jardins e preços"

#. config.garden.notice
#: schema.json
msgctxt "fh"
msgid "Short note shown in the footer, e.g. Fully insured, all planting comes with a 12 month guarantee."
msgstr "Breve nota exibida no rodapé, por exemplo: “Totalmente coberto por seguro; todas as plantas têm garantia de 12 meses.”"

#. config.garden.action-bar
#: schema.json
msgctxt "fh"
msgid "Show call and quote buttons at the bottom of the screen on phones"
msgstr "Exibir os botões “Ligar” e “Orçar” na parte inferior da tela em celulares"

#. config.garden.hours
#: schema.json
msgctxt "fn"
msgid "Office hours"
msgstr "Horário de atendimento"

#. config.garden.hours
#: schema.json
msgctxt "fh"
msgid "Office hours for each day of the week"
msgstr "Horário de atendimento para cada dia da semana"

#. config.theme
#: schema.json
msgctxt "st"
msgid "grove::theme"
msgstr "Tema"
