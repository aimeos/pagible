#. config.garden
#: schema.json
msgctxt "st"
msgid "grove::garden"
msgstr "Bahçe"

#. config.garden.name
#: schema.json
msgctxt "fh"
msgid "Name of the gardening, landscaping or garden design business"
msgstr "Bahçıvanlık, peyzaj veya bahçe tasarımı işletmesinin adı"

#. config.garden.business-type
#: schema.json
msgctxt "op"
msgid "Gardener and landscaper"
msgstr "Bahçıvan ve peyzajcı"

#. config.garden.business-type
#: schema.json
msgctxt "op"
msgid "Landscape contractor"
msgstr "Peyzaj müteahhidi"

#. config.garden.business-type
#: schema.json
msgctxt "op"
msgid "Garden design studio"
msgstr "Bahçe tasarım stüdyosu"

#. config.garden.business-type
#: schema.json
msgctxt "op"
msgid "Garden centre or nursery"
msgstr "Bahçe merkezi veya fidanlık"

#. config.garden.business-type
#: schema.json
msgctxt "op"
msgid "Other garden business"
msgstr "Diğer bahçe işletmesi"

#. config.garden.areas
#: schema.json
msgctxt "fn"
msgid "Service area"
msgstr "Hizmet bölgesi"

#. config.garden.areas
#: schema.json
msgctxt "fh"
msgid "Towns and areas you work in, separated by commas, shown in the top bar and the footer"
msgstr "Çalıştığınız yerleşim yerleri ve bölgeler, virgülle ayrılmış; üst çubukta ve alt bilgide gösterilir"

#. config.garden.email
#: schema.json
msgctxt "fh"
msgid "Email address for quotes, site visits and garden care enquiries"
msgstr "Teklif, yerinde keşif ve bahçe bakımı talepleri için e-posta adresi"

#. config.garden.announcement
#: schema.json
msgctxt "fh"
msgid "Short note shown at the top of every page, e.g. Autumn tidy-ups: book your slot before November"
msgstr "Her sayfanın üstünde gösterilen kısa duyuru, ör. Sonbahar bahçe temizliği: Kasım'dan önce yerinizi ayırtın"

#. config.garden.quote
#: schema.json
msgctxt "fn"
msgid "Quote link"
msgstr "Teklif bağlantısı"

#. config.garden.quote
#: schema.json
msgctxt "fh"
msgid "Link to the quote or site visit request page, shown as a button in the header"
msgstr "Teklif veya yerinde keşif talep sayfasının bağlantısı, üst bilgide düğme olarak gösterilir"

#. config.garden.plans
#: schema.json
msgctxt "fn"
msgid "Care plans link"
msgstr "Bakım paketleri bağlantısı"

#. config.garden.plans
#: schema.json
msgctxt "fh"
msgid "Link to the page with garden care plans and prices"
msgstr "Bahçe bakım paketlerinin ve fiyatlarının yer aldığı sayfanın bağlantısı"

#. config.garden.notice
#: schema.json
msgctxt "fh"
msgid "Short note shown in the footer, e.g. Fully insured, all planting comes with a 12 month guarantee."
msgstr "Alt bilgide gösterilen kısa not, ör. Tam sigortalıyız, tüm dikimlerde 12 ay garanti veriyoruz."

#. config.garden.action-bar
#: schema.json
msgctxt "fh"
msgid "Show call and quote buttons at the bottom of the screen on phones"
msgstr "Telefonlarda ekranın altında arama ve teklif düğmelerini göster"

#. config.garden.hours
#: schema.json
msgctxt "fn"
msgid "Office hours"
msgstr "Çalışma saatleri"

#. config.garden.hours
#: schema.json
msgctxt "fh"
msgid "Office hours for each day of the week"
msgstr "Haftanın her günü için büro çalışma saatleri"

#. config.theme
#: schema.json
msgctxt "st"
msgid "grove::theme"
msgstr "Tema"
