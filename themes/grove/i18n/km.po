#. config.garden
#: schema.json
msgctxt "st"
msgid "grove::garden"
msgstr "សួនច្បារ"

#. config.garden.name
#: schema.json
msgctxt "fh"
msgid "Name of the gardening, landscaping or garden design business"
msgstr "ឈ្មោះអាជីវកម្មថែសួន រៀបចំទេសភាព ឬរចនាសួនច្បារ"

#. config.garden.business-type
#: schema.json
msgctxt "op"
msgid "Gardener and landscaper"
msgstr "អ្នកថែសួន និងរៀបចំទេសភាព"

#. config.garden.business-type
#: schema.json
msgctxt "op"
msgid "Landscape contractor"
msgstr "អ្នកម៉ៅការទេសភាព"

#. config.garden.business-type
#: schema.json
msgctxt "op"
msgid "Garden design studio"
msgstr "ស្ទូឌីយោរចនាសួនច្បារ"

#. config.garden.business-type
#: schema.json
msgctxt "op"
msgid "Garden centre or nursery"
msgstr "មជ្ឈមណ្ឌលសួនច្បារ ឬថ្នាលកូនឈើ"

#. config.garden.business-type
#: schema.json
msgctxt "op"
msgid "Other garden business"
msgstr "អាជីវកម្មសួនច្បារផ្សេងទៀត"

#. config.garden.areas
#: schema.json
msgctxt "fn"
msgid "Service area"
msgstr "តំបន់សេវាកម្ម"

#. config.garden.areas
#: schema.json
msgctxt "fh"
msgid "Towns and areas you work in, separated by commas, shown in the top bar and the footer"
msgstr "ទីក្រុង និងតំបន់ដែលអ្នកធ្វើការ ដោយបំបែកដោយសញ្ញាក្បៀស ដែលបង្ហាញនៅរបារខាងលើ និងបាតទំព័រ"

#. config.garden.email
#: schema.json
msgctxt "fh"
msgid "Email address for quotes, site visits and garden care enquiries"
msgstr "អាសយដ្ឋានអ៊ីមែលសម្រាប់សំណើតម្លៃ ការចុះមើលទីតាំង និងការថែទាំសួន"

#. config.garden.announcement
#: schema.json
msgctxt "fh"
msgid "Short note shown at the top of every page, e.g. Autumn tidy-ups: book your slot before November"
msgstr "កំណត់ចំណាំខ្លីដែលបង្ហាញនៅផ្នែកខាងលើនៃទំព័រនីមួយៗ ឧ. ការសម្អាតរដូវស្លឹកឈើជ្រុះ៖ កក់ពេលវេលារបស់អ្នកមុនខែវិច្ឆិកា"

#. config.garden.quote
#: schema.json
msgctxt "fn"
msgid "Quote link"
msgstr "តំណសំណើតម្លៃ"

#. config.garden.quote
#: schema.json
msgctxt "fh"
msgid "Link to the quote or site visit request page, shown as a button in the header"
msgstr "តំណទៅទំព័រស្នើសុំតម្លៃ ឬការចុះមើលទីតាំង ដែលបង្ហាញជាប៊ូតុងនៅក្បាលទំព័រ"

#. config.garden.plans
#: schema.json
msgctxt "fn"
msgid "Care plans link"
msgstr "តំណគម្រោងថែទាំ"

#. config.garden.plans
#: schema.json
msgctxt "fh"
msgid "Link to the page with garden care plans and prices"
msgstr "តំណទៅទំព័រគម្រោងថែទាំសួន និងតម្លៃ"

#. config.garden.notice
#: schema.json
msgctxt "fh"
msgid "Short note shown in the footer, e.g. Fully insured, all planting comes with a 12 month guarantee."
msgstr "កំណត់ចំណាំខ្លីដែលបង្ហាញនៅបាតទំព័រ ឧ. មានការធានារ៉ាប់រងពេញលេញ ការដាំដុះទាំងអស់មានការធានា 12 ខែ។"

#. config.garden.action-bar
#: schema.json
msgctxt "fh"
msgid "Show call and quote buttons at the bottom of the screen on phones"
msgstr "បង្ហាញប៊ូតុងហៅទូរស័ព្ទ និងស្នើតម្លៃនៅផ្នែកខាងក្រោមនៃអេក្រង់លើទូរស័ព្ទ"

#. config.garden.hours
#: schema.json
msgctxt "fn"
msgid "Office hours"
msgstr "ម៉ោងធ្វើការ"

#. config.garden.hours
#: schema.json
msgctxt "fh"
msgid "Office hours for each day of the week"
msgstr "ម៉ោងធ្វើការសម្រាប់ថ្ងៃនីមួយៗក្នុងសប្តាហ៍"

#. config.theme
#: schema.json
msgctxt "st"
msgid "grove::theme"
msgstr "រចនាប័ទ្ម"
