msgid "Garden centre or nursery"
msgstr "Dārzkopības centrs vai stādaudzētava"

#. config.garden.business-type
#: schema.json
msgctxt "op"
msgid "Other garden business"
msgstr "Cits dārza uzņēmums"

#. config.garden.areas
#: schema.json
msgctxt "fn"
msgid "Service area"
msgstr "Apkalpošanas zona"

#. config.garden.areas
#: schema.json
msgctxt "fh"
msgid "Towns and areas you work in, separated by commas, shown in the top bar and the footer"
msgstr "Apdzīvotās vietas un apgabali, kuros strādājat, atdalīti ar komatiem; tiek rādīti augšējā joslā un kājenē"

#. config.garden.email
#: schema.json
msgctxt "fh"
msgid "Email address for quotes, site visits and garden care enquiries"
msgstr "E-pasta adrese piedāvājumu, apsekojumu uz vietas un dārza kopšanas pieprasījumiem"

#. config.garden.announcement
#: schema.json
msgctxt "fh"
msgid "Short note shown at the top of every page, e.g. Autumn tidy-ups: book your slot before November"
msgstr "Īss paziņojums katras lapas augšdaļā, piem., Rudens dārza sakopšana: piesakiet laiku līdz novembrim"

#. config.garden.quote
#: schema.json
msgctxt "fn"
msgid "Quote link"
msgstr "Piedāvājuma saite"

#. config.garden.quote
#: schema.json
msgctxt "fh"
msgid "Link to the quote or site visit request page, shown as a button in the header"
msgstr "Saite uz piedāvājuma vai apsekojuma pieprasījuma lapu, tiek rādīta kā poga galvenē"

#. config.garden.plans
#: schema.json
msgctxt "fn"
msgid "Care plans link"
msgstr "Kopšanas plānu saite"

#. config.garden.plans
#: schema.json
msgctxt "fh"
msgid "Link to the page with garden care plans and prices"
msgstr "Saite uz lapu ar dārza kopšanas plāniem un cenām"

#. config.garden.notice
#: schema.json
msgctxt "fh"
msgid "Short note shown in the footer, e.g. Fully insured, all planting comes with a 12 month guarantee."
msgstr "Īsa piezīme kājenē, piem., Pilnībā apdrošināti, visiem stādījumiem 12 mēnešu garantija."

#. config.garden.action-bar
#: schema.json
msgctxt "fh"
msgid "Show call and quote buttons at the bottom of the screen on phones"
msgstr "Rādīt zvana un piedāvājuma pogas tālruņu ekrāna apakšā"

#. config.garden.hours
#: schema.json
msgctxt "fn"
msgid "Office hours"
msgstr "Darba laiks"

#. config.garden.hours
#: schema.json
msgctxt "fh"
msgid "Office hours for each day of the week"
msgstr "Biroja darba laiks katrai nedēļas dienai"

