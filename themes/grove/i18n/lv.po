msgid "grove::garden"
msgstr "Dārzs"

#. config.garden.name
#: schema.json
msgctxt "fh"
msgid "Name of the gardening, landscaping or garden design business"
msgstr "Dārzkopības, labiekārtošanas vai dārza dizaina uzņēmuma nosaukums"

#. config.garden.business-type
#: schema.json
msgctxt "op"
msgid "Gardener and landscaper"
msgstr "Dārznieks un labiekārtotājs"

#. config.garden.business-type
#: schema.json
msgctxt "op"
msgid "Landscape contractor"
msgstr "Ainavu būvniecības uzņēmums"

#. config.garden.business-type
#: schema.json
msgctxt "op"
msgid "Garden design studio"
msgstr "Dārza dizaina studija"

#. config.garden.business-type
#: schema.json
