msgid "Other garden business"
msgstr "Sonstiger Gartenbetrieb"

#. config.garden.areas
#: schema.json
msgctxt "fn"
msgid "Service area"
msgstr "Einsatzgebiet"

#. config.garden.areas
#: schema.json
msgctxt "fh"
msgid "Towns and areas you work in, separated by commas, shown in the top bar and the footer"
msgstr "Orte und Regionen, in denen Sie arbeiten, durch Kommas getrennt; wird in der oberen Leiste und in der Fußzeile angezeigt"

#. config.garden.email
#: schema.json
msgctxt "fh"
msgid "Email address for quotes, site visits and garden care enquiries"
msgstr "E-Mail-Adresse für Angebote, Vor-Ort-Termine und Anfragen zur Gartenpflege"

#. config.garden.announcement
#: schema.json
msgctxt "fh"
msgid "Short note shown at the top of every page, e.g. Autumn tidy-ups: book your slot before November"
msgstr "Kurzer Hinweis oben auf jeder Seite, z. B. Herbstputz im Garten: Jetzt Termin vor November sichern"

#. config.garden.quote
#: schema.json
msgctxt "fn"
msgid "Quote link"
msgstr "Angebotslink"

#. config.garden.quote
#: schema.json
msgctxt "fh"
msgid "Link to the quote or site visit request page, shown as a button in the header"
msgstr "Link zur Seite für Angebots- oder Vor-Ort-Anfragen, wird als Button im Header angezeigt"

#. config.garden.plans
#: schema.json
msgctxt "fn"
msgid "Care plans link"
msgstr "Link zu Pflege-Paketen"

#. config.garden.plans
#: schema.json
msgctxt "fh"
msgid "Link to the page with garden care plans and prices"
msgstr "Link zur Seite mit Gartenpflege-Paketen und Preisen"

#. config.garden.notice
#: schema.json
msgctxt "fh"
msgid "Short note shown in the footer, e.g. Fully insured, all planting comes with a 12 month guarantee."
msgstr "Kurzer Hinweis in der Fußzeile, z. B. Voll versichert, auf alle Pflanzungen geben wir 12 Monate Garantie."

#. config.garden.action-bar
#: schema.json
msgctxt "fh"
msgid "Show call and quote buttons at the bottom of the screen on phones"
msgstr "Anruf- und Angebots-Buttons auf Smartphones unten am Bildschirm anzeigen"

#. config.garden.hours
#: schema.json
msgctxt "fn"
msgid "Office hours"
msgstr "Bürozeiten"

#. config.garden.hours
#: schema.json
msgctxt "fh"
msgid "Office hours for each day of the week"
msgstr "Bürozeiten für jeden Wochentag"

