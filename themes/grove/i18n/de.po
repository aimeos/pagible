#. config.garden
#: schema.json
msgctxt "st"
msgid "grove::garden"
msgstr "Garten"

#. config.garden.name
#: schema.json
msgctxt "fh"
msgid "Name of the gardening, landscaping or garden design business"
msgstr "Name des Gartenbau-, Landschaftsbau- oder Gartenplanungsbetriebs"

#. config.garden.business-type
#: schema.json
msgctxt "op"
msgid "Gardener and landscaper"
msgstr "Garten- und Landschaftsbau"

#. config.garden.business-type
#: schema.json
