#. config.garden
#: schema.json
msgctxt "st"
msgid "grove::garden"
msgstr "Aed"

#. config.garden.name
#: schema.json
msgctxt "fh"
msgid "Name of the gardening, landscaping or garden design business"
msgstr "Aiandus-, haljastus- või aiakujundusettevõtte nimi"

#. config.garden.business-type
#: schema.json
msgctxt "op"
msgid "Gardener and landscaper"
msgstr "Aednik ja haljastaja"

#. config.garden.business-type
#: schema.json
msgctxt "op"
msgid "Landscape contractor"
msgstr "Haljastusettevõte"

#. config.garden.business-type
#: schema.json
msgctxt "op"
msgid "Garden design studio"
msgstr "Aiakujundusstuudio"

#. config.garden.business-type
#: schema.json
msgctxt "op"
msgid "Garden centre or nursery"
msgstr "Aianduskeskus või puukool"

#. config.garden.business-type
#: schema.json
msgctxt "op"
msgid "Other garden business"
msgstr "Muu aiandusettevõte"

#. config.garden.areas
#: schema.json
msgctxt "fn"
msgid "Service area"
msgstr "Teeninduspiirkond"

#. config.garden.areas
#: schema.json
msgctxt "fh"
msgid "Towns and areas you work in, separated by commas, shown in the top bar and the footer"
msgstr "Asulad ja piirkonnad, kus töötate, komadega eraldatult; kuvatakse ülemisel ribal ja jaluses"

#. config.garden.email
#: schema.json
msgctxt "fh"
msgid "Email address for quotes, site visits and garden care enquiries"
msgstr "E-posti aadress hinnapakkumiste, objektikülastuste ja aiahoolduse päringute jaoks"

#. config.garden.announcement
#: schema.json
msgctxt "fh"
msgid "Short note shown at the top of every page, e.g. Autumn tidy-ups: book your slot before November"
msgstr "Lühike teade iga lehe ülaosas, nt Sügisene aiakoristus: broneeri aeg enne novembrit"

#. config.garden.quote
#: schema.json
msgctxt "fn"
msgid "Quote link"
msgstr "Hinnapakkumise link"

#. config.garden.quote
#: schema.json
msgctxt "fh"
msgid "Link to the quote or site visit request page, shown as a button in the header"
msgstr "Link hinnapakkumise või objektikülastuse päringu lehele, kuvatakse päises nupuna"

#. config.garden.plans
#: schema.json
msgctxt "fn"
msgid "Care plans link"
msgstr "Hoolduspakettide link"

#. config.garden.plans
#: schema.json
msgctxt "fh"
msgid "Link to the page with garden care plans and prices"
msgstr "Link aiahoolduspakettide ja hindadega lehele"

#. config.garden.notice
#: schema.json
msgctxt "fh"
msgid "Short note shown in the footer, e.g. Fully insured, all planting comes with a 12 month guarantee."
msgstr "Lühike märkus jaluses, nt Täielikult kindlustatud, kõigile istutustele kehtib 12-kuuline garantii."

#. config.garden.action-bar
#: schema.json
msgctxt "fh"
msgid "Show call and quote buttons at the bottom of the screen on phones"
msgstr "Kuva telefonides ekraani allservas helistamise ja hinnapakkumise nupud"

#. config.garden.hours
#: schema.json
msgctxt "fn"
msgid "Office hours"
msgstr "Lahtiolekuajad"

#. config.garden.hours
#: schema.json
msgctxt "fh"
msgid "Office hours for each day of the week"
msgstr "Büroo lahtiolekuajad iga nädalapäeva kohta"

