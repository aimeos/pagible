#. config.garden
#: schema.json
msgctxt "st"
msgid "grove::garden"
msgstr "Grădină"

#. config.garden.name
#: schema.json
msgctxt "fh"
msgid "Name of the gardening, landscaping or garden design business"
msgstr "Numele firmei de grădinărit, amenajări peisagistice sau design de grădini"

#. config.garden.business-type
#: schema.json
msgctxt "op"
msgid "Gardener and landscaper"
msgstr "Grădinar și peisagist"

#. config.garden.business-type
#: schema.json
msgctxt "op"
msgid "Landscape contractor"
msgstr "Firmă de amenajări peisagistice"

#. config.garden.business-type
#: schema.json
msgctxt "op"
msgid "Garden design studio"
msgstr "Studio de design de grădini"

#. config.garden.business-type
#: schema.json
msgctxt "op"
msgid "Garden centre or nursery"
msgstr "Centru de grădinărit sau pepinieră"

#. config.garden.business-type
#: schema.json
msgctxt "op"
msgid "Other garden business"
msgstr "Altă afacere de grădinărit"

#. config.garden.areas
#: schema.json
msgctxt "fn"
msgid "Service area"
msgstr "Zonă de deservire"

#. config.garden.areas
#: schema.json
msgctxt "fh"
msgid "Towns and areas you work in, separated by commas, shown in the top bar and the footer"
msgstr "Localitățile și zonele în care lucrați, separate prin virgule, afișate în bara de sus și în subsol"

#. config.garden.email
#: schema.json
msgctxt "fh"
msgid "Email address for quotes, site visits and garden care enquiries"
msgstr "Adresa de e-mail pentru oferte, vizite la fața locului și solicitări de întreținere a grădinii"

#. config.garden.announcement
#: schema.json
msgctxt "fh"
msgid "Short note shown at the top of every page, e.g. Autumn tidy-ups: book your slot before November"
msgstr "Anunț scurt afișat în partea de sus a fiecărei pagini, de ex. Curățenie de toamnă în grădină: rezervați-vă locul înainte de noiembrie"

#. config.garden.quote
#: schema.json
msgctxt "fn"
msgid "Quote link"
msgstr "Link pentru ofertă"

#. config.garden.quote
#: schema.json
msgctxt "fh"
msgid "Link to the quote or site visit request page, shown as a button in the header"
msgstr "Link către pagina de solicitare a unei oferte sau vizite, afișat ca buton în antet"

#. config.garden.plans
#: schema.json
msgctxt "fn"
msgid "Care plans link"
msgstr "Link către planurile de întreținere"

#. config.garden.plans
#: schema.json
msgctxt "fh"
msgid "Link to the page with garden care plans and prices"
msgstr "Link către pagina cu planurile de întreținere a grădinii și prețurile"

#. config.garden.notice
#: schema.json
msgctxt "fh"
msgid "Short note shown in the footer, e.g. Fully insured, all planting comes with a 12 month guarantee."
msgstr "Notă scurtă afișată în subsol, de ex. Asigurare completă, toate plantările au garanție de 12 luni."

#. config.garden.action-bar
#: schema.json
msgctxt "fh"
msgid "Show call and quote buttons at the bottom of the screen on phones"
msgstr "Afișează butoanele de apel și ofertă în partea de jos a ecranului pe telefoane"

#. config.garden.hours
#: schema.json
msgctxt "fn"
msgid "Office hours"
msgstr "Program de lucru"

#. config.garden.hours
#: schema.json
msgctxt "fh"
msgid "Office hours for each day of the week"
msgstr "Programul biroului pentru fiecare zi a săptămânii"

#. config.theme
#: schema.json
msgctxt "st"
msgid "grove::theme"
msgstr "Temă"
