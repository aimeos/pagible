#. config.garden
#: schema.json
msgctxt "st"
msgid "grove::garden"
msgstr "Sodas"

#. config.garden.name
#: schema.json
msgctxt "fh"
msgid "Name of the gardening, landscaping or garden design business"
msgstr "Sodininkystės, aplinkos tvarkymo ar sodų dizaino įmonės pavadinimas"

#. config.garden.business-type
#: schema.json
msgctxt "op"
msgid "Gardener and landscaper"
msgstr "Sodininkas ir aplinkos tvarkytojas"

#. config.garden.business-type
#: schema.json
msgctxt "op"
msgid "Landscape contractor"
msgstr "Aplinkos įrengimo rangovas"

#. config.garden.business-type
#: schema.json
msgctxt "op"
msgid "Garden design studio"
msgstr "Sodų dizaino studija"

#. config.garden.business-type
#: schema.json
msgctxt "op"
msgid "Garden centre or nursery"
msgstr "Sodo prekių centras ar medelynas"

#. config.garden.business-type
#: schema.json
msgctxt "op"
msgid "Other garden business"
msgstr "Kita sodo įmonė"

#. config.garden.areas
#: schema.json
msgctxt "fn"
msgid "Service area"
msgstr "Aptarnavimo zona"

#. config.garden.areas
#: schema.json
msgctxt "fh"
msgid "Towns and areas you work in, separated by commas, shown in the top bar and the footer"
msgstr "Gyvenvietės ir rajonai, kuriuose dirbate, atskirti kableliais; rodomi viršutinėje juostoje ir poraštėje"

#. config.garden.email
#: schema.json
msgctxt "fh"
msgid "Email address for quotes, site visits and garden care enquiries"
msgstr "El. pašto adresas pasiūlymų, apžiūrų vietoje ir sodo priežiūros užklausoms"

#. config.garden.announcement
#: schema.json
msgctxt "fh"
msgid "Short note shown at the top of every page, e.g. Autumn tidy-ups: book your slot before November"
msgstr "Trumpas pranešimas kiekvieno puslapio viršuje, pvz., Rudeninis sodo tvarkymas: užsisakykite laiką iki lapkričio"

#. config.garden.quote
#: schema.json
msgctxt "fn"
msgid "Quote link"
msgstr "Pasiūlymo nuoroda"

#. config.garden.quote
#: schema.json
msgctxt "fh"
msgid "Link to the quote or site visit request page, shown as a button in the header"
msgstr "Nuoroda į pasiūlymo ar apžiūros užklausos puslapį, rodoma kaip mygtukas antraštėje"

#. config.garden.plans
#: schema.json
msgctxt "fn"
msgid "Care plans link"
msgstr "Priežiūros planų nuoroda"

#. config.garden.plans
#: schema.json
msgctxt "fh"
msgid "Link to the page with garden care plans and prices"
msgstr "Nuoroda į puslapį su sodo priežiūros planais ir kainomis"

#. config.garden.notice
#: schema.json
msgctxt "fh"
msgid "Short note shown in the footer, e.g. Fully insured, all planting comes with a 12 month guarantee."
msgstr "Trumpa pastaba poraštėje, pvz., Visiškai apdrausta, visiems sodinimams suteikiame 12 mėnesių garantiją."

#. config.garden.action-bar
#: schema.json
msgctxt "fh"
msgid "Show call and quote buttons at the bottom of the screen on phones"
msgstr "Rodyti skambučio ir pasiūlymo mygtukus telefonų ekrano apačioje"

#. config.garden.hours
#: schema.json
msgctxt "fn"
msgid "Office hours"
msgstr "Darbo laikas"

#. config.garden.hours
#: schema.json
msgctxt "fh"
msgid "Office hours for each day of the week"
msgstr "Kontoros darbo laikas kiekvienai savaitės dienai"

#. config.theme
#: schema.json
msgctxt "st"
msgid "grove::theme"
msgstr "Tema"
