#. config.garden
#: schema.json
msgctxt "st"
msgid "grove::garden"
msgstr "Vrt"

#. config.garden.name
#: schema.json
msgctxt "fh"
msgid "Name of the gardening, landscaping or garden design business"
msgstr "Ime vrtnarskega, krajinskega ali vrtnooblikovalskega podjetja"

#. config.garden.business-type
#: schema.json
msgctxt "op"
msgid "Gardener and landscaper"
msgstr "Vrtnar in krajinar"

#. config.garden.business-type
#: schema.json
msgctxt "op"
msgid "Landscape contractor"
msgstr "Krajinsko gradbeno podjetje"

#. config.garden.business-type
#: schema.json
msgctxt "op"
msgid "Garden design studio"
msgstr "Studio za oblikovanje vrtov"

#. config.garden.business-type
#: schema.json
msgctxt "op"
msgid "Garden centre or nursery"
msgstr "Vrtni center ali drevesnica"

#. config.garden.business-type
#: schema.json
msgctxt "op"
msgid "Other garden business"
msgstr "Drugo vrtnarsko podjetje"

#. config.garden.areas
#: schema.json
msgctxt "fn"
msgid "Service area"
msgstr "Območje delovanja"

#. config.garden.areas
#: schema.json
msgctxt "fh"
msgid "Towns and areas you work in, separated by commas, shown in the top bar and the footer"
msgstr "Kraji in območja, kjer delate, ločeni z vejicami; prikazani v zgornji vrstici in nogi strani"

#. config.garden.email
#: schema.json
msgctxt "fh"
msgid "Email address for quotes, site visits and garden care enquiries"
msgstr "E-poštni naslov za povpraševanja, oglede na terenu in vprašanja o vzdrževanju vrta"

#. config.garden.announcement
#: schema.json
msgctxt "fh"
msgid "Short note shown at the top of every page, e.g. Autumn tidy-ups: book your slot before November"
msgstr "Kratko obvestilo na vrhu vsake strani, npr. Jesensko čiščenje vrta: rezervirajte termin do novembra"

#. config.garden.quote
#: schema.json
msgctxt "fn"
msgid "Quote link"
msgstr "Povezava do ponudbe"

#. config.garden.quote
#: schema.json
msgctxt "fh"
msgid "Link to the quote or site visit request page, shown as a button in the header"
msgstr "Povezava do strani za povpraševanje ali ogled na terenu, prikazana kot gumb v glavi"

#. config.garden.plans
#: schema.json
msgctxt "fn"
msgid "Care plans link"
msgstr "Povezava do paketov vzdrževanja"

#. config.garden.plans
#: schema.json
msgctxt "fh"
msgid "Link to the page with garden care plans and prices"
msgstr "Povezava do strani s paketi vzdrževanja vrta in ceniki"

#. config.garden.notice
#: schema.json
msgctxt "fh"
msgid "Short note shown in the footer, e.g. Fully insured, all planting comes with a 12 month guarantee."
msgstr "Kratko obvestilo v nogi strani, npr. Polno zavarovani, za vse zasaditve dajemo 12-mesečno garancijo."

#. config.garden.action-bar
#: schema.json
msgctxt "fh"
msgid "Show call and quote buttons at the bottom of the screen on phones"
msgstr "Na telefonih prikaži gumba za klic in ponudbo na dnu zaslona"

#. config.garden.hours
#: schema.json
msgctxt "fn"
msgid "Office hours"
msgstr "Uradne ure"

#. config.garden.hours
#: schema.json
msgctxt "fh"
msgid "Office hours for each day of the week"
msgstr "Uradne ure za vsak dan v tednu"

#. config.theme
#: schema.json
msgctxt "st"
msgid "grove::theme"
msgstr "Tema"
