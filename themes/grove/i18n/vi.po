#: schema.json
msgctxt "op"
msgid "Garden centre or nursery"
msgstr "Cửa hàng cây cảnh hoặc vườn ươm"

#. config.garden.business-type
#: schema.json
msgctxt "op"
msgid "Other garden business"
msgstr "Doanh nghiệp sân vườn khác"

#. config.garden.street-address
#: schema.json
msgctxt "fn"
msgid "Street address"
msgstr "Địa chỉ"

#. config.garden.street-address
#: schema.json
msgctxt "fh"
msgid "Street and house number"
msgstr "Tên đường và số nhà"

#. config.garden.postal-code
#: schema.json
msgctxt "fn"
msgid "Postal code"
msgstr "Mã bưu chính"

#. config.garden.postal-code
#: schema.json
msgctxt "fh"
msgid "Postal code of the business"
msgstr "Mã bưu chính của doanh nghiệp"

#. config.garden.locality
#: schema.json
msgctxt "fn"
msgid "City"
msgstr "Thành phố"

#. config.garden.locality
#: schema.json
msgctxt "fh"
msgid "City the business is located in"
msgstr "Thành phố nơi doanh nghiệp đặt trụ sở"

#. config.garden.country
#: schema.json
msgctxt "fn"
msgid "Country code"
msgstr "Mã quốc gia"

#. config.garden.country
#: schema.json
msgctxt "fh"
msgid "Two letter ISO country code, e.g. DE or US"
msgstr "Mã quốc gia ISO gồm hai chữ cái, ví dụ DE hoặc US"

#. config.garden.telephone
#: schema.json
msgctxt "fn"
msgid "telephone"
msgstr "Điện thoại"

#. config.garden.telephone
#: schema.json
msgctxt "fh"
msgid "Phone number in international format, also used by the call button"
msgstr "Số điện thoại theo định dạng quốc tế, cũng dùng cho nút gọi"

#. config.garden.areas
#: schema.json
msgctxt "fn"
msgid "Service area"
msgstr "Khu vực phục vụ"

#. config.garden.areas
#: schema.json
msgctxt "fh"
msgid "Towns and areas you work in, separated by commas, shown in the top bar and the footer"
msgstr "Các thị trấn và khu vực bạn phục vụ, phân cách bằng dấu phẩy, hiển thị ở thanh trên cùng và chân trang"

#. config.garden.email
#: schema.json
msgctxt "fn"
msgid "email"
msgstr "Email"

#. config.garden.email
#: schema.json
msgctxt "fh"
msgid "Email address for quotes, site visits and garden care enquiries"
msgstr "Địa chỉ email nhận yêu cầu báo giá, khảo sát tại chỗ và chăm sóc sân vườn"

#. config.garden.announcement
#: schema.json
msgctxt "fn"
msgid "Announcement"
msgstr "Thông báo"

#. config.garden.announcement
#: schema.json
msgctxt "fh"
msgid "Short note shown at the top of every page, e.g. Autumn tidy-ups: book your slot before November"
msgstr "Thông báo ngắn hiển thị ở đầu mỗi trang, ví dụ: Dọn vườn mùa thu: đặt lịch trước tháng 11"

#. config.garden.quote
#: schema.json
msgctxt "fn"
msgid "Quote link"
msgstr "Liên kết báo giá"

#. config.garden.quote
#: schema.json
msgctxt "fh"
msgid "Link to the quote or site visit request page, shown as a button in the header"
msgstr "Liên kết đến trang yêu cầu báo giá hoặc khảo sát tại chỗ, hiển thị dưới dạng nút ở đầu trang"

#. config.garden.plans
#: schema.json
msgctxt "fn"
msgid "Care plans link"
msgstr "Liên kết gói chăm sóc"

#. config.garden.plans
#: schema.json
msgctxt "fh"
msgid "Link to the page with garden care plans and prices"
msgstr "Liên kết đến trang giới thiệu các gói chăm sóc sân vườn và bảng giá"

#. config.garden.price-range
#: schema.json
msgctxt "fn"
msgid "Price range"
msgstr "Mức giá"

#. config.garden.price-range
#: schema.json
msgctxt "fh"
msgid "Price level of the business, e.g. ££ or €€"
msgstr "Mức giá của doanh nghiệp, ví dụ: ££ hoặc €€"

#. config.garden.notice
#: schema.json
msgctxt "fn"
msgid "Notice"
msgstr "Lưu ý"

#. config.garden.notice
#: schema.json
msgctxt "fh"
msgid "Short note shown in the footer, e.g. Fully insured, all planting comes with a 12 month guarantee."
msgstr "Ghi chú ngắn hiển thị ở chân trang, ví dụ: Có bảo hiểm đầy đủ, mọi cây trồng đều được bảo hành 12 tháng."

#. config.garden.action-bar
#: schema.json
msgctxt "fn"
msgid "Action bar"
msgstr "Thanh thao tác"

#. config.garden.action-bar
#: schema.json
msgctxt "fh"
msgid "Show call and quote buttons at the bottom of the screen on phones"
msgstr "Hiển thị nút gọi điện và báo giá ở cuối màn hình trên điện thoại"

#. config.garden.hours
