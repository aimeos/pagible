#. config.garden
#: schema.json
msgctxt "st"
msgid "grove::garden"
msgstr "Sân vườn"

#. config.garden.name
#: schema.json
msgctxt "fh"
msgid "Name of the gardening, landscaping or garden design business"
msgstr "Tên doanh nghiệp làm vườn, cảnh quan hoặc thiết kế sân vườn"

#. config.garden.business-type
#: schema.json
msgctxt "fn"
msgid "Business type"
msgstr "Loại hình kinh doanh"

#. config.garden.business-type
#: schema.json
msgctxt "fh"
msgid "Kind of business shown to search engines"
