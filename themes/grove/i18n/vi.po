#. config.garden
#: schema.json
msgctxt "st"
msgid "grove::garden"
msgstr "Sân vườn"

#. config.garden.name
#: schema.json
msgctxt "fh"
msgid "Name of the gardening, landscaping or garden design business"
msgstr "Tên doanh nghiệp làm vườn, cảnh quan hoặc thiết kế sân vườn"

#. config.garden.business-type
#: schema.json
msgctxt "op"
msgid "Gardener and landscaper"
msgstr "Thợ làm vườn và cảnh quan"

#. config.garden.business-type
#: schema.json
msgctxt "op"
msgid "Landscape contractor"
msgstr "Nhà thầu cảnh quan"

#. config.garden.business-type
#: schema.json
msgctxt "op"
msgid "Garden design studio"
msgstr "Studio thiết kế sân vườn"

#. config.garden.business-type
#: schema.json
msgctxt "op"
msgid "Garden centre or nursery"
msgstr "Cửa hàng cây cảnh hoặc vườn ươm"

#. config.garden.business-type
#: schema.json
msgctxt "op"
msgid "Other garden business"
msgstr "Doanh nghiệp sân vườn khác"

#. config.garden.areas
#: schema.json
msgctxt "fn"
msgid "Service area"
msgstr "Khu vực phục vụ"

#. config.garden.areas
#: schema.json
msgctxt "fh"
msgid "Towns and areas you work in, separated by commas, shown in the top bar and the footer"
msgstr "Các thị trấn và khu vực bạn phục vụ, phân cách bằng dấu phẩy, hiển thị ở thanh trên cùng và chân trang"

#. config.garden.email
#: schema.json
msgctxt "fh"
msgid "Email address for quotes, site visits and garden care enquiries"
msgstr "Địa chỉ email nhận yêu cầu báo giá, khảo sát tại chỗ và chăm sóc sân vườn"

#. config.garden.announcement
#: schema.json
msgctxt "fh"
msgid "Short note shown at the top of every page, e.g. Autumn tidy-ups: book your slot before November"
msgstr "Thông báo ngắn hiển thị ở đầu mỗi trang, ví dụ: Dọn vườn mùa thu: đặt lịch trước tháng 11"

#. config.garden.quote
#: schema.json
msgctxt "fn"
msgid "Quote link"
msgstr "Liên kết báo giá"

#. config.garden.quote
#: schema.json
msgctxt "fh"
msgid "Link to the quote or site visit request page, shown as a button in the header"
msgstr "Liên kết đến trang yêu cầu báo giá hoặc khảo sát tại chỗ, hiển thị dưới dạng nút ở đầu trang"

#. config.garden.plans
#: schema.json
msgctxt "fn"
msgid "Care plans link"
msgstr "Liên kết gói chăm sóc"

#. config.garden.plans
#: schema.json
msgctxt "fh"
msgid "Link to the page with garden care plans and prices"
msgstr "Liên kết đến trang giới thiệu các gói chăm sóc sân vườn và bảng giá"

#. config.garden.notice
#: schema.json
msgctxt "fh"
msgid "Short note shown in the footer, e.g. Fully insured, all planting comes with a 12 month guarantee."
msgstr "Ghi chú ngắn hiển thị ở chân trang, ví dụ: Có bảo hiểm đầy đủ, mọi cây trồng đều được bảo hành 12 tháng."

#. config.garden.action-bar
#: schema.json
msgctxt "fh"
msgid "Show call and quote buttons at the bottom of the screen on phones"
msgstr "Hiển thị nút gọi điện và báo giá ở cuối màn hình trên điện thoại"

#. config.garden.hours
#: schema.json
msgctxt "fn"
msgid "Office hours"
msgstr "Giờ làm việc"

#. config.garden.hours
#: schema.json
msgctxt "fh"
msgid "Office hours for each day of the week"
msgstr "Giờ làm việc của văn phòng cho mỗi ngày trong tuần"

#. config.theme
#: schema.json
msgctxt "st"
msgid "grove::theme"
msgstr "Giao diện"
