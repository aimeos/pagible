#. config.garden
#: schema.json
msgctxt "st"
msgid "grove::garden"
msgstr "Сад"

#. config.garden.name
#: schema.json
msgctxt "fh"
msgid "Name of the gardening, landscaping or garden design business"
msgstr "Назва компанії з догляду за садом, ландшафтних робіт або ландшафтного дизайну"

