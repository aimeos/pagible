#: schema.json
msgctxt "fh"
msgid "Price level of the business, e.g. ££ or €€"
msgstr "Ціновий рівень компанії, напр. ££ або €€"

#. config.garden.notice
#: schema.json
msgctxt "fn"
msgid "Notice"
msgstr "Примітка"

#. config.garden.notice
#: schema.json
msgctxt "fh"
msgid "Short note shown in the footer, e.g. Fully insured, all planting comes with a 12 month guarantee."
msgstr "Коротка примітка в підвалі, напр. Повне страхування, на всі насадження надаємо гарантію 12 місяців."

#. config.garden.action-bar
