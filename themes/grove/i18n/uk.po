msgid "Email address for quotes, site visits and garden care enquiries"
msgstr "Електронна пошта для запитів на розрахунок вартості, виїзд на ділянку та догляд за садом"

#. config.garden.announcement
#: schema.json
msgctxt "fn"
msgid "Announcement"
msgstr "Оголошення"

#. config.garden.announcement
#: schema.json
msgctxt "fh"
msgid "Short note shown at the top of every page, e.g. Autumn tidy-ups: book your slot before November"
msgstr "Коротке оголошення вгорі кожної сторінки, напр. Осіннє прибирання саду: запишіться до листопада"

#. config.garden.quote
#: schema.json
msgctxt "fn"
msgid "Quote link"
msgstr "Посилання на розрахунок вартості"

