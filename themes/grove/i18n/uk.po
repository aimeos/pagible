#. config.garden
#: schema.json
msgctxt "st"
msgid "grove::garden"
msgstr "Сад"

#. config.garden.name
#: schema.json
msgctxt "fh"
msgid "Name of the gardening, landscaping or garden design business"
msgstr "Назва компанії з догляду за садом, ландшафтних робіт або ландшафтного дизайну"

#. config.garden.business-type
#: schema.json
msgctxt "op"
msgid "Gardener and landscaper"
msgstr "Садівник і ландшафтний майстер"

#. config.garden.business-type
#: schema.json
msgctxt "op"
msgid "Landscape contractor"
msgstr "Ландшафтна будівельна компанія"

#. config.garden.business-type
#: schema.json
msgctxt "op"
msgid "Garden design studio"
msgstr "Студія ландшафтного дизайну"

#. config.garden.business-type
#: schema.json
msgctxt "op"
msgid "Garden centre or nursery"
msgstr "Садовий центр або розсадник"

#. config.garden.business-type
#: schema.json
msgctxt "op"
msgid "Other garden business"
msgstr "Інший садовий бізнес"

#. config.garden.areas
#: schema.json
msgctxt "fn"
msgid "Service area"
msgstr "Зона обслуговування"

#. config.garden.areas
#: schema.json
msgctxt "fh"
msgid "Towns and areas you work in, separated by commas, shown in the top bar and the footer"
msgstr "Населені пункти та райони, де ви працюєте, через кому; відображаються у верхній панелі та в підвалі"

#. config.garden.email
#: schema.json
msgctxt "fh"
msgid "Email address for quotes, site visits and garden care enquiries"
msgstr "Електронна пошта для запитів на розрахунок вартості, виїзд на ділянку та догляд за садом"

#. config.garden.announcement
#: schema.json
msgctxt "fh"
msgid "Short note shown at the top of every page, e.g. Autumn tidy-ups: book your slot before November"
msgstr "Коротке оголошення вгорі кожної сторінки, напр. Осіннє прибирання саду: запишіться до листопада"

#. config.garden.quote
#: schema.json
msgctxt "fn"
msgid "Quote link"
msgstr "Посилання на розрахунок вартості"

#. config.garden.quote
#: schema.json
msgctxt "fh"
msgid "Link to the quote or site visit request page, shown as a button in the header"
msgstr "Посилання на сторінку заявки на розрахунок вартості або виїзд на ділянку, відображається кнопкою в шапці"

#. config.garden.plans
#: schema.json
msgctxt "fn"
msgid "Care plans link"
msgstr "Посилання на плани догляду"

#. config.garden.plans
#: schema.json
msgctxt "fh"
msgid "Link to the page with garden care plans and prices"
msgstr "Посилання на сторінку з планами догляду за садом і цінами"

#. config.garden.notice
#: schema.json
msgctxt "fh"
msgid "Short note shown in the footer, e.g. Fully insured, all planting comes with a 12 month guarantee."
msgstr "Коротка примітка в підвалі, напр. Повне страхування, на всі насадження надаємо гарантію 12 місяців."

#. config.garden.action-bar
#: schema.json
msgctxt "fh"
msgid "Show call and quote buttons at the bottom of the screen on phones"
msgstr "Показувати кнопки дзвінка та розрахунку вартості внизу екрана на телефонах"

#. config.garden.hours
#: schema.json
msgctxt "fn"
msgid "Office hours"
msgstr "Години роботи"

#. config.garden.hours
#: schema.json
msgctxt "fh"
msgid "Office hours for each day of the week"
msgstr "Години роботи офісу для кожного дня тижня"

#. config.theme
#: schema.json
msgctxt "st"
msgid "grove::theme"
msgstr "Тема оформлення"
