#. config.garden.announcement
#: schema.json
msgctxt "fh"
msgid "Short note shown at the top of every page, e.g. Autumn tidy-ups: book your slot before November"
msgstr "Kort besked øverst på hver side, f.eks. Efterårsoprydning: book din tid inden november"

#. config.garden.quote
#: schema.json
