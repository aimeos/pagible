#. config.garden.action-bar
#: schema.json
msgctxt "fh"
msgid "Show call and quote buttons at the bottom of the screen on phones"
msgstr "Vis ring- og tilbudsknapper nederst på skærmen på mobiler"

#. config.garden.hours
