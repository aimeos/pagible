msgid "Other garden business"
msgstr "نشاط آخر في مجال الحدائق"

#. config.garden.areas
#: schema.json
msgctxt "fn"
msgid "Service area"
msgstr "منطقة الخدمة"

#. config.garden.areas
#: schema.json
msgctxt "fh"
msgid "Towns and areas you work in, separated by commas, shown in the top bar and the footer"
msgstr "المدن والمناطق التي تعمل فيها، مفصولة بفواصل، وتظهر في الشريط العلوي وتذييل الصفحة"

#. config.garden.email
#: schema.json
msgctxt "fh"
msgid "Email address for quotes, site visits and garden care enquiries"
msgstr "البريد الإلكتروني لطلبات عروض الأسعار والمعاينات الميدانية واستفسارات العناية بالحدائق"

#. config.garden.announcement
#: schema.json
msgctxt "fh"
msgid "Short note shown at the top of every page, e.g. Autumn tidy-ups: book your slot before November"
msgstr "ملاحظة قصيرة تظهر أعلى كل صفحة، مثل: تنظيف الحدائق في الخريف: احجز موعدك قبل نوفمبر"

#. config.garden.quote
#: schema.json
msgctxt "fn"
msgid "Quote link"
msgstr "رابط عرض السعر"

#. config.garden.quote
#: schema.json
msgctxt "fh"
msgid "Link to the quote or site visit request page, shown as a button in the header"
msgstr "رابط صفحة طلب عرض السعر أو المعاينة، يظهر كزر في رأس الصفحة"

#. config.garden.plans
#: schema.json
msgctxt "fn"
msgid "Care plans link"
msgstr "رابط باقات العناية"

#. config.garden.plans
#: schema.json
msgctxt "fh"
msgid "Link to the page with garden care plans and prices"
msgstr "رابط الصفحة التي تعرض باقات العناية بالحدائق وأسعارها"

#. config.garden.notice
#: schema.json
msgctxt "fh"
msgid "Short note shown in the footer, e.g. Fully insured, all planting comes with a 12 month guarantee."
msgstr "ملاحظة قصيرة تظهر في تذييل الصفحة، مثل: تأمين شامل، وجميع أعمال الزراعة مضمونة لمدة 12 شهرًا."

#. config.garden.action-bar
#: schema.json
msgctxt "fh"
msgid "Show call and quote buttons at the bottom of the screen on phones"
msgstr "إظهار زري الاتصال وطلب عرض السعر أسفل الشاشة على الهواتف"

#. config.garden.hours
#: schema.json
msgctxt "fn"
msgid "Office hours"
msgstr "ساعات العمل"

#. config.garden.hours
#: schema.json
msgctxt "fh"
msgid "Office hours for each day of the week"
msgstr "ساعات عمل المكتب لكل يوم من أيام الأسبوع"

