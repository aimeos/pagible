#. config.garden.name
#: schema.json
msgctxt "fh"
msgid "Name of the gardening, landscaping or garden design business"
msgstr "اسم شركة البستنة أو تنسيق الحدائق أو تصميم الحدائق"

#. config.garden.business-type
#: schema.json
msgctxt "op"
msgid "Gardener and landscaper"
msgstr "بستاني ومنسق حدائق"

#. config.garden.business-type
#: schema.json
msgctxt "op"
msgid "Landscape contractor"
msgstr "مقاول تنسيق حدائق"

#. config.garden.business-type
#: schema.json
msgctxt "op"
msgid "Garden design studio"
msgstr "استوديو تصميم حدائق"

#. config.garden.business-type
#: schema.json
