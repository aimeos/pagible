#. config.garden
#: schema.json
msgctxt "st"
msgid "grove::garden"
msgstr "สวน"

#. config.garden.name
#: schema.json
msgctxt "fh"
msgid "Name of the gardening, landscaping or garden design business"
msgstr "ชื่อธุรกิจดูแลสวน จัดสวน หรือออกแบบสวน"

#. config.garden.business-type
#: schema.json
msgctxt "op"
msgid "Gardener and landscaper"
msgstr "คนสวนและช่างจัดสวน"

#. config.garden.business-type
#: schema.json
msgctxt "op"
msgid "Landscape contractor"
msgstr "ผู้รับเหมาจัดภูมิทัศน์"

#. config.garden.business-type
#: schema.json
msgctxt "op"
msgid "Garden design studio"
msgstr "สตูดิโอออกแบบสวน"

#. config.garden.business-type
#: schema.json
msgctxt "op"
msgid "Garden centre or nursery"
msgstr "ศูนย์จำหน่ายอุปกรณ์สวนหรือเรือนเพาะชำ"

#. config.garden.business-type
#: schema.json
msgctxt "op"
msgid "Other garden business"
msgstr "ธุรกิจสวนอื่นๆ"

#. config.garden.areas
#: schema.json
msgctxt "fn"
msgid "Service area"
msgstr "พื้นที่ให้บริการ"

#. config.garden.areas
#: schema.json
msgctxt "fh"
msgid "Towns and areas you work in, separated by commas, shown in the top bar and the footer"
msgstr "เมืองและพื้นที่ที่คุณให้บริการ คั่นด้วยเครื่องหมายจุลภาค แสดงในแถบด้านบนและส่วนท้าย"

#. config.garden.email
#: schema.json
msgctxt "fh"
msgid "Email address for quotes, site visits and garden care enquiries"
msgstr "อีเมลสำหรับขอใบเสนอราคา นัดดูหน้างาน และสอบถามเรื่องการดูแลสวน"

#. config.garden.announcement
#: schema.json
msgctxt "fh"
msgid "Short note shown at the top of every page, e.g. Autumn tidy-ups: book your slot before November"
msgstr "ข้อความสั้นที่แสดงด้านบนของทุกหน้า เช่น เก็บกวาดสวนรับฤดูใบไม้ร่วง: จองคิวก่อนเดือนพฤศจิกายน"

#. config.garden.quote
#: schema.json
msgctxt "fn"
msgid "Quote link"
msgstr "ลิงก์ขอใบเสนอราคา"

#. config.garden.quote
#: schema.json
msgctxt "fh"
msgid "Link to the quote or site visit request page, shown as a button in the header"
msgstr "ลิงก์ไปยังหน้าขอใบเสนอราคาหรือนัดดูหน้างาน แสดงเป็นปุ่มในส่วนหัว"

#. config.garden.plans
#: schema.json
msgctxt "fn"
msgid "Care plans link"
msgstr "ลิงก์แพ็กเกจดูแลสวน"

#. config.garden.plans
#: schema.json
msgctxt "fh"
msgid "Link to the page with garden care plans and prices"
msgstr "ลิงก์ไปยังหน้าแพ็กเกจดูแลสวนและราคา"

#. config.garden.notice
#: schema.json
msgctxt "fh"
msgid "Short note shown in the footer, e.g. Fully insured, all planting comes with a 12 month guarantee."
msgstr "ข้อความสั้นที่แสดงในส่วนท้าย เช่น มีประกันครบถ้วน ต้นไม้ที่ปลูกทั้งหมดรับประกัน 12 เดือน"

#. config.garden.action-bar
#: schema.json
msgctxt "fh"
msgid "Show call and quote buttons at the bottom of the screen on phones"
msgstr "แสดงปุ่มโทรและขอใบเสนอราคาที่ด้านล่างของหน้าจอบนโทรศัพท์"

#. config.garden.hours
#: schema.json
msgctxt "fn"
msgid "Office hours"
msgstr "เวลาทำการ"

#. config.garden.hours
#: schema.json
msgctxt "fh"
msgid "Office hours for each day of the week"
msgstr "เวลาทำการของสำนักงานสำหรับแต่ละวันในสัปดาห์"

#. config.theme
#: schema.json
msgctxt "st"
msgid "grove::theme"
msgstr "ธีม"
