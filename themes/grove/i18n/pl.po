#. config.garden
#: schema.json
msgctxt "st"
msgid "grove::garden"
msgstr "Ogród"

#. config.garden.name
#: schema.json
msgctxt "fh"
msgid "Name of the gardening, landscaping or garden design business"
msgstr "Nazwa firmy ogrodniczej, zakładającej ogrody lub projektującej ogrody"

#. config.garden.business-type
#: schema.json
msgctxt "op"
msgid "Gardener and landscaper"
msgstr "Ogrodnik i architekt krajobrazu"

#. config.garden.business-type
#: schema.json
msgctxt "op"
msgid "Landscape contractor"
msgstr "Firma budowy terenów zielonych"

#. config.garden.business-type
#: schema.json
msgctxt "op"
msgid "Garden design studio"
msgstr "Pracownia projektowania ogrodów"

#. config.garden.business-type
#: schema.json
msgctxt "op"
msgid "Garden centre or nursery"
msgstr "Centrum ogrodnicze lub szkółka roślin"

#. config.garden.business-type
#: schema.json
msgctxt "op"
msgid "Other garden business"
msgstr "Inna firma ogrodnicza"

#. config.garden.areas
#: schema.json
msgctxt "fn"
msgid "Service area"
msgstr "Obszar działania"

#. config.garden.areas
#: schema.json
msgctxt "fh"
msgid "Towns and areas you work in, separated by commas, shown in the top bar and the footer"
msgstr "Miejscowości i rejony, w których pracujesz, oddzielone przecinkami, wyświetlane na górnym pasku i w stopce"

#. config.garden.email
#: schema.json
msgctxt "fh"
msgid "Email address for quotes, site visits and garden care enquiries"
msgstr "Adres e-mail do zapytań o wycenę, wizję lokalną i pielęgnację ogrodu"

#. config.garden.announcement
#: schema.json
msgctxt "fh"
msgid "Short note shown at the top of every page, e.g. Autumn tidy-ups: book your slot before November"
msgstr "Krótki komunikat na górze każdej strony, np. Jesienne porządki w ogrodzie: zarezerwuj termin przed listopadem"

#. config.garden.quote
#: schema.json
msgctxt "fn"
msgid "Quote link"
msgstr "Link do wyceny"

#. config.garden.quote
#: schema.json
msgctxt "fh"
msgid "Link to the quote or site visit request page, shown as a button in the header"
msgstr "Link do strony zamawiania wyceny lub wizji lokalnej, wyświetlany jako przycisk w nagłówku"

#. config.garden.plans
#: schema.json
msgctxt "fn"
msgid "Care plans link"
msgstr "Link do pakietów pielęgnacji"

#. config.garden.plans
#: schema.json
msgctxt "fh"
msgid "Link to the page with garden care plans and prices"
msgstr "Link do strony z pakietami pielęgnacji ogrodu i cennikiem"

#. config.garden.notice
#: schema.json
msgctxt "fh"
msgid "Short note shown in the footer, e.g. Fully insured, all planting comes with a 12 month guarantee."
msgstr "Krótka informacja w stopce, np. Pełne ubezpieczenie, na wszystkie nasadzenia dajemy 12 miesięcy gwarancji."

#. config.garden.action-bar
#: schema.json
msgctxt "fh"
msgid "Show call and quote buttons at the bottom of the screen on phones"
msgstr "Pokazuj przyciski połączenia i wyceny u dołu ekranu na telefonach"

#. config.garden.hours
#: schema.json
msgctxt "fn"
msgid "Office hours"
msgstr "Godziny pracy"

#. config.garden.hours
#: schema.json
msgctxt "fh"
msgid "Office hours for each day of the week"
msgstr "Godziny pracy kancelarii dla każdego dnia tygodnia"

#. config.theme
#: schema.json
msgctxt "st"
msgid "grove::theme"
msgstr "Motyw"
