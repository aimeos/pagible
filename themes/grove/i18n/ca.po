#. config.garden
#: schema.json
msgctxt "st"
msgid "grove::garden"
msgstr "Jardí"

#. config.garden.name
#: schema.json
msgctxt "fh"
msgid "Name of the gardening, landscaping or garden design business"
msgstr "Nom de l'empresa de jardineria, paisatgisme o disseny de jardins"

#. config.garden.business-type
#: schema.json
msgctxt "op"
msgid "Gardener and landscaper"
msgstr "Jardiner i paisatgista"

#. config.garden.business-type
#: schema.json
msgctxt "op"
msgid "Landscape contractor"
msgstr "Contractista de paisatgisme"

#. config.garden.business-type
#: schema.json
msgctxt "op"
msgid "Garden design studio"
msgstr "Estudi de disseny de jardins"

#. config.garden.business-type
#: schema.json
msgctxt "op"
msgid "Garden centre or nursery"
msgstr "Centre de jardineria o vivers"

#. config.garden.business-type
#: schema.json
msgctxt "op"
msgid "Other garden business"
msgstr "Altres negocis de jardineria"

#. config.garden.areas
#: schema.json
msgctxt "fn"
msgid "Service area"
msgstr "Àrea de servei"

#. config.garden.areas
#: schema.json
msgctxt "fh"
msgid "Towns and areas you work in, separated by commas, shown in the top bar and the footer"
msgstr "Pobles i zones on treballeu, separats per comes, que apareixen a la barra superior i al peu de pàgina."

#. config.garden.email
#: schema.json
msgctxt "fh"
msgid "Email address for quotes, site visits and garden care enquiries"
msgstr "Adreça de correu electrònic per a pressupostos, visites al lloc i consultes sobre cura de jardins"

#. config.garden.announcement
#: schema.json
msgctxt "fh"
msgid "Short note shown at the top of every page, e.g. Autumn tidy-ups: book your slot before November"
msgstr "Nota breu que apareix a la part superior de cada pàgina, p. ex. Netejes de tardor: reserva la teva cita abans de novembre"

#. config.garden.quote
#: schema.json
msgctxt "fn"
msgid "Quote link"
msgstr "Enllaç de pressupost"

#. config.garden.quote
#: schema.json
msgctxt "fh"
msgid "Link to the quote or site visit request page, shown as a button in the header"
msgstr "Enllaç a la pàgina de sol·licitud de pressupost o de visita, mostrat com un botó a la capçalera"

#. config.garden.plans
#: schema.json
msgctxt "fn"
msgid "Care plans link"
msgstr "Enllaç als plans de manteniment"

#. config.garden.plans
#: schema.json
msgctxt "fh"
msgid "Link to the page with garden care plans and prices"
msgstr "Enllaç a la pàgina amb els plans i preus de cura del jardí"

#. config.garden.notice
#: schema.json
msgctxt "fh"
msgid "Short note shown in the footer, e.g. Fully insured, all planting comes with a 12 month guarantee."
msgstr "Nota breu que apareix al peu de pàgina, p. ex. Totalment assegurat, tota la plantació té una garantia de 12 mesos."

#. config.garden.action-bar
#: schema.json
msgctxt "fh"
msgid "Show call and quote buttons at the bottom of the screen on phones"
msgstr "Mostra els botons de trucada i de pressupost a la part inferior de la pantalla dels telèfons"

#. config.garden.hours
#: schema.json
msgctxt "fn"
msgid "Office hours"
msgstr "Horari d'atenció"

#. config.garden.hours
#: schema.json
msgctxt "fh"
msgid "Office hours for each day of the week"
msgstr "Horari d'atenció de dilluns a divendres"

#. config.theme
#: schema.json
msgctxt "st"
msgid "grove::theme"
msgstr "Tema"
