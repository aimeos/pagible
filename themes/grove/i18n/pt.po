#. config.garden
#: schema.json
msgctxt "st"
msgid "grove::garden"
msgstr "Jardim"

#. config.garden.name
#: schema.json
msgctxt "fh"
msgid "Name of the gardening, landscaping or garden design business"
msgstr "Nome da empresa de jardinagem, paisagismo ou design de jardins"

#. config.garden.business-type
#: schema.json
msgctxt "op"
msgid "Gardener and landscaper"
msgstr "Jardineiro e paisagista"

#. config.garden.business-type
#: schema.json
msgctxt "op"
msgid "Landscape contractor"
msgstr "Empresa de paisagismo"

#. config.garden.business-type
#: schema.json
msgctxt "op"
msgid "Garden design studio"
msgstr "Estúdio de design de jardins"

#. config.garden.business-type
#: schema.json
msgctxt "op"
msgid "Garden centre or nursery"
msgstr "Centro de jardinagem ou viveiro"

#. config.garden.business-type
#: schema.json
msgctxt "op"
msgid "Other garden business"
msgstr "Outra empresa de jardinagem"

#. config.garden.areas
#: schema.json
msgctxt "fn"
msgid "Service area"
msgstr "Área de atuação"

#. config.garden.areas
#: schema.json
msgctxt "fh"
msgid "Towns and areas you work in, separated by commas, shown in the top bar and the footer"
msgstr "Localidades e zonas onde trabalha, separadas por vírgulas, apresentadas na barra superior e no rodapé"

#. config.garden.email
#: schema.json
msgctxt "fh"
msgid "Email address for quotes, site visits and garden care enquiries"
msgstr "Endereço de e-mail para orçamentos, visitas ao local e pedidos de manutenção de jardins"

#. config.garden.announcement
#: schema.json
msgctxt "fh"
msgid "Short note shown at the top of every page, e.g. Autumn tidy-ups: book your slot before November"
msgstr "Aviso curto apresentado no topo de cada página, p. ex. Limpezas de outono: marque a sua visita antes de novembro"

#. config.garden.quote
#: schema.json
msgctxt "fn"
msgid "Quote link"
msgstr "Link de orçamento"

#. config.garden.quote
#: schema.json
msgctxt "fh"
msgid "Link to the quote or site visit request page, shown as a button in the header"
msgstr "Link para a página de pedido de orçamento ou visita, apresentado como botão no cabeçalho"

#. config.garden.plans
#: schema.json
msgctxt "fn"
msgid "Care plans link"
msgstr "Link dos planos de manutenção"

#. config.garden.plans
#: schema.json
msgctxt "fh"
msgid "Link to the page with garden care plans and prices"
msgstr "Link para a página com os planos de manutenção de jardins e preços"

#. config.garden.notice
#: schema.json
msgctxt "fh"
msgid "Short note shown in the footer, e.g. Fully insured, all planting comes with a 12 month guarantee."
msgstr "Nota curta apresentada no rodapé, p. ex. Seguro total, todas as plantações têm 12 meses de garantia."

#. config.garden.action-bar
#: schema.json
msgctxt "fh"
msgid "Show call and quote buttons at the bottom of the screen on phones"
msgstr "Mostrar os botões de chamada e orçamento na parte inferior do ecrã em telemóveis"

#. config.garden.hours
#: schema.json
msgctxt "fn"
msgid "Office hours"
msgstr "Horário de atendimento"

#. config.garden.hours
#: schema.json
msgctxt "fh"
msgid "Office hours for each day of the week"
msgstr "Horário de atendimento para cada dia da semana"

#. config.theme
#: schema.json
msgctxt "st"
msgid "grove::theme"
msgstr "Tema"
