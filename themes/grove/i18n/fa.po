msgid "grove::garden"
msgstr "باغ"

#. config.garden.name
#: schema.json
msgctxt "fh"
msgid "Name of the gardening, landscaping or garden design business"
msgstr "نام کسب‌وکار باغبانی، محوطه‌سازی یا طراحی باغ"

#. config.garden.business-type
#: schema.json
msgctxt "op"
msgid "Gardener and landscaper"
msgstr "باغبان و طراح فضای سبز"

#. config.garden.business-type
#: schema.json
msgctxt "op"
msgid "Landscape contractor"
msgstr "پیمانکار محوطه‌سازی"

#. config.garden.business-type
#: schema.json
msgctxt "op"
msgid "Garden design studio"
msgstr "استودیوی طراحی باغ"

#. config.garden.business-type
#: schema.json
msgctxt "op"
msgid "Garden centre or nursery"
msgstr "مرکز باغ یا نهالستان"

#. config.garden.business-type
#: schema.json
msgctxt "op"
msgid "Other garden business"
msgstr "سایر کسب‌وکارهای باغبانی"

#. config.garden.areas
#: schema.json
msgctxt "fn"
msgid "Service area"
msgstr "منطقهٔ خدماتی"

#. config.garden.areas
#: schema.json
msgctxt "fh"
msgid "Towns and areas you work in, separated by commas, shown in the top bar and the footer"
msgstr "شهرها و مناطقی که در آن‌ها کار می‌کنید، جداشده با ویرگول، در نوار بالایی و پاورقی نمایش داده می‌شوند."

#. config.garden.email
#: schema.json
msgctxt "fh"
msgid "Email address for quotes, site visits and garden care enquiries"
msgstr "آدرس ایمیل برای دریافت پیش‌فاکتور، بازدید از محل و پرسش‌های مربوط به مراقبت از باغ"

#. config.garden.announcement
#: schema.json
msgctxt "fh"
msgid "Short note shown at the top of every page, e.g. Autumn tidy-ups: book your slot before November"
msgstr "یادداشت کوتاهی که در بالای هر صفحه نمایش داده می‌شود، برای مثال: نظافت‌های پاییزی: قبل از نوامبر نوبت خود را رزرو کنید."

#. config.garden.quote
#: schema.json
msgctxt "fn"
msgid "Quote link"
msgstr "لینک درخواست قیمت"

#. config.garden.quote
#: schema.json
msgctxt "fh"
msgid "Link to the quote or site visit request page, shown as a button in the header"
msgstr "لینک به صفحه درخواست نقل‌قول یا بازدید از سایت، که به صورت یک دکمه در هدر نمایش داده می‌شود"

#. config.garden.plans
#: schema.json
msgctxt "fn"
msgid "Care plans link"
msgstr "لینک طرح‌های نگهداری باغ"

#. config.garden.plans
#: schema.json
msgctxt "fh"
msgid "Link to the page with garden care plans and prices"
msgstr "لینک صفحه برنامه‌ها و قیمت‌های مراقبت از باغ"

#. config.garden.notice
#: schema.json
msgctxt "fh"
msgid "Short note shown in the footer, e.g. Fully insured, all planting comes with a 12 month guarantee."
msgstr "یادداشت کوتاهی که در پاورقی نمایش داده می‌شود، برای مثال: با بیمه کامل، تمام کاشت‌ها دارای ضمانت دوازده‌ماهه هستند."

#. config.garden.action-bar
#: schema.json
msgctxt "fh"
msgid "Show call and quote buttons at the bottom of the screen on phones"
msgstr "در گوشی‌ها، دکمه‌های تماس و نقل‌قول را در پایین صفحه نمایش دهید."

#. config.garden.hours
#: schema.json
msgctxt "fn"
msgid "Office hours"
msgstr "ساعات اداری"

#. config.garden.hours
#: schema.json
msgctxt "fh"
msgid "Office hours for each day of the week"
msgstr "ساعات اداری برای هر روز هفته"

