#. config.garden
#: schema.json
msgctxt "st"
msgid "grove::garden"
msgstr "Врт"

#. config.garden.name
#: schema.json
msgctxt "fh"
msgid "Name of the gardening, landscaping or garden design business"
msgstr "Назив предузећа за баштованство, уређење пејзажа или дизајн врта"

#. config.garden.business-type
#: schema.json
msgctxt "op"
msgid "Gardener and landscaper"
msgstr "Вртлар и пејзажни уређивач"

#. config.garden.business-type
#: schema.json
msgctxt "op"
msgid "Landscape contractor"
msgstr "Извођач радова на уређењу пејзажа"

#. config.garden.business-type
#: schema.json
msgctxt "op"
msgid "Garden design studio"
msgstr "Студио за дизајн вртова"

#. config.garden.business-type
#: schema.json
msgctxt "op"
msgid "Garden centre or nursery"
msgstr "Вртни центар или расадник"

#. config.garden.business-type
#: schema.json
msgctxt "op"
msgid "Other garden business"
msgstr "Друга вртларска делатност"

#. config.garden.areas
#: schema.json
msgctxt "fn"
msgid "Service area"
msgstr "Подручје пружања услуга"

#. config.garden.areas
#: schema.json
msgctxt "fh"
msgid "Towns and areas you work in, separated by commas, shown in the top bar and the footer"
msgstr "Градови и области у којима радите, раздвојени зарезима, приказани у горњој траци и подножју."

#. config.garden.email
#: schema.json
msgctxt "fh"
msgid "Email address for quotes, site visits and garden care enquiries"
msgstr "Е-пошта за захтеве за понуде, обиласке локације и упите о нези врта"

#. config.garden.announcement
#: schema.json
msgctxt "fh"
msgid "Short note shown at the top of every page, e.g. Autumn tidy-ups: book your slot before November"
msgstr "Кратки подсетник приказан на врху сваке странице, нпр. Јесење чистке: резервишите свој термин пре новембра"

#. config.garden.quote
#: schema.json
msgctxt "fn"
msgid "Quote link"
msgstr "Линк за понуду"

#. config.garden.quote
#: schema.json
msgctxt "fh"
msgid "Link to the quote or site visit request page, shown as a button in the header"
msgstr "Линк до странице за захтев за понуду или посету објекту, приказан као дугме у заглављу"

#. config.garden.plans
#: schema.json
msgctxt "fn"
msgid "Care plans link"
msgstr "Линк ка пакетима одржавања"

#. config.garden.plans
#: schema.json
msgctxt "fh"
msgid "Link to the page with garden care plans and prices"
msgstr "Линк до странице са плановима и ценама за негу баште"

#. config.garden.notice
#: schema.json
msgctxt "fh"
msgid "Short note shown in the footer, e.g. Fully insured, all planting comes with a 12 month guarantee."
msgstr "Кратка напомена приказана у подножју, нпр. Потпуно осигурано, све садње долазе са 12-месечном гаранцијом."

#. config.garden.action-bar
#: schema.json
msgctxt "fh"
msgid "Show call and quote buttons at the bottom of the screen on phones"
msgstr "Прикажи дугмад за позив и цитат на дну екрана на телефонима"

#. config.garden.hours
#: schema.json
msgctxt "fn"
msgid "Office hours"
msgstr "Радно време"

#. config.garden.hours
#: schema.json
msgctxt "fh"
msgid "Office hours for each day of the week"
msgstr "Радно време сваког дана у недељи"

