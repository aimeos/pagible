#. config.garden
#: schema.json
msgctxt "st"
msgid "grove::garden"
msgstr "花園"

#. config.garden.name
#: schema.json
msgctxt "fh"
msgid "Name of the gardening, landscaping or garden design business"
msgstr "園藝、景觀設計或花園設計公司的名稱"

#. config.garden.business-type
#: schema.json
msgctxt "op"
msgid "Gardener and landscaper"
msgstr "園丁與景觀設計師"

#. config.garden.business-type
#: schema.json
msgctxt "op"
msgid "Landscape contractor"
msgstr "景觀工程承包商"

#. config.garden.business-type
#: schema.json
msgctxt "op"
msgid "Garden design studio"
msgstr "庭園設計工作室"

#. config.garden.business-type
#: schema.json
msgctxt "op"
msgid "Garden centre or nursery"
msgstr "園藝中心或苗圃"

#. config.garden.business-type
#: schema.json
msgctxt "op"
msgid "Other garden business"
msgstr "其他園藝業務"

#. config.garden.areas
#: schema.json
msgctxt "fn"
msgid "Service area"
msgstr "服務範圍"

#. config.garden.areas
#: schema.json
msgctxt "fh"
msgid "Towns and areas you work in, separated by commas, shown in the top bar and the footer"
msgstr "您所服務的城鎮及地區（以逗號分隔），顯示於頂部橫桿及頁尾處"

#. config.garden.email
#: schema.json
msgctxt "fh"
msgid "Email address for quotes, site visits and garden care enquiries"
msgstr "用於索取報價、預約實地勘查及園藝護理諮詢的電子郵件地址"

#. config.garden.announcement
#: schema.json
msgctxt "fh"
msgid "Short note shown at the top of every page, e.g. Autumn tidy-ups: book your slot before November"
msgstr "每頁頂端顯示的簡短提示，例如：「秋季大掃除：請於十一月前預約時段」"

#. config.garden.quote
#: schema.json
msgctxt "fn"
msgid "Quote link"
msgstr "報價連結"

#. config.garden.quote
#: schema.json
msgctxt "fh"
msgid "Link to the quote or site visit request page, shown as a button in the header"
msgstr "引用內容或現場勘查申請頁面的連結，以頁首按鈕的形式顯示"

#. config.garden.plans
#: schema.json
msgctxt "fn"
msgid "Care plans link"
msgstr "養護方案連結"

#. config.garden.plans
#: schema.json
msgctxt "fh"
msgid "Link to the page with garden care plans and prices"
msgstr "園藝養護方案與價格頁面的連結"

#. config.garden.notice
#: schema.json
msgctxt "fh"
msgid "Short note shown in the footer, e.g. Fully insured, all planting comes with a 12 month guarantee."
msgstr "頁尾顯示的簡短說明，例如：「已全額投保，所有植栽均享有 12 個月保固。」"

#. config.garden.action-bar
#: schema.json
msgctxt "fh"
msgid "Show call and quote buttons at the bottom of the screen on phones"
msgstr "在手機上於螢幕底部顯示「致電」和「報價」按鈕"

#. config.garden.hours
#: schema.json
msgctxt "fn"
msgid "Office hours"
msgstr "辦公時間"

#. config.garden.hours
#: schema.json
msgctxt "fh"
msgid "Office hours for each day of the week"
msgstr "每週各天的辦公時間"

#. config.theme
#: schema.json
msgctxt "st"
msgid "grove::theme"
msgstr "主題"
