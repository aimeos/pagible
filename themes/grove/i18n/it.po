#. config.garden
#: schema.json
msgctxt "st"
msgid "grove::garden"
msgstr "Giardino"

#. config.garden.name
#: schema.json
msgctxt "fh"
msgid "Name of the gardening, landscaping or garden design business"
msgstr "Nome dell'impresa di giardinaggio, paesaggistica o progettazione di giardini"

#. config.garden.business-type
#: schema.json
msgctxt "op"
msgid "Gardener and landscaper"
msgstr "Giardiniere e paesaggista"

#. config.garden.business-type
#: schema.json
msgctxt "op"
msgid "Landscape contractor"
msgstr "Impresa di opere a verde"

#. config.garden.business-type
#: schema.json
msgctxt "op"
msgid "Garden design studio"
msgstr "Studio di progettazione di giardini"

#. config.garden.business-type
#: schema.json
msgctxt "op"
msgid "Garden centre or nursery"
msgstr "Garden center o vivaio"

#. config.garden.business-type
#: schema.json
msgctxt "op"
msgid "Other garden business"
msgstr "Altra attività di giardinaggio"

#. config.garden.areas
#: schema.json
msgctxt "fn"
msgid "Service area"
msgstr "Zona di servizio"

#. config.garden.areas
#: schema.json
msgctxt "fh"
msgid "Towns and areas you work in, separated by commas, shown in the top bar and the footer"
msgstr "Comuni e zone in cui lavori, separati da virgole, mostrati nella barra superiore e nel footer"

#. config.garden.email
#: schema.json
msgctxt "fh"
msgid "Email address for quotes, site visits and garden care enquiries"
msgstr "Indirizzo e-mail per preventivi, sopralluoghi e richieste di manutenzione del giardino"

#. config.garden.announcement
#: schema.json
msgctxt "fh"
msgid "Short note shown at the top of every page, e.g. Autumn tidy-ups: book your slot before November"
msgstr "Breve avviso mostrato in cima a ogni pagina, ad es. Pulizie d'autunno: prenota il tuo intervento entro novembre"

#. config.garden.quote
#: schema.json
msgctxt "fn"
msgid "Quote link"
msgstr "Link al preventivo"

#. config.garden.quote
#: schema.json
msgctxt "fh"
msgid "Link to the quote or site visit request page, shown as a button in the header"
msgstr "Link alla pagina di richiesta preventivo o sopralluogo, mostrato come pulsante nell'intestazione"

#. config.garden.plans
#: schema.json
msgctxt "fn"
msgid "Care plans link"
msgstr "Link ai piani di manutenzione"

#. config.garden.plans
#: schema.json
msgctxt "fh"
msgid "Link to the page with garden care plans and prices"
msgstr "Link alla pagina con i piani di manutenzione del giardino e i prezzi"

#. config.garden.notice
#: schema.json
msgctxt "fh"
msgid "Short note shown in the footer, e.g. Fully insured, all planting comes with a 12 month guarantee."
msgstr "Breve nota mostrata nel footer, ad es. Completamente assicurati, tutte le piantumazioni sono garantite 12 mesi."

#. config.garden.action-bar
#: schema.json
msgctxt "fh"
msgid "Show call and quote buttons at the bottom of the screen on phones"
msgstr "Mostra i pulsanti di chiamata e preventivo in fondo allo schermo sugli smartphone"

#. config.garden.hours
#: schema.json
msgctxt "fn"
msgid "Office hours"
msgstr "Orari d'ufficio"

#. config.garden.hours
#: schema.json
msgctxt "fh"
msgid "Office hours for each day of the week"
msgstr "Orari dello studio per ogni giorno della settimana"

#. config.theme
#: schema.json
msgctxt "st"
msgid "grove::theme"
msgstr "Tema"
