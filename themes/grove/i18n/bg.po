#. config.garden
#: schema.json
msgctxt "st"
msgid "grove::garden"
msgstr "Градина"

#. config.garden.name
#: schema.json
msgctxt "fh"
msgid "Name of the gardening, landscaping or garden design business"
msgstr "Име на фирмата за градинарство, озеленяване или градински дизайн"

#. config.garden.business-type
#: schema.json
msgctxt "op"
msgid "Gardener and landscaper"
msgstr "Градинар и озеленител"

#. config.garden.business-type
#: schema.json
msgctxt "op"
msgid "Landscape contractor"
msgstr "Фирма за озеленяване"

#. config.garden.business-type
#: schema.json
msgctxt "op"
msgid "Garden design studio"
msgstr "Студио за градински дизайн"

#. config.garden.business-type
#: schema.json
msgctxt "op"
msgid "Garden centre or nursery"
msgstr "Градински център или разсадник"

#. config.garden.business-type
#: schema.json
msgctxt "op"
msgid "Other garden business"
msgstr "Друг градински бизнес"

#. config.garden.areas
#: schema.json
msgctxt "fn"
msgid "Service area"
msgstr "Район на обслужване"

#. config.garden.areas
#: schema.json
msgctxt "fh"
msgid "Towns and areas you work in, separated by commas, shown in the top bar and the footer"
msgstr "Населени места и райони, в които работите, разделени със запетаи; показват се в горната лента и във футъра"

#. config.garden.email
#: schema.json
msgctxt "fh"
msgid "Email address for quotes, site visits and garden care enquiries"
msgstr "Имейл адрес за оферти, огледи на място и запитвания за поддръжка на градини"

#. config.garden.announcement
#: schema.json
msgctxt "fh"
msgid "Short note shown at the top of every page, e.g. Autumn tidy-ups: book your slot before November"
msgstr "Кратко съобщение в горната част на всяка страница, напр. Есенно почистване на градината: запазете час преди ноември"

#. config.garden.quote
#: schema.json
msgctxt "fn"
msgid "Quote link"
msgstr "Линк за оферта"

#. config.garden.quote
#: schema.json
msgctxt "fh"
msgid "Link to the quote or site visit request page, shown as a button in the header"
msgstr "Линк към страницата за заявка на оферта или оглед, показва се като бутон в хедъра"

#. config.garden.plans
#: schema.json
msgctxt "fn"
msgid "Care plans link"
msgstr "Линк към плановете за поддръжка"

#. config.garden.plans
#: schema.json
msgctxt "fh"
msgid "Link to the page with garden care plans and prices"
msgstr "Линк към страницата с плановете за поддръжка на градини и цените"

#. config.garden.notice
#: schema.json
msgctxt "fh"
msgid "Short note shown in the footer, e.g. Fully insured, all planting comes with a 12 month guarantee."
msgstr "Кратка бележка във футъра, напр. Напълно застраховани, всички засаждания са с 12 месеца гаранция."

#. config.garden.action-bar
#: schema.json
msgctxt "fh"
msgid "Show call and quote buttons at the bottom of the screen on phones"
msgstr "Показване на бутоните за обаждане и оферта в долната част на екрана на телефони"

#. config.garden.hours
#: schema.json
msgctxt "fn"
msgid "Office hours"
msgstr "Работно време"

#. config.garden.hours
#: schema.json
msgctxt "fh"
msgid "Office hours for each day of the week"
msgstr "Работно време на кантората за всеки ден от седмицата"

#. config.theme
#: schema.json
msgctxt "st"
msgid "grove::theme"
msgstr "Тема"
