#. config.garden
#: schema.json
msgctxt "st"
msgid "grove::garden"
msgstr "Κήπος"

#. config.garden.name
#: schema.json
msgctxt "fh"
msgid "Name of the gardening, landscaping or garden design business"
msgstr "Όνομα της επιχείρησης κηπουρικής, διαμόρφωσης τοπίου ή σχεδιασμού κήπων"

#. config.garden.business-type
#: schema.json
msgctxt "op"
msgid "Gardener and landscaper"
msgstr "Κηπουρός και αρχιτέκτονας τοπίου"

#. config.garden.business-type
#: schema.json
msgctxt "op"
msgid "Landscape contractor"
msgstr "Εργολάβος διαμόρφωσης τοπίου"

#. config.garden.business-type
#: schema.json
msgctxt "op"
msgid "Garden design studio"
msgstr "Στούντιο σχεδιασμού κήπων"

#. config.garden.business-type
#: schema.json
msgctxt "op"
msgid "Garden centre or nursery"
msgstr "Κέντρο κηπουρικής ή φυτώριο"

#. config.garden.business-type
#: schema.json
msgctxt "op"
msgid "Other garden business"
msgstr "Άλλη επιχείρηση κήπου"

#. config.garden.areas
#: schema.json
msgctxt "fn"
msgid "Service area"
msgstr "Περιοχή εξυπηρέτησης"

#. config.garden.areas
#: schema.json
msgctxt "fh"
msgid "Towns and areas you work in, separated by commas, shown in the top bar and the footer"
msgstr "Πόλεις και περιοχές όπου εργάζεστε, χωρισμένες με κόμμα· εμφανίζονται στην επάνω μπάρα και στο υποσέλιδο"

#. config.garden.email
#: schema.json
msgctxt "fh"
msgid "Email address for quotes, site visits and garden care enquiries"
msgstr "Διεύθυνση email για προσφορές, αυτοψίες και αιτήματα φροντίδας κήπου"

#. config.garden.announcement
#: schema.json
msgctxt "fh"
msgid "Short note shown at the top of every page, e.g. Autumn tidy-ups: book your slot before November"
msgstr "Σύντομη ανακοίνωση στην κορυφή κάθε σελίδας, π.χ. Φθινοπωρινός καθαρισμός κήπου: κλείστε ραντεβού πριν από τον Νοέμβριο"

#. config.garden.quote
#: schema.json
msgctxt "fn"
msgid "Quote link"
msgstr "Σύνδεσμος αίτησης προσφοράς"

#. config.garden.quote
#: schema.json
msgctxt "fh"
msgid "Link to the quote or site visit request page, shown as a button in the header"
msgstr "Σύνδεσμος προς τη σελίδα αιτήματος προσφοράς ή αυτοψίας, εμφανίζεται ως κουμπί στην κεφαλίδα"

#. config.garden.plans
#: schema.json
msgctxt "fn"
msgid "Care plans link"
msgstr "Σύνδεσμος προγραμμάτων φροντίδας"

#. config.garden.plans
#: schema.json
msgctxt "fh"
msgid "Link to the page with garden care plans and prices"
msgstr "Σύνδεσμος προς τη σελίδα με τα προγράμματα φροντίδας κήπου και τις τιμές"

#. config.garden.notice
#: schema.json
msgctxt "fh"
msgid "Short note shown in the footer, e.g. Fully insured, all planting comes with a 12 month guarantee."
msgstr "Σύντομο σημείωμα στο υποσέλιδο, π.χ. Πλήρως ασφαλισμένοι, όλες οι φυτεύσεις έχουν εγγύηση 12 μηνών."

#. config.garden.action-bar
#: schema.json
msgctxt "fh"
msgid "Show call and quote buttons at the bottom of the screen on phones"
msgstr "Εμφάνιση κουμπιών κλήσης και προσφοράς στο κάτω μέρος της οθόνης σε κινητά"

#. config.garden.hours
#: schema.json
msgctxt "fn"
msgid "Office hours"
msgstr "Ώρες γραφείου"

#. config.garden.hours
#: schema.json
msgctxt "fh"
msgid "Office hours for each day of the week"
msgstr "Ώρες λειτουργίας του γραφείου για κάθε ημέρα της εβδομάδας"

#. config.theme
#: schema.json
msgctxt "st"
msgid "grove::theme"
msgstr "Θέμα"
