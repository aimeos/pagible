#. config.garden
#: schema.json
msgctxt "st"
msgid "grove::garden"
msgstr "Jardin"

#. config.garden.name
#: schema.json
msgctxt "fh"
msgid "Name of the gardening, landscaping or garden design business"
msgstr "Nom de l'entreprise de jardinage, d'aménagement paysager ou de conception de jardins"

#. config.garden.business-type
#: schema.json
msgctxt "op"
msgid "Gardener and landscaper"
msgstr "Jardinier paysagiste"

#. config.garden.business-type
#: schema.json
msgctxt "op"
msgid "Landscape contractor"
msgstr "Entreprise d'aménagement paysager"

#. config.garden.business-type
#: schema.json
msgctxt "op"
msgid "Garden design studio"
msgstr "Studio de conception de jardins"

#. config.garden.business-type
#: schema.json
msgctxt "op"
msgid "Garden centre or nursery"
msgstr "Jardinerie ou pépinière"

#. config.garden.business-type
#: schema.json
msgctxt "op"
msgid "Other garden business"
msgstr "Autre entreprise de jardinage"

#. config.garden.areas
#: schema.json
msgctxt "fn"
msgid "Service area"
msgstr "Zone d'intervention"

#. config.garden.areas
#: schema.json
msgctxt "fh"
msgid "Towns and areas you work in, separated by commas, shown in the top bar and the footer"
msgstr "Communes et secteurs où vous intervenez, séparés par des virgules, affichés dans la barre supérieure et le pied de page"

#. config.garden.email
#: schema.json
msgctxt "fh"
msgid "Email address for quotes, site visits and garden care enquiries"
msgstr "Adresse e-mail pour les demandes de devis, de visite sur place et d'entretien de jardin"

#. config.garden.announcement
#: schema.json
msgctxt "fh"
msgid "Short note shown at the top of every page, e.g. Autumn tidy-ups: book your slot before November"
msgstr "Courte annonce affichée en haut de chaque page, p. ex. Nettoyage d'automne : réservez votre créneau avant novembre"

#. config.garden.quote
#: schema.json
msgctxt "fn"
msgid "Quote link"
msgstr "Lien de devis"

#. config.garden.quote
#: schema.json
msgctxt "fh"
msgid "Link to the quote or site visit request page, shown as a button in the header"
msgstr "Lien vers la page de demande de devis ou de visite, affiché sous forme de bouton dans l'en-tête"

#. config.garden.plans
#: schema.json
msgctxt "fn"
msgid "Care plans link"
msgstr "Lien vers les formules d'entretien"

#. config.garden.plans
#: schema.json
msgctxt "fh"
msgid "Link to the page with garden care plans and prices"
msgstr "Lien vers la page des formules d'entretien de jardin et de leurs tarifs"

#. config.garden.notice
#: schema.json
msgctxt "fh"
msgid "Short note shown in the footer, e.g. Fully insured, all planting comes with a 12 month guarantee."
msgstr "Courte note affichée dans le pied de page, p. ex. Entièrement assurés, toutes nos plantations sont garanties 12 mois."

#. config.garden.action-bar
#: schema.json
msgctxt "fh"
msgid "Show call and quote buttons at the bottom of the screen on phones"
msgstr "Afficher les boutons d'appel et de devis en bas de l'écran sur mobile"

#. config.garden.hours
#: schema.json
msgctxt "fn"
msgid "Office hours"
msgstr "Heures d'ouverture"

#. config.garden.hours
#: schema.json
msgctxt "fh"
msgid "Office hours for each day of the week"
msgstr "Heures d'ouverture du cabinet pour chaque jour de la semaine"

#. config.theme
#: schema.json
msgctxt "st"
msgid "grove::theme"
msgstr "Thème"
