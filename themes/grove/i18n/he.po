#. config.garden
#: schema.json
msgctxt "st"
msgid "grove::garden"
msgstr "גינה"

#. config.garden.name
#: schema.json
msgctxt "fh"
msgid "Name of the gardening, landscaping or garden design business"
msgstr "שם עסק הגינון, פיתוח הנוף או עיצוב הגינות"

#. config.garden.business-type
#: schema.json
msgctxt "op"
msgid "Gardener and landscaper"
msgstr "גנן ומעצב נוף"

#. config.garden.business-type
#: schema.json
msgctxt "op"
msgid "Landscape contractor"
msgstr "קבלן פיתוח נוף"

#. config.garden.business-type
#: schema.json
msgctxt "op"
msgid "Garden design studio"
msgstr "סטודיו לעיצוב גינות"

#. config.garden.business-type
#: schema.json
msgctxt "op"
msgid "Garden centre or nursery"
msgstr "משתלה או מרכז גינון"

#. config.garden.business-type
#: schema.json
msgctxt "op"
msgid "Other garden business"
msgstr "עסק גינון אחר"

#. config.garden.areas
#: schema.json
msgctxt "fn"
msgid "Service area"
msgstr "אזור שירות"

#. config.garden.areas
#: schema.json
msgctxt "fh"
msgid "Towns and areas you work in, separated by commas, shown in the top bar and the footer"
msgstr "יישובים ואזורים שבהם אתם עובדים, מופרדים בפסיקים; מוצגים בסרגל העליון ובכותרת התחתונה"

#. config.garden.email
#: schema.json
msgctxt "fh"
msgid "Email address for quotes, site visits and garden care enquiries"
msgstr "כתובת אימייל לבקשות הצעת מחיר, סיורים בשטח ופניות בנושא טיפול בגינה"

#. config.garden.announcement
#: schema.json
msgctxt "fh"
msgid "Short note shown at the top of every page, e.g. Autumn tidy-ups: book your slot before November"
msgstr "הודעה קצרה בראש כל עמוד, לדוגמה: ניקוי גינה לקראת החורף: הזמינו מקום לפני נובמבר"

#. config.garden.quote
#: schema.json
msgctxt "fn"
msgid "Quote link"
msgstr "קישור להצעת מחיר"

#. config.garden.quote
#: schema.json
msgctxt "fh"
msgid "Link to the quote or site visit request page, shown as a button in the header"
msgstr "קישור לעמוד בקשת הצעת מחיר או סיור בשטח, מוצג ככפתור בכותרת העליונה"

#. config.garden.plans
#: schema.json
msgctxt "fn"
msgid "Care plans link"
msgstr "קישור לתוכניות תחזוקה"

#. config.garden.plans
#: schema.json
msgctxt "fh"
msgid "Link to the page with garden care plans and prices"
msgstr "קישור לעמוד עם תוכניות הטיפול בגינה והמחירים"

#. config.garden.notice
#: schema.json
msgctxt "fh"
msgid "Short note shown in the footer, e.g. Fully insured, all planting comes with a 12 month guarantee."
msgstr "הערה קצרה בכותרת התחתונה, לדוגמה: מבוטחים במלואם, לכל השתילות אחריות ל-12 חודשים."

#. config.garden.action-bar
#: schema.json
msgctxt "fh"
msgid "Show call and quote buttons at the bottom of the screen on phones"
msgstr "הצגת כפתורי התקשרות והצעת מחיר בתחתית המסך בטלפונים"

#. config.garden.hours
#: schema.json
msgctxt "fn"
msgid "Office hours"
msgstr "שעות פעילות"

#. config.garden.hours
#: schema.json
msgctxt "fh"
msgid "Office hours for each day of the week"
msgstr "שעות פעילות המשרד לכל יום בשבוע"

#. config.theme
#: schema.json
msgctxt "st"
msgid "grove::theme"
msgstr "ערכת נושא"
