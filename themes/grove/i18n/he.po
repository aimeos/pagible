#: schema.json
msgctxt "fn"
msgid "Announcement"
msgstr "הודעה"

#. config.garden.announcement
#: schema.json
msgctxt "fh"
msgid "Short note shown at the top of every page, e.g. Autumn tidy-ups: book your slot before November"
msgstr "הודעה קצרה בראש כל עמוד, לדוגמה: ניקוי גינה לקראת החורף: הזמינו מקום לפני נובמבר"

