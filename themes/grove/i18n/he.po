msgstr "קישור לעמוד עם תוכניות הטיפול בגינה והמחירים"

#. config.garden.price-range
#: schema.json
msgctxt "fn"
msgid "Price range"
msgstr "טווח מחירים"

#. config.garden.price-range
#: schema.json
msgctxt "fh"
msgid "Price level of the business, e.g. ££ or €€"
msgstr "רמת המחירים של העסק, לדוגמה ££ או €€"

#. config.garden.notice
#: schema.json
msgctxt "fn"
msgid "Notice"
msgstr "הערה"

#. config.garden.notice
#: schema.json
msgctxt "fh"
msgid "Short note shown in the footer, e.g. Fully insured, all planting comes with a 12 month guarantee."
msgstr "הערה קצרה בכותרת התחתונה, לדוגמה: מבוטחים במלואם, לכל השתילות אחריות ל-12 חודשים."

#. config.garden.action-bar
