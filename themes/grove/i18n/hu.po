#. config.garden
#: schema.json
msgctxt "st"
msgid "grove::garden"
msgstr "Kert"

#. config.garden.name
#: schema.json
msgctxt "fh"
msgid "Name of the gardening, landscaping or garden design business"
msgstr "A kertészeti, kertépítő vagy kerttervező vállalkozás neve"

#. config.garden.business-type
#: schema.json
msgctxt "op"
msgid "Gardener and landscaper"
msgstr "Kertész és kertépítő"

#. config.garden.business-type
#: schema.json
msgctxt "op"
msgid "Landscape contractor"
msgstr "Kertépítő vállalkozás"

#. config.garden.business-type
#: schema.json
msgctxt "op"
msgid "Garden design studio"
msgstr "Kerttervező stúdió"

#. config.garden.business-type
#: schema.json
msgctxt "op"
msgid "Garden centre or nursery"
msgstr "Kertészeti áruház vagy faiskola"

#. config.garden.business-type
#: schema.json
msgctxt "op"
msgid "Other garden business"
msgstr "Egyéb kertészeti vállalkozás"

#. config.garden.areas
#: schema.json
msgctxt "fn"
msgid "Service area"
msgstr "Szolgáltatási terület"

#. config.garden.areas
#: schema.json
msgctxt "fh"
msgid "Towns and areas you work in, separated by commas, shown in the top bar and the footer"
msgstr "Települések és körzetek, ahol dolgozik, vesszővel elválasztva; a felső sávban és a láblécben jelennek meg"

#. config.garden.email
#: schema.json
msgctxt "fh"
msgid "Email address for quotes, site visits and garden care enquiries"
msgstr "E-mail-cím árajánlatkérésekhez, helyszíni felmérésekhez és kertgondozási megkeresésekhez"

#. config.garden.announcement
#: schema.json
msgctxt "fh"
msgid "Short note shown at the top of every page, e.g. Autumn tidy-ups: book your slot before November"
msgstr "Rövid közlemény minden oldal tetején, pl. Őszi kertrendezés: foglaljon időpontot november előtt"

#. config.garden.quote
#: schema.json
msgctxt "fn"
msgid "Quote link"
msgstr "Árajánlat link"

#. config.garden.quote
#: schema.json
msgctxt "fh"
msgid "Link to the quote or site visit request page, shown as a button in the header"
msgstr "Link az árajánlat- vagy helyszíni felmérés-kérő oldalra, gombként jelenik meg a fejlécben"

#. config.garden.plans
#: schema.json
msgctxt "fn"
msgid "Care plans link"
msgstr "Gondozási csomagok link"

#. config.garden.plans
#: schema.json
msgctxt "fh"
msgid "Link to the page with garden care plans and prices"
msgstr "Link a kertgondozási csomagokat és árakat bemutató oldalra"

#. config.garden.notice
#: schema.json
msgctxt "fh"
msgid "Short note shown in the footer, e.g. Fully insured, all planting comes with a 12 month guarantee."
msgstr "Rövid megjegyzés a láblécben, pl. Teljes körű biztosítás, minden ültetésre 12 hónap garanciát vállalunk."

#. config.garden.action-bar
#: schema.json
msgctxt "fh"
msgid "Show call and quote buttons at the bottom of the screen on phones"
msgstr "Hívás és árajánlat gombok megjelenítése telefonokon a képernyő alján"

#. config.garden.hours
#: schema.json
msgctxt "fn"
msgid "Office hours"
msgstr "Ügyfélfogadási idő"

#. config.garden.hours
#: schema.json
msgctxt "fh"
msgid "Office hours for each day of the week"
msgstr "Ügyfélfogadási idő a hét minden napjára"

