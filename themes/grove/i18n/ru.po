#. config.garden
#: schema.json
msgctxt "st"
msgid "grove::garden"
msgstr "Сад"

#. config.garden.name
#: schema.json
msgctxt "fh"
msgid "Name of the gardening, landscaping or garden design business"
msgstr "Название компании по уходу за садом, ландшафтным работам или ландшафтному дизайну"

#. config.garden.business-type
#: schema.json
msgctxt "op"
msgid "Gardener and landscaper"
msgstr "Садовник и ландшафтный мастер"

#. config.garden.business-type
#: schema.json
msgctxt "op"
msgid "Landscape contractor"
msgstr "Ландшафтная строительная компания"

#. config.garden.business-type
#: schema.json
msgctxt "op"
msgid "Garden design studio"
msgstr "Студия ландшафтного дизайна"

#. config.garden.business-type
#: schema.json
msgctxt "op"
msgid "Garden centre or nursery"
msgstr "Садовый центр или питомник"

#. config.garden.business-type
#: schema.json
msgctxt "op"
msgid "Other garden business"
msgstr "Другой садовый бизнес"

#. config.garden.areas
#: schema.json
msgctxt "fn"
msgid "Service area"
msgstr "Зона обслуживания"

#. config.garden.areas
#: schema.json
msgctxt "fh"
msgid "Towns and areas you work in, separated by commas, shown in the top bar and the footer"
msgstr "Населённые пункты и районы, в которых вы работаете, через запятую; отображаются в верхней панели и в подвале"

#. config.garden.email
#: schema.json
msgctxt "fh"
msgid "Email address for quotes, site visits and garden care enquiries"
msgstr "Электронная почта для запросов на расчёт стоимости, выезд на участок и уход за садом"

#. config.garden.announcement
#: schema.json
msgctxt "fh"
msgid "Short note shown at the top of every page, e.g. Autumn tidy-ups: book your slot before November"
msgstr "Короткое объявление вверху каждой страницы, напр. Осенняя уборка сада: запишитесь до ноября"

#. config.garden.quote
#: schema.json
msgctxt "fn"
msgid "Quote link"
msgstr "Ссылка на расчёт стоимости"

#. config.garden.quote
#: schema.json
msgctxt "fh"
msgid "Link to the quote or site visit request page, shown as a button in the header"
msgstr "Ссылка на страницу заявки на расчёт стоимости или выезд на участок, отображается кнопкой в шапке"

#. config.garden.plans
#: schema.json
msgctxt "fn"
msgid "Care plans link"
msgstr "Ссылка на планы ухода"

#. config.garden.plans
#: schema.json
msgctxt "fh"
msgid "Link to the page with garden care plans and prices"
msgstr "Ссылка на страницу с планами ухода за садом и ценами"

#. config.garden.notice
#: schema.json
msgctxt "fh"
msgid "Short note shown in the footer, e.g. Fully insured, all planting comes with a 12 month guarantee."
msgstr "Короткая заметка в подвале, напр. Полная страховка, на все посадки даём гарантию 12 месяцев."

#. config.garden.action-bar
#: schema.json
msgctxt "fh"
msgid "Show call and quote buttons at the bottom of the screen on phones"
msgstr "Показывать кнопки звонка и расчёта стоимости внизу экрана на телефонах"

#. config.garden.hours
#: schema.json
msgctxt "fn"
msgid "Office hours"
msgstr "Часы работы"

#. config.garden.hours
#: schema.json
msgctxt "fh"
msgid "Office hours for each day of the week"
msgstr "Часы работы офиса для каждого дня недели"

#. config.theme
#: schema.json
msgctxt "st"
msgid "grove::theme"
msgstr "Тема оформления"
