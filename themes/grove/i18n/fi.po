#. config.garden
#: schema.json
msgctxt "st"
msgid "grove::garden"
msgstr "Puutarha"

#. config.garden.name
#: schema.json
msgctxt "fh"
msgid "Name of the gardening, landscaping or garden design business"
msgstr "Puutarha-, viherrakennus- tai puutarhasuunnitteluyrityksen nimi"

#. config.garden.business-type
#: schema.json
msgctxt "op"
msgid "Gardener and landscaper"
msgstr "Puutarhuri ja viherrakentaja"

#. config.garden.business-type
#: schema.json
msgctxt "op"
msgid "Landscape contractor"
msgstr "Viherrakennusurakoitsija"

#. config.garden.business-type
#: schema.json
msgctxt "op"
msgid "Garden design studio"
msgstr "Puutarhasuunnittelustudio"

#. config.garden.business-type
#: schema.json
msgctxt "op"
msgid "Garden centre or nursery"
msgstr "Puutarhamyymälä tai taimitarha"

#. config.garden.business-type
#: schema.json
msgctxt "op"
msgid "Other garden business"
msgstr "Muu puutarha-alan yritys"

#. config.garden.areas
#: schema.json
msgctxt "fn"
msgid "Service area"
msgstr "Toiminta-alue"

#. config.garden.areas
#: schema.json
msgctxt "fh"
msgid "Towns and areas you work in, separated by commas, shown in the top bar and the footer"
msgstr "Paikkakunnat ja alueet, joilla työskentelet, pilkuilla erotettuina; näytetään yläpalkissa ja alatunnisteessa"

#. config.garden.email
#: schema.json
msgctxt "fh"
msgid "Email address for quotes, site visits and garden care enquiries"
msgstr "Sähköpostiosoite tarjous-, kartoituskäynti- ja puutarhanhoitopyynnöille"

#. config.garden.announcement
#: schema.json
msgctxt "fh"
msgid "Short note shown at the top of every page, e.g. Autumn tidy-ups: book your slot before November"
msgstr "Lyhyt ilmoitus jokaisen sivun yläosassa, esim. Syyssiivous puutarhaan: varaa aikasi ennen marraskuuta"

#. config.garden.quote
#: schema.json
msgctxt "fn"
msgid "Quote link"
msgstr "Tarjouslinkki"

#. config.garden.quote
#: schema.json
msgctxt "fh"
msgid "Link to the quote or site visit request page, shown as a button in the header"
msgstr "Linkki tarjous- tai kartoituskäyntipyyntösivulle, näytetään painikkeena ylätunnisteessa"

#. config.garden.plans
#: schema.json
msgctxt "fn"
msgid "Care plans link"
msgstr "Hoitopakettien linkki"

#. config.garden.plans
#: schema.json
msgctxt "fh"
msgid "Link to the page with garden care plans and prices"
msgstr "Linkki sivulle, jolla on puutarhan hoitopaketit ja hinnat"

#. config.garden.notice
#: schema.json
msgctxt "fh"
msgid "Short note shown in the footer, e.g. Fully insured, all planting comes with a 12 month guarantee."
msgstr "Lyhyt teksti alatunnisteessa, esim. Täysin vakuutettu, kaikilla istutuksilla 12 kuukauden takuu."

#. config.garden.action-bar
#: schema.json
msgctxt "fh"
msgid "Show call and quote buttons at the bottom of the screen on phones"
msgstr "Näytä soitto- ja tarjouspainikkeet puhelimissa näytön alareunassa"

#. config.garden.hours
#: schema.json
msgctxt "fn"
msgid "Office hours"
msgstr "Aukioloajat"

#. config.garden.hours
#: schema.json
msgctxt "fh"
msgid "Office hours for each day of the week"
msgstr "Toimiston aukioloajat jokaiselle viikonpäivälle"

#. config.theme
#: schema.json
msgctxt "st"
msgid "grove::theme"
msgstr "Teema"
