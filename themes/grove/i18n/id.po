#. config.garden
#: schema.json
msgctxt "st"
msgid "grove::garden"
msgstr "Taman"

#. config.garden.name
#: schema.json
msgctxt "fh"
msgid "Name of the gardening, landscaping or garden design business"
msgstr "Nama usaha jasa taman, lanskap, atau desain taman"

#. config.garden.business-type
#: schema.json
msgctxt "op"
msgid "Gardener and landscaper"
msgstr "Tukang kebun dan penata taman"

#. config.garden.business-type
#: schema.json
msgctxt "op"
msgid "Landscape contractor"
msgstr "Kontraktor lanskap"

#. config.garden.business-type
#: schema.json
msgctxt "op"
msgid "Garden design studio"
msgstr "Studio desain taman"

#. config.garden.business-type
#: schema.json
msgctxt "op"
msgid "Garden centre or nursery"
msgstr "Pusat perlengkapan taman atau pembibitan"

#. config.garden.business-type
#: schema.json
msgctxt "op"
msgid "Other garden business"
msgstr "Usaha taman lainnya"

#. config.garden.areas
#: schema.json
msgctxt "fn"
msgid "Service area"
msgstr "Wilayah layanan"

#. config.garden.areas
#: schema.json
msgctxt "fh"
msgid "Towns and areas you work in, separated by commas, shown in the top bar and the footer"
msgstr "Kota dan wilayah tempat Anda bekerja, dipisahkan koma, ditampilkan di bilah atas dan footer"

#. config.garden.email
#: schema.json
msgctxt "fh"
msgid "Email address for quotes, site visits and garden care enquiries"
msgstr "Alamat email untuk permintaan penawaran, survei lokasi, dan perawatan taman"

#. config.garden.announcement
#: schema.json
msgctxt "fh"
msgid "Short note shown at the top of every page, e.g. Autumn tidy-ups: book your slot before November"
msgstr "Catatan singkat di bagian atas setiap halaman, mis. Bersih-bersih taman musim gugur: pesan jadwal Anda sebelum November"

#. config.garden.quote
#: schema.json
msgctxt "fn"
msgid "Quote link"
msgstr "Tautan penawaran"

#. config.garden.quote
#: schema.json
msgctxt "fh"
msgid "Link to the quote or site visit request page, shown as a button in the header"
msgstr "Tautan ke halaman permintaan penawaran atau survei lokasi, ditampilkan sebagai tombol di header"

#. config.garden.plans
#: schema.json
msgctxt "fn"
msgid "Care plans link"
msgstr "Tautan paket perawatan"

#. config.garden.plans
#: schema.json
msgctxt "fh"
msgid "Link to the page with garden care plans and prices"
msgstr "Tautan ke halaman paket perawatan taman beserta harganya"

#. config.garden.notice
#: schema.json
msgctxt "fh"
msgid "Short note shown in the footer, e.g. Fully insured, all planting comes with a 12 month guarantee."
msgstr "Catatan singkat di footer, mis. Diasuransikan penuh, semua tanaman bergaransi 12 bulan."

#. config.garden.action-bar
#: schema.json
msgctxt "fh"
msgid "Show call and quote buttons at the bottom of the screen on phones"
msgstr "Tampilkan tombol telepon dan penawaran di bagian bawah layar ponsel"

#. config.garden.hours
#: schema.json
msgctxt "fn"
msgid "Office hours"
msgstr "Jam kantor"

#. config.garden.hours
#: schema.json
msgctxt "fh"
msgid "Office hours for each day of the week"
msgstr "Jam kantor untuk setiap hari dalam seminggu"

#. config.theme
#: schema.json
msgctxt "st"
msgid "grove::theme"
msgstr "Tema"
