#. config.garden
#: schema.json
msgctxt "st"
msgid "grove::garden"
msgstr "정원"

#. config.garden.name
#: schema.json
msgctxt "fh"
msgid "Name of the gardening, landscaping or garden design business"
msgstr "정원 관리, 조경 또는 정원 디자인 업체의 이름"

#. config.garden.business-type
#: schema.json
msgctxt "op"
msgid "Gardener and landscaper"
msgstr "정원사 및 조경사"

#. config.garden.business-type
#: schema.json
msgctxt "op"
msgid "Landscape contractor"
msgstr "조경 시공업체"

#. config.garden.business-type
#: schema.json
msgctxt "op"
msgid "Garden design studio"
msgstr "정원 디자인 스튜디오"

#. config.garden.business-type
#: schema.json
msgctxt "op"
msgid "Garden centre or nursery"
msgstr "원예 센터 또는 묘목장"

#. config.garden.business-type
#: schema.json
msgctxt "op"
msgid "Other garden business"
msgstr "기타 정원 관련 업체"

#. config.garden.areas
#: schema.json
msgctxt "fn"
msgid "Service area"
msgstr "서비스 지역"

#. config.garden.areas
#: schema.json
msgctxt "fh"
msgid "Towns and areas you work in, separated by commas, shown in the top bar and the footer"
msgstr "작업하는 지역과 동네를 쉼표로 구분해 입력하세요. 상단 바와 푸터에 표시됩니다"

#. config.garden.email
#: schema.json
msgctxt "fh"
msgid "Email address for quotes, site visits and garden care enquiries"
msgstr "견적, 현장 방문 및 정원 관리 문의용 이메일 주소"

#. config.garden.announcement
#: schema.json
msgctxt "fh"
msgid "Short note shown at the top of every page, e.g. Autumn tidy-ups: book your slot before November"
msgstr "모든 페이지 상단에 표시되는 짧은 공지, 예: 가을 정원 정리, 11월 전에 예약하세요"

#. config.garden.quote
#: schema.json
msgctxt "fn"
msgid "Quote link"
msgstr "견적 링크"

#. config.garden.quote
#: schema.json
msgctxt "fh"
msgid "Link to the quote or site visit request page, shown as a button in the header"
msgstr "견적 또는 현장 방문 요청 페이지 링크로, 헤더에 버튼으로 표시됩니다"

#. config.garden.plans
#: schema.json
msgctxt "fn"
msgid "Care plans link"
msgstr "관리 플랜 링크"

#. config.garden.plans
#: schema.json
msgctxt "fh"
msgid "Link to the page with garden care plans and prices"
msgstr "정원 관리 플랜과 가격이 안내된 페이지 링크"

#. config.garden.notice
#: schema.json
msgctxt "fh"
msgid "Short note shown in the footer, e.g. Fully insured, all planting comes with a 12 month guarantee."
msgstr "푸터에 표시되는 짧은 안내, 예: 배상 책임 보험 가입, 모든 식재는 12개월 동안 보증합니다."

#. config.garden.action-bar
#: schema.json
msgctxt "fh"
msgid "Show call and quote buttons at the bottom of the screen on phones"
msgstr "휴대폰에서 화면 하단에 전화 및 견적 버튼 표시"

#. config.garden.hours
#: schema.json
msgctxt "fn"
msgid "Office hours"
msgstr "운영 시간"

#. config.garden.hours
#: schema.json
msgctxt "fh"
msgid "Office hours for each day of the week"
msgstr "요일별 사무소 운영 시간"

#. config.theme
#: schema.json
msgctxt "st"
msgid "grove::theme"
msgstr "테마"
