#. config.garden
#: schema.json
msgctxt "st"
msgid "grove::garden"
msgstr "Tuin"

#. config.garden.name
#: schema.json
msgctxt "fh"
msgid "Name of the gardening, landscaping or garden design business"
msgstr "Naam van die tuinmaak-, landskap- of tuinontwerpbesigheid"

#. config.garden.business-type
#: schema.json
msgctxt "op"
msgid "Gardener and landscaper"
msgstr "Tuinier en landskapontwerper"

#. config.garden.business-type
#: schema.json
msgctxt "op"
msgid "Landscape contractor"
msgstr "Landskapskontrakteur"

#. config.garden.business-type
#: schema.json
msgctxt "op"
msgid "Garden design studio"
msgstr "Tuinontwerpsateljee"

#. config.garden.business-type
#: schema.json
msgctxt "op"
msgid "Garden centre or nursery"
msgstr "Tuinsentrum of kwekery"

#. config.garden.business-type
#: schema.json
msgctxt "op"
msgid "Other garden business"
msgstr "Ander tuinbesigheid"

#. config.garden.areas
#: schema.json
msgctxt "fn"
msgid "Service area"
msgstr "Diensgebied"

#. config.garden.areas
#: schema.json
msgctxt "fh"
msgid "Towns and areas you work in, separated by commas, shown in the top bar and the footer"
msgstr "Dorpe en gebiede waarin jy werk, geskei deur kommas, vertoon in die boonste balk en die voetskrif"

#. config.garden.email
#: schema.json
msgctxt "fh"
msgid "Email address for quotes, site visits and garden care enquiries"
msgstr "E-posadres vir kwotasies, terreinbesoeke en navrae oor tuinversorging"

#. config.garden.announcement
#: schema.json
msgctxt "fh"
msgid "Short note shown at the top of every page, e.g. Autumn tidy-ups: book your slot before November"
msgstr "Kort kennisgewing wat bo-aan elke bladsy vertoon word, bv. Herfsopruimings: bespreek jou slot voor November"

#. config.garden.quote
#: schema.json
msgctxt "fn"
msgid "Quote link"
msgstr "Kwotasieskakel"

#. config.garden.quote
#: schema.json
msgctxt "fh"
msgid "Link to the quote or site visit request page, shown as a button in the header"
msgstr "Skakel na die aanhaling- of terreinbesoekversoekbladsy, wat as 'n knoppie in die kopstuk vertoon word."

#. config.garden.plans
#: schema.json
msgctxt "fn"
msgid "Care plans link"
msgstr "Sorgplanne-skakel"

#. config.garden.plans
#: schema.json
msgctxt "fh"
msgid "Link to the page with garden care plans and prices"
msgstr "Skakel na die bladsy met tuinversorgingsplanne en pryse"

#. config.garden.notice
#: schema.json
msgctxt "fh"
msgid "Short note shown in the footer, e.g. Fully insured, all planting comes with a 12 month guarantee."
msgstr "Kort nota in die voetskrif, bv. Volledig verseker, alle aanplanting kom met 'n 12-maande waarborg."

#. config.garden.action-bar
#: schema.json
msgctxt "fh"
msgid "Show call and quote buttons at the bottom of the screen on phones"
msgstr "Wys oproep- en aanhalingsknoppies onderaan die skerm op telefone"

#. config.garden.hours
#: schema.json
msgctxt "fn"
msgid "Office hours"
msgstr "Kantoorure"

#. config.garden.hours
#: schema.json
msgctxt "fh"
msgid "Office hours for each day of the week"
msgstr "Kantoorure vir elke dag van die week"

#. config.theme
#: schema.json
msgctxt "st"
msgid "grove::theme"
msgstr "Tema"
