#. config.garden
#: schema.json
msgctxt "st"
msgid "grove::garden"
msgstr "Jardín"

#. config.garden.name
#: schema.json
msgctxt "fh"
msgid "Name of the gardening, landscaping or garden design business"
msgstr "Nombre de la empresa de jardinería, paisajismo o diseño de jardines"

#. config.garden.business-type
#: schema.json
msgctxt "op"
msgid "Gardener and landscaper"
msgstr "Jardinero y paisajista"

#. config.garden.business-type
#: schema.json
msgctxt "op"
msgid "Landscape contractor"
msgstr "Empresa de paisajismo"

#. config.garden.business-type
#: schema.json
msgctxt "op"
msgid "Garden design studio"
msgstr "Estudio de diseño de jardines"

#. config.garden.business-type
#: schema.json
msgctxt "op"
msgid "Garden centre or nursery"
msgstr "Centro de jardinería o vivero"

#. config.garden.business-type
#: schema.json
msgctxt "op"
msgid "Other garden business"
msgstr "Otra empresa de jardinería"

#. config.garden.areas
#: schema.json
msgctxt "fn"
msgid "Service area"
msgstr "Zona de servicio"

#. config.garden.areas
#: schema.json
msgctxt "fh"
msgid "Towns and areas you work in, separated by commas, shown in the top bar and the footer"
msgstr "Localidades y zonas donde trabajas, separadas por comas, que se muestran en la barra superior y en el pie de página"

#. config.garden.email
#: schema.json
msgctxt "fh"
msgid "Email address for quotes, site visits and garden care enquiries"
msgstr "Correo electrónico para presupuestos, visitas técnicas y consultas de mantenimiento de jardines"

#. config.garden.announcement
#: schema.json
msgctxt "fh"
msgid "Short note shown at the top of every page, e.g. Autumn tidy-ups: book your slot before November"
msgstr "Aviso breve que se muestra en la parte superior de cada página, p. ej. Limpieza de otoño: reserva tu cita antes de noviembre"

#. config.garden.quote
#: schema.json
msgctxt "fn"
msgid "Quote link"
msgstr "Enlace de presupuesto"

#. config.garden.quote
#: schema.json
msgctxt "fh"
msgid "Link to the quote or site visit request page, shown as a button in the header"
msgstr "Enlace a la página para solicitar presupuesto o visita, que se muestra como botón en la cabecera"

#. config.garden.plans
#: schema.json
msgctxt "fn"
msgid "Care plans link"
msgstr "Enlace a planes de mantenimiento"

#. config.garden.plans
#: schema.json
msgctxt "fh"
msgid "Link to the page with garden care plans and prices"
msgstr "Enlace a la página con los planes de mantenimiento de jardín y sus precios"

#. config.garden.notice
#: schema.json
msgctxt "fh"
msgid "Short note shown in the footer, e.g. Fully insured, all planting comes with a 12 month guarantee."
msgstr "Nota breve que se muestra en el pie de página, p. ej. Seguro a todo riesgo; todas las plantaciones tienen 12 meses de garantía."

#. config.garden.action-bar
#: schema.json
msgctxt "fh"
msgid "Show call and quote buttons at the bottom of the screen on phones"
msgstr "Mostrar los botones de llamada y presupuesto en la parte inferior de la pantalla en móviles"

#. config.garden.hours
#: schema.json
msgctxt "fn"
msgid "Office hours"
msgstr "Horario de atención"

#. config.garden.hours
#: schema.json
msgctxt "fh"
msgid "Office hours for each day of the week"
msgstr "Horario de atención para cada día de la semana"

#. config.theme
#: schema.json
msgctxt "st"
msgid "grove::theme"
msgstr "Tema"
