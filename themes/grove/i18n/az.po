#. config.garden
#: schema.json
msgctxt "st"
msgid "grove::garden"
msgstr "Bağ"

#. config.garden.name
#: schema.json
msgctxt "fh"
msgid "Name of the gardening, landscaping or garden design business"
msgstr "Bağçılıq, landşaft dizaynı və ya bağ dizaynı biznesinin adı"

#. config.garden.business-type
#: schema.json
msgctxt "op"
msgid "Gardener and landscaper"
msgstr "Bağban və landşaft dizayneri"

#. config.garden.business-type
#: schema.json
msgctxt "op"
msgid "Landscape contractor"
msgstr "Landşaft podratçısı"

#. config.garden.business-type
#: schema.json
msgctxt "op"
msgid "Garden design studio"
msgstr "Bağ dizayn studiyası"

#. config.garden.business-type
#: schema.json
msgctxt "op"
msgid "Garden centre or nursery"
msgstr "Bağ mərkəzi və ya şitilxana"

#. config.garden.business-type
#: schema.json
msgctxt "op"
msgid "Other garden business"
msgstr "Digər bağçılıq biznesi"

#. config.garden.areas
#: schema.json
msgctxt "fn"
msgid "Service area"
msgstr "Xidmət sahəsi"

#. config.garden.areas
#: schema.json
msgctxt "fh"
msgid "Towns and areas you work in, separated by commas, shown in the top bar and the footer"
msgstr "İşlədiyiniz şəhər və ərazilər, vergüllə ayrılmış, yuxarı çubuğa və altbilməyə göstərilir."

#. config.garden.email
#: schema.json
msgctxt "fh"
msgid "Email address for quotes, site visits and garden care enquiries"
msgstr "Qiymət təklifləri, yerində baxışlar və bağça baxımı sorğuları üçün e-poçt ünvanı"

#. config.garden.announcement
#: schema.json
msgctxt "fh"
msgid "Short note shown at the top of every page, e.g. Autumn tidy-ups: book your slot before November"
msgstr "Hər səhifənin yuxarısında göstərilən qısa qeyd, məsələn: Payız təmizlikləri: noyabra qədər yerinizi bron edin"

#. config.garden.quote
#: schema.json
msgctxt "fn"
msgid "Quote link"
msgstr "Qiymət təklifi linki"

#. config.garden.quote
#: schema.json
msgctxt "fh"
msgid "Link to the quote or site visit request page, shown as a button in the header"
msgstr "Sitat və ya yerində baxış tələbi səhifəsinə keçid, başlıqdakı düymə şəklində göstərilir"

#. config.garden.plans
#: schema.json
msgctxt "fn"
msgid "Care plans link"
msgstr "Qayğı planları linki"

#. config.garden.plans
#: schema.json
msgctxt "fh"
msgid "Link to the page with garden care plans and prices"
msgstr "Bağ baxımı planları və qiymətləri səhifəsinə keçid"

#. config.garden.notice
#: schema.json
msgctxt "fh"
msgid "Short note shown in the footer, e.g. Fully insured, all planting comes with a 12 month guarantee."
msgstr "Ayaqnotda göstərilən qısa qeyd, məsələn: Tam sığortalanmışdır, bütün əkilənlər 12 aylıq zəmanətlə təmin olunur."

#. config.garden.action-bar
#: schema.json
msgctxt "fh"
msgid "Show call and quote buttons at the bottom of the screen on phones"
msgstr "Telefonlarda ekranın aşağı hissəsində zəng və qiymət təklif et düymələrini göstərin"

#. config.garden.hours
#: schema.json
msgctxt "fn"
msgid "Office hours"
msgstr "Ofis saatları"

#. config.garden.hours
#: schema.json
msgctxt "fh"
msgid "Office hours for each day of the week"
msgstr "Həftənin hər günü üçün iş saatları"

