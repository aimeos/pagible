msgstr "Ander tuinbedrijf"

#. config.garden.areas
#: schema.json
msgctxt "fn"
msgid "Service area"
msgstr "Werkgebied"

#. config.garden.areas
#: schema.json
msgctxt "fh"
msgid "Towns and areas you work in, separated by commas, shown in the top bar and the footer"
msgstr "Plaatsen en regio's waar je werkt, gescheiden door komma's, getoond in de bovenste balk en de footer"

#. config.garden.email
#: schema.json
msgctxt "fh"
msgid "Email address for quotes, site visits and garden care enquiries"
msgstr "E-mailadres voor offertes, bezoeken op locatie en vragen over tuinonderhoud"

#. config.garden.announcement
#: schema.json
msgctxt "fh"
msgid "Short note shown at the top of every page, e.g. Autumn tidy-ups: book your slot before November"
msgstr "Korte melding bovenaan elke pagina, bijv. Herfstonderhoud: plan je afspraak vóór november"

#. config.garden.quote
#: schema.json
msgctxt "fn"
msgid "Quote link"
msgstr "Offertelink"

#. config.garden.quote
#: schema.json
msgctxt "fh"
msgid "Link to the quote or site visit request page, shown as a button in the header"
msgstr "Link naar de pagina voor offerte- of bezoekaanvragen, getoond als knop in de header"

#. config.garden.plans
#: schema.json
msgctxt "fn"
msgid "Care plans link"
msgstr "Link naar onderhoudsplannen"

#. config.garden.plans
#: schema.json
msgctxt "fh"
msgid "Link to the page with garden care plans and prices"
msgstr "Link naar de pagina met tuinonderhoudsplannen en prijzen"

#. config.garden.notice
#: schema.json
msgctxt "fh"
msgid "Short note shown in the footer, e.g. Fully insured, all planting comes with a 12 month guarantee."
msgstr "Korte tekst in de footer, bijv. Volledig verzekerd, op alle beplanting zit 12 maanden garantie."

#. config.garden.action-bar
#: schema.json
msgctxt "fh"
msgid "Show call and quote buttons at the bottom of the screen on phones"
msgstr "Bel- en offerteknoppen onderaan het scherm tonen op telefoons"

#. config.garden.hours
#: schema.json
msgctxt "fn"
msgid "Office hours"
msgstr "Kantooruren"

#. config.garden.hours
#: schema.json
msgctxt "fh"
msgid "Office hours for each day of the week"
msgstr "Kantooruren voor elke dag van de week"

