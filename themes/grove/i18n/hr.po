#. config.garden
#: schema.json
msgctxt "st"
msgid "grove::garden"
msgstr "Vrt"

#. config.garden.name
#: schema.json
msgctxt "fh"
msgid "Name of the gardening, landscaping or garden design business"
msgstr "Naziv poduzeća za vrtlarenje, uređenje okoliša ili dizajn vrta"

#. config.garden.business-type
#: schema.json
msgctxt "op"
msgid "Gardener and landscaper"
msgstr "Vrtlar i pejzažist"

#. config.garden.business-type
#: schema.json
msgctxt "op"
msgid "Landscape contractor"
msgstr "Izvođač krajobraznih radova"

#. config.garden.business-type
#: schema.json
msgctxt "op"
msgid "Garden design studio"
msgstr "Studio za dizajn vrtova"

#. config.garden.business-type
#: schema.json
msgctxt "op"
msgid "Garden centre or nursery"
msgstr "Vrtni centar ili rasadnik"

#. config.garden.business-type
#: schema.json
msgctxt "op"
msgid "Other garden business"
msgstr "Ostali vrtni poslovi"

#. config.garden.areas
#: schema.json
msgctxt "fn"
msgid "Service area"
msgstr "Područje usluge"

#. config.garden.areas
#: schema.json
msgctxt "fh"
msgid "Towns and areas you work in, separated by commas, shown in the top bar and the footer"
msgstr "Gradovi i područja u kojima radite, odvojeni zarezima, prikazani u gornjoj traci i podnožju"

#. config.garden.email
#: schema.json
msgctxt "fh"
msgid "Email address for quotes, site visits and garden care enquiries"
msgstr "Adresa e-pošte za ponude, obilaske lokacije i upite o njezi vrta"

#. config.garden.announcement
#: schema.json
msgctxt "fh"
msgid "Short note shown at the top of every page, e.g. Autumn tidy-ups: book your slot before November"
msgstr "Kratka napomena prikazana na vrhu svake stranice, npr. Jesensko čišćenje: rezervirajte svoj termin prije studenog"

#. config.garden.quote
#: schema.json
msgctxt "fn"
msgid "Quote link"
msgstr "Poveznica za ponudu"

#. config.garden.quote
#: schema.json
msgctxt "fh"
msgid "Link to the quote or site visit request page, shown as a button in the header"
msgstr "Poveznica na stranicu za zahtjev ponude ili posjeta lokaciji, prikazana kao gumb u zaglavlju"

#. config.garden.plans
#: schema.json
msgctxt "fn"
msgid "Care plans link"
msgstr "Poveznica na planove održavanja"

#. config.garden.plans
#: schema.json
msgctxt "fh"
msgid "Link to the page with garden care plans and prices"
msgstr "Poveznica na stranicu s planovima i cijenama njege vrta"

#. config.garden.notice
#: schema.json
msgctxt "fh"
msgid "Short note shown in the footer, e.g. Fully insured, all planting comes with a 12 month guarantee."
msgstr "Kratka napomena prikazana u podnožju, npr. Potpuno osigurano, sav posadni materijal dolazi s 12-mjesečnim jamstvom."

#. config.garden.action-bar
#: schema.json
msgctxt "fh"
msgid "Show call and quote buttons at the bottom of the screen on phones"
msgstr "Prikaži gumbe za poziv i ponudu na dnu zaslona na telefonima"

#. config.garden.hours
#: schema.json
msgctxt "fn"
msgid "Office hours"
msgstr "Radno vrijeme"

#. config.garden.hours
#: schema.json
msgctxt "fh"
msgid "Office hours for each day of the week"
msgstr "Radno vrijeme svakog dana u tjednu"

#. config.theme
#: schema.json
msgctxt "st"
msgid "grove::theme"
msgstr "Tema"
