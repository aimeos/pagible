#. config.garden
#: schema.json
msgctxt "st"
msgid "grove::garden"
msgstr "Trädgård"

#. config.garden.name
#: schema.json
msgctxt "fh"
msgid "Name of the gardening, landscaping or garden design business"
msgstr "Namn på trädgårds-, anläggnings- eller trädgårdsdesignföretaget"

#. config.garden.business-type
#: schema.json
msgctxt "op"
msgid "Gardener and landscaper"
msgstr "Trädgårdsmästare och anläggare"

#. config.garden.business-type
#: schema.json
msgctxt "op"
msgid "Landscape contractor"
msgstr "Markanläggningsföretag"

#. config.garden.business-type
#: schema.json
msgctxt "op"
msgid "Garden design studio"
msgstr "Trädgårdsdesignstudio"

#. config.garden.business-type
#: schema.json
msgctxt "op"
msgid "Garden centre or nursery"
msgstr "Trädgårdscenter eller plantskola"

#. config.garden.business-type
#: schema.json
msgctxt "op"
msgid "Other garden business"
msgstr "Annat trädgårdsföretag"

#. config.garden.areas
#: schema.json
msgctxt "fn"
msgid "Service area"
msgstr "Serviceområde"

#. config.garden.areas
#: schema.json
msgctxt "fh"
msgid "Towns and areas you work in, separated by commas, shown in the top bar and the footer"
msgstr "Orter och områden du arbetar i, separerade med kommatecken, visas i toppfältet och sidfoten"

#. config.garden.email
#: schema.json
msgctxt "fh"
msgid "Email address for quotes, site visits and garden care enquiries"
msgstr "E-postadress för offerter, platsbesök och frågor om trädgårdsskötsel"

#. config.garden.announcement
#: schema.json
msgctxt "fh"
msgid "Short note shown at the top of every page, e.g. Autumn tidy-ups: book your slot before November"
msgstr "Kort meddelande högst upp på varje sida, t.ex. Höststädning i trädgården: boka din tid före november"

#. config.garden.quote
#: schema.json
msgctxt "fn"
msgid "Quote link"
msgstr "Offertlänk"

#. config.garden.quote
#: schema.json
msgctxt "fh"
msgid "Link to the quote or site visit request page, shown as a button in the header"
msgstr "Länk till sidan för offert- eller platsbesöksförfrågningar, visas som knapp i sidhuvudet"

#. config.garden.plans
#: schema.json
msgctxt "fn"
msgid "Care plans link"
msgstr "Länk till skötselavtal"

#. config.garden.plans
#: schema.json
msgctxt "fh"
msgid "Link to the page with garden care plans and prices"
msgstr "Länk till sidan med trädgårdsskötselavtal och priser"

#. config.garden.notice
#: schema.json
msgctxt "fh"
msgid "Short note shown in the footer, e.g. Fully insured, all planting comes with a 12 month guarantee."
msgstr "Kort text i sidfoten, t.ex. Fullt försäkrade, alla planteringar har 12 månaders garanti."

#. config.garden.action-bar
#: schema.json
msgctxt "fh"
msgid "Show call and quote buttons at the bottom of the screen on phones"
msgstr "Visa ring- och offertknappar längst ned på skärmen i mobiler"

#. config.garden.hours
#: schema.json
msgctxt "fn"
msgid "Office hours"
msgstr "Kontorstider"

#. config.garden.hours
#: schema.json
msgctxt "fh"
msgid "Office hours for each day of the week"
msgstr "Kontorstider för varje veckodag"

#. config.theme
#: schema.json
msgctxt "st"
msgid "grove::theme"
msgstr "Tema"
