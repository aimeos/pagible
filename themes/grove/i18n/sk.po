#. config.garden
#: schema.json
msgctxt "st"
msgid "grove::garden"
msgstr "Záhrada"

#. config.garden.name
#: schema.json
msgctxt "fh"
msgid "Name of the gardening, landscaping or garden design business"
msgstr "Názov záhradníckej, krajinárskej alebo záhradno-architektonickej firmy"

#. config.garden.business-type
#: schema.json
msgctxt "op"
msgid "Gardener and landscaper"
msgstr "Záhradník a krajinár"

#. config.garden.business-type
#: schema.json
msgctxt "op"
msgid "Landscape contractor"
msgstr "Firma na zakladanie zelene"

#. config.garden.business-type
#: schema.json
msgctxt "op"
msgid "Garden design studio"
msgstr "Štúdio záhradnej architektúry"

#. config.garden.business-type
#: schema.json
msgctxt "op"
msgid "Garden centre or nursery"
msgstr "Záhradné centrum alebo škôlka"

#. config.garden.business-type
#: schema.json
msgctxt "op"
msgid "Other garden business"
msgstr "Iná záhradnícka firma"

#. config.garden.areas
#: schema.json
msgctxt "fn"
msgid "Service area"
msgstr "Oblasť pôsobenia"

#. config.garden.areas
#: schema.json
msgctxt "fh"
msgid "Towns and areas you work in, separated by commas, shown in the top bar and the footer"
msgstr "Obce a oblasti, kde pracujete, oddelené čiarkami; zobrazujú sa v hornej lište a v pätičke"

#. config.garden.email
#: schema.json
msgctxt "fh"
msgid "Email address for quotes, site visits and garden care enquiries"
msgstr "E-mailová adresa pre dopyty, obhliadky na mieste a otázky k starostlivosti o záhradu"

#. config.garden.announcement
#: schema.json
msgctxt "fh"
msgid "Short note shown at the top of every page, e.g. Autumn tidy-ups: book your slot before November"
msgstr "Krátke oznámenie v hornej časti každej stránky, napr. Jesenné upratovanie záhrady: rezervujte si termín do novembra"

#. config.garden.quote
#: schema.json
msgctxt "fn"
msgid "Quote link"
msgstr "Odkaz na cenovú ponuku"

#. config.garden.quote
#: schema.json
msgctxt "fh"
msgid "Link to the quote or site visit request page, shown as a button in the header"
msgstr "Odkaz na stránku pre dopyt ponuky alebo obhliadky, zobrazený ako tlačidlo v hlavičke"

#. config.garden.plans
#: schema.json
msgctxt "fn"
msgid "Care plans link"
msgstr "Odkaz na plány starostlivosti"

#. config.garden.plans
#: schema.json
msgctxt "fh"
msgid "Link to the page with garden care plans and prices"
msgstr "Odkaz na stránku s plánmi starostlivosti o záhradu a cenníkom"

#. config.garden.notice
#: schema.json
msgctxt "fh"
msgid "Short note shown in the footer, e.g. Fully insured, all planting comes with a 12 month guarantee."
msgstr "Krátka poznámka v pätičke, napr. Plne poistené, na všetky výsadby poskytujeme 12-mesačnú záruku."

#. config.garden.action-bar
#: schema.json
msgctxt "fh"
msgid "Show call and quote buttons at the bottom of the screen on phones"
msgstr "Zobraziť na telefónoch tlačidlá na volanie a ponuku v spodnej časti obrazovky"

#. config.garden.hours
#: schema.json
msgctxt "fn"
msgid "Office hours"
msgstr "Úradné hodiny"

#. config.garden.hours
#: schema.json
msgctxt "fh"
msgid "Office hours for each day of the week"
msgstr "Úradné hodiny pre každý deň v týždni"

#. config.theme
#: schema.json
msgctxt "st"
msgid "grove::theme"
msgstr "Téma"
