#: schema.json
msgctxt "fn"
msgid "Price range"
msgstr "កម្រិតតម្លៃ"

#. config.salon.price-range
#: schema.json
msgctxt "fh"
msgid "Price level of the salon, e.g. $$ or €€"
msgstr "កម្រិតតម្លៃរបស់ហាង ឧ. $$ ឬ €€"

#. config.salon.notice
#: schema.json
msgctxt "fn"
msgid "Notice"
msgstr "សេចក្តីជូនដំណឹង"

#. config.salon.notice
#: schema.json
msgctxt "fh"
msgid "Short note shown in the footer, e.g. Please cancel at least 24 hours before your appointment."
msgstr "កំណត់ចំណាំខ្លីដែលបង្ហាញនៅបាតទំព័រ ឧ. សូមលុបចោលយ៉ាងហោចណាស់ 24 ម៉ោងមុនការណាត់ជួបរបស់អ្នក។"

#. config.salon.action-bar
#: schema.json
msgctxt "fn"
msgid "Action bar"
msgstr "របារសកម្មភាព"

#. config.salon.action-bar
#: schema.json
msgctxt "fh"
msgid "Show call and booking buttons at the bottom of the screen on phones"
msgstr "បង្ហាញប៊ូតុងហៅទូរស័ព្ទ និងកក់នៅផ្នែកខាងក្រោមនៃអេក្រង់លើទូរស័ព្ទ"

