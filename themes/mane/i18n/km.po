msgid "mane::salon"
msgstr "ហាងកាត់សក់"

#. config.salon.name
#: schema.json
msgctxt "fh"
msgid "Name of the salon, studio or barbershop"
msgstr "ឈ្មោះហាងកាត់សក់ ស្ទូឌីយោ ឬហាងកាត់សក់បុរស"

#. config.salon.business-type
#: schema.json
msgctxt "op"
msgid "Hair salon"
msgstr "ហាងកាត់សក់"

#. config.salon.business-type
#: schema.json
msgctxt "op"
msgid "Barbershop"
msgstr "ហាងកាត់សក់បុរស"

#. config.salon.business-type
#: schema.json
msgctxt "op"
msgid "Beauty salon"
msgstr "ហាងសម្ផស្ស"

#. config.salon.business-type
#: schema.json
msgctxt "op"
msgid "Day spa"
msgstr "ស្ប៉ាពេលថ្ងៃ"

#. config.salon.email
#: schema.json
msgctxt "fh"
msgid "Email address for appointments, gift cards and press"
msgstr "អាសយដ្ឋានអ៊ីមែលសម្រាប់ការណាត់ជួប ប័ណ្ណកាដូ និងសារព័ត៌មាន"

#. config.salon.announcement
#: schema.json
msgctxt "fh"
msgid "Short note shown at the top of every page, e.g. New clients get a free consultation"
msgstr "កំណត់ចំណាំខ្លីដែលបង្ហាញនៅផ្នែកខាងលើនៃទំព័រនីមួយៗ ឧ. អតិថិជនថ្មីទទួលបានការពិគ្រោះយោបល់ដោយឥតគិតថ្លៃ"

#. config.salon.booking
#: schema.json
msgctxt "fh"
msgid "Link to the appointment booking page, shown as a button in the header"
msgstr "តំណទៅទំព័រកក់ការណាត់ជួប ដែលបង្ហាញជាប៊ូតុងនៅក្បាលទំព័រ"

#. config.salon.notice
#: schema.json
msgctxt "fh"
msgid "Short note shown in the footer, e.g. Please cancel at least 24 hours before your appointment."
msgstr "កំណត់ចំណាំខ្លីដែលបង្ហាញនៅបាតទំព័រ ឧ. សូមលុបចោលយ៉ាងហោចណាស់ 24 ម៉ោងមុនការណាត់ជួបរបស់អ្នក។"

