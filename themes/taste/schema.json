{
    "label": "Taste",
    "description": "Modern dark restaurant design with bold food photography, layered midnight surfaces, vivid coral, emerald and violet accents, and no motion effects",
    "maintainer": "Aimeos",
    "email": "info@aimeos.org",
    "website": "https://pagible.com",
    "types": {
        "page": {
            "sections": ["main", "footer"]
        },
        "docs": {
            "sections": ["main", "footer"]
        },
        "blog": {
            "sections": ["main", "footer"]
        }
    },
    "config": {
        "restaurant": {
            "group": "basic",
            "icon": "<svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 24 24\" fill=\"currentColor\"><path d=\"M8.1 13.34 10.93 10.5 3.91 3.5l-1.4 1.41 4.94 4.94L4.62 12.7l3.48.64M14.88 11.53c1.53 0 2.72-1.19 2.72-2.72 0-.7-.28-1.4-.77-1.89L12.8 2.9l-1.41 1.41 2.33 2.33-8.49 8.49 1.41 1.41 4.25-4.24 2.58 2.58 1.41-1.41-2.58-2.58.69-.69c.49.84 1.19 1.33 1.89 1.33M16.92 14c-.53 0-1.04.21-1.41.59L9.1 21H14l4.33-4.33A1.54 1.54 0 0 0 16.92 14Z\"/></svg>",
            "fields": {
                "name": {
                    "type": "string",
                    "hint": "Name of the restaurant",
                    "required": true
                },
                "street-address": {
                    "type": "string",
                    "label": "Street address",
                    "hint": "Street and house number",
                    "required": true
                },
                "postal-code": {
                    "type": "string",
                    "label": "Postal code",
                    "hint": "Postal code of the restaurant",
                    "required": true
                },
                "locality": {
                    "type": "string",
                    "label": "City",
                    "hint": "City the restaurant is located in",
                    "required": true
                },
                "country": {
                    "type": "string",
                    "label": "Country code",
                    "hint": "Two letter ISO country code, e.g. DE or US",
                    "default": "DE",
                    "min": 2,
                    "max": 2,
                    "uppercase": true,
                    "required": true
                },
                "cuisine": {
                    "type": "string",
                    "label": "Cuisines",
                    "hint": "Comma separated list of the cuisines served, e.g. Italian, Vegan",
                    "required": true
                },
                "menu": {
                    "type": "url",
                    "label": "Menu page",
                    "hint": "Page or link to the menu",
                    "required": true
                },
                "price-range": {
                    "type": "string",
                    "label": "Price range",
                    "hint": "Price level of the restaurant, e.g. $$ or €€",
                    "required": true
                },
                "telephone": {
                    "type": "string",
                    "hint": "Phone number for reservations in international format"
                },
                "hours": {
                    "type": "items",
                    "label": "Opening hours",
                    "hint": "Opening hours for each day of the week",
                    "identity": "id",
                    "item": {
                        "day": {
                            "type": "select",
                            "hint": "Day of the week",
                            "options": [
                                {"value": "Monday", "label": "Monday"},
                                {"value": "Tuesday", "label": "Tuesday"},
                                {"value": "Wednesday", "label": "Wednesday"},
                                {"value": "Thursday", "label": "Thursday"},
                                {"value": "Friday", "label": "Friday"},
                                {"value": "Saturday", "label": "Saturday"},
                                {"value": "Sunday", "label": "Sunday"}
                            ]
                        },
                        "opens": {
                            "type": "string",
                            "hint": "Opening time in 24 hour format, e.g. 11:30",
                            "pattern": "^(?:[01][0-9]|2[0-3]):[0-5][0-9]$"
                        },
                        "closes": {
                            "type": "string",
                            "hint": "Closing time in 24 hour format, e.g. 22:00",
                            "pattern": "^(?:[01][0-9]|2[0-3]):[0-5][0-9]$"
                        }
                    }
                }
            }
        },
        "theme": {
            "group": "theme",
            "icon": "<svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 24 24\" fill=\"currentColor\"><path d=\"M8.1 13.34 10.93 10.5 3.91 3.5l-1.4 1.41 4.94 4.94L4.62 12.7l3.48.64M14.88 11.53c1.53 0 2.72-1.19 2.72-2.72 0-.7-.28-1.4-.77-1.89L12.8 2.9l-1.41 1.41 2.33 2.33-8.49 8.49 1.41 1.41 4.25-4.24 2.58 2.58 1.41-1.41-2.58-2.58.69-.69c.49.84 1.19 1.33 1.89 1.33M16.92 14c-.53 0-1.04.21-1.41.59L9.1 21H14l4.33-4.33A1.54 1.54 0 0 0 16.92 14Z\"/></svg>",
            "fields": {
                "--pico-font-family-sans-serif": {
                    "type": "string",
                    "hint": "Comma separated list of fonts used for the text",
                    "default": "ui-rounded, 'Avenir Next', 'Segoe UI', sans-serif"
                },
                "--pico-color": {
                    "type": "color",
                    "hint": "Default text color",
                    "default": "#E7EEF5"
                },
                "--pico-background-color": {
                    "type": "color",
                    "hint": "Background color of the pages",
                    "default": "#090D14"
                },
                "--pico-text-selection-color": {
                    "type": "color",
                    "hint": "Background color of selected text",
                    "default": "#FF6B7A4D"
                },
                "--pico-contrast": {
                    "type": "color",
                    "hint": "Color of elements with strong contrast to the background",
                    "default": "#F7FAFC"
                },
                "--pico-contrast-hover": {
                    "type": "color",
                    "hint": "Contrast color when hovering or focusing an element",
                    "default": "#FFFFFF"
                },
                "--pico-contrast-inverse": {
                    "type": "color",
                    "hint": "Text color on elements using the contrast color",
                    "default": "#F7FAFC"
                },
                "--pico-primary": {
                    "type": "color",
                    "hint": "Main brand color used for links and buttons",
                    "default": "#FF6B7A"
                },
                "--pico-primary-background": {
                    "type": "color",
                    "hint": "Background color of primary buttons and highlights",
                    "default": "#FF6B7A1F"
                },
                "--pico-primary-hover": {
                    "type": "color",
                    "hint": "Primary color when hovering or focusing an element",
                    "default": "#FF93A0"
                },
                "--pico-primary-hover-background": {
                    "type": "color",
                    "hint": "Primary background color when hovering or focusing an element",
                    "default": "#FF93A026"
                },
                "--pico-secondary": {
                    "type": "color",
                    "hint": "Additional color used for less important links and buttons",
                    "default": "#39D6B4"
                },
                "--pico-secondary-background": {
                    "type": "color",
                    "hint": "Background color of secondary buttons",
                    "default": "#39D6B41F"
                },
                "--pico-secondary-hover": {
                    "type": "color",
                    "hint": "Secondary color when hovering or focusing an element",
                    "default": "#70E8CF"
                },
                "--pico-secondary-hover-background": {
                    "type": "color",
                    "hint": "Secondary background color when hovering or focusing an element",
                    "default": "#70E8CF26"
                },
                "--pico-border-radius": {
                    "type": "string",
                    "hint": "Rounding of corners as CSS length, e.g. 0.25rem or 0 for sharp corners",
                    "default": "1rem"
                },
                "--pico-nav-breadcrumb-divider": {
                    "type": "string",
                    "hint": "Character shown between the breadcrumb links",
                    "default": "/"
                }
            }
        }
    }
}
