{
    "name": "aimeos/pagible-themes-solar",
    "description": "Pagible CMS - Solar theme for solar, battery storage and heat pump installers",
    "keywords": ["laravel", "cms", "theme", "solar", "photovoltaics", "battery", "heat-pump", "energy", "trades"],
    "homepage": "https://pagible.com",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": "^8.2",
        "aimeos/pagible-theme": "*@dev"
    },
    "autoload": {
        "psr-4": {
            "Aimeos\\Cms\\": "src/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Aimeos\\Cms\\SolarServiceProvider"
            ]
        }
    }
}
