{
    "label": "Solar",
    "description": "Bright, optimistic design for solar, battery storage and heat pump consultants and installers with forest green, leaf green and sun yellow accents, geometric headings, sun markers and solar cell backgrounds",
    "maintainer": "Aimeos",
    "email": "info@aimeos.org",
    "website": "https://pagible.com",
    "types": {
        "page": {
            "sections": [
                "main",
                "footer"
            ]
        },
        "docs": {
            "sections": [
                "main",
                "footer"
            ]
        },
        "blog": {
            "sections": [
                "main",
                "footer"
            ]
        }
    },
    "config": {
        "business": {
            "group": "basic",
            "icon": "<svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 24 24\" fill=\"currentColor\"><circle cx=\"12\" cy=\"12\" r=\"5\"/><path d=\"M12 1.5v3M12 19.5v3M1.5 12h3M19.5 12h3M4.6 4.6l2.1 2.1M17.3 17.3l2.1 2.1M4.6 19.4l2.1-2.1M17.3 6.7l2.1-2.1\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\"/></svg>",
            "fields": {
                "name": {
                    "type": "string",
                    "hint": "Name of the company",
                    "required": true
                },
                "business-type": {
                    "type": "select",
                    "label": "Business type",
                    "hint": "Kind of business shown to search engines",
                    "default": "HomeAndConstructionBusiness",
                    "options": [
                        {
                            "value": "HomeAndConstructionBusiness",
                            "label": "Home and construction business"
                        },
                        {
                            "value": "Electrician",
                            "label": "Electrician"
                        },
                        {
                            "value": "HVACBusiness",
                            "label": "Heating and air conditioning"
                        }
                    ],
                    "required": true
                },
                "street-address": {
                    "type": "string",
                    "label": "Street address",
                    "hint": "Street and house number",
                    "required": true
                },
                "postal-code": {
                    "type": "string",
                    "label": "Postal code",
                    "hint": "Postal code of the company",
                    "required": true
                },
                "locality": {
                    "type": "string",
                    "label": "City",
                    "hint": "City the company is located in",
                    "required": true
                },
                "country": {
                    "type": "string",
                    "label": "Country code",
                    "hint": "Two letter ISO country code, e.g. DE or US",
                    "default": "DE",
                    "min": 2,
                    "max": 2,
                    "uppercase": true,
                    "required": true
                },
                "telephone": {
                    "type": "string",
                    "hint": "Phone number in international format, also used by the call button",
                    "required": true
                },
                "email": {
                    "type": "string",
                    "hint": "Email address for enquiries"
                },
                "area": {
                    "type": "string",
                    "label": "Places served",
                    "hint": "Comma separated list of the towns and regions you work in, e.g. Leeds, Bradford, York"
                },
                "price-range": {
                    "type": "string",
                    "label": "Price range",
                    "hint": "Price level of the company, e.g. $$ or €€"
                },
                "call-button": {
                    "type": "switch",
                    "label": "Call button",
                    "hint": "Show a call button at the bottom of the screen on phones",
                    "default": true
                },
                "hours": {
                    "type": "items",
                    "label": "Opening hours",
                    "hint": "Opening hours for each day of the week",
                    "identity": "id",
                    "item": {
                        "day": {
                            "type": "select",
                            "hint": "Day of the week",
                            "options": [
                                {
                                    "value": "Monday",
                                    "label": "Monday"
                                },
                                {
                                    "value": "Tuesday",
                                    "label": "Tuesday"
                                },
                                {
                                    "value": "Wednesday",
                                    "label": "Wednesday"
                                },
                                {
                                    "value": "Thursday",
                                    "label": "Thursday"
                                },
                                {
                                    "value": "Friday",
                                    "label": "Friday"
                                },
                                {
                                    "value": "Saturday",
                                    "label": "Saturday"
                                },
                                {
                                    "value": "Sunday",
                                    "label": "Sunday"
                                }
                            ]
                        },
                        "opens": {
                            "type": "string",
                            "hint": "Opening time in 24 hour format, e.g. 07:30",
                            "pattern": "^(?:[01][0-9]|2[0-3]):[0-5][0-9]$"
                        },
                        "closes": {
                            "type": "string",
                            "hint": "Closing time in 24 hour format, e.g. 17:00",
                            "pattern": "^(?:[01][0-9]|2[0-3]):[0-5][0-9]$"
                        }
                    }
                }
            }
        },
        "theme": {
            "group": "theme",
            "icon": "<svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 24 24\" fill=\"currentColor\"><circle cx=\"12\" cy=\"12\" r=\"5\"/><path d=\"M12 1.5v3M12 19.5v3M1.5 12h3M19.5 12h3M4.6 4.6l2.1 2.1M17.3 17.3l2.1 2.1M4.6 19.4l2.1-2.1M17.3 6.7l2.1-2.1\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\"/></svg>",
            "fields": {
                "--pico-font-family-sans-serif": {
                    "type": "string",
                    "hint": "Comma separated list of fonts used for the text",
                    "default": "system-ui, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif"
                },
                "--pico-color": {
                    "type": "color",
                    "hint": "Default text color",
                    "default": "#1C3530"
                },
                "--pico-background-color": {
                    "type": "color",
                    "hint": "Background color of the pages",
                    "default": "#F7F8F1"
                },
                "--pico-text-selection-color": {
                    "type": "color",
                    "hint": "Background color of selected text",
                    "default": "#1F7A4D40"
                },
                "--pico-contrast": {
                    "type": "color",
                    "hint": "Color of elements with strong contrast to the background",
                    "default": "#12302A"
                },
                "--pico-contrast-hover": {
                    "type": "color",
                    "hint": "Contrast color when hovering or focusing an element",
                    "default": "#0A1F1A"
                },
                "--pico-contrast-inverse": {
                    "type": "color",
                    "hint": "Text color on elements using the contrast color",
                    "default": "#FFFFFF"
                },
                "--pico-primary": {
                    "type": "color",
                    "hint": "Main brand color used for links and buttons",
                    "default": "#1F7A4D"
                },
                "--pico-primary-background": {
                    "type": "color",
                    "hint": "Background color of primary buttons and highlights",
                    "default": "#1F7A4D"
                },
                "--pico-primary-hover": {
                    "type": "color",
                    "hint": "Primary color when hovering or focusing an element",
                    "default": "#17603C"
                },
                "--pico-primary-hover-background": {
                    "type": "color",
                    "hint": "Primary background color when hovering or focusing an element",
                    "default": "#17603C"
                },
                "--pico-secondary": {
                    "type": "color",
                    "hint": "Additional color used for less important links and buttons",
                    "default": "#F5B82E"
                },
                "--pico-secondary-background": {
                    "type": "color",
                    "hint": "Background color of secondary buttons",
                    "default": "#F5B82E"
                },
                "--pico-secondary-hover": {
                    "type": "color",
                    "hint": "Secondary color when hovering or focusing an element",
                    "default": "#E0A01A"
                },
                "--pico-secondary-hover-background": {
                    "type": "color",
                    "hint": "Secondary background color when hovering or focusing an element",
                    "default": "#E0A01A"
                },
                "--pico-border-radius": {
                    "type": "string",
                    "hint": "Rounding of corners as CSS length, e.g. 0.25rem or 0 for sharp corners",
                    "default": "0.5rem"
                },
                "--pico-nav-breadcrumb-divider": {
                    "type": "string",
                    "hint": "Character shown between the breadcrumb links",
                    "default": "›"
                }
            }
        }
    }
}
