{
    "name": "aimeos/pagible-themes-aura",
    "description": "Pagible CMS - Aura theme for creative portfolios, design engineers and personal blogs",
    "keywords": [
        "laravel",
        "cms",
        "theme",
        "portfolio",
        "blog",
        "designer",
        "creative",
        "personal website",
        "case studies"
    ],
    "homepage": "https://pagible.com",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": "^8.2",
        "aimeos/pagible-theme": "*@dev"
    },
    "autoload": {
        "psr-4": {
            "Aimeos\\Cms\\": "src/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Aimeos\\Cms\\AuraServiceProvider"
            ]
        }
    }
}
