{
    "label": "Medical",
    "description": "Calm, clean design for medical and dental practices with navy, teal and mint accents, a white header, rounded cards, plus markers and soft dot backgrounds",
    "maintainer": "Aimeos",
    "email": "info@aimeos.org",
    "website": "https://pagible.com",
    "types": {
        "page": {
            "sections": [
                "main",
                "footer"
            ]
        },
        "docs": {
            "sections": [
                "main",
                "footer"
            ]
        },
        "blog": {
            "sections": [
                "main",
                "footer"
            ]
        }
    },
    "config": {
        "practice": {
            "group": "basic",
            "icon": "<svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 24 24\" fill=\"currentColor\"><path d=\"M9.5 2h5A1.5 1.5 0 0 1 16 3.5V8h4.5A1.5 1.5 0 0 1 22 9.5v5a1.5 1.5 0 0 1-1.5 1.5H16v4.5a1.5 1.5 0 0 1-1.5 1.5h-5A1.5 1.5 0 0 1 8 20.5V16H3.5A1.5 1.5 0 0 1 2 14.5v-5A1.5 1.5 0 0 1 3.5 8H8V3.5A1.5 1.5 0 0 1 9.5 2z\"/></svg>",
            "fields": {
                "name": {
                    "type": "string",
                    "hint": "Name of the practice",
                    "required": true
                },
                "business-type": {
                    "type": "select",
                    "label": "Practice type",
                    "hint": "Kind of practice shown to search engines",
                    "default": "Dentist",
                    "options": [
                        {
                            "value": "Dentist",
                            "label": "Dentist"
                        },
                        {
                            "value": "Physician",
                            "label": "Physician"
                        },
                        {
                            "value": "MedicalClinic",
                            "label": "Medical clinic"
                        },
                        {
                            "value": "Physiotherapy",
                            "label": "Physiotherapy"
                        },
                        {
                            "value": "MedicalBusiness",
                            "label": "Other medical practice"
                        }
                    ],
                    "required": true
                },
                "specialty": {
                    "type": "select",
                    "label": "Medical specialty",
                    "hint": "Main medical specialty of the practice",
                    "default": "Dentistry",
                    "options": [
                        {
                            "value": "Dentistry",
                            "label": "Dentistry"
                        },
                        {
                            "value": "PrimaryCare",
                            "label": "General practice"
                        },
                        {
                            "value": "Pediatric",
                            "label": "Pediatrics"
                        },
                        {
                            "value": "Dermatology",
                            "label": "Dermatology"
                        },
                        {
                            "value": "Gynecologic",
                            "label": "Gynecology"
                        },
                        {
                            "value": "Cardiovascular",
                            "label": "Cardiology"
                        },
                        {
                            "value": "Otolaryngologic",
                            "label": "Ear, nose and throat"
                        },
                        {
                            "value": "Optometric",
                            "label": "Optometry"
                        },
                        {
                            "value": "Physiotherapy",
                            "label": "Physiotherapy"
                        },
                        {
                            "value": "Psychiatric",
                            "label": "Psychiatry"
                        }
                    ]
                },
                "street-address": {
                    "type": "string",
                    "label": "Street address",
                    "hint": "Street and house number",
                    "required": true
                },
                "postal-code": {
                    "type": "string",
                    "label": "Postal code",
                    "hint": "Postal code of the practice",
                    "required": true
                },
                "locality": {
                    "type": "string",
                    "label": "City",
                    "hint": "City the practice is located in",
                    "required": true
                },
                "country": {
                    "type": "string",
                    "label": "Country code",
                    "hint": "Two letter ISO country code, e.g. DE or US",
                    "default": "DE",
                    "min": 2,
                    "max": 2,
                    "uppercase": true,
                    "required": true
                },
                "telephone": {
                    "type": "string",
                    "hint": "Phone number in international format, also used by the call button",
                    "required": true
                },
                "email": {
                    "type": "string",
                    "hint": "Email address for appointment requests"
                },
                "emergency-phone": {
                    "type": "string",
                    "label": "Emergency number",
                    "hint": "Phone number for emergencies, shown at the top of every page"
                },
                "booking": {
                    "type": "string",
                    "label": "Booking link",
                    "hint": "Link to the appointment page or online booking, shown as a button in the header"
                },
                "languages": {
                    "type": "string",
                    "label": "Languages",
                    "hint": "Comma separated list of the languages spoken in the practice, e.g. English, German, French"
                },
                "new-patients": {
                    "type": "switch",
                    "label": "New patients",
                    "hint": "Tell search engines that the practice accepts new patients",
                    "default": true
                },
                "price-range": {
                    "type": "string",
                    "label": "Price range",
                    "hint": "Price level of the practice, e.g. $$ or €€"
                },
                "call-button": {
                    "type": "switch",
                    "label": "Call button",
                    "hint": "Show a call button at the bottom of the screen on phones",
                    "default": true
                },
                "hours": {
                    "type": "items",
                    "label": "Opening hours",
                    "hint": "Opening hours for each day of the week",
                    "identity": "id",
                    "item": {
                        "day": {
                            "type": "select",
                            "hint": "Day of the week",
                            "options": [
                                {
                                    "value": "Monday",
                                    "label": "Monday"
                                },
                                {
                                    "value": "Tuesday",
                                    "label": "Tuesday"
                                },
                                {
                                    "value": "Wednesday",
                                    "label": "Wednesday"
                                },
                                {
                                    "value": "Thursday",
                                    "label": "Thursday"
                                },
                                {
                                    "value": "Friday",
                                    "label": "Friday"
                                },
                                {
                                    "value": "Saturday",
                                    "label": "Saturday"
                                },
                                {
                                    "value": "Sunday",
                                    "label": "Sunday"
                                }
                            ]
                        },
                        "opens": {
                            "type": "string",
                            "hint": "Opening time in 24 hour format, e.g. 07:30",
                            "pattern": "^(?:[01][0-9]|2[0-3]):[0-5][0-9]$"
                        },
                        "closes": {
                            "type": "string",
                            "hint": "Closing time in 24 hour format, e.g. 17:00",
                            "pattern": "^(?:[01][0-9]|2[0-3]):[0-5][0-9]$"
                        }
                    }
                }
            }
        },
        "theme": {
            "group": "theme",
            "icon": "<svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 24 24\" fill=\"currentColor\"><path d=\"M9.5 2h5A1.5 1.5 0 0 1 16 3.5V8h4.5A1.5 1.5 0 0 1 22 9.5v5a1.5 1.5 0 0 1-1.5 1.5H16v4.5a1.5 1.5 0 0 1-1.5 1.5h-5A1.5 1.5 0 0 1 8 20.5V16H3.5A1.5 1.5 0 0 1 2 14.5v-5A1.5 1.5 0 0 1 3.5 8H8V3.5A1.5 1.5 0 0 1 9.5 2z\"/></svg>",
            "fields": {
                "--pico-font-family-sans-serif": {
                    "type": "string",
                    "hint": "Comma separated list of fonts used for the text",
                    "default": "system-ui, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif"
                },
                "--pico-color": {
                    "type": "color",
                    "hint": "Default text color",
                    "default": "#1E3440"
                },
                "--pico-background-color": {
                    "type": "color",
                    "hint": "Background color of the pages",
                    "default": "#F4F8F9"
                },
                "--pico-text-selection-color": {
                    "type": "color",
                    "hint": "Background color of selected text",
                    "default": "#0A778240"
                },
                "--pico-contrast": {
                    "type": "color",
                    "hint": "Color of elements with strong contrast to the background",
                    "default": "#0F2D3A"
                },
                "--pico-contrast-hover": {
                    "type": "color",
                    "hint": "Contrast color when hovering or focusing an element",
                    "default": "#091E28"
                },
                "--pico-contrast-inverse": {
                    "type": "color",
                    "hint": "Text color on elements using the contrast color",
                    "default": "#FFFFFF"
                },
                "--pico-primary": {
                    "type": "color",
                    "hint": "Main brand color used for links and buttons",
                    "default": "#0A7782"
                },
                "--pico-primary-background": {
                    "type": "color",
                    "hint": "Background color of primary buttons and highlights",
                    "default": "#0A7782"
                },
                "--pico-primary-hover": {
                    "type": "color",
                    "hint": "Primary color when hovering or focusing an element",
                    "default": "#075F68"
                },
                "--pico-primary-hover-background": {
                    "type": "color",
                    "hint": "Primary background color when hovering or focusing an element",
                    "default": "#075F68"
                },
                "--pico-secondary": {
                    "type": "color",
                    "hint": "Additional color used for less important links and buttons",
                    "default": "#8DD8C8"
                },
                "--pico-secondary-background": {
                    "type": "color",
                    "hint": "Background color of secondary buttons",
                    "default": "#8DD8C8"
                },
                "--pico-secondary-hover": {
                    "type": "color",
                    "hint": "Secondary color when hovering or focusing an element",
                    "default": "#6FC9B6"
                },
                "--pico-secondary-hover-background": {
                    "type": "color",
                    "hint": "Secondary background color when hovering or focusing an element",
                    "default": "#6FC9B6"
                },
                "--pico-border-radius": {
                    "type": "string",
                    "hint": "Rounding of corners as CSS length, e.g. 0.25rem or 0 for sharp corners",
                    "default": "0.75rem"
                },
                "--pico-nav-breadcrumb-divider": {
                    "type": "string",
                    "hint": "Character shown between the breadcrumb links",
                    "default": "›"
                }
            }
        }
    }
}
