{
    "name": "aimeos/pagible-themes-medical",
    "description": "Pagible CMS - Medical theme for medical and dental practices",
    "keywords": ["laravel", "cms", "theme", "medical", "dental", "dentist", "doctor", "clinic", "healthcare"],
    "homepage": "https://pagible.com",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": "^8.2",
        "aimeos/pagible-theme": "*@dev"
    },
    "autoload": {
        "psr-4": {
            "Aimeos\\Cms\\": "src/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Aimeos\\Cms\\MedicalServiceProvider"
            ]
        }
    }
}
