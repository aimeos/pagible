{
    "name": "aimeos/pagible-themes-solid",
    "description": "Pagible CMS - Solid theme for builders, renovation companies and general contractors",
    "keywords": ["laravel", "cms", "theme", "construction", "builder", "renovation", "contractor", "trades"],
    "homepage": "https://pagible.com",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": "^8.2",
        "aimeos/pagible-theme": "*@dev"
    },
    "autoload": {
        "psr-4": {
            "Aimeos\\Cms\\": "src/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Aimeos\\Cms\\SolidServiceProvider"
            ]
        }
    }
}
