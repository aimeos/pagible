#. config.garage.notice
#: schema.json
msgctxt "fh"
msgid "Short note shown in the footer, e.g. All repairs come with a 24 month warranty on parts and labour."
msgstr "Ayaqnotda göstərilən qısa qeyd, məsələn: Bütün təmir işləri hissələrə və əməyə görə 24 aylıq zəmanətlə təmin olunur."

