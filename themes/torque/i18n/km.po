#. config.garage.country
#: schema.json
msgctxt "fn"
msgid "Country code"
msgstr "លេខកូដប្រទេស"

#. config.garage.country
#: schema.json
msgctxt "fh"
msgid "Two letter ISO country code, e.g. DE or US"
msgstr "លេខកូដប្រទេស ISO ពីរតួអក្សរ ឧ. DE ឬ US"

#. config.garage.telephone
#: schema.json
msgctxt "fn"
msgid "telephone"
msgstr "ទូរស័ព្ទ"

#. config.garage.telephone
#: schema.json
msgctxt "fh"
msgid "Phone number in international format, also used by the call button"
msgstr "លេខទូរស័ព្ទជាទម្រង់អន្តរជាតិ ដែលប្រើសម្រាប់ប៊ូតុងហៅទូរស័ព្ទផងដែរ"

#. config.garage.breakdown
#: schema.json
msgctxt "fn"
msgid "Breakdown service"
msgstr "សេវាសង្គ្រោះរថយន្តខូច"

#. config.garage.breakdown
#: schema.json
msgctxt "fh"
msgid "Phone number of the breakdown and towing service, shown in the top bar"
msgstr "លេខទូរស័ព្ទសេវាសង្គ្រោះ និងអូសរថយន្ត ដែលបង្ហាញនៅរបារខាងលើ"

#. config.garage.email
#: schema.json
msgctxt "fn"
msgid "email"
msgstr "អ៊ីមែល"

