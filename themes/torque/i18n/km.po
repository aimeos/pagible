#: schema.json
msgctxt "fh"
msgid "Email address for appointments, quotes and vehicle enquiries"
msgstr "អាសយដ្ឋានអ៊ីមែលសម្រាប់ការណាត់ជួប សំណើតម្លៃ និងសំណួរអំពីយានយន្ត"

#. config.garage.announcement
#: schema.json
msgctxt "fn"
msgid "Announcement"
msgstr "សេចក្តីប្រកាស"

#. config.garage.announcement
#: schema.json
msgctxt "fh"
msgid "Short note shown at the top of every page, e.g. Winter tyre season: book your tyre change now"
msgstr "កំណត់ចំណាំខ្លីដែលបង្ហាញនៅផ្នែកខាងលើនៃទំព័រនីមួយៗ ឧ. រដូវកង់រដូវរងា៖ កក់ការប្តូរកង់របស់អ្នកឥឡូវនេះ"

#. config.garage.booking
#: schema.json
msgctxt "fn"
msgid "Booking link"
msgstr "តំណកក់"

