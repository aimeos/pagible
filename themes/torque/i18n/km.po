#. config.garage
#: schema.json
msgctxt "st"
msgid "torque::garage"
msgstr "យានដ្ឋាន"

#. config.garage.name
#: schema.json
msgctxt "fh"
msgid "Name of the garage, workshop or dealership"
msgstr "ឈ្មោះយានដ្ឋាន រោងជួសជុល ឬអ្នកចែកចាយ"

#. config.garage.business-type
#: schema.json
msgctxt "op"
msgid "Car repair shop"
msgstr "ហាងជួសជុលរថយន្ត"

#. config.garage.business-type
#: schema.json
msgctxt "op"
msgid "Car dealer"
msgstr "អ្នកលក់រថយន្ត"

#. config.garage.business-type
#: schema.json
msgctxt "op"
msgid "Body shop"
msgstr "ហាងជួសជុលតួរថយន្ត"

#. config.garage.business-type
#: schema.json
msgctxt "op"
msgid "Tyre shop"
msgstr "ហាងកង់រថយន្ត"

#. config.garage.business-type
#: schema.json
msgctxt "op"
msgid "Motorcycle repair"
msgstr "ការជួសជុលម៉ូតូ"

#. config.garage.business-type
#: schema.json
msgctxt "op"
msgid "Other automotive business"
msgstr "អាជីវកម្មរថយន្តផ្សេងទៀត"

#. config.garage.breakdown
#: schema.json
msgctxt "fn"
msgid "Breakdown service"
msgstr "សេវាសង្គ្រោះរថយន្តខូច"

#. config.garage.breakdown
#: schema.json
msgctxt "fh"
msgid "Phone number of the breakdown and towing service, shown in the top bar"
msgstr "លេខទូរស័ព្ទសេវាសង្គ្រោះ និងអូសរថយន្ត ដែលបង្ហាញនៅរបារខាងលើ"

#. config.garage.email
#: schema.json
msgctxt "fh"
msgid "Email address for appointments, quotes and vehicle enquiries"
msgstr "អាសយដ្ឋានអ៊ីមែលសម្រាប់ការណាត់ជួប សំណើតម្លៃ និងសំណួរអំពីយានយន្ត"

#. config.garage.announcement
#: schema.json
msgctxt "fh"
msgid "Short note shown at the top of every page, e.g. Winter tyre season: book your tyre change now"
msgstr "កំណត់ចំណាំខ្លីដែលបង្ហាញនៅផ្នែកខាងលើនៃទំព័រនីមួយៗ ឧ. រដូវកង់រដូវរងា៖ កក់ការប្តូរកង់របស់អ្នកឥឡូវនេះ"

#. config.garage.booking
#: schema.json
msgctxt "fh"
msgid "Link to the service booking page, shown as a button in the header"
msgstr "តំណទៅទំព័រកក់សេវាកម្ម ដែលបង្ហាញជាប៊ូតុងនៅក្បាលទំព័រ"

#. config.garage.notice
#: schema.json
msgctxt "fh"
msgid "Short note shown in the footer, e.g. All repairs come with a 24 month warranty on parts and labour."
msgstr "កំណត់ចំណាំខ្លីដែលបង្ហាញនៅបាតទំព័រ ឧ. ការជួសជុលទាំងអស់មានការធានា 24 ខែលើគ្រឿងបន្លាស់ និងកម្លាំងពលកម្ម។"

#. config.theme
#: schema.json
msgctxt "st"
msgid "torque::theme"
msgstr "រចនាប័ទ្ម"
