#: schema.json
msgctxt "fh"
msgid "Link to the service booking page, shown as a button in the header"
msgstr "តំណទៅទំព័រកក់សេវាកម្ម ដែលបង្ហាញជាប៊ូតុងនៅក្បាលទំព័រ"

#. config.garage.prices
#: schema.json
msgctxt "fn"
msgid "Price list link"
msgstr "តំណបញ្ជីតម្លៃ"

#. config.garage.prices
#: schema.json
msgctxt "fh"
msgid "Link to the page with services and prices"
msgstr "តំណទៅទំព័រសេវាកម្ម និងតម្លៃ"

#. config.garage.price-range
#: schema.json
msgctxt "fn"
msgid "Price range"
msgstr "កម្រិតតម្លៃ"

#. config.garage.price-range
#: schema.json
msgctxt "fh"
msgid "Price level of the garage, e.g. $$ or €€"
msgstr "កម្រិតតម្លៃរបស់យានដ្ឋាន ឧ. $$ ឬ €€"

#. config.garage.notice
#: schema.json
msgctxt "fn"
msgid "Notice"
msgstr "សេចក្តីជូនដំណឹង"

#. config.garage.notice
#: schema.json
msgctxt "fh"
msgid "Short note shown in the footer, e.g. All repairs come with a 24 month warranty on parts and labour."
msgstr "កំណត់ចំណាំខ្លីដែលបង្ហាញនៅបាតទំព័រ ឧ. ការជួសជុលទាំងអស់មានការធានា 24 ខែលើគ្រឿងបន្លាស់ និងកម្លាំងពលកម្ម។"

#. config.garage.action-bar
#: schema.json
msgctxt "fn"
msgid "Action bar"
msgstr "របារសកម្មភាព"

#. config.garage.action-bar
#: schema.json
msgctxt "fh"
msgid "Show call and booking buttons at the bottom of the screen on phones"
msgstr "បង្ហាញប៊ូតុងហៅទូរស័ព្ទ និងកក់នៅផ្នែកខាងក្រោមនៃអេក្រង់លើទូរស័ព្ទ"

