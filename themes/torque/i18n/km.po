#. config.garage
#: schema.json
msgctxt "st"
msgid "torque::garage"
msgstr "យានដ្ឋាន"

#. config.garage.name
#: schema.json
msgctxt "fh"
msgid "Name of the garage, workshop or dealership"
msgstr "ឈ្មោះយានដ្ឋាន រោងជួសជុល ឬអ្នកចែកចាយ"

