#. config.garage.breakdown
#: schema.json
msgctxt "fn"
msgid "Breakdown service"
msgstr "Cứu hộ"

#. config.garage.breakdown
#: schema.json
msgctxt "fh"
msgid "Phone number of the breakdown and towing service, shown in the top bar"
msgstr "Số điện thoại dịch vụ cứu hộ và kéo xe, hiển thị ở thanh trên cùng"

#. config.garage.email
#: schema.json
msgctxt "fh"
msgid "Email address for appointments, quotes and vehicle enquiries"
msgstr "Địa chỉ email để đặt lịch, báo giá và hỏi về xe"

#. config.garage.announcement
#: schema.json
msgctxt "fh"
msgid "Short note shown at the top of every page, e.g. Winter tyre season: book your tyre change now"
msgstr "Thông báo ngắn hiển thị ở đầu mỗi trang, ví dụ: Mùa lốp mùa đông: đặt lịch thay lốp ngay hôm nay"

#. config.garage.booking
#: schema.json
msgctxt "fh"
msgid "Link to the service booking page, shown as a button in the header"
msgstr "Liên kết đến trang đặt lịch bảo dưỡng, hiển thị dưới dạng nút ở đầu trang"

#. config.garage.notice
#: schema.json
msgctxt "fh"
msgid "Short note shown in the footer, e.g. All repairs come with a 24 month warranty on parts and labour."
msgstr "Thông báo ngắn hiển thị ở chân trang, ví dụ: Mọi hạng mục sửa chữa đều được bảo hành 24 tháng cho phụ tùng và công thợ."

