#: schema.json
msgctxt "fh"
msgid "Email address for appointments, quotes and vehicle enquiries"
msgstr "Địa chỉ email để đặt lịch, báo giá và hỏi về xe"

#. config.garage.announcement
#: schema.json
msgctxt "fn"
msgid "Announcement"
msgstr "Thông báo"

#. config.garage.announcement
#: schema.json
msgctxt "fh"
msgid "Short note shown at the top of every page, e.g. Winter tyre season: book your tyre change now"
msgstr "Thông báo ngắn hiển thị ở đầu mỗi trang, ví dụ: Mùa lốp mùa đông: đặt lịch thay lốp ngay hôm nay"

#. config.garage.booking
#: schema.json
msgctxt "fn"
msgid "Booking link"
msgstr "Liên kết đặt chỗ"

