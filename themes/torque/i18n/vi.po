#: schema.json
msgctxt "fh"
msgid "Price level of the garage, e.g. $$ or €€"
msgstr "Mức giá của garage, ví dụ $$ hoặc €€"

#. config.garage.notice
#: schema.json
msgctxt "fn"
msgid "Notice"
msgstr "Lưu ý"

#. config.garage.notice
#: schema.json
msgctxt "fh"
msgid "Short note shown in the footer, e.g. All repairs come with a 24 month warranty on parts and labour."
msgstr "Thông báo ngắn hiển thị ở chân trang, ví dụ: Mọi hạng mục sửa chữa đều được bảo hành 24 tháng cho phụ tùng và công thợ."

#. config.garage.action-bar
#: schema.json
msgctxt "fn"
msgid "Action bar"
msgstr "Thanh thao tác"

