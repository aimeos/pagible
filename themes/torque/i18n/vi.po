#: schema.json
msgctxt "fh"
msgid "Phone number of the breakdown and towing service, shown in the top bar"
msgstr "Số điện thoại dịch vụ cứu hộ và kéo xe, hiển thị ở thanh trên cùng"

#. config.garage.email
#: schema.json
msgctxt "fn"
msgid "email"
msgstr "Email"

