#: schema.json
msgctxt "fh"
msgid "Link to the service booking page, shown as a button in the header"
msgstr "Liên kết đến trang đặt lịch bảo dưỡng, hiển thị dưới dạng nút ở đầu trang"

#. config.garage.prices
#: schema.json
msgctxt "fn"
msgid "Price list link"
msgstr "Liên kết bảng giá"

