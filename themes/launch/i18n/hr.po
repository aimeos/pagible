#. config.product.name
#: schema.json
msgctxt "fh"
msgid "Name of the software product or app"
msgstr "Naziv softverskog proizvoda ili aplikacije"

#. config.product.category
#: schema.json
msgctxt "fn"
msgid "Category"
msgstr "Kategorija"

#. config.product.category
#: schema.json
msgctxt "fh"
msgid "Kind of software shown to search engines"
msgstr "Vrsta softvera prikazana pretraživačima"

#. config.product.category
#: schema.json
msgctxt "op"
msgid "Business software"
msgstr "Poslovni softver"

#. config.product.category
#: schema.json
msgctxt "op"
msgid "Developer tool"
msgstr "Alat za programere"

#. config.product.category
#: schema.json
msgctxt "op"
msgid "Design tool"
msgstr "Alat za dizajn"

#. config.product.category
#: schema.json
msgctxt "op"
msgid "Finance software"
msgstr "Financijski softver"

#. config.product.category
#: schema.json
msgctxt "op"
msgid "Security software"
msgstr "Sigurnosni softver"

#. config.product.category
#: schema.json
msgctxt "op"
msgid "Learning software"
msgstr "Softver za učenje"

#. config.product.category
#: schema.json
msgctxt "op"
msgid "Consumer app"
msgstr "Potrošačka aplikacija"

#. config.product.description
#: schema.json
msgctxt "fh"
msgid "One sentence describing what the product does, used for search engines"
msgstr "Jedna rečenica koja opisuje što proizvod radi, namijenjena za tražilice."

#. config.product.announcement
#: schema.json
msgctxt "fn"
msgid "Announcement"
msgstr "Obavijest"

#. config.product.announcement
#: schema.json
msgctxt "fh"
msgid "Short news shown at the top of every page, e.g. New: status pages with custom domains"
msgstr "Kratke vijesti prikazane na vrhu svake stranice, npr. Novost: stranice statusa s prilagođenim domenama"

#. config.product.announcement-link
#: schema.json
msgctxt "fn"
msgid "Announcement link"
msgstr "Poveznica za objavu"

#. config.product.announcement-link
#: schema.json
msgctxt "fh"
msgid "Page the announcement links to, e.g. the changelog entry"
msgstr "Stranica na koju vode poveznice u objavi, npr. unos u dnevniku promjena."

#. config.product.status
#: schema.json
msgctxt "fn"
msgid "Status page link"
msgstr "Poveznica na stranicu sa statusom"

#. config.product.status
#: schema.json
msgctxt "fh"
msgid "Link to the public status page, shown in the footer"
msgstr "Poveznica na javnu stranicu sa statusom, prikazanu u podnožju"

#. config.product.price
#: schema.json
msgctxt "fn"
msgid "Starting price"
msgstr "Početna cijena"

#. config.product.price
#: schema.json
msgctxt "fh"
msgid "Lowest price for search engines, e.g. 0 for a free plan or 19.00"
msgstr "Najniža cijena za tražilice, npr. 0 za besplatni plan ili 19.00"

#. config.product.currency
#: schema.json
msgctxt "fh"
msgid "Three letter ISO currency code, e.g. USD or EUR"
msgstr "Dvoznamenkasti ISO kod valute, npr. USD ili EUR"

#. config.product.rating
#: schema.json
msgctxt "fn"
msgid "Rating"
msgstr "Ocjena"

#. config.product.rating
#: schema.json
msgctxt "fh"
msgid "Average review rating from 1 to 5, e.g. 4.8"
msgstr "Prosječna ocjena recenzija od 1 do 5, npr. 4.8"

#. config.product.reviews
#: schema.json
msgctxt "fn"
msgid "Number of reviews"
msgstr "Broj recenzija"

#. config.product.reviews
#: schema.json
msgctxt "fh"
msgid "Number of reviews the rating is based on"
msgstr "Broj recenzija na kojima se temelji ocjena"

#. config.product.notice
#: schema.json
msgctxt "fn"
msgid "Notice"
msgstr "Napomena"

#. config.product.notice
#: schema.json
msgctxt "fh"
msgid "Short note shown in the footer, e.g. SOC 2 Type II certified, data hosted in the EU"
msgstr "Kratka napomena prikazana u podnožju, npr. certificirano prema SOC 2 Tip II, podaci hostirani u EU"

#. config.theme
#: schema.json
msgctxt "st"
msgid "launch::theme"
msgstr "Tema"

#. config.theme.--pico-border-radius
#: schema.json
msgctxt "fh"
msgid "Rounding of corners as CSS length, e.g. 1rem or 0 for sharp corners"
msgstr "Zaobljavanje kutova kao CSS duljina, npr. 1rem ili 0 za oštre kutove"
