#. config.product
#: schema.json
msgctxt "st"
msgid "launch::product"
msgstr "Məhsul"

#. config.product.name
#: schema.json
msgctxt "fh"
msgid "Name of the software product or app"
msgstr "Proqram təminatı məhsulunun və ya tətbiqin adı"

#. config.product.category
#: schema.json
msgctxt "fn"
msgid "Category"
msgstr "Kateqoriya"

#. config.product.category
#: schema.json
msgctxt "fh"
msgid "Kind of software shown to search engines"
msgstr "Axtarış sistemlərinə göstərilən proqram növü"

#. config.product.category
#: schema.json
msgctxt "op"
msgid "Business software"
msgstr "Biznes proqram təminatı"

#. config.product.category
#: schema.json
msgctxt "op"
msgid "Developer tool"
msgstr "Tərtibatçı aləti"

#. config.product.category
#: schema.json
msgctxt "op"
msgid "Design tool"
msgstr "Dizayn aləti"

#. config.product.category
#: schema.json
msgctxt "op"
msgid "Finance software"
msgstr "Maliyyə proqramı"

#. config.product.category
#: schema.json
msgctxt "op"
msgid "Security software"
msgstr "Təhlükəsizlik proqramı"

#. config.product.category
#: schema.json
msgctxt "op"
msgid "Learning software"
msgstr "Öyrənmə proqramı"

#. config.product.category
#: schema.json
msgctxt "op"
msgid "Consumer app"
msgstr "İstifadəçi tətbiqi"

#. config.product.description
#: schema.json
msgctxt "fh"
msgid "One sentence describing what the product does, used for search engines"
msgstr "Məhsulun nə etdiyini təsvir edən, axtarış motorları üçün istifadə olunan bir cümlə"

#. config.product.announcement
#: schema.json
msgctxt "fn"
msgid "Announcement"
msgstr "Elan"

#. config.product.announcement
#: schema.json
msgctxt "fh"
msgid "Short news shown at the top of every page, e.g. New: status pages with custom domains"
msgstr "Hər səhifənin yuxarısında göstərilən qısa xəbərlər, məsələn: Yeni: öz domenlərinə malik status səhifələri"

#. config.product.announcement-link
#: schema.json
msgctxt "fn"
msgid "Announcement link"
msgstr "Elan linki"

#. config.product.announcement-link
#: schema.json
msgctxt "fh"
msgid "Page the announcement links to, e.g. the changelog entry"
msgstr "Səhifə elan linklərinə istinad edir, məsələn dəyişikliklər jurnalındakı yazıya."

#. config.product.status
#: schema.json
msgctxt "fn"
msgid "Status page link"
msgstr "Status səhifəsinin linki"

#. config.product.status
#: schema.json
msgctxt "fh"
msgid "Link to the public status page, shown in the footer"
msgstr "Ayaqlıqda göstərilən ictimai status səhifəsinə keçid"

#. config.product.price
#: schema.json
msgctxt "fn"
msgid "Starting price"
msgstr "Başlanğıc qiyməti"

#. config.product.price
#: schema.json
msgctxt "fh"
msgid "Lowest price for search engines, e.g. 0 for a free plan or 19.00"
msgstr "Axtarış sistemləri üçün ən aşağı qiymət, məsələn, pulsuz plan üçün 0 və ya 19.00"

#. config.product.currency
#: schema.json
msgctxt "fh"
msgid "Three letter ISO currency code, e.g. USD or EUR"
msgstr "Üç hərfli ISO valyuta kodu, məsələn USD və ya EUR"

#. config.product.rating
#: schema.json
msgctxt "fn"
msgid "Rating"
msgstr "Reytinq"

#. config.product.rating
#: schema.json
msgctxt "fh"
msgid "Average review rating from 1 to 5, e.g. 4.8"
msgstr "1-dən 5-ə qədər orta rəy qiymətləndirməsi, məsələn 4.8"

#. config.product.reviews
#: schema.json
msgctxt "fn"
msgid "Number of reviews"
msgstr "Rəy sayı"

#. config.product.reviews
#: schema.json
msgctxt "fh"
msgid "Number of reviews the rating is based on"
msgstr "Reytinqin əsaslandığı rəylərin sayı"

#. config.product.notice
#: schema.json
msgctxt "fn"
msgid "Notice"
msgstr "Bildiriş"

#. config.product.notice
#: schema.json
msgctxt "fh"
msgid "Short note shown in the footer, e.g. SOC 2 Type II certified, data hosted in the EU"
msgstr "Ayaqnotda göstərilən qısa qeyd, məsələn: SOC 2 Tip II sertifikatlı, məlumatlar Avropa İttifaqında yerləşdirilib"

#. config.theme
#: schema.json
msgctxt "st"
msgid "launch::theme"
msgstr "Mövzu"

#. config.theme.--pico-border-radius
#: schema.json
msgctxt "fh"
msgid "Rounding of corners as CSS length, e.g. 1rem or 0 for sharp corners"
msgstr "Künclərin yuvarlaşdırılması CSS uzunluğu kimi, məsələn, kəskin künclər üçün 1rem və ya 0"
