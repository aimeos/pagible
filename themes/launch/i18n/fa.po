msgid "launch::product"
msgstr "محصول"

#. config.product.name
#: schema.json
msgctxt "fh"
msgid "Name of the software product or app"
msgstr "نام محصول نرم‌افزاری یا اپلیکیشن"

#. config.product.category
#: schema.json
msgctxt "fn"
msgid "Category"
msgstr "دسته‌بندی"

#. config.product.category
#: schema.json
msgctxt "fh"
msgid "Kind of software shown to search engines"
msgstr "نوع نرم‌افزاری که به موتورهای جستجو نشان داده می‌شود"

#. config.product.category
#: schema.json
msgctxt "op"
msgid "Business software"
msgstr "نرم‌افزار کسب‌وکار"

#. config.product.category
#: schema.json
msgctxt "op"
msgid "Developer tool"
msgstr "ابزار توسعه‌دهنده"

#. config.product.category
#: schema.json
msgctxt "op"
msgid "Design tool"
msgstr "ابزار طراحی"

#. config.product.category
#: schema.json
msgctxt "op"
msgid "Finance software"
