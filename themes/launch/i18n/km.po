#. config.product
#: schema.json
msgctxt "st"
msgid "launch::product"
msgstr "ផលិតផល"

#. config.product.name
#: schema.json
msgctxt "fh"
msgid "Name of the software product or app"
msgstr "ឈ្មោះផលិតផលកម្មវិធី ឬកម្មវិធីទូរស័ព្ទ"

#. config.product.category
#: schema.json
msgctxt "fn"
msgid "Category"
msgstr "ប្រភេទ"

#. config.product.category
#: schema.json
msgctxt "fh"
msgid "Kind of software shown to search engines"
msgstr "ប្រភេទកម្មវិធីដែលបង្ហាញដល់ម៉ាស៊ីនស្វែងរក"

#. config.product.category
#: schema.json
msgctxt "op"
msgid "Business software"
msgstr "កម្មវិធីអាជីវកម្ម"

#. config.product.category
#: schema.json
msgctxt "op"
msgid "Developer tool"
msgstr "ឧបករណ៍អ្នកអភិវឌ្ឍន៍"

#. config.product.category
#: schema.json
msgctxt "op"
msgid "Design tool"
msgstr "ឧបករណ៍រចនា"

#. config.product.category
#: schema.json
msgctxt "op"
msgid "Finance software"
msgstr "កម្មវិធីហិរញ្ញវត្ថុ"

#. config.product.category
#: schema.json
msgctxt "op"
msgid "Security software"
msgstr "កម្មវិធីសុវត្ថិភាព"

#. config.product.category
#: schema.json
msgctxt "op"
msgid "Learning software"
msgstr "កម្មវិធីសិក្សា"

#. config.product.category
#: schema.json
msgctxt "op"
msgid "Consumer app"
msgstr "កម្មវិធីសម្រាប់អ្នកប្រើប្រាស់"

#. config.product.description
#: schema.json
msgctxt "fh"
msgid "One sentence describing what the product does, used for search engines"
msgstr "ប្រយោគមួយពិពណ៌នាអំពីអ្វីដែលផលិតផលធ្វើ ដែលប្រើសម្រាប់ម៉ាស៊ីនស្វែងរក"

#. config.product.announcement
#: schema.json
msgctxt "fh"
msgid "Short news shown at the top of every page, e.g. New: status pages with custom domains"
msgstr "ព័ត៌មានខ្លីដែលបង្ហាញនៅផ្នែកខាងលើនៃទំព័រនីមួយៗ ឧ. ថ្មី៖ ទំព័រស្ថានភាពជាមួយដែនផ្ទាល់ខ្លួន"

#. config.product.announcement-link
#: schema.json
msgctxt "fn"
msgid "Announcement link"
msgstr "តំណសេចក្តីប្រកាស"

#. config.product.announcement-link
#: schema.json
msgctxt "fh"
msgid "Page the announcement links to, e.g. the changelog entry"
msgstr "ទំព័រដែលសេចក្តីប្រកាសភ្ជាប់ទៅ ឧ. ធាតុកំណត់ហេតុការផ្លាស់ប្តូរ"

#. config.product.status
#: schema.json
msgctxt "fn"
msgid "Status page link"
msgstr "តំណទំព័រស្ថានភាព"

#. config.product.status
#: schema.json
msgctxt "fh"
msgid "Link to the public status page, shown in the footer"
msgstr "តំណទៅទំព័រស្ថានភាពសាធារណៈ ដែលបង្ហាញនៅបាតទំព័រ"

#. config.product.price
#: schema.json
msgctxt "fn"
msgid "Starting price"
msgstr "តម្លៃចាប់ផ្តើម"

#. config.product.price
#: schema.json
msgctxt "fh"
msgid "Lowest price for search engines, e.g. 0 for a free plan or 19.00"
msgstr "តម្លៃទាបបំផុតសម្រាប់ម៉ាស៊ីនស្វែងរក ឧ. 0 សម្រាប់គម្រោងឥតគិតថ្លៃ ឬ 19.00"

#. config.product.currency
#: schema.json
msgctxt "fh"
msgid "Three letter ISO currency code, e.g. USD or EUR"
msgstr "លេខកូដរូបិយប័ណ្ណ ISO បីតួអក្សរ ឧ. USD ឬ EUR"

#. config.product.rating
#: schema.json
msgctxt "fn"
msgid "Rating"
msgstr "ការដាក់ពិន្ទុ"

#. config.product.rating
#: schema.json
msgctxt "fh"
msgid "Average review rating from 1 to 5, e.g. 4.8"
msgstr "ពិន្ទុវាយតម្លៃមធ្យមពី 1 ដល់ 5 ឧ. 4.8"

#. config.product.reviews
#: schema.json
msgctxt "fn"
msgid "Number of reviews"
msgstr "ចំនួនមតិវាយតម្លៃ"

#. config.product.reviews
#: schema.json
msgctxt "fh"
msgid "Number of reviews the rating is based on"
msgstr "ចំនួនមតិវាយតម្លៃដែលការដាក់ពិន្ទុផ្អែកលើ"

#. config.product.notice
#: schema.json
msgctxt "fh"
msgid "Short note shown in the footer, e.g. SOC 2 Type II certified, data hosted in the EU"
msgstr "កំណត់ចំណាំខ្លីដែលបង្ហាញនៅបាតទំព័រ ឧ. មានវិញ្ញាបនបត្រ SOC 2 Type II ទិន្នន័យរក្សាទុកនៅ EU"

#. config.theme
#: schema.json
msgctxt "st"
msgid "launch::theme"
msgstr "រចនាប័ទ្ម"
