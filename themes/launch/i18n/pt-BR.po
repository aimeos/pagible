#. config.product.description
#: schema.json
msgctxt "fh"
msgid "One sentence describing what the product does, used for search engines"
msgstr "Uma frase que descreva a função do produto, destinada aos mecanismos de busca"

#. config.product.announcement
#: schema.json
msgctxt "fh"
msgid "Short news shown at the top of every page, e.g. New: status pages with custom domains"
msgstr "Notícias curtas exibidas na parte superior de cada página, por exemplo: Novidade: páginas de status com domínios personalizados"

#. config.product.announcement-link
#: schema.json
msgctxt "fn"
msgid "Announcement link"
msgstr "Link do anúncio"

#. config.product.announcement-link
#: schema.json
msgctxt "fh"
msgid "Page the announcement links to, e.g. the changelog entry"
msgstr "Página para a qual o anúncio leva, por exemplo, a entrada no histórico de alterações"

#. config.product.status
#: schema.json
msgctxt "fn"
msgid "Status page link"
msgstr "Link para a página de status"

#. config.product.status
#: schema.json
msgctxt "fh"
msgid "Link to the public status page, shown in the footer"
msgstr "Link para a página de status pública, exibida no rodapé"

#. config.product.price
#: schema.json
msgctxt "fn"
msgid "Starting price"
msgstr "Preço inicial"

#. config.product.price
#: schema.json
msgctxt "fh"
msgid "Lowest price for search engines, e.g. 0 for a free plan or 19.00"
msgstr "Preço mínimo para os mecanismos de busca, por exemplo, 0 para um plano gratuito ou 19.00"

#. config.product.currency
#: schema.json
msgctxt "fh"
msgid "Three letter ISO currency code, e.g. USD or EUR"
msgstr "Código de moeda ISO de três letras, por exemplo, USD ou EUR"

#. config.product.rating
#: schema.json
msgctxt "fn"
msgid "Rating"
msgstr "Nota"

#. config.product.rating
#: schema.json
msgctxt "fh"
msgid "Average review rating from 1 to 5, e.g. 4.8"
msgstr "Nota média das avaliações de 1 a 5, por exemplo, 4.8"

#. config.product.reviews
#: schema.json
msgctxt "fn"
msgid "Number of reviews"
msgstr "Número de avaliações"

#. config.product.reviews
#: schema.json
msgctxt "fh"
msgid "Number of reviews the rating is based on"
msgstr "Número de avaliações nas quais a classificação se baseia"

#. config.product.notice
#: schema.json
msgctxt "fh"
msgid "Short note shown in the footer, e.g. SOC 2 Type II certified, data hosted in the EU"
msgstr "Breve nota exibida no rodapé, por exemplo: Certificado SOC 2 Tipo II, dados hospedados na UE"

