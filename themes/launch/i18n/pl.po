#. config.product.description
#: schema.json
msgctxt "fh"
msgid "One sentence describing what the product does, used for search engines"
msgstr "Jedno zdanie opisujące, co robi produkt, dla wyszukiwarek"

#. config.product.announcement
#: schema.json
msgctxt "fn"
msgid "Announcement"
msgstr "Ogłoszenie"

#. config.product.announcement
#: schema.json
msgctxt "fh"
msgid "Short news shown at the top of every page, e.g. New: status pages with custom domains"
msgstr "Krótka wiadomość wyświetlana na górze każdej strony, np. Nowość: strony statusu z własnymi domenami"

#. config.product.announcement-link
#: schema.json
msgctxt "fn"
msgid "Announcement link"
msgstr "Link do ogłoszenia"

#. config.product.announcement-link
#: schema.json
msgctxt "fh"
msgid "Page the announcement links to, e.g. the changelog entry"
msgstr "Strona, do której prowadzi ogłoszenie, np. wpis dziennika zmian"

#. config.product.status
#: schema.json
msgctxt "fn"
msgid "Status page link"
msgstr "Link do strony statusu"

#. config.product.status
#: schema.json
msgctxt "fh"
msgid "Link to the public status page, shown in the footer"
msgstr "Link do publicznej strony statusu, wyświetlany w stopce"

#. config.product.price
#: schema.json
msgctxt "fn"
msgid "Starting price"
msgstr "Cena początkowa"

#. config.product.price
#: schema.json
msgctxt "fh"
msgid "Lowest price for search engines, e.g. 0 for a free plan or 19.00"
msgstr "Najniższa cena dla wyszukiwarek, np. 0 dla darmowego planu lub 19.00"

#. config.product.currency
#: schema.json
msgctxt "fh"
msgid "Three letter ISO currency code, e.g. USD or EUR"
msgstr "Trzyliterowy kod walutowy ISO, np. USD lub EUR"

#. config.product.rating
#: schema.json
msgctxt "fn"
msgid "Rating"
msgstr "Ocena"

#. config.product.rating
#: schema.json
msgctxt "fh"
msgid "Average review rating from 1 to 5, e.g. 4.8"
msgstr "Średnia ocena opinii od 1 do 5, np. 4.8"

#. config.product.reviews
#: schema.json
msgctxt "fn"
msgid "Number of reviews"
msgstr "Liczba opinii"

#. config.product.reviews
#: schema.json
msgctxt "fh"
msgid "Number of reviews the rating is based on"
msgstr "Liczba opinii, na których oparta jest ocena"

#. config.product.notice
#: schema.json
msgctxt "fn"
msgid "Notice"
msgstr "Informacja"

#. config.product.notice
#: schema.json
msgctxt "fh"
msgid "Short note shown in the footer, e.g. SOC 2 Type II certified, data hosted in the EU"
msgstr "Krótka informacja w stopce, np. certyfikat SOC 2 Type II, dane przechowywane w UE"

#. config.theme
#: schema.json
msgctxt "st"
msgid "launch::theme"
msgstr "Motyw"

#. config.theme.--pico-border-radius
#: schema.json
msgctxt "fh"
msgid "Rounding of corners as CSS length, e.g. 1rem or 0 for sharp corners"
msgstr "Zaokrąglenie narożników jako długość CSS, np. 1rem lub 0 dla ostrych narożników"
