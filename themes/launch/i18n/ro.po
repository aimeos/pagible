#. config.product.announcement
#: schema.json
msgctxt "fn"
msgid "Announcement"
msgstr "Anunț"

#. config.product.announcement
#: schema.json
msgctxt "fh"
msgid "Short news shown at the top of every page, e.g. New: status pages with custom domains"
msgstr "Știre scurtă afișată în partea de sus a fiecărei pagini, de ex. Nou: pagini de stare cu domenii personalizate"

#. config.product.announcement-link
#: schema.json
msgctxt "fn"
msgid "Announcement link"
msgstr "Link anunț"

#. config.product.announcement-link
#: schema.json
msgctxt "fh"
msgid "Page the announcement links to, e.g. the changelog entry"
msgstr "Pagina către care trimite anunțul, de ex. intrarea din changelog"

#. config.product.status
#: schema.json
msgctxt "fn"
msgid "Status page link"
msgstr "Link pagină de stare"

#. config.product.status
#: schema.json
msgctxt "fh"
msgid "Link to the public status page, shown in the footer"
msgstr "Link către pagina de stare publică, afișat în subsol"

#. config.product.price
#: schema.json
msgctxt "fn"
msgid "Starting price"
msgstr "Preț de la"

#. config.product.price
#: schema.json
msgctxt "fh"
msgid "Lowest price for search engines, e.g. 0 for a free plan or 19.00"
msgstr "Cel mai mic preț pentru motoarele de căutare, de ex. 0 pentru un plan gratuit sau 19.00"

#. config.product.currency
#: schema.json
msgctxt "fh"
msgid "Three letter ISO currency code, e.g. USD or EUR"
msgstr "Cod de monedă ISO din trei litere, de ex. USD sau EUR"

#. config.product.rating
#: schema.json
msgctxt "fn"
msgid "Rating"
msgstr "Evaluare"

#. config.product.rating
#: schema.json
msgctxt "fh"
msgid "Average review rating from 1 to 5, e.g. 4.8"
msgstr "Evaluarea medie a recenziilor de la 1 la 5, de ex. 4.8"

#. config.product.reviews
#: schema.json
msgctxt "fn"
msgid "Number of reviews"
msgstr "Număr de recenzii"

#. config.product.reviews
#: schema.json
msgctxt "fh"
msgid "Number of reviews the rating is based on"
msgstr "Numărul de recenzii pe care se bazează evaluarea"

#. config.product.notice
#: schema.json
msgctxt "fn"
msgid "Notice"
msgstr "Notă"

#. config.product.notice
#: schema.json
msgctxt "fh"
msgid "Short note shown in the footer, e.g. SOC 2 Type II certified, data hosted in the EU"
msgstr "Notă scurtă afișată în subsol, de ex. certificat SOC 2 Type II, date găzduite în UE"

#. config.theme
#: schema.json
msgctxt "st"
msgid "launch::theme"
msgstr "Temă"

#. config.theme.--pico-border-radius
#: schema.json
msgctxt "fh"
msgid "Rounding of corners as CSS length, e.g. 1rem or 0 for sharp corners"
msgstr "Rotunjirea colțurilor ca valoare de lungime CSS, de exemplu 1rem sau 0 pentru colțuri ascuțite"
