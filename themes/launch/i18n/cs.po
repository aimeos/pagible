#. config.product.description
#: schema.json
msgctxt "fh"
msgid "One sentence describing what the product does, used for search engines"
msgstr "Jedna věta popisující, co produkt dělá, pro vyhledávače"

#. config.product.announcement
#: schema.json
msgctxt "fh"
msgid "Short news shown at the top of every page, e.g. New: status pages with custom domains"
msgstr "Krátká novinka zobrazená v horní části každé stránky, např. Novinka: stránky stavu s vlastními doménami"

#. config.product.announcement-link
#: schema.json
msgctxt "fn"
msgid "Announcement link"
msgstr "Odkaz na oznámení"

#. config.product.announcement-link
#: schema.json
msgctxt "fh"
msgid "Page the announcement links to, e.g. the changelog entry"
msgstr "Stránka, na kterou oznámení odkazuje, např. záznam ve changelogu"

#. config.product.status
#: schema.json
msgctxt "fn"
msgid "Status page link"
msgstr "Odkaz na stránku stavu"

#. config.product.status
#: schema.json
msgctxt "fh"
msgid "Link to the public status page, shown in the footer"
msgstr "Odkaz na veřejnou stránku stavu, zobrazený v zápatí"

#. config.product.price
#: schema.json
msgctxt "fn"
msgid "Starting price"
msgstr "Počáteční cena"

#. config.product.price
#: schema.json
msgctxt "fh"
msgid "Lowest price for search engines, e.g. 0 for a free plan or 19.00"
msgstr "Nejnižší cena pro vyhledávače, např. 0 pro bezplatný plán nebo 19.00"

#. config.product.currency
#: schema.json
msgctxt "fh"
msgid "Three letter ISO currency code, e.g. USD or EUR"
msgstr "Třípísmenný ISO kód měny, např. USD nebo EUR"

#. config.product.rating
#: schema.json
msgctxt "fn"
msgid "Rating"
msgstr "Hodnocení"

#. config.product.rating
#: schema.json
msgctxt "fh"
msgid "Average review rating from 1 to 5, e.g. 4.8"
msgstr "Průměrné hodnocení recenzí od 1 do 5, např. 4.8"

#. config.product.reviews
#: schema.json
msgctxt "fn"
msgid "Number of reviews"
msgstr "Počet recenzí"

#. config.product.reviews
#: schema.json
msgctxt "fh"
msgid "Number of reviews the rating is based on"
msgstr "Počet recenzí, na kterých je hodnocení založeno"

#. config.product.notice
#: schema.json
msgctxt "fh"
msgid "Short note shown in the footer, e.g. SOC 2 Type II certified, data hosted in the EU"
msgstr "Krátká poznámka v zápatí, např. certifikace SOC 2 Type II, data hostovaná v EU"

#. config.theme
