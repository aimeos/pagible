#. config.product.description
#: schema.json
msgctxt "fh"
msgid "One sentence describing what the product does, used for search engines"
msgstr "Jedna veta popisujúca, čo produkt robí, pre vyhľadávače"

#. config.product.announcement
#: schema.json
msgctxt "fn"
msgid "Announcement"
msgstr "Oznámenie"

#. config.product.announcement
#: schema.json
msgctxt "fh"
msgid "Short news shown at the top of every page, e.g. New: status pages with custom domains"
msgstr "Krátka novinka zobrazená v hornej časti každej stránky, napr. Novinka: stránky stavu s vlastnými doménami"

#. config.product.announcement-link
#: schema.json
msgctxt "fn"
msgid "Announcement link"
msgstr "Odkaz na oznámenie"

#. config.product.announcement-link
#: schema.json
msgctxt "fh"
msgid "Page the announcement links to, e.g. the changelog entry"
msgstr "Stránka, na ktorú oznámenie odkazuje, napr. záznam v changelogu"

#. config.product.status
#: schema.json
msgctxt "fn"
msgid "Status page link"
msgstr "Odkaz na stránku stavu"

#. config.product.status
#: schema.json
msgctxt "fh"
msgid "Link to the public status page, shown in the footer"
msgstr "Odkaz na verejnú stránku stavu, zobrazený v päte"

#. config.product.price
#: schema.json
msgctxt "fn"
msgid "Starting price"
msgstr "Cena od"

#. config.product.price
#: schema.json
msgctxt "fh"
msgid "Lowest price for search engines, e.g. 0 for a free plan or 19.00"
msgstr "Najnižšia cena pre vyhľadávače, napr. 0 pre bezplatný plán alebo 19.00"

#. config.product.currency
#: schema.json
msgctxt "fh"
msgid "Three letter ISO currency code, e.g. USD or EUR"
msgstr "Trojpísmenový ISO kód meny, napr. USD alebo EUR"

#. config.product.rating
#: schema.json
msgctxt "fn"
msgid "Rating"
msgstr "Hodnotenie"

#. config.product.rating
#: schema.json
msgctxt "fh"
msgid "Average review rating from 1 to 5, e.g. 4.8"
msgstr "Priemerné hodnotenie recenzií od 1 do 5, napr. 4.8"

#. config.product.reviews
#: schema.json
msgctxt "fn"
msgid "Number of reviews"
msgstr "Počet recenzií"

#. config.product.reviews
#: schema.json
msgctxt "fh"
msgid "Number of reviews the rating is based on"
msgstr "Počet recenzií, na ktorých je hodnotenie založené"

#. config.product.notice
#: schema.json
msgctxt "fn"
msgid "Notice"
msgstr "Upozornenie"

#. config.product.notice
#: schema.json
msgctxt "fh"
msgid "Short note shown in the footer, e.g. SOC 2 Type II certified, data hosted in the EU"
msgstr "Krátka poznámka v päte, napr. certifikácia SOC 2 Type II, dáta hostované v EÚ"

#. config.theme
#: schema.json
msgctxt "st"
msgid "launch::theme"
msgstr "Téma"

#. config.theme.--pico-border-radius
#: schema.json
msgctxt "fh"
msgid "Rounding of corners as CSS length, e.g. 1rem or 0 for sharp corners"
msgstr "Zaoblenie rohov ako dĺžka v CSS, napr. 1rem alebo 0 pre ostré rohy"
