msgstr "Software educativo"

#. config.product.category
#: schema.json
msgctxt "op"
msgid "Consumer app"
msgstr "Aplicación para consumidores"

#. config.product.description
#: schema.json
msgctxt "fh"
msgid "One sentence describing what the product does, used for search engines"
msgstr "Una frase que describe qué hace el producto, usada para los motores de búsqueda"

#. config.product.announcement
#: schema.json
msgctxt "fn"
msgid "Announcement"
msgstr "Anuncio"

#. config.product.announcement
#: schema.json
msgctxt "fh"
msgid "Short news shown at the top of every page, e.g. New: status pages with custom domains"
msgstr "Noticia breve mostrada en la parte superior de cada página, p. ej. Novedad: páginas de estado con dominios personalizados"

#. config.product.announcement-link
#: schema.json
msgctxt "fn"
msgid "Announcement link"
msgstr "Enlace del anuncio"

#. config.product.announcement-link
#: schema.json
msgctxt "fh"
msgid "Page the announcement links to, e.g. the changelog entry"
msgstr "Página a la que enlaza el anuncio, p. ej. la entrada del registro de cambios"

#. config.product.status
#: schema.json
msgctxt "fn"
msgid "Status page link"
msgstr "Enlace de la página de estado"

#. config.product.status
#: schema.json
msgctxt "fh"
msgid "Link to the public status page, shown in the footer"
msgstr "Enlace a la página de estado pública, se muestra en el pie de página"

#. config.product.price
#: schema.json
msgctxt "fn"
msgid "Starting price"
msgstr "Precio inicial"

#. config.product.price
#: schema.json
msgctxt "fh"
msgid "Lowest price for search engines, e.g. 0 for a free plan or 19.00"
msgstr "Precio más bajo para los motores de búsqueda, p. ej. 0 para un plan gratuito o 19.00"

#. config.product.currency
#: schema.json
msgctxt "fh"
msgid "Three letter ISO currency code, e.g. USD or EUR"
msgstr "Código de moneda ISO de tres letras, p. ej. USD o EUR"

#. config.product.rating
#: schema.json
msgctxt "fn"
msgid "Rating"
msgstr "Valoración"

#. config.product.rating
#: schema.json
msgctxt "fh"
msgid "Average review rating from 1 to 5, e.g. 4.8"
msgstr "Valoración media de las reseñas de 1 a 5, p. ej. 4.8"

#. config.product.reviews
#: schema.json
msgctxt "fn"
msgid "Number of reviews"
msgstr "Número de reseñas"

#. config.product.reviews
#: schema.json
msgctxt "fh"
msgid "Number of reviews the rating is based on"
msgstr "Número de reseñas en las que se basa la valoración"

#. config.product.notice
#: schema.json
msgctxt "fn"
msgid "Notice"
msgstr "Aviso"

#. config.product.notice
#: schema.json
msgctxt "fh"
msgid "Short note shown in the footer, e.g. SOC 2 Type II certified, data hosted in the EU"
msgstr "Nota breve mostrada en el pie de página, p. ej. certificado SOC 2 Type II, datos alojados en la UE"

#. config.theme
#: schema.json
msgctxt "st"
msgid "launch::theme"
msgstr "Tema"

#. config.theme.--pico-border-radius
#: schema.json
msgctxt "fh"
msgid "Rounding of corners as CSS length, e.g. 1rem or 0 for sharp corners"
msgstr "Redondeo de esquinas como longitud CSS; por ejemplo, 1rem o 0 para esquinas afiladas"
