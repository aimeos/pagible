#. config.product.description
#: schema.json
msgctxt "fh"
msgid "One sentence describing what the product does, used for search engines"
msgstr "En stavek, ki opisuje, kaj izdelek počne, za iskalnike"

#. config.product.announcement
#: schema.json
msgctxt "fh"
msgid "Short news shown at the top of every page, e.g. New: status pages with custom domains"
msgstr "Kratka novica na vrhu vsake strani, npr. Novo: strani s stanjem po meri z lastnimi domenami"

#. config.product.announcement-link
#: schema.json
msgctxt "fn"
msgid "Announcement link"
msgstr "Povezava do obvestila"

#. config.product.announcement-link
#: schema.json
msgctxt "fh"
msgid "Page the announcement links to, e.g. the changelog entry"
msgstr "Stran, na katero se obvestilo sklicuje, npr. vnos v dnevniku sprememb"

#. config.product.status
#: schema.json
msgctxt "fn"
msgid "Status page link"
msgstr "Povezava do strani s stanjem"

#. config.product.status
#: schema.json
msgctxt "fh"
msgid "Link to the public status page, shown in the footer"
msgstr "Povezava do javne strani s stanjem, prikazana v nogi"

#. config.product.price
#: schema.json
msgctxt "fn"
msgid "Starting price"
msgstr "Cena od"

#. config.product.price
#: schema.json
msgctxt "fh"
msgid "Lowest price for search engines, e.g. 0 for a free plan or 19.00"
msgstr "Najnižja cena za iskalnike, npr. 0 za brezplačni paket ali 19.00"

#. config.product.currency
#: schema.json
msgctxt "fh"
msgid "Three letter ISO currency code, e.g. USD or EUR"
msgstr "Tričrkovna ISO koda valute, npr. USD ali EUR"

#. config.product.rating
#: schema.json
msgctxt "fn"
msgid "Rating"
msgstr "Ocena"

