#. config.product.category
#: schema.json
msgctxt "op"
msgid "Finance software"
msgstr "Finanšu programmatūra"

#. config.product.category
#: schema.json
msgctxt "op"
msgid "Security software"
msgstr "Drošības programmatūra"

#. config.product.category
#: schema.json
msgctxt "op"
msgid "Learning software"
msgstr "Apmācības programmatūra"

#. config.product.category
#: schema.json
msgctxt "op"
msgid "Consumer app"
msgstr "Patērētāju lietotne"

#. config.product.description
#: schema.json
msgctxt "fh"
msgid "One sentence describing what the product does, used for search engines"
msgstr "Viens teikums, kas aprakstīta, ko produkts dara, meklētājprogrammām"

#. config.product.announcement
#: schema.json
msgctxt "fn"
msgid "Announcement"
msgstr "Paziņojums"

#. config.product.announcement
#: schema.json
msgctxt "fh"
msgid "Short news shown at the top of every page, e.g. New: status pages with custom domains"
msgstr "Īsa ziņa, kas tiek rādīta katras lapas augšdaļā, piem. Jauns: statusa lapas ar pielāgotiem domēniem"

#. config.product.announcement-link
#: schema.json
msgctxt "fn"
msgid "Announcement link"
msgstr "Paziņojuma saite"

#. config.product.announcement-link
#: schema.json
msgctxt "fh"
msgid "Page the announcement links to, e.g. the changelog entry"
msgstr "Lapa, uz kuru norāda paziņojums, piem. izmaiņu žurnāla ieraksts"

#. config.product.status
#: schema.json
msgctxt "fn"
msgid "Status page link"
msgstr "Statusa lapas saite"

#. config.product.status
#: schema.json
msgctxt "fh"
msgid "Link to the public status page, shown in the footer"
msgstr "Saite uz publisko statusa lapu, tiek rādīta kājenē"

#. config.product.price
#: schema.json
msgctxt "fn"
msgid "Starting price"
msgstr "Sākuma cena"

#. config.product.price
#: schema.json
msgctxt "fh"
msgid "Lowest price for search engines, e.g. 0 for a free plan or 19.00"
msgstr "Zemākā cena meklētājprogrammām, piem. 0 bezmaksas plānam vai 19.00"

#. config.product.currency
#: schema.json
msgctxt "fh"
msgid "Three letter ISO currency code, e.g. USD or EUR"
msgstr "Trīsburtu ISO valūtas kods, piem. USD vai EUR"

#. config.product.rating
#: schema.json
msgctxt "fn"
msgid "Rating"
msgstr "Vērtējums"

#. config.product.rating
#: schema.json
msgctxt "fh"
msgid "Average review rating from 1 to 5, e.g. 4.8"
msgstr "Vidējais atsauksmju vērtējums no 1 līdz 5, piem. 4.8"

#. config.product.reviews
#: schema.json
msgctxt "fn"
msgid "Number of reviews"
msgstr "Atsauksmju skaits"

#. config.product.reviews
#: schema.json
msgctxt "fh"
msgid "Number of reviews the rating is based on"
msgstr "Atsauksmju skaits, uz kura balstīts vērtējums"

#. config.product.notice
#: schema.json
msgctxt "fn"
msgid "Notice"
msgstr "Piezīme"

#. config.product.notice
#: schema.json
msgctxt "fh"
msgid "Short note shown in the footer, e.g. SOC 2 Type II certified, data hosted in the EU"
msgstr "Īsa piezīme kājenē, piem. SOC 2 Type II sertificēts, dati tiek glabāti ES"

#. config.theme
#: schema.json
msgctxt "st"
msgid "launch::theme"
msgstr "Tēma"

#. config.theme.--pico-border-radius
#: schema.json
msgctxt "fh"
msgid "Rounding of corners as CSS length, e.g. 1rem or 0 for sharp corners"
msgstr "Stūru noapaļošana kā CSS garums, piemēram, 1rem vai 0, lai iegūtu asus stūrus"
