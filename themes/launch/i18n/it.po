msgid "launch::product"
msgstr "Prodotto"

#. config.product.name
#: schema.json
msgctxt "fh"
msgid "Name of the software product or app"
msgstr "Nome del prodotto software o dell'app"

#. config.product.category
#: schema.json
msgctxt "fn"
msgid "Category"
