msgid "Finance software"
msgstr "Software finanziario"

#. config.product.category
#: schema.json
msgctxt "op"
msgid "Security software"
msgstr "Software di sicurezza"

#. config.product.category
#: schema.json
msgctxt "op"
msgid "Learning software"
msgstr "Software didattico"

#. config.product.category
#: schema.json
msgctxt "op"
msgid "Consumer app"
msgstr "App per consumatori"

#. config.product.description
#: schema.json
msgctxt "fh"
msgid "One sentence describing what the product does, used for search engines"
msgstr "Una frase che descrive cosa fa il prodotto, usata per i motori di ricerca"

#. config.product.announcement
#: schema.json
msgctxt "fh"
msgid "Short news shown at the top of every page, e.g. New: status pages with custom domains"
msgstr "Breve notizia mostrata in alto in ogni pagina, ad es. Novità: pagine di stato con domini personalizzati"

#. config.product.announcement-link
#: schema.json
msgctxt "fn"
msgid "Announcement link"
msgstr "Link dell'annuncio"

#. config.product.announcement-link
#: schema.json
msgctxt "fh"
msgid "Page the announcement links to, e.g. the changelog entry"
msgstr "Pagina a cui rimanda l'annuncio, ad es. la voce del changelog"

#. config.product.status
#: schema.json
msgctxt "fn"
msgid "Status page link"
msgstr "Link della pagina di stato"

#. config.product.status
#: schema.json
msgctxt "fh"
msgid "Link to the public status page, shown in the footer"
msgstr "Link alla pagina di stato pubblica, mostrato nel footer"

#. config.product.price
#: schema.json
msgctxt "fn"
msgid "Starting price"
msgstr "Prezzo di partenza"

#. config.product.price
#: schema.json
msgctxt "fh"
msgid "Lowest price for search engines, e.g. 0 for a free plan or 19.00"
msgstr "Prezzo più basso per i motori di ricerca, ad es. 0 per un piano gratuito o 19.00"

#. config.product.currency
#: schema.json
msgctxt "fh"
msgid "Three letter ISO currency code, e.g. USD or EUR"
msgstr "Codice valuta ISO di tre lettere, ad es. USD o EUR"

#. config.product.rating
#: schema.json
msgctxt "fn"
msgid "Rating"
msgstr "Valutazione"

#. config.product.rating
#: schema.json
msgctxt "fh"
msgid "Average review rating from 1 to 5, e.g. 4.8"
msgstr "Valutazione media delle recensioni da 1 a 5, ad es. 4.8"

#. config.product.reviews
#: schema.json
msgctxt "fn"
msgid "Number of reviews"
msgstr "Numero di recensioni"

#. config.product.reviews
#: schema.json
msgctxt "fh"
msgid "Number of reviews the rating is based on"
msgstr "Numero di recensioni su cui si basa la valutazione"

#. config.product.notice
#: schema.json
msgctxt "fh"
msgid "Short note shown in the footer, e.g. SOC 2 Type II certified, data hosted in the EU"
msgstr "Breve nota mostrata nel footer, ad es. certificato SOC 2 Type II, dati ospitati nell'UE"

#. config.theme
