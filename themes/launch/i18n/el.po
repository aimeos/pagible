#. config.product
#: schema.json
msgctxt "st"
msgid "launch::product"
msgstr "Προϊόν"

#. config.product.name
#: schema.json
msgctxt "fh"
msgid "Name of the software product or app"
msgstr "Όνομα του λογισμικού ή της εφαρμογής"

#. config.product.category
#: schema.json
msgctxt "fn"
msgid "Category"
msgstr "Κατηγορία"

#. config.product.category
#: schema.json
msgctxt "fh"
msgid "Kind of software shown to search engines"
msgstr "Είδος λογισμικού που εμφανίζεται στις μηχανές αναζήτησης"

#. config.product.category
#: schema.json
msgctxt "op"
msgid "Business software"
msgstr "Επιχειρηματικό λογισμικό"

#. config.product.category
#: schema.json
msgctxt "op"
msgid "Developer tool"
msgstr "Εργαλείο προγραμματιστών"

#. config.product.category
#: schema.json
msgctxt "op"
msgid "Design tool"
msgstr "Εργαλείο σχεδίασης"

#. config.product.category
#: schema.json
msgctxt "op"
msgid "Finance software"
msgstr "Λογισμικό οικονομικών"

#. config.product.category
#: schema.json
msgctxt "op"
msgid "Security software"
msgstr "Λογισμικό ασφαλείας"

#. config.product.category
#: schema.json
msgctxt "op"
msgid "Learning software"
msgstr "Εκπαιδευτικό λογισμικό"

#. config.product.category
#: schema.json
msgctxt "op"
msgid "Consumer app"
msgstr "Καταναλωτική εφαρμογή"

#. config.product.description
#: schema.json
msgctxt "fh"
msgid "One sentence describing what the product does, used for search engines"
msgstr "Μία πρόταση που περιγράφει τι κάνει το προϊόν, για τις μηχανές αναζήτησης"

#. config.product.announcement
#: schema.json
msgctxt "fh"
msgid "Short news shown at the top of every page, e.g. New: status pages with custom domains"
msgstr "Σύντομο νέο στο επάνω μέρος κάθε σελίδας, π.χ. Νέο: σελίδες κατάστασης με προσαρμοσμένους τομείς"

#. config.product.announcement-link
#: schema.json
msgctxt "fn"
msgid "Announcement link"
msgstr "Σύνδεσμος ανακοίνωσης"

#. config.product.announcement-link
#: schema.json
msgctxt "fh"
msgid "Page the announcement links to, e.g. the changelog entry"
msgstr "Σελίδα στην οποία παραπέμπει η ανακοίνωση, π.χ. η καταχώριση του changelog"

#. config.product.status
#: schema.json
msgctxt "fn"
msgid "Status page link"
msgstr "Σύνδεσμος σελίδας κατάστασης"

#. config.product.status
#: schema.json
msgctxt "fh"
msgid "Link to the public status page, shown in the footer"
msgstr "Σύνδεσμος για τη δημόσια σελίδα κατάστασης, εμφανίζεται στο υποσέλιδο"

#. config.product.price
#: schema.json
msgctxt "fn"
msgid "Starting price"
msgstr "Αρχική τιμή"

#. config.product.price
#: schema.json
msgctxt "fh"
msgid "Lowest price for search engines, e.g. 0 for a free plan or 19.00"
msgstr "Χαμηλότερη τιμή για τις μηχανές αναζήτησης, π.χ. 0 για δωρεάν πλάνο ή 19.00"

#. config.product.currency
#: schema.json
msgctxt "fh"
msgid "Three letter ISO currency code, e.g. USD or EUR"
msgstr "Τριγράμματος κωδικός νομίσματος ISO, π.χ. USD ή EUR"

#. config.product.rating
#: schema.json
msgctxt "fn"
msgid "Rating"
msgstr "Αξιολόγηση"

#. config.product.rating
#: schema.json
msgctxt "fh"
msgid "Average review rating from 1 to 5, e.g. 4.8"
msgstr "Μέση βαθμολογία κριτικών από 1 έως 5, π.χ. 4.8"

#. config.product.reviews
#: schema.json
msgctxt "fn"
msgid "Number of reviews"
msgstr "Αριθμός κριτικών"

#. config.product.reviews
#: schema.json
msgctxt "fh"
msgid "Number of reviews the rating is based on"
msgstr "Αριθμός κριτικών στις οποίες βασίζεται η βαθμολογία"

#. config.product.notice
#: schema.json
msgctxt "fh"
msgid "Short note shown in the footer, e.g. SOC 2 Type II certified, data hosted in the EU"
msgstr "Σύντομη σημείωση στο υποσέλιδο, π.χ. πιστοποίηση SOC 2 Type II, τα δεδομένα φιλοξενούνται στην ΕΕ"

#. config.theme
#: schema.json
msgctxt "st"
msgid "launch::theme"
msgstr "Θέμα"

#. config.theme-dark
#: schema.json
msgctxt "st"
msgid "launch::theme-dark"
msgstr "Σκούρο θέμα"
