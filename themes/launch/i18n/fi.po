#: schema.json
msgctxt "fh"
msgid "Page the announcement links to, e.g. the changelog entry"
msgstr "Sivu, johon tiedote linkittää, esim. muutoslokin merkintä"

#. config.product.status
#: schema.json
msgctxt "fn"
msgid "Status page link"
msgstr "Tilasivun linkki"

#. config.product.status
#: schema.json
msgctxt "fh"
msgid "Link to the public status page, shown in the footer"
msgstr "Linkki julkiseen tilasivuun, näytetään alatunnisteessa"

#. config.product.price
#: schema.json
msgctxt "fn"
msgid "Starting price"
msgstr "Lähtöhinta"

#. config.product.price
#: schema.json
msgctxt "fh"
msgid "Lowest price for search engines, e.g. 0 for a free plan or 19.00"
msgstr "Alin hinta hakukoneille, esim. 0 ilmaiselle suunnitelmalle tai 19.00"

#. config.product.currency
#: schema.json
msgctxt "fh"
msgid "Three letter ISO currency code, e.g. USD or EUR"
msgstr "Kolmikirjaiminen ISO-valuuttakoodi, esim. USD tai EUR"

#. config.product.rating
#: schema.json
msgctxt "fn"
