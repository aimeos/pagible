#. config.product
#: schema.json
msgctxt "st"
msgid "launch::product"
msgstr "Sản phẩm"

#. config.product.name
#: schema.json
msgctxt "fh"
msgid "Name of the software product or app"
msgstr "Tên sản phẩm phần mềm hoặc ứng dụng"

#. config.product.category
#: schema.json
msgctxt "fn"
msgid "Category"
msgstr "Danh mục"

#. config.product.category
#: schema.json
msgctxt "fh"
msgid "Kind of software shown to search engines"
msgstr "Loại phần mềm hiển thị cho công cụ tìm kiếm"

#. config.product.category
#: schema.json
msgctxt "op"
msgid "Business software"
msgstr "Phần mềm doanh nghiệp"

#. config.product.category
#: schema.json
msgctxt "op"
msgid "Developer tool"
msgstr "Công cụ cho nhà phát triển"

#. config.product.category
#: schema.json
msgctxt "op"
msgid "Design tool"
msgstr "Công cụ thiết kế"

#. config.product.category
#: schema.json
msgctxt "op"
msgid "Finance software"
msgstr "Phần mềm tài chính"

#. config.product.category
#: schema.json
msgctxt "op"
msgid "Security software"
msgstr "Phần mềm bảo mật"

#. config.product.category
#: schema.json
msgctxt "op"
msgid "Learning software"
msgstr "Phần mềm học tập"

#. config.product.category
#: schema.json
msgctxt "op"
msgid "Consumer app"
msgstr "Ứng dụng tiêu dùng"

#. config.product.description
#: schema.json
msgctxt "fh"
msgid "One sentence describing what the product does, used for search engines"
msgstr "Một câu mô tả sản phẩm làm gì, dùng cho công cụ tìm kiếm"

#. config.product.announcement
#: schema.json
msgctxt "fh"
msgid "Short news shown at the top of every page, e.g. New: status pages with custom domains"
msgstr "Tin ngắn hiển thị ở đầu mỗi trang, ví dụ: Mới: trang trạng thái với miền tùy chỉnh"

#. config.product.announcement-link
#: schema.json
msgctxt "fn"
msgid "Announcement link"
msgstr "Liên kết thông báo"

#. config.product.announcement-link
#: schema.json
msgctxt "fh"
msgid "Page the announcement links to, e.g. the changelog entry"
msgstr "Trang mà thông báo liên kết đến, ví dụ: mục trong nhật ký thay đổi"

#. config.product.status
#: schema.json
msgctxt "fn"
msgid "Status page link"
msgstr "Liên kết trang trạng thái"

#. config.product.status
#: schema.json
msgctxt "fh"
msgid "Link to the public status page, shown in the footer"
msgstr "Liên kết đến trang trạng thái công khai, hiển thị ở phần chân trang"

#. config.product.price
#: schema.json
msgctxt "fn"
msgid "Starting price"
msgstr "Giá khởi điểm"

#. config.product.price
#: schema.json
msgctxt "fh"
msgid "Lowest price for search engines, e.g. 0 for a free plan or 19.00"
msgstr "Giá thấp nhất cho công cụ tìm kiếm, ví dụ: 0 cho gói miễn phí hoặc 19.00"

#. config.product.currency
#: schema.json
msgctxt "fh"
msgid "Three letter ISO currency code, e.g. USD or EUR"
msgstr "Mã tiền tệ ISO gồm ba chữ, ví dụ: USD hoặc EUR"

#. config.product.rating
#: schema.json
msgctxt "fn"
msgid "Rating"
msgstr "Điểm đánh giá"

#. config.product.rating
#: schema.json
msgctxt "fh"
msgid "Average review rating from 1 to 5, e.g. 4.8"
msgstr "Điểm đánh giá trung bình từ 1 đến 5, ví dụ: 4.8"

#. config.product.reviews
#: schema.json
msgctxt "fn"
msgid "Number of reviews"
msgstr "Số lượng đánh giá"

#. config.product.reviews
#: schema.json
msgctxt "fh"
msgid "Number of reviews the rating is based on"
msgstr "Số lượng đánh giá làm cơ sở cho điểm số"

#. config.product.notice
#: schema.json
msgctxt "fh"
msgid "Short note shown in the footer, e.g. SOC 2 Type II certified, data hosted in the EU"
msgstr "Lưu ý ngắn hiển thị ở phần chân trang, ví dụ: đạt chứng nhận SOC 2 Type II, dữ liệu lưu trữ tại EU"

#. config.theme
#: schema.json
msgctxt "st"
msgid "launch::theme"
msgstr "Giao diện"

#. config.theme-dark
#: schema.json
msgctxt "st"
msgid "launch::theme-dark"
msgstr "Giao diện tối"
