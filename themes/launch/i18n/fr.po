msgid "launch::product"
msgstr "Produit"

#. config.product.name
#: schema.json
msgctxt "fh"
msgid "Name of the software product or app"
msgstr "Nom du logiciel ou de l'application"

#. config.product.category
#: schema.json
msgctxt "fn"
msgid "Category"
msgstr "Catégorie"

#. config.product.category
#: schema.json
msgctxt "fh"
msgid "Kind of software shown to search engines"
msgstr "Type de logiciel indiqué aux moteurs de recherche"

#. config.product.category
#: schema.json
msgctxt "op"
msgid "Business software"
msgstr "Logiciel professionnel"

#. config.product.category
#: schema.json
msgctxt "op"
msgid "Developer tool"
msgstr "Outil pour développeurs"

#. config.product.category
#: schema.json
msgctxt "op"
