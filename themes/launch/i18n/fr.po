#. config.product.category
#: schema.json
msgctxt "op"
msgid "Finance software"
msgstr "Logiciel financier"

#. config.product.category
#: schema.json
msgctxt "op"
msgid "Security software"
msgstr "Logiciel de sécurité"

#. config.product.category
#: schema.json
msgctxt "op"
msgid "Learning software"
msgstr "Logiciel éducatif"

#. config.product.category
#: schema.json
msgctxt "op"
msgid "Consumer app"
msgstr "Application grand public"

#. config.product.description
#: schema.json
msgctxt "fh"
msgid "One sentence describing what the product does, used for search engines"
msgstr "Une phrase décrivant ce que fait le produit, utilisée pour les moteurs de recherche"

#. config.product.announcement
#: schema.json
msgctxt "fn"
msgid "Announcement"
msgstr "Annonce"

#. config.product.announcement
#: schema.json
msgctxt "fh"
msgid "Short news shown at the top of every page, e.g. New: status pages with custom domains"
msgstr "Brève actualité affichée en haut de chaque page, par ex. Nouveau : pages de statut avec domaines personnalisés"

#. config.product.announcement-link
#: schema.json
msgctxt "fn"
msgid "Announcement link"
msgstr "Lien de l'annonce"

#. config.product.announcement-link
#: schema.json
msgctxt "fh"
msgid "Page the announcement links to, e.g. the changelog entry"
msgstr "Page vers laquelle l'annonce renvoie, par ex. l'entrée du journal des modifications"

#. config.product.status
#: schema.json
msgctxt "fn"
msgid "Status page link"
msgstr "Lien de la page de statut"

#. config.product.status
#: schema.json
msgctxt "fh"
msgid "Link to the public status page, shown in the footer"
msgstr "Lien vers la page de statut publique, affiché dans le pied de page"

#. config.product.price
#: schema.json
msgctxt "fn"
msgid "Starting price"
msgstr "Prix de départ"

#. config.product.price
#: schema.json
msgctxt "fh"
msgid "Lowest price for search engines, e.g. 0 for a free plan or 19.00"
msgstr "Prix le plus bas pour les moteurs de recherche, par ex. 0 pour un forfait gratuit ou 19.00"

#. config.product.currency
#: schema.json
msgctxt "fh"
msgid "Three letter ISO currency code, e.g. USD or EUR"
msgstr "Code devise ISO à trois lettres, par ex. USD ou EUR"

#. config.product.rating
#: schema.json
msgctxt "fn"
msgid "Rating"
msgstr "Note"

#. config.product.rating
#: schema.json
msgctxt "fh"
msgid "Average review rating from 1 to 5, e.g. 4.8"
msgstr "Note moyenne des avis de 1 à 5, par ex. 4.8"

#. config.product.reviews
#: schema.json
msgctxt "fn"
msgid "Number of reviews"
msgstr "Nombre d'avis"

#. config.product.reviews
#: schema.json
msgctxt "fh"
msgid "Number of reviews the rating is based on"
msgstr "Nombre d'avis sur lesquels la note est basée"

#. config.product.notice
#: schema.json
msgctxt "fn"
msgid "Notice"
msgstr "Mention"

#. config.product.notice
#: schema.json
msgctxt "fh"
msgid "Short note shown in the footer, e.g. SOC 2 Type II certified, data hosted in the EU"
msgstr "Courte remarque affichée dans le pied de page, par ex. certifié SOC 2 Type II, données hébergées dans l'UE"

#. config.theme
#: schema.json
msgctxt "st"
msgid "launch::theme"
msgstr "Thème"

#. config.theme.--pico-border-radius
#: schema.json
msgctxt "fh"
msgid "Rounding of corners as CSS length, e.g. 1rem or 0 for sharp corners"
msgstr "Arrondi des angles exprimé en unité de longueur CSS, par exemple 1rem ou 0 pour des angles vifs"
