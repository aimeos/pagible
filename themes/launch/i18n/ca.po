#. config.product.announcement
#: schema.json
msgctxt "fh"
msgid "Short news shown at the top of every page, e.g. New: status pages with custom domains"
msgstr "Notícies breus que es mostren a la part superior de cada pàgina, p. ex. Nou: pàgines d'estat amb dominis personalitzats"

#. config.product.announcement-link
#: schema.json
msgctxt "fn"
msgid "Announcement link"
msgstr "Enllaç de l'anunci"

