#: schema.json
msgctxt "fh"
msgid "Link to the public status page, shown in the footer"
msgstr "Enllaç a la pàgina pública d'estat, que es mostra al peu de pàgina."

#. config.product.price
#: schema.json
msgctxt "fn"
msgid "Starting price"
msgstr "Preu inicial"

