msgid "Page the announcement links to, e.g. the changelog entry"
msgstr "Pàgina a la qual enllaça l'anunci, p. ex. l'entrada del registre de canvis"

#. config.product.status
#: schema.json
msgctxt "fn"
msgid "Status page link"
msgstr "Enllaç de la pàgina d'estat"

