#: schema.json
msgctxt "fh"
msgid "Lowest price for search engines, e.g. 0 for a free plan or 19.00"
msgstr "Preu més baix per als motors de cerca, p. ex. 0 per a un pla gratuït o 19.00"

#. config.product.currency
#: schema.json
msgctxt "fh"
