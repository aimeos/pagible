msgstr "Puntuació mitjana de ressenyes de 1 a 5, p. ex. 4.8"

#. config.product.reviews
#: schema.json
msgctxt "fn"
msgid "Number of reviews"
msgstr "Nombre de ressenyes"

#. config.product.reviews
#: schema.json
msgctxt "fh"
msgid "Number of reviews the rating is based on"
msgstr "Nombre de ressenyes en què es basa la valoració"

