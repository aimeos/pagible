#. config.product.description
#: schema.json
msgctxt "fh"
msgid "One sentence describing what the product does, used for search engines"
msgstr "Одно предложение, описывающее, что делает продукт, для поисковых систем"

#. config.product.announcement
#: schema.json
msgctxt "fh"
msgid "Short news shown at the top of every page, e.g. New: status pages with custom domains"
msgstr "Короткая новость в верхней части каждой страницы, напр. Новое: страницы статуса с собственными доменами"

#. config.product.announcement-link
#: schema.json
msgctxt "fn"
msgid "Announcement link"
msgstr "Ссылка на объявление"

#. config.product.announcement-link
#: schema.json
msgctxt "fh"
msgid "Page the announcement links to, e.g. the changelog entry"
msgstr "Страница, на которую ведёт объявление, напр. запись в журнале изменений"

#. config.product.status
#: schema.json
msgctxt "fn"
msgid "Status page link"
msgstr "Ссылка на страницу статуса"

#. config.product.status
#: schema.json
msgctxt "fh"
msgid "Link to the public status page, shown in the footer"
msgstr "Ссылка на публичную страницу статуса, отображается в подвале сайта"

#. config.product.price
#: schema.json
msgctxt "fn"
msgid "Starting price"
msgstr "Начальная цена"

#. config.product.price
#: schema.json
msgctxt "fh"
msgid "Lowest price for search engines, e.g. 0 for a free plan or 19.00"
msgstr "Минимальная цена для поисковых систем, напр. 0 для бесплатного плана или 19.00"

#. config.product.currency
#: schema.json
msgctxt "fh"
msgid "Three letter ISO currency code, e.g. USD or EUR"
msgstr "Трёхбуквенный код валюты ISO, напр. USD или EUR"

#. config.product.rating
#: schema.json
msgctxt "fn"
msgid "Rating"
msgstr "Рейтинг"

#. config.product.rating
#: schema.json
msgctxt "fh"
msgid "Average review rating from 1 to 5, e.g. 4.8"
msgstr "Средний рейтинг отзывов от 1 до 5, напр. 4.8"

#. config.product.reviews
#: schema.json
msgctxt "fn"
msgid "Number of reviews"
msgstr "Количество отзывов"

#. config.product.reviews
#: schema.json
msgctxt "fh"
msgid "Number of reviews the rating is based on"
msgstr "Количество отзывов, на основе которых рассчитан рейтинг"

#. config.product.notice
#: schema.json
msgctxt "fh"
msgid "Short note shown in the footer, e.g. SOC 2 Type II certified, data hosted in the EU"
msgstr "Короткое примечание в подвале сайта, напр. сертифицировано по SOC 2 Type II, данные хранятся в ЕС"

#. config.theme
#: schema.json
msgctxt "st"
msgid "launch::theme"
msgstr "Тема оформления"

#. config.theme-dark
