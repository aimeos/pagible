#. config.product
#: schema.json
msgctxt "st"
msgid "launch::product"
msgstr "מוצר"

#. config.product.name
#: schema.json
msgctxt "fh"
msgid "Name of the software product or app"
msgstr "שם מוצר התוכנה או האפליקציה"

#. config.product.category
#: schema.json
msgctxt "fn"
msgid "Category"
msgstr "קטגוריה"

#. config.product.category
#: schema.json
msgctxt "fh"
msgid "Kind of software shown to search engines"
msgstr "סוג התוכנה המוצג למנועי חיפוש"

#. config.product.category
#: schema.json
msgctxt "op"
msgid "Business software"
msgstr "תוכנת עסקים"

#. config.product.category
#: schema.json
msgctxt "op"
msgid "Developer tool"
msgstr "כלי למפתחים"

#. config.product.category
#: schema.json
msgctxt "op"
msgid "Design tool"
msgstr "כלי עיצוב"

#. config.product.category
#: schema.json
msgctxt "op"
msgid "Finance software"
msgstr "תוכנת פיננסים"

#. config.product.category
#: schema.json
msgctxt "op"
msgid "Security software"
msgstr "תוכנת אבטחה"

#. config.product.category
#: schema.json
msgctxt "op"
msgid "Learning software"
msgstr "תוכנת למידה"

#. config.product.category
#: schema.json
msgctxt "op"
msgid "Consumer app"
msgstr "אפליקציית צרכנים"

#. config.product.description
#: schema.json
msgctxt "fh"
msgid "One sentence describing what the product does, used for search engines"
msgstr "משפט אחד המתאר מה המוצר עושה, לשימוש מנועי חיפוש"

#. config.product.announcement
#: schema.json
msgctxt "fh"
msgid "Short news shown at the top of every page, e.g. New: status pages with custom domains"
msgstr "חדשה קצרה המוצגת בראש כל עמוד, לדוגמה חדש: עמודי סטטוס עם דומיינים מותאמים"

#. config.product.announcement-link
#: schema.json
msgctxt "fn"
msgid "Announcement link"
msgstr "קישור להודעה"

#. config.product.announcement-link
#: schema.json
msgctxt "fh"
msgid "Page the announcement links to, e.g. the changelog entry"
msgstr "העמוד שאליו ההודעה מקשרת, לדוגמה רשומת יומן השינויים"

#. config.product.status
#: schema.json
msgctxt "fn"
msgid "Status page link"
msgstr "קישור לעמוד הסטטוס"

#. config.product.status
#: schema.json
msgctxt "fh"
msgid "Link to the public status page, shown in the footer"
msgstr "קישור לעמוד הסטטוס הציבורי, מוצג בכותרת התחתונה"

#. config.product.price
#: schema.json
msgctxt "fn"
msgid "Starting price"
msgstr "מחיר התחלתי"

#. config.product.price
#: schema.json
msgctxt "fh"
msgid "Lowest price for search engines, e.g. 0 for a free plan or 19.00"
msgstr "המחיר הנמוך ביותר למנועי חיפוש, לדוגמה 0 לתוכנית חינמית או 19.00"

#. config.product.currency
#: schema.json
msgctxt "fh"
msgid "Three letter ISO currency code, e.g. USD or EUR"
msgstr "קוד מטבע ISO בן שלוש אותיות, לדוגמה USD או EUR"

#. config.product.rating
#: schema.json
msgctxt "fn"
msgid "Rating"
msgstr "דירוג"

#. config.product.rating
#: schema.json
msgctxt "fh"
msgid "Average review rating from 1 to 5, e.g. 4.8"
msgstr "דירוג חוות דעת ממוצע מ-1 עד 5, לדוגמה 4.8"

#. config.product.reviews
#: schema.json
msgctxt "fn"
msgid "Number of reviews"
msgstr "מספר חוות דעת"

#. config.product.reviews
#: schema.json
msgctxt "fh"
msgid "Number of reviews the rating is based on"
msgstr "מספר חוות הדעת שעליהן מבוסס הדירוג"

#. config.product.notice
#: schema.json
msgctxt "fh"
msgid "Short note shown in the footer, e.g. SOC 2 Type II certified, data hosted in the EU"
msgstr "הערה קצרה המוצגת בכותרת התחתונה, לדוגמה בעל תעודת SOC 2 Type II, הנתונים מאוחסנים באיחוד האירופי"

#. config.theme
#: schema.json
msgctxt "st"
msgid "launch::theme"
msgstr "ערכת נושא"
