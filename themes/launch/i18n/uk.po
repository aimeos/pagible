#. config.product
#: schema.json
msgctxt "st"
msgid "launch::product"
msgstr "Продукт"

#. config.product.name
#: schema.json
msgctxt "fh"
msgid "Name of the software product or app"
msgstr "Назва програмного продукту або застосунку"

#. config.product.category
#: schema.json
msgctxt "fn"
msgid "Category"
msgstr "Категорія"

#. config.product.category
#: schema.json
msgctxt "fh"
msgid "Kind of software shown to search engines"
msgstr "Тип програмного забезпечення, що показується пошуковим системам"

#. config.product.category
#: schema.json
msgctxt "op"
msgid "Business software"
msgstr "Бізнес-софт"

#. config.product.category
#: schema.json
msgctxt "op"
msgid "Developer tool"
msgstr "Інструмент для розробників"

#. config.product.category
#: schema.json
msgctxt "op"
msgid "Design tool"
msgstr "Інструмент для дизайну"

#. config.product.category
#: schema.json
msgctxt "op"
msgid "Finance software"
msgstr "Фінансове ПЗ"

#. config.product.category
#: schema.json
msgctxt "op"
msgid "Security software"
msgstr "ПЗ безпеки"

#. config.product.category
#: schema.json
msgctxt "op"
msgid "Learning software"
msgstr "Навчальне ПЗ"

#. config.product.category
#: schema.json
msgctxt "op"
msgid "Consumer app"
msgstr "Застосунок для споживачів"

#. config.product.description
#: schema.json
msgctxt "fh"
msgid "One sentence describing what the product does, used for search engines"
msgstr "Одне речення, що описує, що робить продукт, для пошукових систем"

#. config.product.announcement
#: schema.json
msgctxt "fh"
msgid "Short news shown at the top of every page, e.g. New: status pages with custom domains"
msgstr "Коротка новина у верхній частині кожної сторінки, напр. Нове: сторінки статусу з власними доменами"

#. config.product.announcement-link
#: schema.json
msgctxt "fn"
msgid "Announcement link"
msgstr "Посилання на оголошення"

#. config.product.announcement-link
#: schema.json
msgctxt "fh"
msgid "Page the announcement links to, e.g. the changelog entry"
msgstr "Сторінка, на яку веде оголошення, напр. запис у журналі змін"

#. config.product.status
#: schema.json
msgctxt "fn"
msgid "Status page link"
msgstr "Посилання на сторінку статусу"

#. config.product.status
#: schema.json
msgctxt "fh"
msgid "Link to the public status page, shown in the footer"
msgstr "Посилання на публічну сторінку статусу, відображається у футері"

#. config.product.price
#: schema.json
msgctxt "fn"
msgid "Starting price"
msgstr "Початкова ціна"

#. config.product.price
#: schema.json
msgctxt "fh"
msgid "Lowest price for search engines, e.g. 0 for a free plan or 19.00"
msgstr "Найнижча ціна для пошукових систем, напр. 0 для безкоштовного плану або 19.00"

#. config.product.currency
#: schema.json
msgctxt "fh"
msgid "Three letter ISO currency code, e.g. USD or EUR"
msgstr "Трибуквений код валюти ISO, напр. USD або EUR"

#. config.product.rating
#: schema.json
msgctxt "fn"
msgid "Rating"
msgstr "Рейтинг"

#. config.product.rating
#: schema.json
msgctxt "fh"
msgid "Average review rating from 1 to 5, e.g. 4.8"
msgstr "Середній рейтинг відгуків від 1 до 5, напр. 4.8"

#. config.product.reviews
#: schema.json
msgctxt "fn"
msgid "Number of reviews"
msgstr "Кількість відгуків"

#. config.product.reviews
#: schema.json
msgctxt "fh"
msgid "Number of reviews the rating is based on"
msgstr "Кількість відгуків, на яких базується рейтинг"

#. config.product.notice
#: schema.json
msgctxt "fh"
msgid "Short note shown in the footer, e.g. SOC 2 Type II certified, data hosted in the EU"
msgstr "Коротка примітка у футері, напр. сертифіковано за SOC 2 Type II, дані зберігаються в ЄС"

#. config.theme
#: schema.json
msgctxt "st"
msgid "launch::theme"
msgstr "Тема оформлення"
