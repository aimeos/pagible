#. config.product.description
#: schema.json
msgctxt "fh"
msgid "One sentence describing what the product does, used for search engines"
msgstr "Egy mondat, amely leírja, mit csinál a termék, a keresőmotorok számára"

#. config.product.announcement
#: schema.json
msgctxt "fh"
msgid "Short news shown at the top of every page, e.g. New: status pages with custom domains"
msgstr "Rövid hír minden oldal tetején, pl. Új: állapotoldalak egyéni domainekkel"

#. config.product.announcement-link
#: schema.json
msgctxt "fn"
msgid "Announcement link"
msgstr "Bejelentés linkje"

#. config.product.announcement-link
#: schema.json
msgctxt "fh"
msgid "Page the announcement links to, e.g. the changelog entry"
msgstr "Az oldal, amelyre a bejelentés hivatkozik, pl. a changelog bejegyzés"

#. config.product.status
#: schema.json
msgctxt "fn"
msgid "Status page link"
msgstr "Állapotoldal linkje"

#. config.product.status
#: schema.json
msgctxt "fh"
msgid "Link to the public status page, shown in the footer"
msgstr "Link a nyilvános állapotoldalra, a lábjegyzetben jelenik meg"

#. config.product.price
#: schema.json
msgctxt "fn"
msgid "Starting price"
msgstr "Kezdő ár"

#. config.product.price
#: schema.json
msgctxt "fh"
msgid "Lowest price for search engines, e.g. 0 for a free plan or 19.00"
msgstr "A legalacsonyabb ár a keresőmotoroknak, pl. 0 az ingyenes csomaghoz vagy 19.00"

#. config.product.currency
#: schema.json
msgctxt "fh"
msgid "Three letter ISO currency code, e.g. USD or EUR"
msgstr "Háromjegyű ISO pénznemkód, pl. USD vagy EUR"

#. config.product.rating
#: schema.json
msgctxt "fn"
msgid "Rating"
msgstr "Értékelés"

#. config.product.rating
#: schema.json
msgctxt "fh"
msgid "Average review rating from 1 to 5, e.g. 4.8"
msgstr "Átlagos értékelés 1-től 5-ig, pl. 4.8"

#. config.product.reviews
#: schema.json
msgctxt "fn"
msgid "Number of reviews"
msgstr "Értékelések száma"

#. config.product.reviews
#: schema.json
msgctxt "fh"
msgid "Number of reviews the rating is based on"
msgstr "Az értékelések száma, amelyen az értékelés alapul"

#. config.product.notice
#: schema.json
msgctxt "fh"
msgid "Short note shown in the footer, e.g. SOC 2 Type II certified, data hosted in the EU"
msgstr "Rövid megjegyzés a lábjegyzetben, pl. SOC 2 Type II tanúsítvánnyal, az adatok az EU-ban tárolva"

#. config.theme
