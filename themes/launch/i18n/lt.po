#. config.product.announcement
#: schema.json
msgctxt "fh"
msgid "Short news shown at the top of every page, e.g. New: status pages with custom domains"
msgstr "Trumpa naujiena, rodoma kiekvieno puslapio viršuje, pvz. Naujiena: būsenos puslapiai su individualiais domenais"

