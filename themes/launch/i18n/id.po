#. config.product
#: schema.json
msgctxt "st"
msgid "launch::product"
msgstr "Produk"

#. config.product.name
#: schema.json
msgctxt "fh"
msgid "Name of the software product or app"
msgstr "Nama produk perangkat lunak atau aplikasi"

#. config.product.category
#: schema.json
msgctxt "fn"
msgid "Category"
msgstr "Kategori"

#. config.product.category
#: schema.json
msgctxt "fh"
msgid "Kind of software shown to search engines"
msgstr "Jenis perangkat lunak yang ditampilkan ke mesin pencari"

#. config.product.category
#: schema.json
msgctxt "op"
msgid "Business software"
msgstr "Perangkat lunak bisnis"

#. config.product.category
#: schema.json
msgctxt "op"
msgid "Developer tool"
msgstr "Alat pengembang"

#. config.product.category
#: schema.json
msgctxt "op"
msgid "Design tool"
msgstr "Alat desain"

#. config.product.category
#: schema.json
msgctxt "op"
msgid "Finance software"
msgstr "Perangkat lunak keuangan"

#. config.product.category
#: schema.json
msgctxt "op"
msgid "Security software"
msgstr "Perangkat lunak keamanan"

#. config.product.category
#: schema.json
msgctxt "op"
msgid "Learning software"
msgstr "Perangkat lunak pembelajaran"

#. config.product.category
#: schema.json
msgctxt "op"
msgid "Consumer app"
msgstr "Aplikasi konsumen"

#. config.product.description
#: schema.json
msgctxt "fh"
msgid "One sentence describing what the product does, used for search engines"
msgstr "Satu kalimat yang menjelaskan fungsi produk, digunakan untuk mesin pencari"

#. config.product.announcement
#: schema.json
msgctxt "fn"
msgid "Announcement"
msgstr "Pengumuman"

#. config.product.announcement
#: schema.json
msgctxt "fh"
msgid "Short news shown at the top of every page, e.g. New: status pages with custom domains"
msgstr "Berita singkat yang ditampilkan di bagian atas setiap halaman, mis. Baru: halaman status dengan domain khusus"

#. config.product.announcement-link
#: schema.json
msgctxt "fn"
msgid "Announcement link"
msgstr "Tautan pengumuman"

#. config.product.announcement-link
#: schema.json
msgctxt "fh"
msgid "Page the announcement links to, e.g. the changelog entry"
msgstr "Halaman yang dituju oleh tautan pengumuman, mis. entri changelog"

#. config.product.status
#: schema.json
msgctxt "fn"
msgid "Status page link"
msgstr "Tautan halaman status"

#. config.product.status
#: schema.json
msgctxt "fh"
msgid "Link to the public status page, shown in the footer"
msgstr "Tautan ke halaman status publik, ditampilkan di footer"

#. config.product.price
#: schema.json
msgctxt "fn"
msgid "Starting price"
msgstr "Harga mulai"

#. config.product.price
#: schema.json
msgctxt "fh"
msgid "Lowest price for search engines, e.g. 0 for a free plan or 19.00"
msgstr "Harga terendah untuk mesin pencari, mis. 0 untuk paket gratis atau 19.00"

#. config.product.currency
#: schema.json
msgctxt "fh"
msgid "Three letter ISO currency code, e.g. USD or EUR"
msgstr "Kode mata uang ISO tiga huruf, mis. USD atau EUR"

#. config.product.rating
#: schema.json
msgctxt "fn"
msgid "Rating"
msgstr "Penilaian"

#. config.product.rating
#: schema.json
msgctxt "fh"
msgid "Average review rating from 1 to 5, e.g. 4.8"
msgstr "Rata-rata penilaian ulasan dari 1 hingga 5, mis. 4.8"

#. config.product.reviews
#: schema.json
msgctxt "fn"
msgid "Number of reviews"
msgstr "Jumlah ulasan"

#. config.product.reviews
#: schema.json
msgctxt "fh"
msgid "Number of reviews the rating is based on"
msgstr "Jumlah ulasan yang menjadi dasar penilaian"

#. config.product.notice
#: schema.json
msgctxt "fn"
msgid "Notice"
msgstr "Catatan"

#. config.product.notice
#: schema.json
msgctxt "fh"
msgid "Short note shown in the footer, e.g. SOC 2 Type II certified, data hosted in the EU"
msgstr "Catatan singkat yang ditampilkan di footer, mis. tersertifikasi SOC 2 Type II, data dihosting di UE"

#. config.theme
#: schema.json
msgctxt "st"
msgid "launch::theme"
msgstr "Tema"

#. config.theme.--pico-border-radius
#: schema.json
msgctxt "fh"
msgid "Rounding of corners as CSS length, e.g. 1rem or 0 for sharp corners"
msgstr "Pembulatan sudut sebagai nilai panjang CSS, misalnya 1rem atau 0 untuk sudut tajam"
