#. config.product.description
#: schema.json
msgctxt "fh"
msgid "One sentence describing what the product does, used for search engines"
msgstr "Едно изречение, описващо какво прави продуктът, за търсачките"

#. config.product.announcement
#: schema.json
msgctxt "fh"
msgid "Short news shown at the top of every page, e.g. New: status pages with custom domains"
msgstr "Кратка новина в горната част на всяка страница, напр. Ново: страници за статус с персонализирани домейни"

#. config.product.announcement-link
#: schema.json
msgctxt "fn"
msgid "Announcement link"
msgstr "Връзка към съобщението"

#. config.product.announcement-link
#: schema.json
msgctxt "fh"
msgid "Page the announcement links to, e.g. the changelog entry"
msgstr "Страница, към която води съобщението, напр. записът в дневника на промените"

#. config.product.status
#: schema.json
msgctxt "fn"
msgid "Status page link"
msgstr "Връзка към страницата за статус"

#. config.product.status
#: schema.json
msgctxt "fh"
msgid "Link to the public status page, shown in the footer"
msgstr "Връзка към публичната страница за статус, показва се във футъра"

#. config.product.price
#: schema.json
msgctxt "fn"
msgid "Starting price"
msgstr "Начална цена"

#. config.product.price
#: schema.json
msgctxt "fh"
msgid "Lowest price for search engines, e.g. 0 for a free plan or 19.00"
msgstr "Най-ниска цена за търсачките, напр. 0 за безплатен план или 19.00"

#. config.product.currency
#: schema.json
msgctxt "fh"
msgid "Three letter ISO currency code, e.g. USD or EUR"
msgstr "Трибуквен ISO код на валутата, напр. USD или EUR"

#. config.product.rating
#: schema.json
msgctxt "fn"
msgid "Rating"
msgstr "Оценка"

#. config.product.rating
#: schema.json
msgctxt "fh"
msgid "Average review rating from 1 to 5, e.g. 4.8"
msgstr "Средна оценка от отзивите от 1 до 5, напр. 4.8"

#. config.product.reviews
#: schema.json
msgctxt "fn"
msgid "Number of reviews"
msgstr "Брой отзиви"

#. config.product.reviews
#: schema.json
msgctxt "fh"
msgid "Number of reviews the rating is based on"
msgstr "Брой отзиви, на които се базира оценката"

#. config.product.notice
#: schema.json
msgctxt "fh"
msgid "Short note shown in the footer, e.g. SOC 2 Type II certified, data hosted in the EU"
msgstr "Кратка бележка във футъра, напр. сертифицирано по SOC 2 Type II, данните се съхраняват в ЕС"

#. config.theme
#: schema.json
msgctxt "st"
