#. config.bar
#: schema.json
msgctxt "st"
msgid "tonic::bar"
msgstr "Bar"

#. config.bar.name
#: schema.json
msgctxt "fh"
msgid "Name of the bar, pub or club"
msgstr "Barın, pabın və ya klubun adı"

#. config.bar.business-type
#: schema.json
msgctxt "op"
msgid "Bar or pub"
msgstr "Bar və ya pab"

#. config.bar.business-type
#: schema.json
msgctxt "op"
msgid "Night club"
msgstr "Gecə klubu"

#. config.bar.business-type
#: schema.json
msgctxt "op"
msgid "Brewery or taproom"
msgstr "Pivə zavodu və ya pivə evi"

#. config.bar.business-type
#: schema.json
msgctxt "op"
msgid "Restaurant"
msgstr "Restoran"

#. config.bar.email
#: schema.json
msgctxt "fh"
msgid "Email address for reservations, private events and press"
msgstr "Ehtiyat rezervasiyaları, özəl tədbirlər və mətbuat üçün e-poçt ünvanı"

#. config.bar.announcement
#: schema.json
msgctxt "fh"
msgid "Short note shown at the top of every page, e.g. Walk-ins welcome until 23:00"
msgstr "Hər səhifənin yuxarısında göstərilən qısa qeyd, məsələn: 23:00-dək əvvəlcədən rezervasiya etmədən gələnlər xoş qarşılanır"

#. config.bar.booking
#: schema.json
msgctxt "fh"
msgid "Link to the table reservation page, shown as a button in the header"
msgstr "Başlıqda düymə şəklində göstərilən masa rezervasiyası səhifəsinə keçid"

#. config.bar.menu
#: schema.json
msgctxt "fn"
msgid "Menu link"
msgstr "Menyu linki"

#. config.bar.menu
#: schema.json
msgctxt "fh"
msgid "Link to the page with the drinks menu"
msgstr "İçkilər menyusunun olduğu səhifənin linki"

#. config.bar.cuisine
#: schema.json
msgctxt "fn"
msgid "Cuisine"
msgstr "Mətbəx"

#. config.bar.cuisine
#: schema.json
msgctxt "fh"
msgid "Comma separated list of what you serve, e.g. Cocktails, Wine, Bar snacks"
msgstr "Nə təqdim etdiyinizin virgulla ayrılmış siyahısı, məsələn: kokteyllər, şərab, bar qəlyanaltıları"

#. config.bar.notice
#: schema.json
msgctxt "fh"
msgid "Short note shown in the footer, e.g. Over 18 only. Please drink responsibly."
msgstr "Ayaqnotda göstərilən qısa qeyd, məsələn: Yalnız 18 yaşdan yuxarılar üçündür. Zəhmət olmasa məsuliyyətlə içın."

#. config.bar.hours.closes
#: schema.json
msgctxt "fh"
msgid "Closing time in 24 hour format, also after midnight, e.g. 02:00"
msgstr "24 saatlıq formatda bağlanma vaxtı, həmçinin gecə yarısından sonra, məsələn, 02:00"

#. config.theme
#: schema.json
msgctxt "st"
msgid "tonic::theme"
msgstr "Mövzu"
