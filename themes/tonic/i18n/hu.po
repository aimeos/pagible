#: schema.json
msgctxt "fh"
msgid "Link to the page with the drinks menu"
msgstr "Link az itallapot tartalmazó oldalra"

#. config.bar.cuisine
#: schema.json
msgctxt "fn"
msgid "Cuisine"
msgstr "Kínálat"

#. config.bar.cuisine
#: schema.json
msgctxt "fh"
