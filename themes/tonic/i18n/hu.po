#: schema.json
msgctxt "fn"
msgid "Announcement"
msgstr "Bejelentés"

#. config.bar.announcement
#: schema.json
msgctxt "fh"
msgid "Short note shown at the top of every page, e.g. Walk-ins welcome until 23:00"
msgstr "Rövid üzenet minden oldal tetején, pl. Foglalás nélkül is várunk 23:00-ig"

#. config.bar.booking
#: schema.json
msgctxt "fn"
msgid "Booking link"
msgstr "Foglalási link"

#. config.bar.booking
#: schema.json
msgctxt "fh"
msgid "Link to the table reservation page, shown as a button in the header"
msgstr "Link az asztalfoglalási oldalra, gombként jelenik meg a fejlécben"

#. config.bar.menu
#: schema.json
msgctxt "fn"
msgid "Menu link"
msgstr "Étlap hivatkozás"

