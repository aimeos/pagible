#: schema.json
msgctxt "fn"
msgid "Price range"
msgstr "Árkategória"

#. config.bar.price-range
#: schema.json
msgctxt "fh"
msgid "Price level of the bar, e.g. $$ or €€"
msgstr "A bár árszintje, pl. $$ vagy €€"

