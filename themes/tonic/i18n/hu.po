msgid "Two letter ISO country code, e.g. DE or US"
msgstr "Kétbetűs ISO országkód, pl. DE vagy US"

#. config.bar.telephone
#: schema.json
msgctxt "fn"
msgid "telephone"
msgstr "Telefon"

