#: schema.json
msgctxt "fh"
msgid "Phone number in international format, also used by the call button"
msgstr "Telefonszám nemzetközi formátumban, a hívás gomb is ezt használja"

#. config.bar.email
#: schema.json
msgctxt "fn"
msgid "email"
msgstr "E-mail"

#. config.bar.email
#: schema.json
msgctxt "fh"
msgid "Email address for reservations, private events and press"
msgstr "E-mail-cím asztalfoglaláshoz, zártkörű rendezvényekhez és sajtómegkeresésekhez"

