#. config.bar.email
#: schema.json
msgctxt "fh"
msgid "Email address for reservations, private events and press"
msgstr "Rezervasyonlar, özel etkinlikler ve basın için e-posta adresi"

#. config.bar.announcement
#: schema.json
msgctxt "fh"
msgid "Short note shown at the top of every page, e.g. Walk-ins welcome until 23:00"
msgstr "Her sayfanın üstünde gösterilen kısa not, örn. 23:00'e kadar rezervasyonsuz gelebilirsiniz"

#. config.bar.booking
#: schema.json
msgctxt "fh"
msgid "Link to the table reservation page, shown as a button in the header"
msgstr "Masa rezervasyonu sayfasının bağlantısı, başlıkta düğme olarak gösterilir"

#. config.bar.menu
#: schema.json
msgctxt "fn"
msgid "Menu link"
msgstr "Menü bağlantısı"

#. config.bar.menu
#: schema.json
msgctxt "fh"
msgid "Link to the page with the drinks menu"
msgstr "İçecek menüsünün bulunduğu sayfanın bağlantısı"

#. config.bar.cuisine
#: schema.json
msgctxt "fn"
msgid "Cuisine"
msgstr "Mutfak"

#. config.bar.cuisine
#: schema.json
msgctxt "fh"
msgid "Comma separated list of what you serve, e.g. Cocktails, Wine, Bar snacks"
msgstr "Sunduklarınızın virgülle ayrılmış listesi, örn. Kokteyller, Şarap, Atıştırmalıklar"

#. config.bar.notice
#: schema.json
msgctxt "fh"
msgid "Short note shown in the footer, e.g. Over 18 only. Please drink responsibly."
msgstr "Altbilgide gösterilen kısa not, örn. Yalnızca 18 yaş üstü. Lütfen sorumlu bir şekilde tüketin."

#. config.bar.hours.closes
#: schema.json
msgctxt "fh"
msgid "Closing time in 24 hour format, also after midnight, e.g. 02:00"
msgstr "24 saat formatında kapanış saati, gece yarısından sonra da olabilir, örn. 02:00"

