msgid "Two letter ISO country code, e.g. DE or US"
msgstr "รหัสประเทศ ISO สองตัวอักษร เช่น DE หรือ US"

#. config.bar.telephone
#: schema.json
msgctxt "fn"
msgid "telephone"
msgstr "โทรศัพท์"

