#. config.bar
#: schema.json
msgctxt "st"
msgid "tonic::bar"
msgstr "บาร์"

#. config.bar.name
#: schema.json
msgctxt "fh"
msgid "Name of the bar, pub or club"
msgstr "ชื่อบาร์ ผับ หรือคลับ"

#. config.bar.business-type
#: schema.json
msgctxt "op"
msgid "Bar or pub"
msgstr "บาร์หรือผับ"

#. config.bar.business-type
#: schema.json
msgctxt "op"
msgid "Night club"
msgstr "ไนต์คลับ"

#. config.bar.business-type
#: schema.json
msgctxt "op"
msgid "Brewery or taproom"
msgstr "โรงเบียร์หรือแท็ปรูม"

#. config.bar.business-type
#: schema.json
msgctxt "op"
msgid "Restaurant"
msgstr "ร้านอาหาร"

#. config.bar.email
#: schema.json
msgctxt "fh"
msgid "Email address for reservations, private events and press"
msgstr "อีเมลสำหรับการจองโต๊ะ งานส่วนตัว และสื่อมวลชน"

#. config.bar.announcement
#: schema.json
msgctxt "fh"
msgid "Short note shown at the top of every page, e.g. Walk-ins welcome until 23:00"
msgstr "ข้อความสั้น ๆ ที่แสดงด้านบนของทุกหน้า เช่น เข้าร้านได้โดยไม่ต้องจองจนถึง 23:00"

#. config.bar.booking
#: schema.json
msgctxt "fh"
msgid "Link to the table reservation page, shown as a button in the header"
msgstr "ลิงก์ไปยังหน้าจองโต๊ะ แสดงเป็นปุ่มในส่วนหัว"

#. config.bar.menu
#: schema.json
msgctxt "fn"
msgid "Menu link"
msgstr "ลิงก์เมนู"

#. config.bar.menu
#: schema.json
msgctxt "fh"
msgid "Link to the page with the drinks menu"
msgstr "ลิงก์ไปยังหน้าเมนูเครื่องดื่ม"

#. config.bar.cuisine
#: schema.json
msgctxt "fn"
msgid "Cuisine"
msgstr "ประเภทอาหาร"

#. config.bar.cuisine
#: schema.json
msgctxt "fh"
msgid "Comma separated list of what you serve, e.g. Cocktails, Wine, Bar snacks"
msgstr "รายการสิ่งที่คุณเสิร์ฟ คั่นด้วยจุลภาค เช่น ค็อกเทล, ไวน์, ของทานเล่น"

#. config.bar.notice
#: schema.json
msgctxt "fh"
msgid "Short note shown in the footer, e.g. Over 18 only. Please drink responsibly."
msgstr "ข้อความสั้น ๆ ที่แสดงในส่วนท้าย เช่น เฉพาะผู้มีอายุ 18 ปีขึ้นไป โปรดดื่มอย่างรับผิดชอบ"

#. config.bar.hours.closes
#: schema.json
msgctxt "fh"
msgid "Closing time in 24 hour format, also after midnight, e.g. 02:00"
msgstr "เวลาปิดในรูปแบบ 24 ชั่วโมง รวมถึงหลังเที่ยงคืน เช่น 02:00"

#. config.theme
#: schema.json
msgctxt "st"
msgid "tonic::theme"
msgstr "ธีม"
