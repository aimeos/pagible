#: schema.json
msgctxt "fn"
msgid "Cuisine"
msgstr "ประเภทอาหาร"

#. config.bar.cuisine
#: schema.json
msgctxt "fh"
msgid "Comma separated list of what you serve, e.g. Cocktails, Wine, Bar snacks"
msgstr "รายการสิ่งที่คุณเสิร์ฟ คั่นด้วยจุลภาค เช่น ค็อกเทล, ไวน์, ของทานเล่น"

#. config.bar.price-range
#: schema.json
msgctxt "fn"
msgid "Price range"
msgstr "ช่วงราคา"

