#: schema.json
msgctxt "fh"
msgid "Price level of the bar, e.g. $$ or €€"
msgstr "ระดับราคาของบาร์ เช่น $$ หรือ €€"

#. config.bar.notice
#: schema.json
msgctxt "fn"
msgid "Notice"
msgstr "หมายเหตุ"

