#. config.bar
#: schema.json
msgctxt "st"
msgid "tonic::bar"
msgstr "Bar"

#. config.bar.name
#: schema.json
msgctxt "fh"
msgid "Name of the bar, pub or club"
msgstr "Název baru, hospody nebo klubu"

#. config.bar.business-type
#: schema.json
msgctxt "op"
msgid "Bar or pub"
msgstr "Bar nebo hospoda"

#. config.bar.business-type
#: schema.json
msgctxt "op"
msgid "Night club"
msgstr "Noční klub"

#. config.bar.business-type
#: schema.json
msgctxt "op"
msgid "Brewery or taproom"
msgstr "Pivovar nebo výčep"

#. config.bar.business-type
#: schema.json
msgctxt "op"
msgid "Restaurant"
msgstr "Restaurace"

#. config.bar.email
#: schema.json
msgctxt "fh"
msgid "Email address for reservations, private events and press"
msgstr "E-mailová adresa pro rezervace, soukromé akce a tisk"

#. config.bar.announcement
#: schema.json
msgctxt "fh"
msgid "Short note shown at the top of every page, e.g. Walk-ins welcome until 23:00"
msgstr "Krátká poznámka zobrazená v horní části každé stránky, např. Bez rezervace vítáni do 23:00"

#. config.bar.booking
#: schema.json
msgctxt "fh"
msgid "Link to the table reservation page, shown as a button in the header"
msgstr "Odkaz na stránku s rezervací stolu, zobrazený jako tlačítko v záhlaví"

#. config.bar.menu
#: schema.json
msgctxt "fn"
msgid "Menu link"
msgstr "Odkaz na menu"

#. config.bar.menu
#: schema.json
msgctxt "fh"
msgid "Link to the page with the drinks menu"
msgstr "Odkaz na stránku s nápojovým lístkem"

#. config.bar.cuisine
#: schema.json
msgctxt "fn"
msgid "Cuisine"
msgstr "Nabídka"

#. config.bar.cuisine
#: schema.json
msgctxt "fh"
msgid "Comma separated list of what you serve, e.g. Cocktails, Wine, Bar snacks"
msgstr "Seznam toho, co podáváte, oddělený čárkami, např. Koktejly, Víno, Občerstvení"

#. config.bar.notice
#: schema.json
msgctxt "fh"
msgid "Short note shown in the footer, e.g. Over 18 only. Please drink responsibly."
msgstr "Krátká poznámka zobrazená v zápatí, např. Pouze od 18 let. Pijte zodpovědně."

#. config.bar.hours.closes
#: schema.json
msgctxt "fh"
msgid "Closing time in 24 hour format, also after midnight, e.g. 02:00"
msgstr "Čas zavření ve 24hodinovém formátu, i po půlnoci, např. 02:00"

#. config.theme
#: schema.json
msgctxt "st"
msgid "tonic::theme"
