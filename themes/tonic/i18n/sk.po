msgstr "Bar"

#. config.bar.name
#: schema.json
msgctxt "fh"
msgid "Name of the bar, pub or club"
msgstr "Názov baru, krčmy alebo klubu"

#. config.bar.business-type
#: schema.json
msgctxt "op"
msgid "Bar or pub"
msgstr "Bar alebo krčma"

#. config.bar.business-type
#: schema.json
msgctxt "op"
msgid "Night club"
msgstr "Nočný klub"

#. config.bar.business-type
#: schema.json
msgctxt "op"
msgid "Brewery or taproom"
msgstr "Pivovar alebo výčap"

#. config.bar.business-type
#: schema.json
msgctxt "op"
msgid "Restaurant"
msgstr "Reštaurácia"

#. config.bar.email
#: schema.json
msgctxt "fh"
msgid "Email address for reservations, private events and press"
msgstr "E-mailová adresa pre rezervácie, súkromné podujatia a tlač"

#. config.bar.announcement
#: schema.json
msgctxt "fh"
msgid "Short note shown at the top of every page, e.g. Walk-ins welcome until 23:00"
msgstr "Krátka poznámka zobrazená v hornej časti každej stránky, napr. Bez rezervácie vítaní do 23:00"

#. config.bar.booking
#: schema.json
msgctxt "fh"
msgid "Link to the table reservation page, shown as a button in the header"
msgstr "Odkaz na stránku s rezerváciou stola, zobrazený ako tlačidlo v hlavičke"

#. config.bar.menu
#: schema.json
msgctxt "fn"
msgid "Menu link"
msgstr "Odkaz na menu"

#. config.bar.menu
#: schema.json
msgctxt "fh"
msgid "Link to the page with the drinks menu"
msgstr "Odkaz na stránku s nápojovým lístkom"

#. config.bar.cuisine
#: schema.json
msgctxt "fn"
msgid "Cuisine"
msgstr "Kuchyňa"

#. config.bar.cuisine
#: schema.json
msgctxt "fh"
msgid "Comma separated list of what you serve, e.g. Cocktails, Wine, Bar snacks"
msgstr "Zoznam toho, čo podávate, oddelený čiarkami, napr. Kokteily, Víno, Občerstvenie"

#. config.bar.notice
#: schema.json
msgctxt "fh"
msgid "Short note shown in the footer, e.g. Over 18 only. Please drink responsibly."
msgstr "Krátka poznámka zobrazená v pätičke, napr. Iba od 18 rokov. Pite zodpovedne."

#. config.bar.hours.closes
#: schema.json
msgctxt "fh"
msgid "Closing time in 24 hour format, also after midnight, e.g. 02:00"
msgstr "Čas zatvorenia v 24-hodinovom formáte, aj po polnoci, napr. 02:00"

