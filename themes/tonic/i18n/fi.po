msgid "Email address for reservations, private events and press"
msgstr "Sähköpostiosoite pöytävarauksia, yksityistilaisuuksia ja lehdistöä varten"

#. config.bar.announcement
#: schema.json
msgctxt "fh"
msgid "Short note shown at the top of every page, e.g. Walk-ins welcome until 23:00"
msgstr "Lyhyt ilmoitus jokaisen sivun yläosassa, esim. Ilman varausta klo 23:00 asti"

#. config.bar.booking
#: schema.json
msgctxt "fh"
msgid "Link to the table reservation page, shown as a button in the header"
msgstr "Linkki pöytävaraussivulle, näytetään painikkeena ylätunnisteessa"

#. config.bar.menu
#: schema.json
msgctxt "fn"
msgid "Menu link"
msgstr "Menulinkki"

#. config.bar.menu
#: schema.json
msgctxt "fh"
msgid "Link to the page with the drinks menu"
msgstr "Linkki juomalistan sivulle"

#. config.bar.cuisine
#: schema.json
msgctxt "fn"
msgid "Cuisine"
msgstr "Tarjonta"

#. config.bar.cuisine
#: schema.json
msgctxt "fh"
msgid "Comma separated list of what you serve, e.g. Cocktails, Wine, Bar snacks"
msgstr "Pilkuilla eroteltu luettelo tarjonnastasi, esim. Cocktailit, Viini, Naposteltavat"

#. config.bar.notice
#: schema.json
msgctxt "fh"
msgid "Short note shown in the footer, e.g. Over 18 only. Please drink responsibly."
msgstr "Lyhyt ilmoitus alatunnisteessa, esim. Vain täysi-ikäisille. Nauti vastuullisesti."

#. config.bar.hours.closes
#: schema.json
msgctxt "fh"
msgid "Closing time in 24 hour format, also after midnight, e.g. 02:00"
msgstr "Sulkemisaika 24 tunnin muodossa, myös puolenyön jälkeen, esim. 02:00"

