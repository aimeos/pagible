msgid "tonic::bar"
msgstr "Baras"

#. config.bar.name
#: schema.json
msgctxt "fh"
msgid "Name of the bar, pub or club"
msgstr "Baro, aludės ar klubo pavadinimas"

#. config.bar.business-type
#: schema.json
msgctxt "op"
msgid "Bar or pub"
msgstr "Baras ar aludė"

#. config.bar.business-type
#: schema.json
msgctxt "op"
msgid "Night club"
msgstr "Naktinis klubas"

#. config.bar.business-type
#: schema.json
msgctxt "op"
msgid "Brewery or taproom"
msgstr "Alaus darykla ar alaus baras"

#. config.bar.business-type
#: schema.json
msgctxt "op"
msgid "Restaurant"
msgstr "Restoranas"

#. config.bar.email
#: schema.json
msgctxt "fh"
msgid "Email address for reservations, private events and press"
msgstr "El. pašto adresas rezervacijoms, privatiems renginiams ir žiniasklaidai"

#. config.bar.announcement
#: schema.json
msgctxt "fh"
msgid "Short note shown at the top of every page, e.g. Walk-ins welcome until 23:00"
msgstr "Trumpa žinutė kiekvieno puslapio viršuje, pvz., Be rezervacijos laukiame iki 23:00"

#. config.bar.booking
#: schema.json
msgctxt "fh"
msgid "Link to the table reservation page, shown as a button in the header"
msgstr "Nuoroda į staliuko rezervavimo puslapį, rodoma kaip mygtukas antraštėje"

#. config.bar.menu
#: schema.json
msgctxt "fn"
msgid "Menu link"
msgstr "Meniu nuoroda"

#. config.bar.menu
#: schema.json
msgctxt "fh"
msgid "Link to the page with the drinks menu"
msgstr "Nuoroda į puslapį su gėrimų meniu"

#. config.bar.cuisine
#: schema.json
msgctxt "fn"
msgid "Cuisine"
msgstr "Virtuvė"

#. config.bar.cuisine
#: schema.json
msgctxt "fh"
msgid "Comma separated list of what you serve, e.g. Cocktails, Wine, Bar snacks"
msgstr "Kableliais atskirtas siūlomų dalykų sąrašas, pvz., Kokteiliai, Vynas, Užkandžiai"

#. config.bar.notice
#: schema.json
msgctxt "fh"
msgid "Short note shown in the footer, e.g. Over 18 only. Please drink responsibly."
msgstr "Trumpa žinutė poraštėje, pvz., Tik vyresniems nei 18 metų. Vartokite atsakingai."

#. config.bar.hours.closes
#: schema.json
msgctxt "fh"
msgid "Closing time in 24 hour format, also after midnight, e.g. 02:00"
msgstr "Uždarymo laikas 24 valandų formatu, taip pat po vidurnakčio, pvz., 02:00"

#. config.theme
