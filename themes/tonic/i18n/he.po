#. config.bar
#: schema.json
msgctxt "st"
msgid "tonic::bar"
msgstr "בר"

#. config.bar.name
#: schema.json
msgctxt "fh"
msgid "Name of the bar, pub or club"
msgstr "שם הבר, הפאב או המועדון"

#. config.bar.business-type
#: schema.json
msgctxt "op"
msgid "Bar or pub"
msgstr "בר או פאב"

#. config.bar.business-type
#: schema.json
msgctxt "op"
msgid "Night club"
msgstr "מועדון לילה"

#. config.bar.business-type
#: schema.json
msgctxt "op"
msgid "Brewery or taproom"
msgstr "מבשלת בירה או בר בירה"

#. config.bar.business-type
#: schema.json
msgctxt "op"
msgid "Restaurant"
msgstr "מסעדה"

#. config.bar.email
#: schema.json
msgctxt "fh"
msgid "Email address for reservations, private events and press"
msgstr "כתובת אימייל להזמנות, אירועים פרטיים ועיתונות"

#. config.bar.announcement
#: schema.json
msgctxt "fh"
msgid "Short note shown at the top of every page, e.g. Walk-ins welcome until 23:00"
msgstr "הודעה קצרה בראש כל עמוד, למשל: אפשר להגיע ללא הזמנה עד 23:00"

#. config.bar.booking
#: schema.json
msgctxt "fh"
msgid "Link to the table reservation page, shown as a button in the header"
msgstr "קישור לעמוד הזמנת שולחן, מוצג ככפתור בכותרת העליונה"

#. config.bar.menu
#: schema.json
msgctxt "fn"
msgid "Menu link"
msgstr "קישור לתפריט"

#. config.bar.menu
#: schema.json
msgctxt "fh"
msgid "Link to the page with the drinks menu"
msgstr "קישור לעמוד עם תפריט המשקאות"

#. config.bar.cuisine
#: schema.json
msgctxt "fn"
msgid "Cuisine"
msgstr "מטבח"

#. config.bar.cuisine
#: schema.json
msgctxt "fh"
msgid "Comma separated list of what you serve, e.g. Cocktails, Wine, Bar snacks"
msgstr "רשימה מופרדת בפסיקים של מה שאתם מגישים, למשל: קוקטיילים, יין, נשנושי בר"

#. config.bar.notice
#: schema.json
msgctxt "fh"
msgid "Short note shown in the footer, e.g. Over 18 only. Please drink responsibly."
msgstr "הודעה קצרה בכותרת התחתונה, למשל: מגיל 18 ומעלה בלבד. שתו באחריות."

#. config.bar.hours.closes
#: schema.json
msgctxt "fh"
msgid "Closing time in 24 hour format, also after midnight, e.g. 02:00"
msgstr "שעת סגירה בפורמט 24 שעות, גם אחרי חצות, למשל 02:00"

#. config.theme
#: schema.json
msgctxt "st"
msgid "tonic::theme"
msgstr "ערכת נושא"
