msgid "Opening hours"
msgstr "שעות פתיחה"

#. config.bar.hours
#: schema.json
msgctxt "fh"
msgid "Opening hours for each day of the week, shown in the footer"
msgstr "שעות פתיחה לכל יום בשבוע, מוצגות בכותרת התחתונה"

