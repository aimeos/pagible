#: schema.json
msgctxt "fh"
msgid "Two letter ISO country code, e.g. DE or US"
msgstr "קוד מדינה ISO בן שתי אותיות, למשל DE או US"

#. config.bar.telephone
#: schema.json
msgctxt "fn"
msgid "telephone"
msgstr "טלפון"

#. config.bar.telephone
#: schema.json
msgctxt "fh"
msgid "Phone number in international format, also used by the call button"
msgstr "מספר טלפון בפורמט בינלאומי, משמש גם לכפתור החיוג"

#. config.bar.email
#: schema.json
msgctxt "fn"
msgid "email"
msgstr "אימייל"

#. config.bar.email
#: schema.json
msgctxt "fh"
msgid "Email address for reservations, private events and press"
msgstr "כתובת אימייל להזמנות, אירועים פרטיים ועיתונות"

#. config.bar.announcement
#: schema.json
msgctxt "fn"
msgid "Announcement"
msgstr "הודעה"

#. config.bar.announcement
#: schema.json
msgctxt "fh"
msgid "Short note shown at the top of every page, e.g. Walk-ins welcome until 23:00"
msgstr "הודעה קצרה בראש כל עמוד, למשל: אפשר להגיע ללא הזמנה עד 23:00"

#. config.bar.booking
#: schema.json
msgctxt "fn"
msgid "Booking link"
msgstr "קישור להזמנה"

#. config.bar.booking
#: schema.json
msgctxt "fh"
msgid "Link to the table reservation page, shown as a button in the header"
msgstr "קישור לעמוד הזמנת שולחן, מוצג ככפתור בכותרת העליונה"

#. config.bar.menu
#: schema.json
msgctxt "fn"
msgid "Menu link"
msgstr "קישור לתפריט"

#. config.bar.menu
#: schema.json
msgctxt "fh"
msgid "Link to the page with the drinks menu"
msgstr "קישור לעמוד עם תפריט המשקאות"

#. config.bar.cuisine
#: schema.json
msgctxt "fn"
msgid "Cuisine"
msgstr "מטבח"

#. config.bar.cuisine
#: schema.json
msgctxt "fh"
msgid "Comma separated list of what you serve, e.g. Cocktails, Wine, Bar snacks"
msgstr "רשימה מופרדת בפסיקים של מה שאתם מגישים, למשל: קוקטיילים, יין, נשנושי בר"

#. config.bar.price-range
#: schema.json
msgctxt "fn"
msgid "Price range"
msgstr "טווח מחירים"

#. config.bar.price-range
#: schema.json
msgctxt "fh"
msgid "Price level of the bar, e.g. $$ or €€"
msgstr "רמת המחירים של הבר, למשל $$ או €€"

#. config.bar.notice
#: schema.json
msgctxt "fn"
msgid "Notice"
msgstr "הערה"

#. config.bar.notice
#: schema.json
msgctxt "fh"
msgid "Short note shown in the footer, e.g. Over 18 only. Please drink responsibly."
msgstr "הודעה קצרה בכותרת התחתונה, למשל: מגיל 18 ומעלה בלבד. שתו באחריות."

#. config.bar.action-bar
#: schema.json
msgctxt "fn"
msgid "Action bar"
msgstr "סרגל פעולות"

#. config.bar.action-bar
#: schema.json
msgctxt "fh"
msgid "Show call and booking buttons at the bottom of the screen on phones"
msgstr "הצגת כפתורי התקשרות והזמנת מקום בתחתית המסך בטלפונים"

#. config.bar.hours
#: schema.json
