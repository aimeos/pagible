#. config.bar.business-type
#: schema.json
msgctxt "op"
msgid "Other business"
msgstr "עסק אחר"

#. config.bar.street-address
#: schema.json
msgctxt "fn"
msgid "Street address"
msgstr "כתובת"

#. config.bar.street-address
#: schema.json
msgctxt "fh"
msgid "Street and house number"
msgstr "רחוב ומספר בית"

#. config.bar.postal-code
#: schema.json
msgctxt "fn"
msgid "Postal code"
msgstr "מיקוד"

#. config.bar.postal-code
#: schema.json
msgctxt "fh"
msgid "Postal code of the bar"
msgstr "המיקוד של הבר"

#. config.bar.locality
#: schema.json
msgctxt "fn"
msgid "City"
msgstr "עיר"

