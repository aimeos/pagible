#: schema.json
msgctxt "fh"
msgid "Link to the table reservation page, shown as a button in the header"
msgstr "Link către pagina de rezervare a mesei, afișat ca buton în antet"

#. config.bar.menu
#: schema.json
msgctxt "fn"
msgid "Menu link"
msgstr "Link către meniu"

#. config.bar.menu
#: schema.json
