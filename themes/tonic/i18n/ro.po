msgid "Link to the page with the drinks menu"
msgstr "Link către pagina cu meniul de băuturi"

#. config.bar.cuisine
#: schema.json
msgctxt "fn"
msgid "Cuisine"
msgstr "Bucătărie"

#. config.bar.cuisine
#: schema.json
msgctxt "fh"
msgid "Comma separated list of what you serve, e.g. Cocktails, Wine, Bar snacks"
msgstr "Listă separată prin virgule cu ce serviți, de ex. Cocktailuri, Vin, Gustări"

#. config.bar.notice
#: schema.json
msgctxt "fh"
msgid "Short note shown in the footer, e.g. Over 18 only. Please drink responsibly."
msgstr "Notă scurtă afișată în subsol, de ex. Doar pentru persoane peste 18 ani. Consumați responsabil."

#. config.bar.hours.closes
#: schema.json
msgctxt "fh"
msgid "Closing time in 24 hour format, also after midnight, e.g. 02:00"
msgstr "Ora de închidere în format de 24 de ore, inclusiv după miezul nopții, de ex. 02:00"

