#. config.bar
#: schema.json
msgctxt "st"
msgid "tonic::bar"
msgstr "Bar"

#. config.bar.name
#: schema.json
msgctxt "fh"
msgid "Name of the bar, pub or club"
msgstr "Naziv bara, puba ili kluba"

#. config.bar.business-type
#: schema.json
msgctxt "op"
msgid "Bar or pub"
msgstr "Bar ili pub"

#. config.bar.business-type
#: schema.json
msgctxt "op"
msgid "Night club"
msgstr "Noćni klub"

#. config.bar.business-type
#: schema.json
msgctxt "op"
msgid "Brewery or taproom"
msgstr "Pivovara ili pivnica"

#. config.bar.business-type
#: schema.json
msgctxt "op"
msgid "Restaurant"
msgstr "Restoran"

#. config.bar.email
#: schema.json
msgctxt "fh"
msgid "Email address for reservations, private events and press"
msgstr "Adresa e-pošte za rezervacije, privatne događaje i medije"

#. config.bar.announcement
#: schema.json
msgctxt "fh"
msgid "Short note shown at the top of every page, e.g. Walk-ins welcome until 23:00"
msgstr "Kratka napomena prikazana na vrhu svake stranice, npr. Posjeti bez najave dobrodošli do 23:00"

#. config.bar.booking
#: schema.json
msgctxt "fh"
msgid "Link to the table reservation page, shown as a button in the header"
msgstr "Poveznica na stranicu za rezervaciju stola, prikazana kao gumb u zaglavlju"

#. config.bar.menu
#: schema.json
msgctxt "fn"
msgid "Menu link"
msgstr "Poveznica na jelovnik"

#. config.bar.menu
#: schema.json
msgctxt "fh"
msgid "Link to the page with the drinks menu"
msgstr "Poveznica na stranicu s jelovnikom pića"

#. config.bar.cuisine
#: schema.json
msgctxt "fn"
msgid "Cuisine"
msgstr "Ponuda"

#. config.bar.cuisine
#: schema.json
msgctxt "fh"
msgid "Comma separated list of what you serve, e.g. Cocktails, Wine, Bar snacks"
msgstr "Popis razdvojen zarezom onoga što poslužujete, npr. kokteli, vino, bar grickalice"

#. config.bar.notice
#: schema.json
msgctxt "fh"
msgid "Short note shown in the footer, e.g. Over 18 only. Please drink responsibly."
msgstr "Kratka napomena prikazana u podnožju, npr. Samo za osobe starije od 18 godina. Molimo pijte odgovorno."

#. config.bar.hours.closes
#: schema.json
msgctxt "fh"
msgid "Closing time in 24 hour format, also after midnight, e.g. 02:00"
msgstr "Vrijeme zatvaranja u 24-satnom formatu, također nakon ponoći, npr. 02:00"

#. config.theme
#: schema.json
msgctxt "st"
msgid "tonic::theme"
msgstr "Tema"
