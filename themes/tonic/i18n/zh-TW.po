#. config.bar
#: schema.json
msgctxt "st"
msgid "tonic::bar"
msgstr "酒吧"

#. config.bar.name
#: schema.json
msgctxt "fh"
msgid "Name of the bar, pub or club"
msgstr "酒吧、酒館或夜店的名稱"

#. config.bar.business-type
#: schema.json
msgctxt "op"
msgid "Bar or pub"
msgstr "酒吧或酒館"

#. config.bar.business-type
#: schema.json
msgctxt "op"
msgid "Night club"
msgstr "夜店"

#. config.bar.business-type
#: schema.json
msgctxt "op"
msgid "Brewery or taproom"
msgstr "啤酒廠或品酒室"

#. config.bar.business-type
#: schema.json
msgctxt "op"
msgid "Restaurant"
msgstr "餐廳"

#. config.bar.email
#: schema.json
msgctxt "fh"
msgid "Email address for reservations, private events and press"
msgstr "用於預訂、私人活動及媒體聯絡的電子郵件地址"

#. config.bar.announcement
#: schema.json
msgctxt "fh"
msgid "Short note shown at the top of every page, e.g. Walk-ins welcome until 23:00"
msgstr "每頁頂端顯示的簡短說明，例如：歡迎直接前來，服務時間至 23:00"

#. config.bar.booking
#: schema.json
msgctxt "fh"
msgid "Link to the table reservation page, shown as a button in the header"
msgstr "餐桌預訂頁面的連結，以按鈕形式顯示於頁首"

#. config.bar.menu
#: schema.json
msgctxt "fn"
msgid "Menu link"
msgstr "菜單連結"

#. config.bar.menu
#: schema.json
msgctxt "fh"
msgid "Link to the page with the drinks menu"
msgstr "飲品菜單頁面的連結"

#. config.bar.cuisine
#: schema.json
msgctxt "fn"
msgid "Cuisine"
msgstr "餐飲類型"

#. config.bar.cuisine
#: schema.json
msgctxt "fh"
msgid "Comma separated list of what you serve, e.g. Cocktails, Wine, Bar snacks"
msgstr "以逗號分隔的供應項目清單，例如：雞尾酒、葡萄酒、酒吧小點"

#. config.bar.notice
#: schema.json
msgctxt "fh"
msgid "Short note shown in the footer, e.g. Over 18 only. Please drink responsibly."
msgstr "頁尾顯示的簡短說明，例如：「僅限 18 歲以上人士。請理性飲酒。」"

#. config.bar.hours.closes
#: schema.json
msgctxt "fh"
msgid "Closing time in 24 hour format, also after midnight, e.g. 02:00"
msgstr "以 24 小時制表示的打烊時間，包括午夜之後的時間，例如 02:00"

#. config.theme
#: schema.json
msgctxt "st"
msgid "tonic::theme"
msgstr "主題"
