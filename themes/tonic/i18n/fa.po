#. config.bar.announcement
#: schema.json
msgctxt "fh"
msgid "Short note shown at the top of every page, e.g. Walk-ins welcome until 23:00"
msgstr "یادداشت کوتاهی که در بالای هر صفحه نمایش داده می‌شود، مثلاً پذیرش مراجعین بدون نوبت تا ساعت ۲۳:۰۰"

#. config.bar.booking
#: schema.json
msgctxt "fh"
msgid "Link to the table reservation page, shown as a button in the header"
msgstr "لینک صفحه رزرو میز که به صورت یک دکمه در هدر نمایش داده می‌شود"

#. config.bar.menu
#: schema.json
msgctxt "fn"
msgid "Menu link"
msgstr "لینک منو"

#. config.bar.menu
#: schema.json
msgctxt "fh"
msgid "Link to the page with the drinks menu"
msgstr "لینک صفحه منوی نوشیدنی‌ها"

#. config.bar.cuisine
#: schema.json
msgctxt "fn"
msgid "Cuisine"
msgstr "غذاها و نوشیدنی‌ها"

#. config.bar.cuisine
#: schema.json
msgctxt "fh"
msgid "Comma separated list of what you serve, e.g. Cocktails, Wine, Bar snacks"
msgstr "فهرست جداشده با ویرگول از آنچه ارائه می‌دهید، مانند کوکتل‌ها، شراب، تنقلات بار"

#. config.bar.notice
#: schema.json
msgctxt "fh"
msgid "Short note shown in the footer, e.g. Over 18 only. Please drink responsibly."
msgstr "یادداشت کوتاه نمایش داده شده در پاورقی، مثلاً: فقط بالای ۱۸ سال. لطفاً مسئولانه بنوشید."

#. config.bar.hours.closes
#: schema.json
msgctxt "fh"
msgid "Closing time in 24 hour format, also after midnight, e.g. 02:00"
msgstr "زمان پایان در قالب 24 ساعته، حتی پس از نیمه‌شب، مانند 02:00"

