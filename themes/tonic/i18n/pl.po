#. config.bar
#: schema.json
msgctxt "st"
msgid "tonic::bar"
msgstr "Bar"

#. config.bar.name
#: schema.json
msgctxt "fh"
msgid "Name of the bar, pub or club"
msgstr "Nazwa baru, pubu lub klubu"

#. config.bar.business-type
#: schema.json
msgctxt "op"
msgid "Bar or pub"
msgstr "Bar lub pub"

#. config.bar.business-type
#: schema.json
msgctxt "op"
msgid "Night club"
msgstr "Klub nocny"

#. config.bar.business-type
#: schema.json
msgctxt "op"
msgid "Brewery or taproom"
msgstr "Browar lub pijalnia piwa"

#. config.bar.business-type
#: schema.json
msgctxt "op"
msgid "Restaurant"
msgstr "Restauracja"

#. config.bar.email
#: schema.json
msgctxt "fh"
msgid "Email address for reservations, private events and press"
msgstr "Adres e-mail do rezerwacji, imprez prywatnych i kontaktu z mediami"

#. config.bar.announcement
#: schema.json
msgctxt "fh"
msgid "Short note shown at the top of every page, e.g. Walk-ins welcome until 23:00"
msgstr "Krótka informacja wyświetlana u góry każdej strony, np. Bez rezerwacji zapraszamy do 23:00"

#. config.bar.booking
#: schema.json
msgctxt "fh"
msgid "Link to the table reservation page, shown as a button in the header"
msgstr "Link do strony rezerwacji stolika, wyświetlany jako przycisk w nagłówku"

#. config.bar.menu
#: schema.json
msgctxt "fn"
msgid "Menu link"
msgstr "Link do menu"

#. config.bar.menu
#: schema.json
msgctxt "fh"
msgid "Link to the page with the drinks menu"
msgstr "Link do strony z kartą drinków"

#. config.bar.cuisine
#: schema.json
msgctxt "fn"
msgid "Cuisine"
msgstr "Kuchnia"

#. config.bar.cuisine
#: schema.json
msgctxt "fh"
msgid "Comma separated list of what you serve, e.g. Cocktails, Wine, Bar snacks"
msgstr "Lista serwowanych pozycji oddzielona przecinkami, np. Koktajle, Wino, Przekąski"

#. config.bar.notice
#: schema.json
msgctxt "fh"
msgid "Short note shown in the footer, e.g. Over 18 only. Please drink responsibly."
msgstr "Krótka informacja wyświetlana w stopce, np. Tylko dla osób pełnoletnich. Pij odpowiedzialnie."

#. config.bar.hours.closes
#: schema.json
msgctxt "fh"
msgid "Closing time in 24 hour format, also after midnight, e.g. 02:00"
msgstr "Godzina zamknięcia w formacie 24-godzinnym, także po północy, np. 02:00"

#. config.theme
#: schema.json
msgctxt "st"
msgid "tonic::theme"
