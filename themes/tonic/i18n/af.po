msgctxt "st"
msgid "tonic::bar"
msgstr "Kroeg"

#. config.bar.name
#: schema.json
msgctxt "fh"
msgid "Name of the bar, pub or club"
msgstr "Naam van die kroeg, pub of klub"

#. config.bar.business-type
#: schema.json
msgctxt "op"
msgid "Bar or pub"
msgstr "Kroeg of taverne"

#. config.bar.business-type
#: schema.json
msgctxt "op"
msgid "Night club"
msgstr "Nagklub"

#. config.bar.business-type
#: schema.json
msgctxt "op"
msgid "Brewery or taproom"
msgstr "Brouery of tapkamer"

#. config.bar.business-type
#: schema.json
msgctxt "op"
msgid "Restaurant"
msgstr "Restaurant"

#. config.bar.email
#: schema.json
msgctxt "fh"
msgid "Email address for reservations, private events and press"
msgstr "E-posadres vir besprekings, privaat geleenthede en pers"

#. config.bar.announcement
#: schema.json
msgctxt "fh"
msgid "Short note shown at the top of every page, e.g. Walk-ins welcome until 23:00"
msgstr "Kort kennisgewing bo-aan elke bladsy, bv. Spontane besoeke welkom tot 23:00"

#. config.bar.booking
#: schema.json
msgctxt "fh"
msgid "Link to the table reservation page, shown as a button in the header"
msgstr "Skakel na die tafelsreserveringsbladsy, wat as 'n knoppie in die kopstuk vertoon word"

#. config.bar.menu
#: schema.json
msgctxt "fn"
msgid "Menu link"
msgstr "Menu-skakel"

#. config.bar.menu
#: schema.json
msgctxt "fh"
msgid "Link to the page with the drinks menu"
msgstr "Skakel na die bladsy met die drankiemenu"

#. config.bar.cuisine
#: schema.json
msgctxt "fn"
msgid "Cuisine"
msgstr "Kookstyl"

#. config.bar.cuisine
#: schema.json
msgctxt "fh"
msgid "Comma separated list of what you serve, e.g. Cocktails, Wine, Bar snacks"
msgstr "Komma-geskeide lys van wat jy bedien, bv. koktels, wyn, kroeghappies"

#. config.bar.notice
#: schema.json
msgctxt "fh"
msgid "Short note shown in the footer, e.g. Over 18 only. Please drink responsibly."
msgstr "Kort kennisgewing in die voetskrif, bv. Slegs vir 18 jaar en ouer. Drink asseblief verantwoordelik."

#. config.bar.hours.closes
#: schema.json
msgctxt "fh"
msgid "Closing time in 24 hour format, also after midnight, e.g. 02:00"
msgstr "Sluitings tyd in 24-uur formaat, ook ná middernag, bv. 02:00"

#. config.theme
#: schema.json
msgctxt "st"
msgid "tonic::theme"
msgstr "Tema"
