msgctxt "st"
msgid "tonic::bar"
msgstr "Bārs"

#. config.bar.name
#: schema.json
msgctxt "fh"
msgid "Name of the bar, pub or club"
msgstr "Bāra, krodziņa vai kluba nosaukums"

#. config.bar.business-type
#: schema.json
msgctxt "op"
msgid "Bar or pub"
msgstr "Bārs vai krodziņš"

#. config.bar.business-type
#: schema.json
msgctxt "op"
msgid "Night club"
msgstr "Naktsklubs"

#. config.bar.business-type
#: schema.json
msgctxt "op"
msgid "Brewery or taproom"
msgstr "Alus darītava vai alus bārs"

#. config.bar.business-type
#: schema.json
msgctxt "op"
msgid "Restaurant"
msgstr "Restorāns"

#. config.bar.email
#: schema.json
msgctxt "fh"
msgid "Email address for reservations, private events and press"
msgstr "E-pasta adrese rezervācijām, privātiem pasākumiem un presei"

#. config.bar.announcement
#: schema.json
msgctxt "fh"
msgid "Short note shown at the top of every page, e.g. Walk-ins welcome until 23:00"
msgstr "Īss paziņojums katras lapas augšdaļā, piem., Bez rezervācijas gaidām līdz 23:00"

#. config.bar.booking
#: schema.json
msgctxt "fh"
msgid "Link to the table reservation page, shown as a button in the header"
msgstr "Saite uz galdiņa rezervācijas lapu, tiek rādīta kā poga galvenē"

#. config.bar.menu
#: schema.json
msgctxt "fn"
msgid "Menu link"
msgstr "Ēdienkartes saite"

#. config.bar.menu
#: schema.json
msgctxt "fh"
msgid "Link to the page with the drinks menu"
msgstr "Saite uz lapu ar dzērienu karti"

#. config.bar.cuisine
#: schema.json
msgctxt "fn"
msgid "Cuisine"
msgstr "Virtuve"

#. config.bar.cuisine
#: schema.json
msgctxt "fh"
msgid "Comma separated list of what you serve, e.g. Cocktails, Wine, Bar snacks"
msgstr "Ar komatiem atdalīts piedāvājuma saraksts, piem., Kokteiļi, Vīns, Uzkodas"

#. config.bar.notice
#: schema.json
msgctxt "fh"
msgid "Short note shown in the footer, e.g. Over 18 only. Please drink responsibly."
msgstr "Īss paziņojums kājenē, piem., Tikai no 18 gadiem. Lūdzu, lietojiet atbildīgi."

#. config.bar.hours.closes
#: schema.json
msgctxt "fh"
msgid "Closing time in 24 hour format, also after midnight, e.g. 02:00"
msgstr "Slēgšanas laiks 24 stundu formātā, arī pēc pusnakts, piem., 02:00"

#. config.theme
#: schema.json
msgctxt "st"
msgid "tonic::theme"
msgstr "Tēma"
