#: schema.json
msgctxt "fh"
msgid "Short note shown at the top of every page, e.g. Walk-ins welcome until 23:00"
msgstr "显示在每个页面顶部的简短提示，例如：23:00 前无需预订"

#. config.bar.booking
#: schema.json
msgctxt "fh"
msgid "Link to the table reservation page, shown as a button in the header"
msgstr "订座页面的链接，以按钮形式显示在页眉中"

#. config.bar.menu
#: schema.json
msgctxt "fn"
msgid "Menu link"
