#. config.bar
#: schema.json
msgctxt "st"
msgid "tonic::bar"
msgstr "바"

#. config.bar.name
#: schema.json
msgctxt "fh"
msgid "Name of the bar, pub or club"
msgstr "바, 펍 또는 클럽 이름"

#. config.bar.business-type
#: schema.json
msgctxt "op"
msgid "Bar or pub"
msgstr "바 또는 펍"

#. config.bar.business-type
#: schema.json
msgctxt "op"
msgid "Night club"
msgstr "나이트클럽"

#. config.bar.business-type
#: schema.json
msgctxt "op"
msgid "Brewery or taproom"
msgstr "브루어리 또는 탭룸"

#. config.bar.business-type
#: schema.json
msgctxt "op"
msgid "Restaurant"
msgstr "레스토랑"

#. config.bar.email
#: schema.json
msgctxt "fh"
msgid "Email address for reservations, private events and press"
msgstr "예약, 프라이빗 행사 및 언론 문의용 이메일 주소"

#. config.bar.announcement
#: schema.json
msgctxt "fh"
msgid "Short note shown at the top of every page, e.g. Walk-ins welcome until 23:00"
msgstr "모든 페이지 상단에 표시되는 짧은 안내(예: 23:00까지 예약 없이 방문 가능)"

#. config.bar.booking
#: schema.json
msgctxt "fh"
msgid "Link to the table reservation page, shown as a button in the header"
msgstr "테이블 예약 페이지 링크, 헤더에 버튼으로 표시됩니다"

#. config.bar.menu
#: schema.json
msgctxt "fn"
msgid "Menu link"
msgstr "메뉴 링크"

#. config.bar.menu
#: schema.json
msgctxt "fh"
msgid "Link to the page with the drinks menu"
msgstr "음료 메뉴 페이지 링크"

#. config.bar.cuisine
#: schema.json
msgctxt "fn"
msgid "Cuisine"
msgstr "메뉴 종류"

#. config.bar.cuisine
#: schema.json
msgctxt "fh"
msgid "Comma separated list of what you serve, e.g. Cocktails, Wine, Bar snacks"
msgstr "제공하는 메뉴를 쉼표로 구분한 목록(예: 칵테일, 와인, 바 스낵)"

#. config.bar.notice
#: schema.json
msgctxt "fh"
msgid "Short note shown in the footer, e.g. Over 18 only. Please drink responsibly."
msgstr "푸터에 표시되는 짧은 안내(예: 18세 이상만 이용 가능. 책임감 있는 음주를 부탁드립니다.)"

#. config.bar.hours.closes
#: schema.json
msgctxt "fh"
msgid "Closing time in 24 hour format, also after midnight, e.g. 02:00"
msgstr "24시간 형식의 마감 시간, 자정 이후도 가능(예: 02:00)"

#. config.theme
#: schema.json
msgctxt "st"
msgid "tonic::theme"
msgstr "테마"
