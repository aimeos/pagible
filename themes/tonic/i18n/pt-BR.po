msgid "Link to the page with the drinks menu"
msgstr "Link para a página com o cardápio de bebidas"

#. config.bar.cuisine
#: schema.json
msgctxt "fn"
msgid "Cuisine"
msgstr "Culinária"

#. config.bar.cuisine
#: schema.json
msgctxt "fh"
msgid "Comma separated list of what you serve, e.g. Cocktails, Wine, Bar snacks"
msgstr "Lista separada por vírgulas do que você serve, por exemplo: coquetéis, vinho, petiscos de bar"

#. config.bar.notice
#: schema.json
msgctxt "fh"
msgid "Short note shown in the footer, e.g. Over 18 only. Please drink responsibly."
msgstr "Breve nota exibida no rodapé, por exemplo: Somente para maiores de 18 anos. Beba com responsabilidade."

#. config.bar.hours.closes
#: schema.json
msgctxt "fh"
msgid "Closing time in 24 hour format, also after midnight, e.g. 02:00"
msgstr "Horário de fechamento no formato de 24 horas, inclusive após a meia-noite, por exemplo, 02:00"

