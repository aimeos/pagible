msgstr "Nom del bar, pub o club"

#. config.bar.business-type
#: schema.json
msgctxt "op"
msgid "Bar or pub"
msgstr "Bar o pub"

#. config.bar.business-type
#: schema.json
msgctxt "op"
msgid "Night club"
msgstr "Discoteca"

#. config.bar.business-type
#: schema.json
msgctxt "op"
msgid "Brewery or taproom"
msgstr "Cerveseria o sala de tast"

#. config.bar.business-type
#: schema.json
