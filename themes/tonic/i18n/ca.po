msgid "Restaurant"
msgstr "Restaurant"

#. config.bar.email
#: schema.json
msgctxt "fh"
msgid "Email address for reservations, private events and press"
msgstr "Adreça de correu electrònic per a reserves, esdeveniments privats i premsa"

#. config.bar.announcement
#: schema.json
msgctxt "fh"
msgid "Short note shown at the top of every page, e.g. Walk-ins welcome until 23:00"
msgstr "Nota breu que apareix a la part superior de cada pàgina, p. ex. S'admeten visites sense cita prèvia fins a les 23:00"

#. config.bar.booking
#: schema.json
msgctxt "fh"
msgid "Link to the table reservation page, shown as a button in the header"
msgstr "Enllaç a la pàgina de reserva de taula, mostrat com un botó a l'encapçalament"

#. config.bar.menu
#: schema.json
msgctxt "fn"
msgid "Menu link"
msgstr "Enllaç del menú"

#. config.bar.menu
#: schema.json
msgctxt "fh"
msgid "Link to the page with the drinks menu"
msgstr "Enllaç a la pàgina amb el menú de begudes"

#. config.bar.cuisine
#: schema.json
msgctxt "fn"
msgid "Cuisine"
msgstr "Cuina"

#. config.bar.cuisine
#: schema.json
msgctxt "fh"
msgid "Comma separated list of what you serve, e.g. Cocktails, Wine, Bar snacks"
msgstr "Llista separada per comes del que serveixes, p. ex. còctels, vi, aperitius de bar"

#. config.bar.notice
#: schema.json
msgctxt "fh"
msgid "Short note shown in the footer, e.g. Over 18 only. Please drink responsibly."
msgstr "Nota breu que apareix al peu de pàgina, p. ex. Per a majors de 18 anys. Si us plau, begueu amb responsabilitat."

#. config.bar.hours.closes
#: schema.json
msgctxt "fh"
msgid "Closing time in 24 hour format, also after midnight, e.g. 02:00"
msgstr "Hora de tancament en format de 24 hores, també després de la mitjanit, p. ex. 02:00"

#. config.theme
#: schema.json
msgctxt "st"
msgid "tonic::theme"
msgstr "Tema"
