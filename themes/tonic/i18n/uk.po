#. config.bar
#: schema.json
msgctxt "st"
msgid "tonic::bar"
msgstr "Бар"

#. config.bar.name
#: schema.json
msgctxt "fh"
msgid "Name of the bar, pub or club"
msgstr "Назва бару, пабу чи клубу"

#. config.bar.business-type
#: schema.json
msgctxt "op"
msgid "Bar or pub"
msgstr "Бар або паб"

#. config.bar.business-type
#: schema.json
msgctxt "op"
msgid "Night club"
msgstr "Нічний клуб"

#. config.bar.business-type
#: schema.json
msgctxt "op"
msgid "Brewery or taproom"
msgstr "Пивоварня або пивний бар"

#. config.bar.business-type
#: schema.json
msgctxt "op"
msgid "Restaurant"
msgstr "Ресторан"

#. config.bar.email
#: schema.json
msgctxt "fh"
msgid "Email address for reservations, private events and press"
msgstr "Адреса електронної пошти для бронювань, приватних заходів і преси"

#. config.bar.announcement
#: schema.json
msgctxt "fh"
msgid "Short note shown at the top of every page, e.g. Walk-ins welcome until 23:00"
msgstr "Коротке повідомлення вгорі кожної сторінки, наприклад Без бронювання до 23:00"

#. config.bar.booking
#: schema.json
msgctxt "fh"
msgid "Link to the table reservation page, shown as a button in the header"
msgstr "Посилання на сторінку бронювання столика, відображається кнопкою в шапці"

#. config.bar.menu
#: schema.json
msgctxt "fn"
msgid "Menu link"
msgstr "Посилання на меню"

#. config.bar.menu
#: schema.json
msgctxt "fh"
msgid "Link to the page with the drinks menu"
msgstr "Посилання на сторінку з барною картою"

#. config.bar.cuisine
#: schema.json
msgctxt "fn"
msgid "Cuisine"
msgstr "Кухня"

#. config.bar.cuisine
#: schema.json
msgctxt "fh"
msgid "Comma separated list of what you serve, e.g. Cocktails, Wine, Bar snacks"
msgstr "Список того, що ви подаєте, через кому, наприклад Коктейлі, Вино, Закуски"

#. config.bar.notice
#: schema.json
msgctxt "fh"
msgid "Short note shown in the footer, e.g. Over 18 only. Please drink responsibly."
msgstr "Коротке повідомлення в підвалі сайту, наприклад Лише для осіб, старших 18 років. Пийте відповідально."

#. config.bar.hours.closes
#: schema.json
msgctxt "fh"
msgid "Closing time in 24 hour format, also after midnight, e.g. 02:00"
msgstr "Час закриття у 24-годинному форматі, також після півночі, наприклад 02:00"

#. config.theme
#: schema.json
msgctxt "st"
msgid "tonic::theme"
msgstr "Тема оформлення"
