#: schema.json
msgctxt "fh"
msgid "Opening time in 24 hour format, e.g. 18:00"
msgstr "Ώρα έναρξης σε μορφή 24 ωρών, π.χ. 18:00"

#. config.bar.hours.closes
#: schema.json
msgctxt "fn"
msgid "closes"
msgstr "Ώρα κλεισίματος"

#. config.bar.hours.closes
#: schema.json
msgctxt "fh"
msgid "Closing time in 24 hour format, also after midnight, e.g. 02:00"
msgstr "Ώρα κλεισίματος σε μορφή 24 ωρών, και μετά τα μεσάνυχτα, π.χ. 02:00"

