#. config.bar.hours.day
#: schema.json
msgctxt "op"
msgid "Monday"
msgstr "Δευτέρα"

#. config.bar.hours.day
#: schema.json
msgctxt "op"
msgid "Tuesday"
msgstr "Τρίτη"

#. config.bar.hours.day
#: schema.json
msgctxt "op"
msgid "Wednesday"
