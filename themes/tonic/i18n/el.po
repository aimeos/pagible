#. config.bar
#: schema.json
msgctxt "st"
msgid "tonic::bar"
msgstr "Μπαρ"

#. config.bar.name
#: schema.json
msgctxt "fh"
msgid "Name of the bar, pub or club"
msgstr "Όνομα του μπαρ, της παμπ ή του κλαμπ"

#. config.bar.business-type
#: schema.json
msgctxt "op"
msgid "Bar or pub"
msgstr "Μπαρ ή παμπ"

#. config.bar.business-type
#: schema.json
msgctxt "op"
msgid "Night club"
msgstr "Νυχτερινό κέντρο"

#. config.bar.business-type
#: schema.json
msgctxt "op"
msgid "Brewery or taproom"
msgstr "Ζυθοποιείο ή μπυραρία"

#. config.bar.business-type
#: schema.json
msgctxt "op"
msgid "Restaurant"
msgstr "Εστιατόριο"

#. config.bar.email
#: schema.json
msgctxt "fh"
msgid "Email address for reservations, private events and press"
msgstr "Διεύθυνση email για κρατήσεις, ιδιωτικές εκδηλώσεις και τύπο"

#. config.bar.announcement
#: schema.json
msgctxt "fh"
msgid "Short note shown at the top of every page, e.g. Walk-ins welcome until 23:00"
msgstr "Σύντομο μήνυμα στο πάνω μέρος κάθε σελίδας, π.χ. Χωρίς κράτηση έως τις 23:00"

#. config.bar.booking
#: schema.json
msgctxt "fh"
msgid "Link to the table reservation page, shown as a button in the header"
msgstr "Σύνδεσμος προς τη σελίδα κράτησης τραπεζιού, εμφανίζεται ως κουμπί στην κεφαλίδα"

#. config.bar.menu
#: schema.json
msgctxt "fn"
msgid "Menu link"
msgstr "Σύνδεσμος καταλόγου"

#. config.bar.menu
#: schema.json
msgctxt "fh"
msgid "Link to the page with the drinks menu"
msgstr "Σύνδεσμος προς τη σελίδα με τον κατάλογο ποτών"

#. config.bar.cuisine
#: schema.json
msgctxt "fn"
msgid "Cuisine"
msgstr "Προσφερόμενα είδη"

#. config.bar.cuisine
#: schema.json
msgctxt "fh"
msgid "Comma separated list of what you serve, e.g. Cocktails, Wine, Bar snacks"
msgstr "Λίστα με όσα σερβίρετε, χωρισμένη με κόμματα, π.χ. Κοκτέιλ, Κρασί, Μεζέδες"

#. config.bar.notice
#: schema.json
msgctxt "fh"
msgid "Short note shown in the footer, e.g. Over 18 only. Please drink responsibly."
msgstr "Σύντομο μήνυμα στο υποσέλιδο, π.χ. Μόνο για άτομα άνω των 18. Πίνετε υπεύθυνα."

#. config.bar.hours.closes
#: schema.json
msgctxt "fh"
msgid "Closing time in 24 hour format, also after midnight, e.g. 02:00"
msgstr "Ώρα κλεισίματος σε μορφή 24 ωρών, και μετά τα μεσάνυχτα, π.χ. 02:00"

#. config.theme
#: schema.json
msgctxt "st"
msgid "tonic::theme"
msgstr "Θέμα"
