#. config.bar
#: schema.json
msgctxt "st"
msgid "tonic::bar"
msgstr "بار"

#. config.bar.name
#: schema.json
msgctxt "fh"
msgid "Name of the bar, pub or club"
msgstr "اسم البار أو الحانة أو النادي"

#. config.bar.business-type
#: schema.json
msgctxt "op"
msgid "Bar or pub"
msgstr "بار أو حانة"

#. config.bar.business-type
#: schema.json
msgctxt "op"
msgid "Night club"
msgstr "ملهى ليلي"

#. config.bar.business-type
#: schema.json
msgctxt "op"
msgid "Brewery or taproom"
msgstr "مصنع جعة أو حانة جعة"

#. config.bar.business-type
#: schema.json
msgctxt "op"
msgid "Restaurant"
msgstr "مطعم"

#. config.bar.email
#: schema.json
msgctxt "fh"
msgid "Email address for reservations, private events and press"
msgstr "عنوان البريد الإلكتروني للحجوزات والمناسبات الخاصة والصحافة"

#. config.bar.announcement
#: schema.json
msgctxt "fh"
msgid "Short note shown at the top of every page, e.g. Walk-ins welcome until 23:00"
msgstr "ملاحظة قصيرة تظهر أعلى كل صفحة، مثل: نرحب بالزوار دون حجز حتى 23:00"

#. config.bar.booking
#: schema.json
msgctxt "fh"
msgid "Link to the table reservation page, shown as a button in the header"
msgstr "رابط صفحة حجز الطاولات، يظهر كزر في الترويسة"

#. config.bar.menu
#: schema.json
msgctxt "fn"
msgid "Menu link"
msgstr "رابط القائمة"

#. config.bar.menu
#: schema.json
msgctxt "fh"
msgid "Link to the page with the drinks menu"
msgstr "رابط الصفحة التي تحتوي على قائمة المشروبات"

#. config.bar.cuisine
#: schema.json
msgctxt "fn"
msgid "Cuisine"
msgstr "المأكولات والمشروبات"

#. config.bar.cuisine
#: schema.json
msgctxt "fh"
msgid "Comma separated list of what you serve, e.g. Cocktails, Wine, Bar snacks"
msgstr "قائمة مفصولة بفواصل بما تقدمه، مثل: كوكتيلات، نبيذ، وجبات خفيفة"

#. config.bar.notice
#: schema.json
msgctxt "fh"
msgid "Short note shown in the footer, e.g. Over 18 only. Please drink responsibly."
msgstr "ملاحظة قصيرة تظهر في التذييل، مثل: لمن هم فوق 18 عامًا فقط. يرجى الشرب بمسؤولية."

#. config.bar.hours.closes
#: schema.json
msgctxt "fh"
msgid "Closing time in 24 hour format, also after midnight, e.g. 02:00"
msgstr "وقت الإغلاق بصيغة 24 ساعة، حتى بعد منتصف الليل، مثل 02:00"

#. config.theme
#: schema.json
msgctxt "st"
msgid "tonic::theme"
msgstr "المظهر"
