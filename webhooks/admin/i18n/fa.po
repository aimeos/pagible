msgctxt "webhooks"
msgid "Secret copied"
msgstr "کلید محرمانه کپی شد"

msgctxt "webhooks"
msgid "Unable to copy secret"
msgstr "کپی کلید محرمانه ممکن نیست"

msgctxt "webhooks"
msgid "Webhook secret"
msgstr "کلید محرمانه وب‌هوک"

msgctxt "webhooks"
msgid "Edit webhook"
msgstr "ویرایش وب‌هوک"

msgctxt "webhooks"
msgid "Add webhook"
msgstr "افزودن وب‌هوک"

msgctxt "webhooks"
msgid "Copy this secret now. It will not be shown again."
msgstr "این کلید محرمانه را اکنون کپی کنید. دوباره نمایش داده نخواهد شد."

msgctxt "webhooks"
msgid "Active"
msgstr "فعال"

msgctxt "webhooks"
msgid ""
"Inactive webhooks receive no events and their queued deliveries are dropped"
msgstr ""
"وب‌هوک‌های غیرفعال هیچ رویدادی دریافت نمی‌کنند و ارسال‌های در صف آن‌ها حذف می‌شوند"

msgctxt "webhooks"
msgid "HTTPS endpoint URL"
msgstr "نشانی URL نقطه پایانی HTTPS"

msgctxt "webhooks"
msgid "Address receiving the signed events, it cannot be changed later"
msgstr "نشانی دریافت‌کننده رویدادهای امضاشده؛ بعداً قابل تغییر نیست"

msgctxt "webhooks"
msgid "Not a valid URL"
msgstr "URL معتبر نیست"

msgctxt "webhooks"
msgid "Events"
msgstr "رویدادها"

msgctxt "webhooks"
msgid ""
"Events sent to the webhook, queued deliveries of removed events are cancelled"
msgstr "رویدادهای ارسالی به وب‌هوک؛ ارسال‌های در صفِ رویدادهای حذف‌شده لغو می‌شوند"

msgctxt "webhooks"
msgid "Name"
msgstr "نام"

msgctxt "webhooks"
msgid ""
"Optional name to tell webhooks with the same endpoint apart, visible to all "
"webhook editors"
msgstr ""
"نام اختیاری برای تشخیص وب‌هوک‌هایی با نقطه پایانی یکسان؛ برای همه ویرایشگران "
"وب‌هوک قابل مشاهده است"

msgctxt "webhooks"
msgid "Test"
msgstr "آزمایش"

msgctxt "webhooks"
msgid "Done"
msgstr "انجام شد"

msgctxt "webhooks"
msgid "Copy secret"
msgstr "کپی کلید محرمانه"

msgctxt "webhooks"
msgid "Cancel"
msgstr "لغو"

msgctxt "webhooks"
msgid "Save"
msgstr "ذخیره"

msgctxt "webhooks"
msgid "Webhooks"
msgstr "وب‌هوک‌ها"

msgctxt "webhooks"
msgid "Webhooks are disabled by the server configuration, no events are sent"
msgstr "وب‌هوک‌ها در پیکربندی سرور غیرفعال شده‌اند و هیچ رویدادی ارسال نمی‌شود"

msgctxt "webhooks"
msgid "All deliveries are blocked by the server configuration: %{reason}"
msgstr "همه ارسال‌ها توسط پیکربندی سرور مسدود شده‌اند: %{reason}"

msgctxt "webhooks"
msgid "Status"
msgstr "وضعیت"

