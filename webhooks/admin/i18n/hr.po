msgstr "Poslužitelj nije pronađen"

msgctxt "webhooks"
msgid "Response too large"
msgstr "Odgovor je prevelik"

msgctxt "webhooks"
msgid "Request timed out"
msgstr "Isteklo je vrijeme čekanja zahtjeva"

msgctxt "webhooks"
