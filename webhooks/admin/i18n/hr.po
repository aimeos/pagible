msgctxt "webhooks"
msgid "Secret copied"
msgstr "Tajni ključ kopiran"

msgctxt "webhooks"
msgid "Unable to copy secret"
msgstr "Nije moguće kopirati tajni ključ"

msgctxt "webhooks"
msgid "Webhook secret"
msgstr "Tajni ključ webhooka"

msgctxt "webhooks"
msgid "Edit webhook"
msgstr "Uredi webhook"

msgctxt "webhooks"
msgid "Add webhook"
msgstr "Dodaj webhook"

msgctxt "webhooks"
msgid "Copy this secret now. It will not be shown again."
msgstr "Kopirajte ovaj tajni ključ sada. Neće se ponovno prikazati."

msgctxt "webhooks"
msgid "Active"
msgstr "Aktivan"

msgctxt "webhooks"
msgid ""
"Inactive webhooks receive no events and their queued deliveries are dropped"
msgstr ""
"Neaktivni webhookovi ne primaju događaje, a njihove isporuke na čekanju se "
"odbacuju"

msgctxt "webhooks"
msgid "HTTPS endpoint URL"
msgstr "URL HTTPS krajnje točke"

msgctxt "webhooks"
msgid "Address receiving the signed events, it cannot be changed later"
msgstr "Adresa koja prima potpisane događaje; ne može se naknadno promijeniti"

msgctxt "webhooks"
msgid "Not a valid URL"
msgstr "Nije valjan URL"

msgctxt "webhooks"
msgid "Events"
msgstr "Događaji"

msgctxt "webhooks"
msgid ""
"Events sent to the webhook, queued deliveries of removed events are cancelled"
msgstr ""
"Događaji koji se šalju webhooku; isporuke uklonjenih događaja na čekanju se "
"otkazuju"

msgctxt "webhooks"
msgid "Name"
msgstr "Naziv"

msgctxt "webhooks"
msgid ""
"Optional name to tell webhooks with the same endpoint apart, visible to all "
"webhook editors"
msgstr ""
"Neobavezan naziv za razlikovanje webhookova s istom krajnjom točkom, vidljiv "
"svim urednicima webhookova"

msgctxt "webhooks"
msgid "Test"
msgstr "Testiraj"

msgctxt "webhooks"
msgid "Done"
msgstr "Gotovo"

msgctxt "webhooks"
msgid "Copy secret"
msgstr "Kopiraj tajni ključ"

msgctxt "webhooks"
msgid "Cancel"
msgstr "Odustani"

msgctxt "webhooks"
msgid "Save"
msgstr "Spremi"

msgctxt "webhooks"
msgid "Webhooks"
msgstr "Webhookovi"

msgctxt "webhooks"
msgid "Webhooks are disabled by the server configuration, no events are sent"
msgstr ""
"Webhookovi su onemogućeni konfiguracijom poslužitelja; događaji se ne šalju"

msgctxt "webhooks"
msgid "All deliveries are blocked by the server configuration: %{reason}"
msgstr "Sve isporuke blokirane su konfiguracijom poslužitelja: %{reason}"

msgctxt "webhooks"
msgid "Status"
msgstr "Status"

msgctxt "webhooks"
msgid "All"
msgstr "Sve"

msgctxt "webhooks"
msgid "Inactive"
msgstr "Neaktivan"

msgctxt "webhooks"
msgid "None"
msgstr "Ništa"

msgctxt "webhooks"
msgid "%{reason} · %{date}"
msgstr "%{reason} · %{date}"

msgctxt "webhooks"
msgid "Error fetching webhooks"
msgstr "Pogreška pri dohvaćanju webhookova"

msgctxt "webhooks"
msgid "Test event delivered (%{status})"
msgstr "Probni događaj isporučen (%{status})"

msgctxt "webhooks"
msgid "Test event failed: %{reason}"
msgstr "Probni događaj nije uspio: %{reason}"

msgctxt "webhooks"
msgid "Test event failed"
msgstr "Probni događaj nije uspio"

msgctxt "webhooks"
msgid "Error purging webhook"
msgstr "Pogreška pri trajnom brisanju webhooka"

msgctxt "webhooks"
msgid ""
"The new webhook secret could not be shown after leaving the page, please "
"rotate it to get a new one"
msgstr ""
"Nova tajna webhooka nije se mogla prikazati nakon napuštanja stranice, "
"obnovite je kako biste dobili novu"

msgctxt "webhooks"
msgid ""
"Rotate the secret of this webhook? Receivers must be updated with the new "
"secret."
msgstr ""
"Zamijeniti tajni ključ ovog webhooka? Primatelje treba ažurirati novim "
"tajnim ključem."

msgctxt "webhooks"
msgid "Rotate"
msgstr "Zamijeni ključ"

msgctxt "webhooks"
msgid "Error rotating webhook secret"
msgstr "Pogreška pri zamjeni tajnog ključa webhooka"

msgctxt "webhooks"
msgid "Error saving webhook"
msgstr "Pogreška pri spremanju webhooka"

msgctxt "webhooks"
msgid "Send signed notifications when published content changes."
msgstr "Šaljite potpisane obavijesti kada se promijeni objavljeni sadržaj."

msgctxt "webhooks"
msgid "Toggle selection"
msgstr "Uključi/isključi odabir"

