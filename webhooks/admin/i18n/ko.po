msgctxt "webhooks"
msgid "Test event delivered (%{status})"
msgstr "테스트 이벤트가 전송되었습니다 (%{status})"

msgctxt "webhooks"
msgid "Test event failed: %{reason}"
msgstr "테스트 이벤트에 실패했습니다: %{reason}"

msgctxt "webhooks"
msgid "Test event failed"
msgstr "테스트 이벤트에 실패했습니다"

