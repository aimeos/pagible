msgid "Save"
msgstr "저장"

msgctxt "webhooks"
msgid "Webhooks"
msgstr "웹후크"

msgctxt "webhooks"
msgid "Webhooks are disabled by the server configuration, no events are sent"
msgstr "서버 설정에 의해 웹후크가 비활성화되어 이벤트가 전송되지 않습니다"

msgctxt "webhooks"
msgid "All deliveries are blocked by the server configuration: %{reason}"
msgstr "서버 설정에 의해 모든 전송이 차단되었습니다: %{reason}"

msgctxt "webhooks"
msgid "Status"
msgstr "상태"

