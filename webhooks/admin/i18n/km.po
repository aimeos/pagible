msgctxt "webhooks"
msgid "Secret copied"
msgstr "បានចម្លងសោសម្ងាត់"

msgctxt "webhooks"
msgid "Unable to copy secret"
msgstr "មិនអាចចម្លងសោសម្ងាត់បានទេ"

msgctxt "webhooks"
msgid "Webhook secret"
msgstr "សោសម្ងាត់របស់ Webhook"

msgctxt "webhooks"
msgid "Edit webhook"
msgstr "កែសម្រួល Webhook"

msgctxt "webhooks"
msgid "Add webhook"
msgstr "បន្ថែម Webhook"

msgctxt "webhooks"
msgid "Copy this secret now. It will not be shown again."
msgstr "ចម្លងសោសម្ងាត់នេះឥឡូវនេះ។ វានឹងមិនត្រូវបានបង្ហាញម្តងទៀតទេ។"

msgctxt "webhooks"
msgid "Active"
msgstr "សកម្ម"

msgctxt "webhooks"
msgid ""
"Inactive webhooks receive no events and their queued deliveries are dropped"
msgstr "Webhook ដែលអសកម្មមិនទទួលព្រឹត្តិការណ៍ទេ ហើយការបញ្ជូនរបស់វាដែលកំពុងរង់ចាំនឹងត្រូវបោះបង់"

msgctxt "webhooks"
msgid "HTTPS endpoint URL"
msgstr "URL ចំណុចចុង HTTPS"

msgctxt "webhooks"
msgid "Address receiving the signed events, it cannot be changed later"
msgstr "អាសយដ្ឋានដែលទទួលព្រឹត្តិការណ៍មានហត្ថលេខា មិនអាចផ្លាស់ប្តូរនៅពេលក្រោយបានទេ"

msgctxt "webhooks"
msgid "Not a valid URL"
msgstr "មិនមែនជា URL ត្រឹមត្រូវទេ"

msgctxt "webhooks"
msgid "Events"
msgstr "ព្រឹត្តិការណ៍"

msgctxt "webhooks"
msgid ""
"Events sent to the webhook, queued deliveries of removed events are cancelled"
msgstr ""
"ព្រឹត្តិការណ៍ដែលផ្ញើទៅ Webhook ការបញ្ជូនដែលកំពុងរង់ចាំសម្រាប់ព្រឹត្តិការណ៍ដែលបានដកចេញនឹងត្រូវលុបចោល"

msgctxt "webhooks"
msgid "Name"
msgstr "ឈ្មោះ"

msgctxt "webhooks"
msgid ""
"Optional name to tell webhooks with the same endpoint apart, visible to all "
"webhook editors"
msgstr ""
"ឈ្មោះជាជម្រើសសម្រាប់សម្គាល់ Webhook ដែលមានចំណុចចុងដូចគ្នា អាចមើលឃើញដោយអ្នកកែសម្រួល Webhook "
"ទាំងអស់"

msgctxt "webhooks"
msgid "Test"
msgstr "សាកល្បង"

msgctxt "webhooks"
msgid "Done"
msgstr "រួចរាល់"

msgctxt "webhooks"
msgid "Copy secret"
msgstr "ចម្លងសោសម្ងាត់"

msgctxt "webhooks"
msgid "Cancel"
msgstr "បោះបង់"

msgctxt "webhooks"
msgid "Save"
msgstr "រក្សាទុក"

msgctxt "webhooks"
msgid "Webhooks"
msgstr "Webhook"

msgctxt "webhooks"
msgid "Webhooks are disabled by the server configuration, no events are sent"
msgstr "Webhook ត្រូវបានបិទដោយការកំណត់របស់ម៉ាស៊ីនមេ ដូច្នេះគ្មានព្រឹត្តិការណ៍ត្រូវបានផ្ញើទេ"

msgctxt "webhooks"
msgid "All deliveries are blocked by the server configuration: %{reason}"
msgstr "ការបញ្ជូនទាំងអស់ត្រូវបានរារាំងដោយការកំណត់របស់ម៉ាស៊ីនមេ: %{reason}"

msgctxt "webhooks"
msgid "Status"
msgstr "ស្ថានភាព"

msgctxt "webhooks"
msgid "All"
msgstr "ទាំងអស់"

msgctxt "webhooks"
msgid "Inactive"
msgstr "អសកម្ម"

msgctxt "webhooks"
msgid "None"
msgstr "គ្មាន"

msgctxt "webhooks"
msgid "%{reason} · %{date}"
msgstr "%{reason} · %{date}"

msgctxt "webhooks"
msgid "Error fetching webhooks"
msgstr "មានកំហុសក្នុងការទាញយក Webhook"

msgctxt "webhooks"
msgid "Test event delivered (%{status})"
msgstr "បានបញ្ជូនព្រឹត្តិការណ៍សាកល្បង (%{status})"

msgctxt "webhooks"
msgid "Test event failed: %{reason}"
msgstr "ព្រឹត្តិការណ៍សាកល្បងបានបរាជ័យ: %{reason}"

msgctxt "webhooks"
msgid "Test event failed"
msgstr "ព្រឹត្តិការណ៍សាកល្បងបានបរាជ័យ"

msgctxt "webhooks"
msgid "Error purging webhook"
msgstr "មានកំហុសក្នុងការលុប Webhook ជាអចិន្ត្រៃយ៍"

msgctxt "webhooks"
msgid ""
"The new webhook secret could not be shown after leaving the page, please "
"rotate it to get a new one"
msgstr "មិនអាចបង្ហាញសម្ងាត់ webhook ថ្មីបានទេ បន្ទាប់ពីចាកចេញពីទំព័រ សូមប្តូរវាដើម្បីទទួលបានថ្មី"

msgctxt "webhooks"
msgid ""
"Rotate the secret of this webhook? Receivers must be updated with the new "
"secret."
msgstr "ប្តូរសោសម្ងាត់របស់ Webhook នេះឬ? អ្នកទទួលត្រូវធ្វើបច្ចុប្បន្នភាពដោយប្រើសោសម្ងាត់ថ្មី។"

msgctxt "webhooks"
msgid "Rotate"
msgstr "ប្តូរសោ"

msgctxt "webhooks"
msgid "Error rotating webhook secret"
msgstr "មានកំហុសក្នុងការប្តូរសោសម្ងាត់របស់ Webhook"

msgctxt "webhooks"
msgid "Error saving webhook"
msgstr "មានកំហុសក្នុងការរក្សាទុក Webhook"

msgctxt "webhooks"
msgid "Send signed notifications when published content changes."
msgstr "ផ្ញើការជូនដំណឹងដែលមានហត្ថលេខា នៅពេលមាតិកាដែលបានបោះផ្សាយផ្លាស់ប្តូរ។"

msgctxt "webhooks"
msgid "Toggle selection"
msgstr "បិទ/បើកការជ្រើសរើស"

msgctxt "webhooks"
msgid "Purge (%{count})"
msgstr "លុបជាអចិន្ត្រៃយ៍ (%{count})"

msgctxt "webhooks"
msgid "Search for"
msgstr "ស្វែងរក"

msgctxt "webhooks"
msgid "Refresh"
msgstr "ផ្ទុកឡើងវិញ"

msgctxt "webhooks"
msgid "Edit"
msgstr "កែសម្រួល"

msgctxt "webhooks"
msgid "Purge"
msgstr "លុបជាអចិន្ត្រៃយ៍"

msgctxt "webhooks"
msgid "Last success: %{date}"
msgstr "ការបញ្ជូនជោគជ័យចុងក្រោយ: %{date}"

msgctxt "webhooks"
msgid "Last error: %{reason}"
msgstr "កំហុសចុងក្រោយ: %{reason}"

msgctxt "webhooks"
msgid "Paused until: %{date}"
msgstr "ផ្អាករហូតដល់: %{date}"

msgctxt "webhooks"
msgid "Loading"
msgstr "កំពុងផ្ទុក"

msgctxt "webhooks"
msgid "No entries found"
msgstr "រកមិនឃើញធាតុបញ្ចូលទេ"

msgctxt "webhooks"
msgid "No webhooks configured."
msgstr "មិនទាន់មាន Webhook ត្រូវបានកំណត់ទេ។"

msgctxt "webhooks"
msgid "Connection failed"
msgstr "ការតភ្ជាប់បានបរាជ័យ"

msgctxt "webhooks"
msgid "Access denied"
msgstr "ការចូលប្រើត្រូវបានបដិសេធ"

msgctxt "webhooks"
msgid "Secret can't be decrypted, rotate it"
msgstr "មិនអាចឌិគ្រីបសោសម្ងាត់បានទេ សូមប្តូរវា"

msgctxt "webhooks"
msgid "Invalid list of denied networks"
msgstr "បញ្ជីបណ្តាញដែលបានបដិសេធមិនត្រឹមត្រូវ"

msgctxt "webhooks"
msgid "Queue unavailable"
msgstr "មិនអាចប្រើជួររង់ចាំបានទេ"

msgctxt "webhooks"
msgid "Host not found"
msgstr "រកមិនឃើញម៉ាស៊ីន Host ទេ"

msgctxt "webhooks"
msgid "Response too large"
msgstr "ការឆ្លើយតបធំពេក"

msgctxt "webhooks"
msgid "Request timed out"
msgstr "សំណើបានផុតពេលរង់ចាំ"

msgctxt "webhooks"
msgid "Redirects aren't followed"
msgstr "មិនធ្វើតាមការបញ្ជូនបន្តទេ"

msgctxt "webhooks"
msgid "Delivery failed"
msgstr "ការបញ្ជូនបានបរាជ័យ"

msgctxt "webhooks"
msgid "%{reason} (%{status})"
msgstr "%{reason} (%{status})"
