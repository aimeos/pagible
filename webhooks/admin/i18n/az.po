msgid "Address receiving the signed events, it cannot be changed later"
msgstr "İmzalanmış hadisələri qəbul edən ünvan; sonradan dəyişdirilə bilməz"

msgctxt "webhooks"
msgid "Not a valid URL"
msgstr "Etibarlı URL deyil"

msgctxt "webhooks"
msgid "Events"
msgstr "Hadisələr"

msgctxt "webhooks"
msgid ""
"Events sent to the webhook, queued deliveries of removed events are cancelled"
msgstr ""
"Webhook-a göndərilən hadisələr; silinmiş hadisələrin növbədəki "
"çatdırılmaları ləğv edilir"

msgctxt "webhooks"
msgid "Name"
msgstr "Ad"

msgctxt "webhooks"
msgid ""
"Optional name to tell webhooks with the same endpoint apart, visible to all "
