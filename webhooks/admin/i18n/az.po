msgctxt "webhooks"
msgid "Secret copied"
msgstr "Gizli açar kopyalandı"

msgctxt "webhooks"
msgid "Unable to copy secret"
msgstr "Gizli açarı kopyalamaq mümkün olmadı"

msgctxt "webhooks"
