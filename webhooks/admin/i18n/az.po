msgid "Copy this secret now. It will not be shown again."
msgstr "Bu gizli açarı indi kopyalayın. O, bir daha göstərilməyəcək."

msgctxt "webhooks"
msgid "Active"
msgstr "Aktiv"

msgctxt "webhooks"
msgid ""
"Inactive webhooks receive no events and their queued deliveries are dropped"
msgstr ""
"Qeyri-aktiv webhook-lar hadisə qəbul etmir və onların növbədəki "
"çatdırılmaları ləğv edilir"

msgctxt "webhooks"
msgid "HTTPS endpoint URL"
msgstr "HTTPS son nöqtəsinin URL-i"

