msgstr "เกิดข้อผิดพลาดขณะดึงเว็บฮุก"

msgctxt "webhooks"
msgid "Test event delivered (%{status})"
msgstr "ส่งเหตุการณ์ทดสอบแล้ว (%{status})"

msgctxt "webhooks"
msgid "Test event failed: %{reason}"
msgstr "เหตุการณ์ทดสอบล้มเหลว: %{reason}"

msgctxt "webhooks"
msgid "Test event failed"
msgstr "เหตุการณ์ทดสอบล้มเหลว"

msgctxt "webhooks"
