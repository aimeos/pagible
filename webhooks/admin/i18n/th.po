msgctxt "webhooks"
msgid "Secret copied"
msgstr "คัดลอกข้อมูลลับแล้ว"

msgctxt "webhooks"
msgid "Unable to copy secret"
msgstr "ไม่สามารถคัดลอกข้อมูลลับได้"

msgctxt "webhooks"
msgid "Webhook secret"
msgstr "ข้อมูลลับของเว็บฮุก"

msgctxt "webhooks"
msgid "Edit webhook"
msgstr "แก้ไขเว็บฮุก"

msgctxt "webhooks"
msgid "Add webhook"
msgstr "เพิ่มเว็บฮุก"

msgctxt "webhooks"
msgid "Copy this secret now. It will not be shown again."
msgstr "คัดลอกข้อมูลลับนี้ตอนนี้ ระบบจะไม่แสดงอีก"

msgctxt "webhooks"
msgid "Active"
msgstr "ใช้งานอยู่"

msgctxt "webhooks"
msgid ""
"Inactive webhooks receive no events and their queued deliveries are dropped"
msgstr "เว็บฮุกที่ไม่ได้ใช้งานจะไม่ได้รับเหตุการณ์ใด ๆ และการส่งที่ค้างอยู่ในคิวจะถูกยกเลิก"

msgctxt "webhooks"
msgid "HTTPS endpoint URL"
msgstr "URL ปลายทาง HTTPS"

msgctxt "webhooks"
msgid "Address receiving the signed events, it cannot be changed later"
msgstr "ที่อยู่ที่รับเหตุการณ์ที่มีลายเซ็น ไม่สามารถเปลี่ยนแปลงได้ภายหลัง"

msgctxt "webhooks"
msgid "Not a valid URL"
msgstr "ไม่ใช่ URL ที่ถูกต้อง"

msgctxt "webhooks"
msgid "Events"
msgstr "เหตุการณ์"

msgctxt "webhooks"
msgid ""
"Events sent to the webhook, queued deliveries of removed events are cancelled"
msgstr "เหตุการณ์ที่ส่งไปยังเว็บฮุก การส่งที่ค้างอยู่ในคิวของเหตุการณ์ที่ถูกลบจะถูกยกเลิก"

msgctxt "webhooks"
msgid "Name"
msgstr "ชื่อ"

msgctxt "webhooks"
msgid ""
"Optional name to tell webhooks with the same endpoint apart, visible to all "
"webhook editors"
msgstr ""
"ชื่อที่ไม่บังคับสำหรับแยกความแตกต่างของเว็บฮุกที่มีปลายทางเดียวกัน มองเห็นได้โดยผู้แก้ไขเว็บฮุกทุกคน"

msgctxt "webhooks"
msgid "Test"
msgstr "ทดสอบ"

msgctxt "webhooks"
msgid "Done"
msgstr "เสร็จแล้ว"

msgctxt "webhooks"
msgid "Copy secret"
msgstr "คัดลอกข้อมูลลับ"

msgctxt "webhooks"
msgid "Cancel"
msgstr "ยกเลิก"

