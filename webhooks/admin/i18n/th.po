msgid "Save"
msgstr "บันทึก"

msgctxt "webhooks"
msgid "Webhooks"
msgstr "เว็บฮุก"

msgctxt "webhooks"
msgid "Webhooks are disabled by the server configuration, no events are sent"
msgstr "เว็บฮุกถูกปิดใช้งานโดยการกำหนดค่าเซิร์ฟเวอร์ จึงไม่มีการส่งเหตุการณ์"

msgctxt "webhooks"
msgid "All deliveries are blocked by the server configuration: %{reason}"
msgstr "การส่งทั้งหมดถูกบล็อกโดยการกำหนดค่าเซิร์ฟเวอร์: %{reason}"

msgctxt "webhooks"
msgid "Status"
msgstr "สถานะ"

msgctxt "webhooks"
msgid "All"
msgstr "ทั้งหมด"

msgctxt "webhooks"
