msgstr "Viimeisin onnistuminen: %{date}"

msgctxt "webhooks"
msgid "Last error: %{reason}"
msgstr "Viimeisin virhe: %{reason}"

msgctxt "webhooks"
msgid "Paused until: %{date}"
msgstr "Tauko päättyy: %{date}"

