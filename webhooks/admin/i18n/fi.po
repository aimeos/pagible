msgid "Loading"
msgstr "Ladataan"

msgctxt "webhooks"
msgid "No entries found"
msgstr "Merkintöjä ei löytynyt"

msgctxt "webhooks"
msgid "No webhooks configured."
msgstr "Webhookeja ei ole määritetty."

msgctxt "webhooks"
msgid "Connection failed"
msgstr "Yhteys epäonnistui"

msgctxt "webhooks"
msgid "Access denied"
msgstr "Pääsy evätty"

msgctxt "webhooks"
msgid "Secret can't be decrypted, rotate it"
msgstr "Salaisuuden salausta ei voi purkaa, vaihda salaisuus"

msgctxt "webhooks"
msgid "Invalid list of denied networks"
msgstr "Virheellinen estettyjen verkkojen luettelo"

msgctxt "webhooks"
msgid "Queue unavailable"
msgstr "Jono ei ole käytettävissä"

msgctxt "webhooks"
msgid "Host not found"
msgstr "Isäntää ei löytynyt"

msgctxt "webhooks"
msgid "Response too large"
msgstr "Vastaus on liian suuri"

msgctxt "webhooks"
msgid "Request timed out"
msgstr "Pyyntö aikakatkaistiin"

msgctxt "webhooks"
msgid "Redirects aren't followed"
msgstr "Uudelleenohjauksia ei seurata"

msgctxt "webhooks"
msgid "Delivery failed"
msgstr "Toimitus epäonnistui"

