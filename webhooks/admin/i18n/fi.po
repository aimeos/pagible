msgctxt "webhooks"
msgid "Secret copied"
msgstr "Salaisuus kopioitu"

msgctxt "webhooks"
msgid "Unable to copy secret"
msgstr "Salaisuuden kopiointi epäonnistui"

msgctxt "webhooks"
msgid "Webhook secret"
msgstr "Webhookin salaisuus"

msgctxt "webhooks"
msgid "Edit webhook"
msgstr "Muokkaa webhookia"

msgctxt "webhooks"
msgid "Add webhook"
msgstr "Lisää webhook"

msgctxt "webhooks"
msgid "Copy this secret now. It will not be shown again."
msgstr "Kopioi tämä salaisuus nyt. Sitä ei näytetä uudelleen."

msgctxt "webhooks"
msgid "Active"
msgstr "Aktiivinen"

msgctxt "webhooks"
msgid ""
"Inactive webhooks receive no events and their queued deliveries are dropped"
msgstr ""
"Ei-aktiiviset webhookit eivät vastaanota tapahtumia, ja niiden jonossa "
"olevat toimitukset hylätään"

msgctxt "webhooks"
msgid "HTTPS endpoint URL"
msgstr "HTTPS-päätepisteen URL-osoite"

msgctxt "webhooks"
msgid "Address receiving the signed events, it cannot be changed later"
msgstr ""
"Osoite, joka vastaanottaa allekirjoitetut tapahtumat, sitä ei voi muuttaa "
"myöhemmin"

msgctxt "webhooks"
msgid "Not a valid URL"
msgstr "Virheellinen URL-osoite"

msgctxt "webhooks"
msgid "Events"
msgstr "Tapahtumat"

msgctxt "webhooks"
msgid ""
"Events sent to the webhook, queued deliveries of removed events are cancelled"
msgstr ""
"Webhookiin lähetetyt tapahtumat, poistettujen tapahtumien jonossa olevat "
"toimitukset peruutetaan"

msgctxt "webhooks"
msgid "Name"
msgstr "Nimi"

msgctxt "webhooks"
msgid ""
"Optional name to tell webhooks with the same endpoint apart, visible to all "
"webhook editors"
msgstr ""
"Valinnainen nimi, jolla erottaa saman päätepisteen webhookit toisistaan, "
"näkyy kaikille webhookien muokkaajille"

msgctxt "webhooks"
msgid "Test"
msgstr "Testaa"

msgctxt "webhooks"
msgid "Done"
msgstr "Valmis"

msgctxt "webhooks"
msgid "Copy secret"
msgstr "Kopioi salaisuus"

msgctxt "webhooks"
msgid "Cancel"
msgstr "Peruuta"

msgctxt "webhooks"
msgid "Save"
msgstr "Tallenna"

msgctxt "webhooks"
msgid "Webhooks"
msgstr "Webhookit"

msgctxt "webhooks"
msgid "Webhooks are disabled by the server configuration, no events are sent"
msgstr ""
"Palvelimen määritys on poistanut webhookit käytöstä, tapahtumia ei lähetetä"

msgctxt "webhooks"
msgid "All deliveries are blocked by the server configuration: %{reason}"
msgstr "Palvelimen määritys estää kaikki toimitukset: %{reason}"

msgctxt "webhooks"
msgid "Status"
msgstr "Tila"

msgctxt "webhooks"
msgid "All"
msgstr "Kaikki"

msgctxt "webhooks"
msgid "Inactive"
msgstr "Ei-aktiivinen"

msgctxt "webhooks"
msgid "None"
msgstr "Ei mitään"

msgctxt "webhooks"
msgid "%{reason} · %{date}"
msgstr "%{reason} · %{date}"

msgctxt "webhooks"
msgid "Error fetching webhooks"
msgstr "Virhe webhookien noutamisessa"

msgctxt "webhooks"
msgid "Test event delivered (%{status})"
msgstr "Testitapahtuma toimitettu (%{status})"

msgctxt "webhooks"
msgid "Test event failed: %{reason}"
msgstr "Testitapahtuma epäonnistui: %{reason}"

msgctxt "webhooks"
msgid "Test event failed"
msgstr "Testitapahtuma epäonnistui"

msgctxt "webhooks"
msgid "Error purging webhook"
msgstr "Virhe webhookin pysyvässä poistamisessa"

msgctxt "webhooks"
msgid ""
"The new webhook secret could not be shown after leaving the page, please "
"rotate it to get a new one"
msgstr ""
"Uutta webhookin salaisuutta ei voitu näyttää sivulta poistumisen jälkeen, "
"vaihda se saadaksesi uuden"

msgctxt "webhooks"
msgid ""
"Rotate the secret of this webhook? Receivers must be updated with the new "
"secret."
msgstr ""
"Vaihdetaanko tämän webhookin salaisuus? Vastaanottajat on päivitettävä "
"käyttämään uutta salaisuutta."

msgctxt "webhooks"
msgid "Rotate"
msgstr "Vaihda"

msgctxt "webhooks"
msgid "Error rotating webhook secret"
msgstr "Virhe webhookin salaisuuden vaihtamisessa"

msgctxt "webhooks"
msgid "Error saving webhook"
msgstr "Virhe webhookin tallentamisessa"

msgctxt "webhooks"
msgid "Send signed notifications when published content changes."
msgstr "Lähetä allekirjoitettuja ilmoituksia, kun julkaistu sisältö muuttuu."

msgctxt "webhooks"
msgid "Toggle selection"
msgstr "Vaihda valintaa"

msgctxt "webhooks"
msgid "Purge (%{count})"
msgstr "Poista pysyvästi (%{count})"

msgctxt "webhooks"
msgid "Search for"
msgstr "Etsi"

