msgstr "Webhookai išjungti serverio konfigūracijoje, įvykiai nesiunčiami"

msgctxt "webhooks"
msgid "All deliveries are blocked by the server configuration: %{reason}"
msgstr "Visi pristatymai užblokuoti serverio konfigūracijoje: %{reason}"

