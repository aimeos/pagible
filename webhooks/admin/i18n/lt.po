msgctxt "webhooks"
msgid "Secret copied"
msgstr "Slaptasis raktas nukopijuotas"

msgctxt "webhooks"
msgid "Unable to copy secret"
msgstr "Nepavyko nukopijuoti slaptojo rakto"

msgctxt "webhooks"
msgid "Webhook secret"
msgstr "Webhooko slaptasis raktas"

msgctxt "webhooks"
msgid "Edit webhook"
msgstr "Redaguoti webhooką"

msgctxt "webhooks"
msgid "Add webhook"
msgstr "Pridėti webhooką"

msgctxt "webhooks"
msgid "Copy this secret now. It will not be shown again."
msgstr "Nukopijuokite šį slaptąjį raktą dabar. Jis daugiau nebus rodomas."

msgctxt "webhooks"
msgid "Active"
msgstr "Aktyvus"

msgctxt "webhooks"
msgid ""
"Inactive webhooks receive no events and their queued deliveries are dropped"
msgstr ""
"Neaktyvūs webhookai negauna jokių įvykių, o jų laukiantys pristatymai "
"atmetami"

msgctxt "webhooks"
msgid "HTTPS endpoint URL"
msgstr "HTTPS galinio taško URL"

msgctxt "webhooks"
msgid "Address receiving the signed events, it cannot be changed later"
msgstr "Adresas, gaunantis pasirašytus įvykius, vėliau negali būti keičiamas"

msgctxt "webhooks"
msgid "Not a valid URL"
msgstr "Netinkamas URL adresas"

msgctxt "webhooks"
msgid "Events"
msgstr "Įvykiai"

msgctxt "webhooks"
msgid ""
"Events sent to the webhook, queued deliveries of removed events are cancelled"
msgstr ""
"Webhookui siunčiami įvykiai, pašalintų įvykių laukiantys pristatymai "
"atšaukiami"

msgctxt "webhooks"
msgid "Name"
msgstr "Pavadinimas"

msgctxt "webhooks"
msgid ""
"Optional name to tell webhooks with the same endpoint apart, visible to all "
"webhook editors"
msgstr ""
"Neprivalomas pavadinimas, skiriantis vienodą galinį tašką turinčius "
"webhookus, matomas visiems webhookų redaktoriams"

msgctxt "webhooks"
msgid "Test"
