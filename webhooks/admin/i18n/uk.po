msgctxt "webhooks"
msgid "Secret copied"
msgstr "Секрет скопійовано"

msgctxt "webhooks"
msgid "Unable to copy secret"
msgstr "Не вдалося скопіювати секрет"

msgctxt "webhooks"
msgid "Webhook secret"
msgstr "Секрет вебхука"

msgctxt "webhooks"
msgid "Edit webhook"
msgstr "Редагувати вебхук"

msgctxt "webhooks"
msgid "Add webhook"
msgstr "Додати вебхук"

msgctxt "webhooks"
msgid "Copy this secret now. It will not be shown again."
msgstr "Скопіюйте цей секрет зараз. Він більше не відображатиметься."

msgctxt "webhooks"
msgid "Active"
msgstr "Активний"

msgctxt "webhooks"
msgid ""
"Inactive webhooks receive no events and their queued deliveries are dropped"
msgstr ""
"Неактивні вебхуки не отримують події, а їхні доставки в черзі скасовуються"

msgctxt "webhooks"
msgid "HTTPS endpoint URL"
msgstr "URL кінцевої точки HTTPS"

msgctxt "webhooks"
msgid "Address receiving the signed events, it cannot be changed later"
msgstr "Адреса, що приймає підписані події, її не можна змінити пізніше"

msgctxt "webhooks"
msgid "Not a valid URL"
msgstr "Недійсна URL-адреса"

msgctxt "webhooks"
msgid "Events"
msgstr "Події"

msgctxt "webhooks"
msgid ""
"Events sent to the webhook, queued deliveries of removed events are cancelled"
msgstr ""
"Події, що надсилаються на вебхук, доставки в черзі для видалених подій "
"скасовуються"

msgctxt "webhooks"
msgid "Name"
msgstr "Назва"

msgctxt "webhooks"
msgid ""
"Optional name to tell webhooks with the same endpoint apart, visible to all "
"webhook editors"
msgstr ""
"Необов'язкова назва для розрізнення вебхуків з однаковою кінцевою точкою, "
"видима всім редакторам вебхуків"

msgctxt "webhooks"
msgid "Test"
msgstr "Перевірити"

msgctxt "webhooks"
msgid "Done"
msgstr "Готово"

msgctxt "webhooks"
msgid "Copy secret"
msgstr "Копіювати секрет"

msgctxt "webhooks"
msgid "Cancel"
msgstr "Скасувати"

msgctxt "webhooks"
msgid "Save"
msgstr "Зберегти"

msgctxt "webhooks"
msgid "Webhooks"
msgstr "Вебхуки"

msgctxt "webhooks"
msgid "Webhooks are disabled by the server configuration, no events are sent"
msgstr "Вебхуки вимкнено конфігурацією сервера, події не надсилаються"

msgctxt "webhooks"
msgid "All deliveries are blocked by the server configuration: %{reason}"
msgstr "Усі доставки заблоковано конфігурацією сервера: %{reason}"

msgctxt "webhooks"
msgid "Status"
msgstr "Статус"

msgctxt "webhooks"
msgid "All"
msgstr "Усі"

msgctxt "webhooks"
msgid "Inactive"
msgstr "Неактивний"

msgctxt "webhooks"
msgid "None"
msgstr "Немає"

