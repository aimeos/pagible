msgid "%{reason} · %{date}"
msgstr "%{reason} · %{date}"

msgctxt "webhooks"
msgid "Error fetching webhooks"
msgstr "Помилка під час отримання вебхуків"

msgctxt "webhooks"
msgid "Test event delivered (%{status})"
msgstr "Тестову подію доставлено (%{status})"

msgctxt "webhooks"
msgid "Test event failed: %{reason}"
msgstr "Помилка тестової події: %{reason}"

msgctxt "webhooks"
msgid "Test event failed"
msgstr "Помилка тестової події"

msgctxt "webhooks"
msgid "Error purging webhook"
msgstr "Помилка під час остаточного видалення вебхука"

msgctxt "webhooks"
msgid ""
"The new webhook secret could not be shown after leaving the page, please "
"rotate it to get a new one"
msgstr ""
"Новий секрет вебхука не вдалося показати після виходу зі сторінки, оновіть "
"його, щоб отримати новий"

msgctxt "webhooks"
msgid ""
"Rotate the secret of this webhook? Receivers must be updated with the new "
"secret."
msgstr ""
"Змінити секрет цього вебхука? Отримувачам потрібно передати новий секрет."

msgctxt "webhooks"
msgid "Rotate"
msgstr "Змінити"

msgctxt "webhooks"
msgid "Error rotating webhook secret"
msgstr "Помилка під час зміни секрету вебхука"

msgctxt "webhooks"
msgid "Error saving webhook"
msgstr "Помилка під час збереження вебхука"

msgctxt "webhooks"
msgid "Send signed notifications when published content changes."
msgstr "Надсилати підписані сповіщення, коли опублікований вміст змінюється."

