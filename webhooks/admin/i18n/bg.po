msgid "No webhooks configured."
msgstr "Няма конфигурирани уебхукове."

msgctxt "webhooks"
msgid "Connection failed"
msgstr "Връзката е неуспешна"

msgctxt "webhooks"
msgid "Access denied"
msgstr "Отказан достъп"

msgctxt "webhooks"
msgid "Secret can't be decrypted, rotate it"
msgstr "Тайната не може да се дешифрира, подновете я"

msgctxt "webhooks"
msgid "Invalid list of denied networks"
msgstr "Невалиден списък със забранени мрежи"

msgctxt "webhooks"
msgid "Queue unavailable"
msgstr "Опашката не е достъпна"

msgctxt "webhooks"
msgid "Host not found"
msgstr "Хостът не е намерен"

msgctxt "webhooks"
msgid "Response too large"
msgstr "Отговорът е твърде голям"

msgctxt "webhooks"
msgid "Request timed out"
msgstr "Времето за заявката изтече"

msgctxt "webhooks"
msgid "Redirects aren't followed"
msgstr "Пренасочванията не се следват"

msgctxt "webhooks"
