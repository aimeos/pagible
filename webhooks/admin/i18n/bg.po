msgid "Refresh"
msgstr "Опресняване"

msgctxt "webhooks"
msgid "Edit"
msgstr "Редактиране"

msgctxt "webhooks"
msgid "Purge"
msgstr "Изтриване завинаги"

msgctxt "webhooks"
msgid "Last success: %{date}"
msgstr "Последен успех: %{date}"

msgctxt "webhooks"
msgid "Last error: %{reason}"
msgstr "Последна грешка: %{reason}"

msgctxt "webhooks"
msgid "Paused until: %{date}"
msgstr "Спряно до: %{date}"

