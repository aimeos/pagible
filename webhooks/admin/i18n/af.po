msgid "Copy this secret now. It will not be shown again."
msgstr "Kopieer hierdie geheime sleutel nou. Dit sal nie weer gewys word nie."

msgctxt "webhooks"
msgid "Active"
msgstr "Aktief"

msgctxt "webhooks"
msgid ""
"Inactive webhooks receive no events and their queued deliveries are dropped"
msgstr ""
"Onaktiewe webhooks ontvang geen gebeurtenisse nie en hul aflewerings in die "
"waglys word verwyder"

msgctxt "webhooks"
msgid "HTTPS endpoint URL"
msgstr "HTTPS-eindpunt-URL"

