msgctxt "webhooks"
msgid "Secret copied"
msgstr "Saladus kopeeritud"

msgctxt "webhooks"
msgid "Unable to copy secret"
msgstr "Saladust ei saanud kopeerida"

msgctxt "webhooks"
msgid "Webhook secret"
msgstr "Veebikonksu saladus"

msgctxt "webhooks"
msgid "Edit webhook"
msgstr "Muuda veebikonksu"

