msgid ""
"Events sent to the webhook, queued deliveries of removed events are cancelled"
msgstr ""
"Webhookam sūtītie notikumi, noņemto notikumu gaidošās piegādes tiek atceltas"

msgctxt "webhooks"
msgid "Name"
msgstr "Nosaukums"

