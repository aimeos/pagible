msgstr "Front nie je dostupný"

msgctxt "webhooks"
msgid "Host not found"
msgstr "Hostiteľ sa nenašiel"

msgctxt "webhooks"
msgid "Response too large"
msgstr "Odpoveď je príliš veľká"

msgctxt "webhooks"
msgid "Request timed out"
msgstr "Časový limit požiadavky vypršal"

msgctxt "webhooks"
