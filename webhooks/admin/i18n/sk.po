msgctxt "webhooks"
msgid "Secret copied"
msgstr "Tajný kľúč skopírovaný"

msgctxt "webhooks"
msgid "Unable to copy secret"
msgstr "Tajný kľúč sa nepodarilo skopírovať"

msgctxt "webhooks"
msgid "Webhook secret"
msgstr "Tajný kľúč webhooku"

msgctxt "webhooks"
msgid "Edit webhook"
msgstr "Upraviť webhook"

msgctxt "webhooks"
msgid "Add webhook"
msgstr "Pridať webhook"

msgctxt "webhooks"
msgid "Copy this secret now. It will not be shown again."
msgstr "Skopírujte tento tajný kľúč teraz. Už sa znova nezobrazí."

msgctxt "webhooks"
msgid "Active"
msgstr "Aktívny"

msgctxt "webhooks"
msgid ""
"Inactive webhooks receive no events and their queued deliveries are dropped"
msgstr ""
"Neaktívne webhooky nedostávajú žiadne udalosti a ich čakajúce doručenia sa "
"zahadzujú"

msgctxt "webhooks"
msgid "HTTPS endpoint URL"
msgstr "URL koncového bodu HTTPS"

msgctxt "webhooks"
msgid "Address receiving the signed events, it cannot be changed later"
msgstr "Adresa prijímajúca podpísané udalosti, neskôr ju nemožno zmeniť"

msgctxt "webhooks"
msgid "Not a valid URL"
msgstr "Neplatná adresa URL"

msgctxt "webhooks"
msgid "Events"
msgstr "Udalosti"

msgctxt "webhooks"
msgid ""
"Events sent to the webhook, queued deliveries of removed events are cancelled"
msgstr ""
"Udalosti odosielané na webhook, čakajúce doručenia odstránených udalostí sa "
"rušia"

msgctxt "webhooks"
msgid "Name"
msgstr "Názov"

msgctxt "webhooks"
msgid ""
"Optional name to tell webhooks with the same endpoint apart, visible to all "
"webhook editors"
msgstr ""
"Voliteľný názov na odlíšenie webhookov s rovnakým koncovým bodom, viditeľný "
"pre všetkých editorov webhookov"

msgctxt "webhooks"
msgid "Test"
msgstr "Otestovať"

msgctxt "webhooks"
msgid "Done"
msgstr "Hotovo"

msgctxt "webhooks"
msgid "Copy secret"
msgstr "Kopírovať tajný kľúč"

msgctxt "webhooks"
msgid "Cancel"
msgstr "Zrušiť"

msgctxt "webhooks"
msgid "Save"
msgstr "Uložiť"

msgctxt "webhooks"
msgid "Webhooks"
msgstr "Webhooky"

msgctxt "webhooks"
msgid "Webhooks are disabled by the server configuration, no events are sent"
msgstr ""
"Webhooky sú zakázané konfiguráciou servera, neodosielajú sa žiadne udalosti"

msgctxt "webhooks"
msgid "All deliveries are blocked by the server configuration: %{reason}"
msgstr "Všetky doručenia sú blokované konfiguráciou servera: %{reason}"

msgctxt "webhooks"
msgid "Status"
msgstr "Stav"

msgctxt "webhooks"
msgid "All"
msgstr "Všetky"

msgctxt "webhooks"
msgid "Inactive"
msgstr "Neaktívny"

msgctxt "webhooks"
msgid "None"
msgstr "Žiadne"

msgctxt "webhooks"
msgid "%{reason} · %{date}"
msgstr "%{reason} · %{date}"

msgctxt "webhooks"
msgid "Error fetching webhooks"
msgstr "Chyba pri načítaní webhookov"

msgctxt "webhooks"
msgid "Test event delivered (%{status})"
msgstr "Testovacia udalosť doručená (%{status})"

msgctxt "webhooks"
msgid "Test event failed: %{reason}"
msgstr "Testovacia udalosť zlyhala: %{reason}"

msgctxt "webhooks"
msgid "Test event failed"
msgstr "Testovacia udalosť zlyhala"

msgctxt "webhooks"
msgid "Error purging webhook"
msgstr "Chyba pri trvalom odstraňovaní webhooku"

msgctxt "webhooks"
msgid ""
"The new webhook secret could not be shown after leaving the page, please "
"rotate it to get a new one"
msgstr ""
"Nový tajný kľúč webhooku sa po opustení stránky nepodarilo zobraziť, obnovte "
"ho a získajte nový"

msgctxt "webhooks"
msgid ""
"Rotate the secret of this webhook? Receivers must be updated with the new "
"secret."
msgstr ""
"Zmeniť tajný kľúč tohto webhooku? Príjemcovia musia byť aktualizovaní novým "
"tajným kľúčom."

msgctxt "webhooks"
msgid "Rotate"
msgstr "Zmeniť kľúč"

msgctxt "webhooks"
msgid "Error rotating webhook secret"
msgstr "Chyba pri zmene tajného kľúča webhooku"

msgctxt "webhooks"
msgid "Error saving webhook"
msgstr "Chyba pri ukladaní webhooku"

msgctxt "webhooks"
msgid "Send signed notifications when published content changes."
msgstr "Odosielať podpísané oznámenia pri zmene publikovaného obsahu."

msgctxt "webhooks"
msgid "Toggle selection"
msgstr "Prepnúť výber"

