msgctxt "webhooks"
msgid "Secret copied"
msgstr "Titkos kulcs másolva"

msgctxt "webhooks"
msgid "Unable to copy secret"
msgstr "A titkos kulcs nem másolható"

msgctxt "webhooks"
msgid "Webhook secret"
msgstr "Webhook titkos kulcsa"

msgctxt "webhooks"
msgid "Edit webhook"
msgstr "Webhook szerkesztése"

msgctxt "webhooks"
msgid "Add webhook"
msgstr "Webhook hozzáadása"

msgctxt "webhooks"
msgid "Copy this secret now. It will not be shown again."
msgstr "Másolja ki most ezt a titkos kulcsot. Többé nem jelenik meg."

msgctxt "webhooks"
msgid "Active"
msgstr "Aktív"

msgctxt "webhooks"
msgid ""
"Inactive webhooks receive no events and their queued deliveries are dropped"
msgstr ""
"Az inaktív webhookok nem kapnak eseményeket, és a várakozó kézbesítéseik "
"elvesznek"

msgctxt "webhooks"
msgid "HTTPS endpoint URL"
msgstr "HTTPS-végpont URL-címe"

msgctxt "webhooks"
msgid "Address receiving the signed events, it cannot be changed later"
msgstr "A cím, amely fogadja az aláírt eseményeket, később nem módosítható"

msgctxt "webhooks"
msgid "Not a valid URL"
msgstr "Nem érvényes URL"

msgctxt "webhooks"
msgid "Events"
msgstr "Események"

msgctxt "webhooks"
msgid ""
"Events sent to the webhook, queued deliveries of removed events are cancelled"
msgstr ""
"A webhooknak küldött események, az eltávolított események várakozó "
"kézbesítései visszavonásra kerülnek"

msgctxt "webhooks"
msgid "Name"
msgstr "Név"

msgctxt "webhooks"
msgid ""
"Optional name to tell webhooks with the same endpoint apart, visible to all "
"webhook editors"
msgstr ""
"Opcionális név az azonos végponttal rendelkező webhookok "
"megkülönböztetésére, minden webhook-szerkesztő számára látható"

msgctxt "webhooks"
msgid "Test"
msgstr "Teszt"

msgctxt "webhooks"
msgid "Done"
msgstr "Kész"

msgctxt "webhooks"
msgid "Copy secret"
msgstr "Titkos kulcs másolása"

msgctxt "webhooks"
msgid "Cancel"
msgstr "Mégse"

msgctxt "webhooks"
msgid "Save"
msgstr "Mentés"

msgctxt "webhooks"
msgid "Webhooks"
msgstr "Webhookok"

msgctxt "webhooks"
msgid "Webhooks are disabled by the server configuration, no events are sent"
msgstr ""
"A webhookokat a szerverkonfiguráció letiltotta, nem küldünk eseményeket"

msgctxt "webhooks"
msgid "All deliveries are blocked by the server configuration: %{reason}"
msgstr "A szerverkonfiguráció minden kézbesítést blokkol: %{reason}"

msgctxt "webhooks"
msgid "Status"
msgstr "Állapot"

msgctxt "webhooks"
msgid "All"
msgstr "Összes"

msgctxt "webhooks"
msgid "Inactive"
msgstr "Inaktív"

