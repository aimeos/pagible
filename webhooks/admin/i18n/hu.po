msgctxt "webhooks"
msgid "Error fetching webhooks"
msgstr "Hiba a webhookok lekérésekor"

msgctxt "webhooks"
msgid "Test event delivered (%{status})"
msgstr "Tesztesemény kézbesítve (%{status})"

msgctxt "webhooks"
msgid "Test event failed: %{reason}"
msgstr "A tesztesemény sikertelen: %{reason}"

msgctxt "webhooks"
msgid "Test event failed"
msgstr "A tesztesemény sikertelen"

msgctxt "webhooks"
msgid "Error purging webhook"
msgstr "Hiba a webhook végleges törlésekor"

msgctxt "webhooks"
msgid ""
"The new webhook secret could not be shown after leaving the page, please "
"rotate it to get a new one"
msgstr ""
"Az új webhook-titok nem jeleníthető meg az oldal elhagyása után, kérjük, "
"cserélje le, hogy újat kapjon"

msgctxt "webhooks"
msgid ""
"Rotate the secret of this webhook? Receivers must be updated with the new "
"secret."
msgstr ""
"Lecseréli a webhook titkos kulcsát? A fogadókat frissíteni kell az új titkos "
"kulccsal."

msgctxt "webhooks"
msgid "Rotate"
msgstr "Kulcscsere"

msgctxt "webhooks"
msgid "Error rotating webhook secret"
msgstr "Hiba a webhook titkos kulcsának cseréjekor"

msgctxt "webhooks"
