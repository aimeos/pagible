msgctxt "webhooks"
msgid "Secret copied"
msgstr "Đã sao chép khóa bí mật"

msgctxt "webhooks"
msgid "Unable to copy secret"
msgstr "Không thể sao chép khóa bí mật"

msgctxt "webhooks"
msgid "Webhook secret"
msgstr "Khóa bí mật webhook"

msgctxt "webhooks"
msgid "Edit webhook"
msgstr "Chỉnh sửa webhook"

msgctxt "webhooks"
msgid "Add webhook"
msgstr "Thêm webhook"

msgctxt "webhooks"
msgid "Copy this secret now. It will not be shown again."
msgstr "Hãy sao chép khóa bí mật này ngay. Khóa sẽ không được hiển thị lại."

msgctxt "webhooks"
msgid "Active"
msgstr "Hoạt động"

msgctxt "webhooks"
msgid ""
"Inactive webhooks receive no events and their queued deliveries are dropped"
msgstr ""
"Webhook không hoạt động sẽ không nhận sự kiện nào và các lượt gửi đang chờ "
"trong hàng đợi sẽ bị hủy"

msgctxt "webhooks"
msgid "HTTPS endpoint URL"
msgstr "URL điểm cuối HTTPS"

msgctxt "webhooks"
msgid "Address receiving the signed events, it cannot be changed later"
msgstr "Địa chỉ nhận các sự kiện đã ký, không thể thay đổi sau này"

msgctxt "webhooks"
msgid "Not a valid URL"
msgstr "Đây không phải là một URL hợp lệ."

msgctxt "webhooks"
msgid "Events"
msgstr "Sự kiện"

msgctxt "webhooks"
msgid ""
"Events sent to the webhook, queued deliveries of removed events are cancelled"
msgstr ""
"Các sự kiện được gửi đến webhook, các lượt gửi đang chờ của sự kiện đã xóa "
"sẽ bị hủy"

msgctxt "webhooks"
msgid "Name"
msgstr "Tên"

msgctxt "webhooks"
msgid ""
"Optional name to tell webhooks with the same endpoint apart, visible to all "
"webhook editors"
msgstr ""
"Tên tùy chọn để phân biệt các webhook có cùng điểm cuối, hiển thị với tất cả "
"người chỉnh sửa webhook"

msgctxt "webhooks"
msgid "Test"
msgstr "Kiểm tra"

msgctxt "webhooks"
msgid "Done"
msgstr "Xong"

msgctxt "webhooks"
msgid "Copy secret"
msgstr "Sao chép khóa bí mật"

msgctxt "webhooks"
msgid "Cancel"
msgstr "Hủy"

msgctxt "webhooks"
msgid "Save"
msgstr "Lưu"

msgctxt "webhooks"
msgid "Webhooks"
msgstr "Webhook"

msgctxt "webhooks"
msgid "Webhooks are disabled by the server configuration, no events are sent"
msgstr "Webhook bị tắt bởi cấu hình máy chủ, không có sự kiện nào được gửi"

msgctxt "webhooks"
msgid "All deliveries are blocked by the server configuration: %{reason}"
msgstr "Mọi lượt gửi đều bị chặn bởi cấu hình máy chủ: %{reason}"

msgctxt "webhooks"
msgid "Status"
msgstr "Trạng thái"

msgctxt "webhooks"
msgid "All"
msgstr "Tất cả"

msgctxt "webhooks"
msgid "Inactive"
msgstr "Không hoạt động"

msgctxt "webhooks"
msgid "None"
msgstr "Không có"

msgctxt "webhooks"
msgid "%{reason} · %{date}"
msgstr "%{reason} · %{date}"

msgctxt "webhooks"
msgid "Error fetching webhooks"
msgstr "Lỗi khi tải webhook"

msgctxt "webhooks"
msgid "Test event delivered (%{status})"
msgstr "Đã gửi sự kiện thử nghiệm (%{status})"

msgctxt "webhooks"
msgid "Test event failed: %{reason}"
msgstr "Sự kiện thử nghiệm thất bại: %{reason}"

msgctxt "webhooks"
msgid "Test event failed"
msgstr "Sự kiện thử nghiệm thất bại"

msgctxt "webhooks"
msgid "Error purging webhook"
msgstr "Lỗi khi xóa webhook vĩnh viễn"

msgctxt "webhooks"
msgid ""
"The new webhook secret could not be shown after leaving the page, please "
"rotate it to get a new one"
msgstr ""
"Không thể hiển thị khóa bí mật webhook mới sau khi rời trang, vui lòng xoay "
"vòng để nhận khóa mới"

msgctxt "webhooks"
msgid ""
"Rotate the secret of this webhook? Receivers must be updated with the new "
"secret."
msgstr ""
"Làm mới khóa bí mật của webhook này? Các bên nhận phải được cập nhật khóa bí "
"mật mới."

msgctxt "webhooks"
msgid "Rotate"
msgstr "Đổi khóa"

msgctxt "webhooks"
msgid "Error rotating webhook secret"
msgstr "Lỗi khi làm mới khóa bí mật webhook"

msgctxt "webhooks"
msgid "Error saving webhook"
msgstr "Lỗi khi lưu webhook"

msgctxt "webhooks"
msgid "Send signed notifications when published content changes."
msgstr "Gửi thông báo có chữ ký khi nội dung đã xuất bản thay đổi."

msgctxt "webhooks"
msgid "Toggle selection"
msgstr "Chuyển đổi lựa chọn"

msgctxt "webhooks"
msgid "Purge (%{count})"
msgstr "Xóa vĩnh viễn (%{count})"

msgctxt "webhooks"
msgid "Search for"
msgstr "Tìm kiếm"

msgctxt "webhooks"
msgid "Refresh"
msgstr "Làm mới"

msgctxt "webhooks"
msgid "Edit"
msgstr "Chỉnh sửa"

msgctxt "webhooks"
msgid "Purge"
msgstr "Xóa vĩnh viễn"

msgctxt "webhooks"
msgid "Last success: %{date}"
msgstr "Lần thành công gần nhất: %{date}"

msgctxt "webhooks"
msgid "Last error: %{reason}"
msgstr "Lỗi gần nhất: %{reason}"

msgctxt "webhooks"
msgid "Paused until: %{date}"
msgstr "Tạm dừng đến: %{date}"

msgctxt "webhooks"
msgid "Loading"
msgstr "Đang tải"

msgctxt "webhooks"
msgid "No entries found"
msgstr "Không tìm thấy kết quả nào."

msgctxt "webhooks"
msgid "No webhooks configured."
msgstr "Chưa cấu hình webhook nào."

msgctxt "webhooks"
msgid "Connection failed"
msgstr "Kết nối thất bại"

msgctxt "webhooks"
msgid "Access denied"
msgstr "Truy cập bị từ chối"

msgctxt "webhooks"
msgid "Secret can't be decrypted, rotate it"
msgstr "Không thể giải mã khóa bí mật, hãy làm mới"

msgctxt "webhooks"
msgid "Invalid list of denied networks"
msgstr "Danh sách mạng bị từ chối không hợp lệ"

msgctxt "webhooks"
msgid "Queue unavailable"
msgstr "Hàng đợi không khả dụng"

msgctxt "webhooks"
msgid "Host not found"
msgstr "Không tìm thấy máy chủ"

msgctxt "webhooks"
msgid "Response too large"
msgstr "Phản hồi quá lớn"

msgctxt "webhooks"
msgid "Request timed out"
msgstr "Yêu cầu đã hết thời gian chờ"

msgctxt "webhooks"
msgid "Redirects aren't followed"
msgstr "Không theo chuyển hướng"

msgctxt "webhooks"
msgid "Delivery failed"
msgstr "Gửi thất bại"

