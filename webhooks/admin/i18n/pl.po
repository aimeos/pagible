msgctxt "webhooks"
msgid "Secret copied"
msgstr "Klucz tajny skopiowany"

msgctxt "webhooks"
msgid "Unable to copy secret"
msgstr "Nie można skopiować klucza tajnego"

msgctxt "webhooks"
msgid "Webhook secret"
msgstr "Klucz tajny webhooka"

msgctxt "webhooks"
msgid "Edit webhook"
msgstr "Edytuj webhook"

msgctxt "webhooks"
msgid "Add webhook"
msgstr "Dodaj webhook"

msgctxt "webhooks"
msgid "Copy this secret now. It will not be shown again."
msgstr "Skopiuj ten klucz tajny teraz. Nie zostanie wyświetlony ponownie."

msgctxt "webhooks"
msgid "Active"
msgstr "Aktywny"

msgctxt "webhooks"
msgid ""
"Inactive webhooks receive no events and their queued deliveries are dropped"
msgstr ""
"Nieaktywne webhooki nie otrzymują żadnych zdarzeń, a ich oczekujące "
"dostarczenia są odrzucane"

msgctxt "webhooks"
msgid "HTTPS endpoint URL"
msgstr "Adres URL punktu końcowego HTTPS"

msgctxt "webhooks"
msgid "Address receiving the signed events, it cannot be changed later"
msgstr "Adres odbierający podpisane zdarzenia, nie można go później zmienić"

msgctxt "webhooks"
msgid "Not a valid URL"
msgstr "Nieprawidłowy adres URL"

msgctxt "webhooks"
msgid "Events"
msgstr "Zdarzenia"

msgctxt "webhooks"
msgid ""
"Events sent to the webhook, queued deliveries of removed events are cancelled"
msgstr ""
"Zdarzenia wysyłane do webhooka, oczekujące dostarczenia usuniętych zdarzeń "
"są anulowane"

msgctxt "webhooks"
msgid "Name"
msgstr "Nazwa"

msgctxt "webhooks"
msgid ""
"Optional name to tell webhooks with the same endpoint apart, visible to all "
"webhook editors"
msgstr ""
"Opcjonalna nazwa pozwalająca odróżnić webhooki z tym samym punktem końcowym, "
"widoczna dla wszystkich edytorów webhooków"

msgctxt "webhooks"
msgid "Test"
msgstr "Testuj"

msgctxt "webhooks"
msgid "Done"
msgstr "Gotowe"

msgctxt "webhooks"
msgid "Copy secret"
msgstr "Kopiuj klucz tajny"

msgctxt "webhooks"
msgid "Cancel"
msgstr "Anuluj"

msgctxt "webhooks"
msgid "Save"
msgstr "Zapisz"

msgctxt "webhooks"
msgid "Webhooks"
msgstr "Webhooki"

msgctxt "webhooks"
msgid "Webhooks are disabled by the server configuration, no events are sent"
msgstr ""
"Webhooki są wyłączone w konfiguracji serwera, żadne zdarzenia nie są wysyłane"

msgctxt "webhooks"
msgid "All deliveries are blocked by the server configuration: %{reason}"
msgstr ""
"Wszystkie dostarczenia są blokowane przez konfigurację serwera: %{reason}"

msgctxt "webhooks"
msgid "Status"
msgstr "Status"

msgctxt "webhooks"
msgid "All"
msgstr "Wszystkie"

msgctxt "webhooks"
