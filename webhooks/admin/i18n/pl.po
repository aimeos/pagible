msgstr "Błąd podczas pobierania webhooków"

msgctxt "webhooks"
msgid "Test event delivered (%{status})"
msgstr "Zdarzenie testowe dostarczone (%{status})"

msgctxt "webhooks"
msgid "Test event failed: %{reason}"
msgstr "Zdarzenie testowe nie powiodło się: %{reason}"

msgctxt "webhooks"
msgid "Test event failed"
msgstr "Zdarzenie testowe nie powiodło się"

msgctxt "webhooks"
msgid "Error purging webhook"
msgstr "Błąd podczas trwałego usuwania webhooka"

msgctxt "webhooks"
msgid ""
"The new webhook secret could not be shown after leaving the page, please "
"rotate it to get a new one"
msgstr ""
"Nowego sekretu webhooka nie można było wyświetlić po opuszczeniu strony, "
"odnów go, aby otrzymać nowy"

msgctxt "webhooks"
msgid ""
"Rotate the secret of this webhook? Receivers must be updated with the new "
"secret."
msgstr ""
"Odnowić klucz tajny tego webhooka? Odbiorcy muszą zostać zaktualizowani "
"nowym kluczem tajnym."

msgctxt "webhooks"
msgid "Rotate"
msgstr "Odnów"

msgctxt "webhooks"
msgid "Error rotating webhook secret"
msgstr "Błąd podczas odnawiania klucza tajnego webhooka"

msgctxt "webhooks"
