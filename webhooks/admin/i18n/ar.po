msgstr "قائمة الشبكات المحظورة غير صالحة"

msgctxt "webhooks"
msgid "Queue unavailable"
msgstr "قائمة الانتظار غير متاحة"

msgctxt "webhooks"
msgid "Host not found"
msgstr "لم يتم العثور على المضيف"

msgctxt "webhooks"
msgid "Response too large"
msgstr "الاستجابة كبيرة جدًا"

msgctxt "webhooks"
msgid "Request timed out"
msgstr "انتهت مهلة الطلب"

msgctxt "webhooks"
