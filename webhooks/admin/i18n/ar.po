msgstr "آخر نجاح: %{date}"

msgctxt "webhooks"
msgid "Last error: %{reason}"
msgstr "الخطأ الأخير: %{reason}"

msgctxt "webhooks"
msgid "Paused until: %{date}"
msgstr "متوقف مؤقتًا حتى: %{date}"

