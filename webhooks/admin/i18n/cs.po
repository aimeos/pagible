msgctxt "webhooks"
msgid "Secret copied"
msgstr "Tajný klíč zkopírován"

msgctxt "webhooks"
msgid "Unable to copy secret"
msgstr "Tajný klíč nelze zkopírovat"

msgctxt "webhooks"
msgid "Webhook secret"
msgstr "Tajný klíč webhooku"

msgctxt "webhooks"
msgid "Edit webhook"
msgstr "Upravit webhook"

msgctxt "webhooks"
msgid "Add webhook"
msgstr "Přidat webhook"

msgctxt "webhooks"
msgid "Copy this secret now. It will not be shown again."
msgstr "Zkopírujte tento tajný klíč nyní. Již se znovu nezobrazí."

msgctxt "webhooks"
msgid "Active"
msgstr "Aktivní"

msgctxt "webhooks"
msgid ""
"Inactive webhooks receive no events and their queued deliveries are dropped"
msgstr ""
"Neaktivní webhooky nedostávají žádné události a jejich čekající doručení se "
"zahazují"

msgctxt "webhooks"
msgid "HTTPS endpoint URL"
msgstr "URL koncového bodu HTTPS"

msgctxt "webhooks"
msgid "Address receiving the signed events, it cannot be changed later"
msgstr "Adresa přijímající podepsané události, později ji nelze změnit"

msgctxt "webhooks"
msgid "Not a valid URL"
msgstr "Neplatná adresa URL"

msgctxt "webhooks"
msgid "Events"
msgstr "Události"

msgctxt "webhooks"
msgid ""
"Events sent to the webhook, queued deliveries of removed events are cancelled"
msgstr ""
"Události odesílané webhooku, čekající doručení odebraných událostí se ruší"

msgctxt "webhooks"
msgid "Name"
msgstr "Název"

msgctxt "webhooks"
msgid ""
"Optional name to tell webhooks with the same endpoint apart, visible to all "
"webhook editors"
msgstr ""
"Volitelný název pro odlišení webhooků se stejným koncovým bodem, viditelný "
"pro všechny editory webhooků"

msgctxt "webhooks"
msgid "Test"
msgstr "Otestovat"

msgctxt "webhooks"
msgid "Done"
msgstr "Hotovo"

msgctxt "webhooks"
msgid "Copy secret"
