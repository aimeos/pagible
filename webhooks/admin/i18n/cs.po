msgctxt "webhooks"
msgid "Save"
msgstr "Uložit"

msgctxt "webhooks"
msgid "Webhooks"
msgstr "Webhooky"

msgctxt "webhooks"
msgid "Webhooks are disabled by the server configuration, no events are sent"
msgstr ""
"Webhooky jsou zakázány konfigurací serveru, žádné události se neodesílají"

msgctxt "webhooks"
msgid "All deliveries are blocked by the server configuration: %{reason}"
msgstr "Všechna doručení jsou blokována konfigurací serveru: %{reason}"

