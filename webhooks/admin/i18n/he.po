msgctxt "webhooks"
msgid "Test event delivered (%{status})"
msgstr "אירוע הבדיקה נמסר (%{status})"

msgctxt "webhooks"
msgid "Test event failed: %{reason}"
msgstr "אירוע הבדיקה נכשל: %{reason}"

msgctxt "webhooks"
msgid "Test event failed"
msgstr "אירוע הבדיקה נכשל"

