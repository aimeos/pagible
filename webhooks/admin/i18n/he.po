msgid ""
"The new webhook secret could not be shown after leaving the page, please "
"rotate it to get a new one"
msgstr ""
"לא ניתן היה להציג את הסוד החדש של ה-webhook לאחר עזיבת הדף, החליפו אותו כדי "
"לקבל סוד חדש"

msgctxt "webhooks"
msgid ""
"Rotate the secret of this webhook? Receivers must be updated with the new "
"secret."
msgstr "להחליף את הסוד של ה-Webhook הזה? יש לעדכן את המקבלים בסוד החדש."

msgctxt "webhooks"
msgid "Rotate"
msgstr "החלפת סוד"

msgctxt "webhooks"
msgid "Error rotating webhook secret"
msgstr "שגיאה בהחלפת סוד ה-Webhook"

msgctxt "webhooks"
msgid "Error saving webhook"
msgstr "שגיאה בשמירת Webhook"

msgctxt "webhooks"
