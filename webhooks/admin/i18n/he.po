msgctxt "webhooks"
msgid "Secret copied"
msgstr "הסוד הועתק"

msgctxt "webhooks"
msgid "Unable to copy secret"
msgstr "לא ניתן להעתיק את הסוד"

msgctxt "webhooks"
msgid "Webhook secret"
msgstr "סוד Webhook"

msgctxt "webhooks"
msgid "Edit webhook"
msgstr "עריכת Webhook"

msgctxt "webhooks"
msgid "Add webhook"
msgstr "הוספת Webhook"

msgctxt "webhooks"
msgid "Copy this secret now. It will not be shown again."
msgstr "יש להעתיק את הסוד עכשיו. הוא לא יוצג שוב."

msgctxt "webhooks"
msgid "Active"
msgstr "פעיל"

msgctxt "webhooks"
msgid ""
"Inactive webhooks receive no events and their queued deliveries are dropped"
msgstr ""
"רכיבי Webhook לא פעילים אינם מקבלים אירועים והמסירות הממתינות שלהם נמחקות"

msgctxt "webhooks"
msgid "HTTPS endpoint URL"
msgstr "כתובת URL של נקודת קצה HTTPS"

msgctxt "webhooks"
msgid "Address receiving the signed events, it cannot be changed later"
msgstr "הכתובת המקבלת את האירועים החתומים, לא ניתן לשנות אותה לאחר מכן"

msgctxt "webhooks"
msgid "Not a valid URL"
msgstr "כתובת URL לא חוקית"

msgctxt "webhooks"
msgid "Events"
msgstr "אירועים"

msgctxt "webhooks"
msgid ""
"Events sent to the webhook, queued deliveries of removed events are cancelled"
msgstr "אירועים הנשלחים ל-Webhook, מסירות ממתינות של אירועים שהוסרו מבוטלות"

msgctxt "webhooks"
msgid "Name"
msgstr "שם"

msgctxt "webhooks"
msgid ""
"Optional name to tell webhooks with the same endpoint apart, visible to all "
"webhook editors"
msgstr ""
"שם אופציונלי להבחנה בין רכיבי Webhook בעלי אותה נקודת קצה, גלוי לכל עורכי "
"ה-Webhook"

msgctxt "webhooks"
msgid "Test"
msgstr "בדיקה"

msgctxt "webhooks"
msgid "Done"
msgstr "בוצע"

msgctxt "webhooks"
msgid "Copy secret"
msgstr "העתקת הסוד"

msgctxt "webhooks"
msgid "Cancel"
msgstr "ביטול"

msgctxt "webhooks"
msgid "Save"
msgstr "שמור"

msgctxt "webhooks"
msgid "Webhooks"
msgstr "Webhooks"

msgctxt "webhooks"
msgid "Webhooks are disabled by the server configuration, no events are sent"
msgstr "רכיבי Webhook מושבתים על ידי תצורת השרת, לא נשלחים אירועים"

msgctxt "webhooks"
msgid "All deliveries are blocked by the server configuration: %{reason}"
msgstr "כל המסירות חסומות על ידי תצורת השרת: %{reason}"

msgctxt "webhooks"
msgid "Status"
msgstr "סטטוס"

msgctxt "webhooks"
msgid "All"
msgstr "הכל"

msgctxt "webhooks"
