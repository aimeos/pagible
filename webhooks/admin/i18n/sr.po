msgstr "Сервер није пронађен"

msgctxt "webhooks"
msgid "Response too large"
msgstr "Одговор је превелик"

msgctxt "webhooks"
msgid "Request timed out"
msgstr "Истекло је време чекања захтева"

msgctxt "webhooks"
