{
    "name": "aimeos/pagible-cashier",
    "description": "Pagible CMS - Payment integration via Laravel Cashier",
    "keywords": ["laravel", "cms", "cashier", "payments", "stripe", "paddle", "mollie"],
    "homepage": "https://pagible.com",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": "^8.2",
        "aimeos/pagible-core": "0.12.*"
    },
    "suggest": {
        "aimeos/pagible-cashier-stripe": "Stripe payment provider",
        "aimeos/pagible-cashier-paddle": "Paddle payment provider",
        "aimeos/pagible-cashier-mollie": "Mollie payment provider"
    },
    "autoload": {
        "psr-4": {
            "Aimeos\\Cms\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Aimeos\\Cms\\CashierServiceProvider"
            ]
        }
    }
}
