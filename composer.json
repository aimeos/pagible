{
	"name": "aimeos/pagible",
	"description": "Pagible CMS",
	"keywords": ["laravel", "cms", "package", "api", "graphql", "jsonapi", "multi-tenant", "multi-language"],
	"homepage": "https://pagible.com",
	"type": "library",
	"license": "MIT",
	"prefer-stable": true,
	"minimum-stability": "dev",
	"require": {
		"aimeos/pagible-core": "~0.13",
		"aimeos/pagible-admin": "~0.13",
		"aimeos/pagible-ai": "~0.13",
		"aimeos/pagible-graphql": "~0.13",
		"aimeos/pagible-search": "~0.13",
		"aimeos/pagible-jsonapi": "~0.13",
		"aimeos/pagible-mcp": "~0.13",
		"aimeos/pagible-theme": "~0.13"
	},
	"require-dev": {
		"orchestra/testbench": "^10.0||^11.0",
		"laravel/pulse": "^1.7",
		"laravel-json-api/testing": "^3.1",
		"larastan/larastan": "^3.9",
		"friendsofsymfony/http-cache": "^3.2",
		"php-http/guzzle7-adapter": "^1.1",
		"om/potrans": "^1.0.1",
		"kkomelin/laravel-translatable-string-exporter": "^1.26"
	},
	"suggest": {
		"aimeos/pagible-cdn": "For purging changed pages and removed files from CDNs and caching proxies",
		"aimeos/pagible-webhooks": "For signed outbound notifications when CMS content changes"
	},
	"repositories": [
		{"type": "path", "url": "core", "options": {"versions": {"aimeos/pagible-core": "0.13.x-dev"}}},
		{"type": "path", "url": "admin", "options": {"versions": {"aimeos/pagible-admin": "0.13.x-dev"}}},
		{"type": "path", "url": "ai", "options": {"versions": {"aimeos/pagible-ai": "0.13.x-dev"}}},
		{"type": "path", "url": "graphql", "options": {"versions": {"aimeos/pagible-graphql": "0.13.x-dev"}}},
		{"type": "path", "url": "search", "options": {"versions": {"aimeos/pagible-search": "0.13.x-dev"}}},
		{"type": "path", "url": "jsonapi", "options": {"versions": {"aimeos/pagible-jsonapi": "0.13.x-dev"}}},
		{"type": "path", "url": "mcp", "options": {"versions": {"aimeos/pagible-mcp": "0.13.x-dev"}}},
		{"type": "path", "url": "theme", "options": {"versions": {"aimeos/pagible-theme": "0.13.x-dev"}}},
		{"type": "path", "url": "webhooks", "options": {"versions": {"aimeos/pagible-webhooks": "0.13.x-dev"}}},
		{"type": "path", "url": "cdn", "options": {"versions": {"aimeos/pagible-cdn": "0.13.x-dev"}}}
	],
	"autoload": {
		"psr-4": {
			"Aimeos\\Cms\\": ["src/"]
		}
	},
	"autoload-dev": {
		"psr-4": {
			"Aimeos\\Cms\\": [
				"backup/src/",
				"cashier/src/",
				"cdn/src/",
				"import/src/",
				"pulse/src/",
				"themes/glass/src/",
				"themes/estate/src/",
				"themes/journal/src/",
				"themes/news/src/",
				"themes/pagible/src/",
				"themes/paper/src/",
				"themes/bold/src/",
				"themes/premium/src/",
				"themes/luxury/src/",
				"themes/style/src/",
				"themes/taste/src/",
				"webhooks/src/"
			],
			"Tests\\": [
				"tests/",
				"core/tests/",
				"admin/tests/",
				"ai/tests/",
				"cashier/tests/",
				"cdn/tests/",
				"graphql/tests/",
				"import/tests/",
				"jsonapi/tests/",
				"mcp/tests/",
				"pulse/tests/",
				"search/tests/",
				"theme/tests/",
				"themes/estate/tests/",
				"backup/tests/",
				"webhooks/tests/"
			]
		},
		"classmap": [
			"tests/User.php"
		]
	},
	"scripts": {
		"post-autoload-dump": [
			"@php vendor/bin/testbench package:discover --ansi"
		],
		"translate": [
			"@php bin/translate ar bg cs da de el en es et fi fr he hu id it ja lt lv nb nl pl pt-br pt ro ru sk sl sv tr uk vi zh",
			"npm run gettext:extract --prefix admin",
			"mv admin/i18n/no.po admin/i18n/nb.po",
			"for POFILE in `ls admin/i18n/*.po`; do msgattrib --no-obsolete -o $POFILE $POFILE; done",
			"for POFILE in `ls admin/i18n/*.po`; do vendor/bin/potrans deepl --ignore='%\\{[a-z]+\\}' --only --pot=admin/i18n/messages.pot $POFILE; done",
			"mv admin/i18n/nb.po admin/i18n/no.po",
			"npm run gettext:compile --prefix admin"
		],
		"build": [
			"npm run build --prefix admin",
			"npm run build --prefix webhooks/admin"
		],
		"coverage": [
			"npx playwright install chromium",
			"npm run coverage:all"
		]
	},
	"config": {
		"allow-plugins": {
			"php-http/discovery": true
		}
	},
	"extra": {
		"laravel": {
			"providers": [
				"Aimeos\\Cms\\ServiceProvider"
			]
		}
	}
}
