{
	"name": "aimeos/pagible",
	"description": "Pagible CMS",
	"keywords": ["laravel", "cms", "package", "api", "graphql", "jsonapi", "multi-tenant", "multi-language"],
	"homepage": "https://pagible.com",
	"type": "library",
	"license": "MIT",
	"prefer-stable": true,
	"minimum-stability": "dev",
	"require": {
		"aimeos/pagible-core": "dev-master",
		"aimeos/pagible-admin": "dev-master",
		"aimeos/pagible-ai": "dev-master",
		"aimeos/pagible-graphql": "dev-master",
		"aimeos/pagible-search": "dev-master",
		"aimeos/pagible-jsonapi": "dev-master",
		"aimeos/pagible-mcp": "dev-master",
		"aimeos/pagible-metrics": "dev-master",
		"aimeos/pagible-theme": "dev-master"
	},
	"require-dev": {
		"orchestra/testbench": "^10.0||^11.0",
		"laravel/pulse": "^1.7",
		"laravel-json-api/testing": "^3.1",
		"larastan/larastan": "^3.9",
		"friendsofsymfony/http-cache": "^3.2",
		"php-http/guzzle7-adapter": "^1.1",
		"om/potrans": "^1.0.1",
		"kkomelin/laravel-translatable-string-exporter": "^1.26"
	},
	"suggest": {
		"aimeos/pagible-cdn": "For purging changed pages and removed files from CDNs and caching proxies",
		"aimeos/pagible-webhooks": "For signed outbound notifications when CMS content changes"
	},
	"repositories": [
		{"type": "path", "url": "core"},
		{"type": "path", "url": "admin"},
		{"type": "path", "url": "ai"},
		{"type": "path", "url": "graphql"},
		{"type": "path", "url": "search"},
		{"type": "path", "url": "jsonapi"},
		{"type": "path", "url": "mcp"},
		{"type": "path", "url": "metrics"},
		{"type": "path", "url": "theme"},
		{"type": "path", "url": "webhooks"},
		{"type": "path", "url": "cdn"}
	],
	"autoload": {
		"psr-4": {
			"Aimeos\\Cms\\": ["src/"]
		}
	},
	"autoload-dev": {
		"psr-4": {
			"Aimeos\\Cms\\": [
				"backup/src/",
				"benchmark/src/",
				"cashier/src/",
				"cdn/src/",
				"import/src/",
				"pulse/src/",
				"themes/glass/src/",
				"themes/estate/src/",
				"themes/journal/src/",
				"themes/news/src/",
				"themes/pagible/src/",
				"themes/paper/src/",
				"themes/solid/src/",
				"themes/volt/src/",
				"themes/flow/src/",
				"themes/solar/src/",
				"themes/medical/src/",
				"themes/paws/src/",
				"themes/counsel/src/",
				"themes/brew/src/",
				"themes/tonic/src/",
				"themes/mane/src/",
				"themes/glow/src/",
				"themes/torque/src/",
				"themes/grove/src/",
				"themes/launch/src/",
				"themes/manual/src/",
				"themes/aura/src/",
				"themes/folio/src/",
				"themes/bold/src/",
				"themes/premium/src/",
				"themes/luxury/src/",
				"themes/style/src/",
				"themes/taste/src/",
				"webhooks/src/"
			],
			"Database\\Seeders\\": [
				"benchmark/database/seeders/",
				"themes/glass/database/seeders/",
				"themes/estate/database/seeders/",
				"themes/journal/database/seeders/",
				"themes/news/database/seeders/",
				"themes/pagible/database/seeders/",
				"themes/paper/database/seeders/",
				"themes/solid/database/seeders/",
				"themes/volt/database/seeders/",
				"themes/flow/database/seeders/",
				"themes/solar/database/seeders/",
				"themes/medical/database/seeders/",
				"themes/paws/database/seeders/",
				"themes/counsel/database/seeders/",
				"themes/brew/database/seeders/",
				"themes/tonic/database/seeders/",
				"themes/mane/database/seeders/",
				"themes/glow/database/seeders/",
				"themes/torque/database/seeders/",
				"themes/grove/database/seeders/",
				"themes/launch/database/seeders/",
				"themes/manual/database/seeders/",
				"themes/aura/database/seeders/",
				"themes/folio/database/seeders/",
				"themes/bold/database/seeders/",
				"themes/premium/database/seeders/",
				"themes/luxury/database/seeders/",
				"themes/style/database/seeders/",
				"themes/taste/database/seeders/"
			],
			"Tests\\": [
				"tests/",
				"core/tests/",
				"admin/tests/",
				"ai/tests/",
				"cashier/tests/",
				"cdn/tests/",
				"graphql/tests/",
				"import/tests/",
				"jsonapi/tests/",
				"mcp/tests/",
				"metrics/tests/",
				"pulse/tests/",
				"search/tests/",
				"theme/tests/",
				"themes/estate/tests/",
				"themes/solid/tests/",
				"themes/volt/tests/",
				"themes/flow/tests/",
				"themes/solar/tests/",
				"themes/medical/tests/",
				"themes/paws/tests/",
				"themes/counsel/tests/",
				"themes/brew/tests/",
				"themes/tonic/tests/",
				"themes/mane/tests/",
				"themes/glow/tests/",
				"themes/torque/tests/",
				"themes/grove/tests/",
				"themes/launch/tests/",
				"themes/manual/tests/",
				"themes/aura/tests/",
				"themes/folio/tests/",
				"backup/tests/",
				"webhooks/tests/"
			]
		},
		"classmap": [
			"tests/User.php"
		]
	},
	"scripts": {
		"post-autoload-dump": [
			"@php vendor/bin/testbench package:discover --ansi"
		],
		"translate": [
			"@php bin/translate",
			"npm run gettext:extract --workspaces",
			"@php bin/schema-i18n extract theme themes/*",
			"for POFILE in `ls admin/i18n/*.po */admin/i18n/*.po`; do msgattrib --no-obsolete -o $POFILE $POFILE; done",
			"for POFILE in `ls admin/i18n/*.po */admin/i18n/*.po`; do vendor/bin/potrans deepl --translator=bin/potrans-deepl.php --ignore='%\\{[a-z]+\\}' --only --pot=`dirname $POFILE`/messages.pot $POFILE; done",
			"npm run gettext:compile --workspaces",
			"for POFILE in `ls theme/i18n/*.po themes/*/i18n/*.po`; do vendor/bin/potrans deepl --translator=bin/potrans-deepl.php --only --pot=`dirname $POFILE`/messages.pot $POFILE; done",
			"@php bin/schema-i18n compile theme themes/*"
		],
		"build": [
			"@php bin/schema-i18n extract theme themes/*",
			"@php bin/schema-i18n compile theme themes/*",
			"npm run build --workspaces"
		],
		"coverage": [
			"npx playwright install chromium",
			"npm run coverage:all"
		]
	},
	"config": {
		"allow-plugins": {
			"php-http/discovery": true
		}
	},
	"extra": {
		"laravel": {
			"providers": [
				"Aimeos\\Cms\\ServiceProvider"
			]
		}
	}
}
