msgctxt "fh"
msgid "Form fields shown to visitors in this order"
msgstr "Поля формы, показываемые посетителям в этом порядке"

#: js/strings.js:316
msgctxt "fh"
msgid "Select a form field or enter your own name"
msgstr "Выберите поле формы или введите собственное название"

#: js/strings.js:317
msgctxt "fh"
msgid "Visitors must fill out this field"
msgstr "Посетители должны заполнить это поле"

#: js/strings.js:318
msgctxt "fh"
msgid "Type of input shown to visitors"
msgstr "Тип поля, показываемого посетителям"

#: js/strings.js:319
msgctxt "fh"
msgid "Choices for selection inputs, one per line"
msgstr "Варианты для полей выбора, по одному в строке"

#: js/strings.js:320
msgctxt "fh"
msgid ""
"Maximum number of images or PDF files visitors can attach, 0 disables uploads"
msgstr ""
"Максимальное количество изображений или PDF-файлов, которые могут прикрепить "
"посетители, 0 отключает загрузку"

