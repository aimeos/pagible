#: js/strings.js:305
msgctxt "fh"
msgid "Answer to the question"
msgstr "Ответ на вопрос"

#: js/strings.js:306
msgctxt "fh"
msgid "Optional headline shown above the timeline"
msgstr "Необязательный заголовок над хронологией"

#: js/strings.js:307
msgctxt "fh"
msgid ""
"Show the steps one below the other or side by side, side by side suits up to "
"five steps"
msgstr "Показывать шаги друг под другом или рядом, расположение рядом подходит для пяти шагов и меньше"

#: js/strings.js:308
msgctxt "fh"
msgid "Steps or events in the order they happen"
msgstr "Шаги или события в том порядке, в котором они происходят"

#: js/strings.js:309
msgctxt "fh"
msgid ""
"Optional date, period or phase shown above the title, e.g. 2024 or Week 1"
msgstr "Необязательная дата, период или этап над заголовком, например 2024 или Неделя 1"

#: js/strings.js:310
msgctxt "fh"
msgid "Name of the step or event"
msgstr "Название шага или события"

#: js/strings.js:311
msgctxt "fh"
msgid "Description of the step or event"
msgstr "Описание шага или события"

#: js/strings.js:312
msgctxt "fh"
msgid "Optional headline shown above the table of contents"
msgstr "Необязательный заголовок, отображаемый над оглавлением"

#: js/strings.js:313
msgctxt "fh"
msgid "Optional headline shown above the contact form"
msgstr "Необязательный заголовок, отображаемый над контактной формой"

#: js/strings.js:314
msgctxt "fh"
msgid "Optional text shown between headline and contact form"
msgstr "Необязательный текст между заголовком и контактной формой"

