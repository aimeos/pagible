msgctxt "fh"
msgid "Short description of the price plan"
msgstr "Краткое описание тарифного плана"

#: js/strings.js:299
msgctxt "fh"
msgid "List of the features included in the plan"
msgstr "Список функций, включённых в план"

#: js/strings.js:300
msgctxt "fh"
msgid "Emphasize this plan compared to the others"
msgstr "Выделить этот план на фоне остальных"

