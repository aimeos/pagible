msgctxt "fh"
msgid "Text of the headline"
msgstr "អត្ថបទនៃចំណងជើង"

#: js/strings.js:209
msgctxt "fh"
msgid ""
"Level 1 is the main page headline, higher levels structure the sections below"
msgstr "កម្រិត 1 គឺជាចំណងជើងចម្បងនៃទំព័រ កម្រិតខ្ពស់ជាងនេះរៀបចំរចនាសម្ព័ន្ធផ្នែកខាងក្រោម"

#: js/strings.js:210
msgctxt "fh"
msgid "Formatted text with paragraphs, lists and links"
msgstr "អត្ថបទដែលបានធ្វើទ្រង់ទ្រាយជាមួយកថាខណ្ឌ បញ្ជី និងតំណ"

#: js/strings.js:211
msgctxt "fh"
msgid "Formatted text shown next to the image"
msgstr "អត្ថបទដែលបានធ្វើទ្រង់ទ្រាយ បង្ហាញនៅជាប់រូបភាព"

#: js/strings.js:212
msgctxt "fh"
msgid "Image shown next to the text"
msgstr "រូបភាពដែលបង្ហាញនៅជាប់អត្ថបទ"

#: js/strings.js:213
msgctxt "fh"
msgid "Position of the image relative to the text"
msgstr "ទីតាំងរូបភាពធៀបនឹងអត្ថបទ"

#: js/strings.js:214
msgctxt "fh"
msgid "Width ratio between image and text"
msgstr "សមាមាត្រទទឹងរវាងរូបភាព និងអត្ថបទ"

#: js/strings.js:215
msgctxt "fh"
msgid "Programming language used for syntax highlighting"
msgstr "ភាសាកម្មវិធីដែលប្រើសម្រាប់ការបន្លិចវាក្យសម្ព័ន្ធ"

#: js/strings.js:216
msgctxt "fh"
msgid "Source code shown with syntax highlighting"
msgstr "កូដប្រភពដែលបង្ហាញជាមួយការបន្លិចវាក្យសម្ព័ន្ធ"

#: js/strings.js:217
msgctxt "fh"
msgid "Optional caption shown above the table"
msgstr "ចំណងជើងតារាងជាជម្រើស ដែលបង្ហាញនៅខាងលើតារាង"

#: js/strings.js:218
msgctxt "fh"
msgid "Use the first row, the first column or both as table headers"
msgstr "ប្រើជួរដេកទីមួយ ជួរឈរទីមួយ ឬទាំងពីរជាក្បាលតារាង"

#: js/strings.js:219
msgctxt "fh"
msgid "Enter data in the cells; add or remove rows and columns as needed"
msgstr "បញ្ចូលទិន្នន័យក្នុងក្រឡា ហើយបន្ថែម ឬលុបជួរដេក និងជួរឈរតាមតម្រូវការ"

#: js/strings.js:220
msgctxt "fh"
msgid "Optional headline shown above the map"
msgstr "ចំណងជើងជាជម្រើស ដែលបង្ហាញនៅខាងលើផែនទី"

#: js/strings.js:221
msgctxt "fh"
msgid "Description shown next to the map, e.g. address or directions"
msgstr "ការពិពណ៌នាដែលបង្ហាញនៅជាប់ផែនទី ឧ. អាសយដ្ឋាន ឬទិសដៅ"

#: js/strings.js:222
msgctxt "fh"
msgid "Search for a place or click on the map to set the location"
msgstr "ស្វែងរកទីកន្លែង ឬចុចលើផែនទីដើម្បីកំណត់ទីតាំង"

#: js/strings.js:223
msgctxt "fh"
msgid "Text of the link that opens the location in a map service"
msgstr "អត្ថបទនៃតំណដែលបើកទីតាំងក្នុងសេវាផែនទី"

#: js/strings.js:224
msgctxt "fh"
msgid "HTML code inserted into the page as is, e.g. for embeds and widgets"
msgstr "កូដ HTML ដែលបញ្ចូលទៅក្នុងទំព័រដូចដើម ឧ. សម្រាប់ការបង្កប់ និងវិដជែត"

#: js/strings.js:225
msgctxt "fh"
msgid "Image shown in full width of the content area"
msgstr "រូបភាពដែលបង្ហាញពេញទទឹងនៃតំបន់មាតិកា"

#: js/strings.js:226
msgctxt "fh"
msgid "Load the image without delay if it is visible at the top of the page"
msgstr "ផ្ទុករូបភាពដោយគ្មានការពន្យារពេល ប្រសិនបើវាអាចមើលឃើញនៅផ្នែកខាងលើនៃទំព័រ"

#: js/strings.js:227
msgctxt "fh"
msgid "Optional headline shown above the slideshow"
msgstr "ចំណងជើងជាជម្រើស ដែលបង្ហាញនៅខាងលើស្លាយបញ្ចាំង"

#: js/strings.js:228
msgctxt "fh"
msgid "Images shown one after another, drag to change the order"
msgstr "រូបភាពដែលបង្ហាញម្តងមួយៗ អូសដើម្បីប្តូរលំដាប់"

#: js/strings.js:229
msgctxt "fh"
msgid ""
"Load the first image without delay if it is visible at the top of the page"
msgstr "ផ្ទុករូបភាពទីមួយដោយគ្មានការពន្យារពេល ប្រសិនបើវាអាចមើលឃើញនៅផ្នែកខាងលើនៃទំព័រ"

#: js/strings.js:230
msgctxt "fh"
msgid "Video file played in the page"
msgstr "ឯកសារវីដេអូដែលចាក់នៅក្នុងទំព័រ"

#: js/strings.js:231
msgctxt "fh"
msgid "Audio file played in the page"
msgstr "ឯកសារសំឡេងដែលចាក់នៅក្នុងទំព័រ"

#: js/strings.js:232
msgctxt "fh"
msgid "File offered for download"
msgstr "ឯកសារដែលផ្តល់ជូនសម្រាប់ទាញយក"

#: js/strings.js:233
msgctxt "fh"
msgid "Main headline of the page"
msgstr "ចំណងជើងចម្បងនៃទំព័រ"

#: js/strings.js:234
msgctxt "fh"
msgid "Short line shown above the headline"
msgstr "បន្ទាត់ខ្លីដែលបង្ហាញនៅខាងលើចំណងជើង"

#: js/strings.js:235
msgctxt "fh"
msgid "Introduction shown below the headline"
msgstr "សេចក្តីផ្តើមដែលបង្ហាញនៅខាងក្រោមចំណងជើង"

#: js/strings.js:236
msgctxt "fh"
msgid "Page or link the main button leads to"
msgstr "ទំព័រ ឬតំណដែលប៊ូតុងចម្បងនាំទៅ"

#: js/strings.js:237
msgctxt "fh"
msgid "Text of the main button"
msgstr "អត្ថបទនៃប៊ូតុងចម្បង"

#: js/strings.js:238
msgctxt "fh"
msgid "Page or link the second button leads to"
msgstr "ទំព័រ ឬតំណដែលប៊ូតុងទីពីរនាំទៅ"

#: js/strings.js:239
msgctxt "fh"
msgid "Text of the second button"
msgstr "អត្ថបទនៃប៊ូតុងទីពីរ"

#: js/strings.js:240
msgctxt "fh"
msgid "Image shown behind the text"
msgstr "រូបភាពដែលបង្ហាញនៅពីក្រោយអត្ថបទ"

#: js/strings.js:241
msgctxt "fh"
msgid "Animation effect of the background image"
msgstr "បែបផែនចលនានៃរូបភាពផ្ទៃខាងក្រោយ"

#: js/strings.js:242
msgctxt "fh"
msgid "Images shown next to the text"
msgstr "រូបភាពដែលបង្ហាញនៅជាប់អត្ថបទ"

#: js/strings.js:243
msgctxt "fh"
msgid "Headline catching the attention of visitors"
msgstr "ចំណងជើងដែលទាក់ទាញការចាប់អារម្មណ៍របស់អ្នកទស្សនា"

#: js/strings.js:244
msgctxt "fh"
msgid "Text motivating visitors to take action"
msgstr "អត្ថបទដែលជំរុញអ្នកទស្សនាឱ្យធ្វើសកម្មភាព"

#: js/strings.js:245
msgctxt "fh"
msgid "Buttons leading visitors to the next step"
msgstr "ប៊ូតុងដែលនាំអ្នកទស្សនាទៅជំហានបន្ទាប់"

#: js/strings.js:246
msgctxt "fh"
msgid "Text of the button"
msgstr "អត្ថបទនៃប៊ូតុង"

#: js/strings.js:247
msgctxt "fh"
msgid "Page or link the button leads to"
msgstr "ទំព័រ ឬតំណដែលប៊ូតុងនាំទៅ"

#: js/strings.js:248
msgctxt "fh"
msgid "Optional headline shown above the cards"
msgstr "ចំណងជើងជាជម្រើស ដែលបង្ហាញនៅខាងលើកាត"

#: js/strings.js:249
msgctxt "fh"
msgid "Number of cards per row, \"auto\" adapts to the screen width"
msgstr "ចំនួនកាតក្នុងមួយជួរ \"auto\" សម្របតាមទទឹងអេក្រង់"

#: js/strings.js:250
msgctxt "fh"
msgid "Cards shown in the grid"
msgstr "កាតដែលបង្ហាញក្នុងក្រឡាចត្រង្គ"

#: js/strings.js:251
msgctxt "fh"
msgid "Headline of the card"
msgstr "ចំណងជើងនៃកាត"

#: js/strings.js:252
msgctxt "fh"
msgid "Image shown at the top of the card"
msgstr "រូបភាពដែលបង្ហាញនៅផ្នែកខាងលើនៃកាត"

#: js/strings.js:253
msgctxt "fh"
msgid "Text of the card"
msgstr "អត្ថបទនៃកាត"

#: js/strings.js:254
msgctxt "fh"
msgid "Page or link the card leads to"
msgstr "ទំព័រ ឬតំណដែលកាតនាំទៅ"

#: js/strings.js:255
msgctxt "fh"
msgid "Optional headline shown above the quotes"
msgstr "ចំណងជើងជាជម្រើស ដែលបង្ហាញនៅខាងលើសម្រង់សម្តី"

#: js/strings.js:256
msgctxt "fh"
msgid "Quotes of customers or partners"
msgstr "សម្រង់សម្តីរបស់អតិថិជន ឬដៃគូ"

#: js/strings.js:257
msgctxt "fh"
msgid "Quote of the person"
msgstr "សម្រង់សម្តីរបស់បុគ្គល"

#: js/strings.js:258
msgctxt "fh"
msgid "Name of the person"
msgstr "ឈ្មោះរបស់បុគ្គល"

#: js/strings.js:259
msgctxt "fh"
msgid "Position or company of the person"
msgstr "មុខតំណែង ឬក្រុមហ៊ុនរបស់បុគ្គល"

#: js/strings.js:260
msgctxt "fh"
msgid "Photo of the person"
msgstr "រូបថតរបស់បុគ្គល"

#: js/strings.js:261
msgctxt "fh"
msgid "Introduction of the article shown below the page title"
msgstr "សេចក្តីផ្តើមនៃអត្ថបទ ដែលបង្ហាញនៅខាងក្រោមចំណងជើងទំព័រ"

#: js/strings.js:262
msgctxt "fh"
msgid "Images of the article, the first one is used as preview image"
msgstr "រូបភាពនៃអត្ថបទ រូបទីមួយត្រូវបានប្រើជារូបភាពមើលជាមុន"

#: js/strings.js:263
msgctxt "fh"
msgid "Name of the author of the article"
msgstr "ឈ្មោះអ្នកនិពន្ធអត្ថបទ"

#: js/strings.js:264
msgctxt "fh"
msgid "Link to the profile page of the author"
msgstr "តំណទៅទំព័រប្រវត្តិរូបរបស់អ្នកនិពន្ធ"

#: js/strings.js:265
msgctxt "fh"
msgid "Optional headline shown above the list"
msgstr "ចំណងជើងជាជម្រើស ដែលបង្ហាញនៅខាងលើបញ្ជី"

#: js/strings.js:266
msgctxt "fh"
msgid "Display the pages as cards or as a compact list"
msgstr "បង្ហាញទំព័រជាកាត ឬជាបញ្ជីបង្រួម"

#: js/strings.js:267
msgctxt "fh"
msgid "Page whose subpages are listed"
msgstr "ទំព័រដែលទំព័ររងរបស់វាត្រូវបានរាយបញ្ជី"

#: js/strings.js:268
msgctxt "fh"
msgid "Sort order of the listed pages"
msgstr "លំដាប់តម្រៀបនៃទំព័រដែលបានរាយបញ្ជី"

#: js/strings.js:269
msgctxt "fh"
msgid "Maximum number of pages shown at once"
msgstr "ចំនួនទំព័រអតិបរមាដែលបង្ហាញក្នុងពេលតែមួយ"

#: js/strings.js:270
msgctxt "fh"
msgid "Display the further subpages as cards or as a compact list"
msgstr "បង្ហាញទំព័ររងផ្សេងទៀតជាកាត ឬជាបញ្ជីបង្រួម"

#: js/strings.js:271
msgctxt "fh"
msgid "Optional headline shown above the price plans"
msgstr "ចំណងជើងជាជម្រើស ដែលបង្ហាញនៅខាងលើគម្រោងតម្លៃ"

#: js/strings.js:272
msgctxt "fh"
msgid "Short text shown below the headline"
msgstr "អត្ថបទខ្លីដែលបង្ហាញនៅខាងក្រោមចំណងជើង"

#: js/strings.js:273
msgctxt "fh"
msgid "Price plans shown side by side"
msgstr "គម្រោងតម្លៃដែលបង្ហាញនៅជាប់គ្នា"

#: js/strings.js:274
msgctxt "fh"
msgid "Name of the price plan"
msgstr "ឈ្មោះគម្រោងតម្លៃ"

#: js/strings.js:275
msgctxt "fh"
msgid "Role granted to customers after the payment to access protected pages"
msgstr "តួនាទីដែលផ្តល់ឱ្យអតិថិជនបន្ទាប់ពីការទូទាត់ ដើម្បីចូលប្រើទំព័រដែលបានការពារ"

#: js/strings.js:276
msgctxt "fh"
msgid "Prices of the plan, e.g. monthly and yearly"
msgstr "តម្លៃនៃគម្រោង ឧ. ប្រចាំខែ និងប្រចាំឆ្នាំ"

#: js/strings.js:277
msgctxt "fh"
msgid "Recurring subscription or one-time payment"
msgstr "ការជាវដដែលៗ ឬការទូទាត់តែម្តង"

#: js/strings.js:278
msgctxt "fh"
msgid "Number of days between two payments, e.g. 30 for monthly"
msgstr "ចំនួនថ្ងៃរវាងការទូទាត់ពីរ ឧ. 30 សម្រាប់ប្រចាំខែ"

#: js/strings.js:279
msgctxt "fh"
msgid "Three letter ISO currency code, e.g. EUR or USD"
msgstr "លេខកូដរូបិយប័ណ្ណ ISO បីអក្សរ ឧ. EUR ឬ USD"

#: js/strings.js:280
msgctxt "fh"
msgid "Price ID or amount used by the payment provider"
msgstr "ID តម្លៃ ឬចំនួនទឹកប្រាក់ដែលប្រើដោយអ្នកផ្តល់សេវាទូទាត់"

#: js/strings.js:281
msgctxt "fh"
msgid "Formatted price shown to visitors, e.g. €9.99"
msgstr "តម្លៃដែលបានធ្វើទ្រង់ទ្រាយបង្ហាញដល់អ្នកទស្សនា ឧ. €9.99"

#: js/strings.js:282
msgctxt "fh"
msgid "Numeric price shown if no formatted price is set"
msgstr "តម្លៃជាលេខដែលបង្ហាញ ប្រសិនបើមិនបានកំណត់តម្លៃដែលបានធ្វើទ្រង់ទ្រាយ"

#: js/strings.js:283
msgctxt "fh"
msgid "Text shown after the price, e.g. per month"
msgstr "អត្ថបទដែលបង្ហាញបន្ទាប់ពីតម្លៃ ឧ. ក្នុងមួយខែ"

#: js/strings.js:284
msgctxt "fh"
msgid "Short description of the price plan"
msgstr "ការពិពណ៌នាខ្លីនៃគម្រោងតម្លៃ"

#: js/strings.js:285
msgctxt "fh"
msgid "List of the features included in the plan"
msgstr "បញ្ជីមុខងារដែលរួមបញ្ចូលក្នុងគម្រោង"

#: js/strings.js:286
msgctxt "fh"
msgid "Emphasize this plan compared to the others"
msgstr "សង្កត់ធ្ងន់លើគម្រោងនេះធៀបនឹងគម្រោងផ្សេងទៀត"

#: js/strings.js:287
msgctxt "fh"
msgid "Short label shown on the highlighted plan, e.g. Popular"
msgstr "ស្លាកខ្លីដែលបង្ហាញលើគម្រោងដែលបានបន្លិច ឧ. ពេញនិយម"

#: js/strings.js:288
msgctxt "fh"
msgid "Optional headline shown above the questions"
msgstr "ចំណងជើងជាជម្រើស ដែលបង្ហាញនៅខាងលើសំណួរ"

#: js/strings.js:289
msgctxt "fh"
msgid "Questions and answers shown as expandable list"
msgstr "សំណួរ និងចម្លើយដែលបង្ហាញជាបញ្ជីអាចពង្រីកបាន"

#: js/strings.js:290
msgctxt "fh"
msgid "Question asked by visitors"
msgstr "សំណួរដែលសួរដោយអ្នកទស្សនា"

#: js/strings.js:291
msgctxt "fh"
msgid "Answer to the question"
msgstr "ចម្លើយចំពោះសំណួរ"

#: js/strings.js:292
msgctxt "fh"
msgid "Optional headline shown above the table of contents"
msgstr "ចំណងជើងជាជម្រើស ដែលបង្ហាញនៅខាងលើតារាងមាតិកា"

#: js/strings.js:293
msgctxt "fh"
msgid "Optional headline shown above the contact form"
msgstr "ចំណងជើងជាជម្រើស ដែលបង្ហាញនៅខាងលើទម្រង់ទំនាក់ទំនង"

#: js/strings.js:294
msgctxt "fh"
msgid "Optional text shown between headline and contact form"
msgstr "អត្ថបទជាជម្រើស ដែលបង្ហាញរវាងចំណងជើង និងទម្រង់ទំនាក់ទំនង"

#: js/strings.js:295
msgctxt "fh"
msgid "Form fields shown to visitors in this order"
msgstr "វាលទម្រង់ដែលបង្ហាញដល់អ្នកទស្សនាតាមលំដាប់នេះ"

#: js/strings.js:296
msgctxt "fh"
msgid "Select a form field or enter your own name"
msgstr "ជ្រើសរើសវាលទម្រង់ ឬបញ្ចូលឈ្មោះផ្ទាល់ខ្លួនរបស់អ្នក"

#: js/strings.js:297
msgctxt "fh"
msgid "Visitors must fill out this field"
msgstr "អ្នកទស្សនាត្រូវតែបំពេញវាលនេះ"

#: js/strings.js:298
msgctxt "fh"
msgid ""
"Summary of the page shown in search results, 150 to 160 characters "
"recommended"
msgstr "សេចក្តីសង្ខេបនៃទំព័រដែលបង្ហាញក្នុងលទ្ធផលស្វែងរក ណែនាំឱ្យមាន 150 ទៅ 160 តួអក្សរ"

#: js/strings.js:299
msgctxt "fh"
msgid "Comma separated list of keywords describing the page"
msgstr "បញ្ជីពាក្យគន្លឹះដែលពិពណ៌នាទំព័រ បំបែកដោយសញ្ញាក្បៀស"

#: js/strings.js:300
msgctxt "fh"
msgid "Title shown when the page is shared in social media"
msgstr "ចំណងជើងដែលបង្ហាញនៅពេលទំព័រត្រូវបានចែករំលែកលើបណ្តាញសង្គម"

#: js/strings.js:301
msgctxt "fh"
msgid "Summary shown when the page is shared in social media"
msgstr "សេចក្តីសង្ខេបដែលបង្ហាញនៅពេលទំព័រត្រូវបានចែករំលែកលើបណ្តាញសង្គម"

#: js/strings.js:302
msgctxt "fh"
msgid "Preview image shown when the page is shared in social media"
msgstr "រូបភាពមើលជាមុនដែលបង្ហាញនៅពេលទំព័រត្រូវបានចែករំលែកលើបណ្តាញសង្គម"

#: js/strings.js:303
msgctxt "fh"
msgid "Original URL if the same content is available at several addresses"
msgstr "URL ដើម ប្រសិនបើមាតិកាដដែលមាននៅអាសយដ្ឋានច្រើន"

#: js/strings.js:304
msgctxt "fh"
msgid "Allow or prevent search engines from listing this page"
msgstr "អនុញ្ញាត ឬរារាំងម៉ាស៊ីនស្វែងរកពីការរាយបញ្ជីទំព័រនេះ"

#: js/strings.js:305
msgctxt "fh"
msgid "Allow or prevent search engines from following the links on this page"
msgstr "អនុញ្ញាត ឬរារាំងម៉ាស៊ីនស្វែងរកពីការតាមដានតំណនៅលើទំព័រនេះ"

#: js/strings.js:306
msgctxt "fh"
msgid "Name of the website shown in the browser tab and search results"
msgstr "ឈ្មោះគេហទំព័រដែលបង្ហាញក្នុងផ្ទាំងកម្មវិធីរុករក និងលទ្ធផលស្វែងរក"

#: js/strings.js:307
msgctxt "fh"
msgid "Logo shown in the page header"
msgstr "ឡូហ្គោដែលបង្ហាញនៅក្បាលទំព័រ"

#: js/strings.js:308
msgctxt "fh"
msgid "Logo variant used for dark backgrounds"
msgstr "កំណែឡូហ្គោដែលប្រើសម្រាប់ផ្ទៃខាងក្រោយងងឹត"

#: js/strings.js:309
msgctxt "fh"
msgid "Small square image shown in browser tabs and bookmarks"
msgstr "រូបភាពការ៉េតូចដែលបង្ហាញក្នុងផ្ទាំងកម្មវិធីរុករក និងចំណាំ"

#: js/strings.js:310
msgctxt "fh"
msgid "Comma separated list of fonts used for the text"
msgstr "បញ្ជីពុម្ពអក្សរដែលប្រើសម្រាប់អត្ថបទ បំបែកដោយសញ្ញាក្បៀស"

#: js/strings.js:311
msgctxt "fh"
msgid "Default text color"
msgstr "ពណ៌អត្ថបទលំនាំដើម"

#: js/strings.js:312
msgctxt "fh"
msgid "Background color of the pages"
msgstr "ពណ៌ផ្ទៃខាងក្រោយនៃទំព័រ"

#: js/strings.js:313
msgctxt "fh"
msgid "Background color of selected text"
msgstr "ពណ៌ផ្ទៃខាងក្រោយនៃអត្ថបទដែលបានជ្រើសរើស"

#: js/strings.js:314
msgctxt "fh"
msgid "Color of elements with strong contrast to the background"
msgstr "ពណ៌នៃធាតុដែលមានភាពផ្ទុយខ្លាំងធៀបនឹងផ្ទៃខាងក្រោយ"

#: js/strings.js:315
msgctxt "fh"
msgid "Contrast color when hovering or focusing an element"
msgstr "ពណ៌ផ្ទុយនៅពេលដាក់ទស្សន៍ទ្រនិចលើ ឬផ្តោតលើធាតុ"

#: js/strings.js:316
msgctxt "fh"
msgid "Text color on elements using the contrast color"
msgstr "ពណ៌អត្ថបទលើធាតុដែលប្រើពណ៌ផ្ទុយ"

#: js/strings.js:317
msgctxt "fh"
msgid "Main brand color used for links and buttons"
msgstr "ពណ៌ម៉ាកចម្បងដែលប្រើសម្រាប់តំណ និងប៊ូតុង"

#: js/strings.js:318
msgctxt "fh"
msgid "Background color of primary buttons and highlights"
msgstr "ពណ៌ផ្ទៃខាងក្រោយនៃប៊ូតុងចម្បង និងការបន្លិច"

#: js/strings.js:319
msgctxt "fh"
msgid "Primary color when hovering or focusing an element"
msgstr "ពណ៌ចម្បងនៅពេលដាក់ទស្សន៍ទ្រនិចលើ ឬផ្តោតលើធាតុ"

#: js/strings.js:320
msgctxt "fh"
msgid "Primary background color when hovering or focusing an element"
msgstr "ពណ៌ផ្ទៃខាងក្រោយចម្បងនៅពេលដាក់ទស្សន៍ទ្រនិចលើ ឬផ្តោតលើធាតុ"

#: js/strings.js:321
msgctxt "fh"
msgid "Additional color used for less important links and buttons"
msgstr "ពណ៌បន្ថែមដែលប្រើសម្រាប់តំណ និងប៊ូតុងដែលមិនសូវសំខាន់"

#: js/strings.js:322
msgctxt "fh"
msgid "Background color of secondary buttons"
msgstr "ពណ៌ផ្ទៃខាងក្រោយនៃប៊ូតុងបន្ទាប់បន្សំ"

#: js/strings.js:323
msgctxt "fh"
msgid "Secondary color when hovering or focusing an element"
msgstr "ពណ៌បន្ទាប់បន្សំនៅពេលដាក់ទស្សន៍ទ្រនិចលើ ឬផ្តោតលើធាតុ"

#: js/strings.js:324
msgctxt "fh"
msgid "Secondary background color when hovering or focusing an element"
msgstr "ពណ៌ផ្ទៃខាងក្រោយបន្ទាប់បន្សំនៅពេលដាក់ទស្សន៍ទ្រនិចលើ ឬផ្តោតលើធាតុ"

#: js/strings.js:325
msgctxt "fh"
msgid "Rounding of corners as CSS length, e.g. 0.25rem or 0 for sharp corners"
msgstr "ភាពមូលនៃជ្រុងជាប្រវែង CSS ឧ. 0.25rem ឬ 0 សម្រាប់ជ្រុងស្រួច"

#: js/strings.js:326
msgctxt "fh"
msgid "Character shown between the breadcrumb links"
msgstr "តួអក្សរដែលបង្ហាញរវាងតំណផ្លូវរុករក (breadcrumb)"

#: js/strings.js:327
msgctxt "fh"
msgid "HTTPS link to contact the security team, e.g. a form"
msgstr "តំណ HTTPS ដើម្បីទាក់ទងក្រុមសុវត្ថិភាព ឧ. ទម្រង់បែបបទ"

#: js/strings.js:328
msgctxt "fh"
msgid "E-mail address for reporting security issues"
msgstr "អាសយដ្ឋានអ៊ីមែលសម្រាប់រាយការណ៍បញ្ហាសុវត្ថិភាព"

#: js/strings.js:329
msgctxt "fh"
msgid "Date after which the security information is considered outdated"
msgstr "កាលបរិច្ឆេទដែលបន្ទាប់ពីនោះព័ត៌មានសុវត្ថិភាពត្រូវចាត់ទុកថាហួសសម័យ"

#: js/strings.js:330
msgctxt "fh"
msgid "HTTPS link to the public key for encrypted messages"
msgstr "តំណ HTTPS ទៅកូនសោសាធារណៈសម្រាប់សារដែលបានអ៊ិនគ្រីប"

#: js/strings.js:331
msgctxt "fh"
msgid "HTTPS link to the page thanking security researchers"
msgstr "តំណ HTTPS ទៅទំព័រថ្លែងអំណរគុណអ្នកស្រាវជ្រាវសុវត្ថិភាព"

#: js/strings.js:332
msgctxt "fh"
msgid "Comma separated language codes for security reports, e.g. en, de"
msgstr "លេខកូដភាសាសម្រាប់របាយការណ៍សុវត្ថិភាព បំបែកដោយសញ្ញាក្បៀស ឧ. en, de"

#: js/strings.js:333
msgctxt "fh"
msgid "HTTPS URL where the security.txt file is published"
msgstr "HTTPS URL ដែលឯកសារ security.txt ត្រូវបានបោះផ្សាយ"

#: js/strings.js:334
msgctxt "fh"
msgid "HTTPS link to the security and disclosure policy"
msgstr "តំណ HTTPS ទៅគោលការណ៍សុវត្ថិភាព និងការបង្ហាញព័ត៌មាន"

#: js/strings.js:335
msgctxt "fh"
msgid "HTTPS link to open security related jobs"
