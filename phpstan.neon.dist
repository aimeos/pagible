includes:
	- vendor/larastan/larastan/extension.neon
	- vendor/nesbot/carbon/extension.neon

parameters:
	level: 8
	treatPhpDocTypesAsCertain: false
	ignoreErrors:
		# Scope is generic in Laravel 13 but not in Laravel 11/12.
		-
			identifier: generics.notGeneric
			paths:
				- core/src/Scopes/Status.php
				- core/src/Scopes/Tenancy.php
			reportUnmatched: false
	paths:
		- src
		- core/src
		- admin/src
		- ai/src
		- graphql/src
		- import/src
		- jsonapi/src
		- mcp/src
		- search/src
		- backup/src
		- benchmark/src
		- benchmark/database/seeders
		- cashier/src
		- cdn/src
		- pulse/src
		- theme/src
		- theme/database/seeders
		- webhooks/src
		- themes/bold/src
		- themes/bold/database/seeders
		- themes/brew/src
		- themes/brew/database/seeders
		- themes/counsel/src
		- themes/counsel/database/seeders
		- themes/estate/src
		- themes/estate/database/seeders
		- themes/flow/src
		- themes/flow/database/seeders
		- themes/glass/src
		- themes/glass/database/seeders
		- themes/journal/src
		- themes/journal/database/seeders
		- themes/luxury/src
		- themes/luxury/database/seeders
		- themes/mane/src
		- themes/mane/database/seeders
		- themes/medical/src
		- themes/medical/database/seeders
		- themes/news/src
		- themes/news/database/seeders
		- themes/pagible/src
		- themes/pagible/database/seeders
		- themes/paws/src
		- themes/paws/database/seeders
		- themes/paper/src
		- themes/paper/database/seeders
		- themes/premium/src
		- themes/premium/database/seeders
		- themes/solar/src
		- themes/solar/database/seeders
		- themes/solid/src
		- themes/solid/database/seeders
		- themes/volt/src
		- themes/volt/database/seeders
		- themes/style/src
		- themes/style/database/seeders
		- themes/taste/src
		- themes/taste/database/seeders
		- themes/tonic/src
		- themes/tonic/database/seeders
		- tests/User.php
