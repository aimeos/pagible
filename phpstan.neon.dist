includes:
	- vendor/larastan/larastan/extension.neon
	- vendor/nesbot/carbon/extension.neon

parameters:
	level: 8
	treatPhpDocTypesAsCertain: false
	ignoreErrors:
		# Scope is generic in Laravel 13 but not in Laravel 11/12.
		-
			identifier: generics.notGeneric
			paths:
				- core/src/Scopes/Status.php
				- core/src/Scopes/Tenancy.php
			reportUnmatched: false
	paths:
		- src
		- core/src
		- admin/src
		- ai/src
		- graphql/src
		- import/src
		- jsonapi/src
		- mcp/src
		- search/src
		- backup/src
		- cashier/src
		- theme/src
		- theme/database/seeders
		- tests/User.php
